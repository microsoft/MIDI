    <activatableClass name="Windows.Devices.Midi2.MidiUniversalSystemExclusiveChannel" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />

    <!-- Windows.Devices.Midi2.CapabilityInquiry -->
    <activatableClass name="Windows.Devices.Midi2.CapabilityInquiry.MidiCapabilityInquiryMessage" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
