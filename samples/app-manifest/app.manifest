<?xml version="1.0" encoding="utf-8"?>
<!--
  Example application manifest for Windows MIDI Services (Windows.Devices.Midi2)

  For an unpackaged desktop app that ships its own copy of Windows.Devices.Midi2.dll next to its
  .exe. Use this file as your app's manifest, or copy the <file> section into the one you have.
  Change the assemblyIdentity name and version to your app's own.

  Windows looks up a Windows Runtime class in its registration, and your copy of the DLL isn't
  registered. The <file> section tells Windows where each class is, so RoGetActivationFactory and
  RoActivateInstance can find it from any language. C++/WinRT, C#/WinRT, and the Rust windows
  crate already load the DLL from your app's folder when a class isn't registered, so apps built
  with those work without this.

  The list has every class an app asks for by name: each class with a constructor or static
  members. Every other class only comes back from calls into the API, so it doesn't need an entry.

  On a PC where Windows MIDI Services is part of Windows, Windows uses its own copy for each class
  it registers, and ignores the entry here for that class.

  Made from version 0.99.91-preview.11 of the Windows.Devices.Midi2 NuGet package. If you ship a
  different version, check the list against it. A missing class fails with REGDB_E_CLASSNOTREG
  (0x80040154).

  https://learn.microsoft.com/windows/win32/sbscs/application-manifests#activatableclass
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="Contoso.MidiApp" version="1.0.0.0" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <file name="Windows.Devices.Midi2.dll">
    <!-- Windows.Devices.Midi2 -->
    <activatableClass name="Windows.Devices.Midi2.MidiApi" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Windows.Devices.Midi2.MidiChannel" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Windows.Devices.Midi2.MidiClock" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Windows.Devices.Midi2.MidiEndpointConnection" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Windows.Devices.Midi2.MidiEndpointConnectionSettings" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
