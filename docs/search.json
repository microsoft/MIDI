---
layout: null
---
{% assign indexed = site.pages | where_exp: "p", "p.title" %}
[
  {% for post in indexed %}{% unless post.url contains ".json" or post.url contains "404" %}
    {
      "title"    : {{ post.title | jsonify }},
      "description": {{ post.description | jsonify }},
      "namespace"    : {{ post.namespace | jsonify }},
      "type"    : {{ post.type | jsonify }},
      "categories" : {{ post.categories | join: ", " | jsonify }},
      "tags"     : {{ post.tags | join: ", " | jsonify }},
      "content"  : {{ post.content | strip_html | normalize_whitespace | truncate: 6000, "" | jsonify }},
      "url"      : {{ post.url | relative_url | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endunless %}{% endfor %}
]