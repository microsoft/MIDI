<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

    <?define StagingSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\staging ?>
    <?define TransportStagingFolder=$(StagingSourceRootFolder)\api\$(var.Platform) ?>

    <?define StagingVersionIncludeFile=$(StagingSourceRootFolder)\version\BundleInfo.wxi ?>
    <?include $(StagingVersionIncludeFile) ?>

    <!-- Each CLSID is shared with the in-box version of that transport, which is what makes the
         uninstall behavior below matter. -->
    <?define NetworkTransportClsid={C95DCD1F-CDE3-4C2D-913C-528CB8A4CBE6} ?>
    <?define NetworkTransportPluginKeyName=Midi2NetworkMidiTransport ?>

    <?define RtpMidiTransportClsid={54c9b2f6-c235-4000-a675-9f6958a1a4fa} ?>
    <?define RtpMidiTransportPluginKeyName=Midi2RtpMidiTransport ?>

    <?define BasicLoopbackTransportClsid={10088473-9478-4E62-850B-3D2315E135B8} ?>
    <?define BasicLoopbackTransportPluginKeyName=Midi2BasicLoopbackMidiTransport ?>

    <?define SynthTransportClsid={7605713E-FEA9-409D-A90F-A81233200D0A} ?>
    <?define SynthTransportPluginKeyName=Midi2MidiSynthTransport ?>

    <?define BluetoothTransportClsid={5dc87270-f318-4838-a4f9-6aadc63e925f} ?>
    <?define BluetoothTransportPluginKeyName=Midi2BluetoothMidiTransport ?>

    <Package  
          Name="Microsoft Windows MIDI Services Transports (Preview) $(var.Platform)"
          Manufacturer="Microsoft Corporation"
          Version="$(MidiPluginsNumericVersion)"
          UpgradeCode="8d0373b1-7fc1-482d-9a71-d6e48bccf355"
          Scope="perMachine"
          Compressed="true"
          
          >
       
        <MediaTemplate EmbedCab="yes" />

        <!--
          The unregister actions at the bottom of this file are conditioned on NOT
          UPGRADINGPRODUCTCODE, which Windows Installer sets only while it removes a superseded
          product as part of an upgrade, so an upgrade never tears down the registrations it is
          about to write again. A real uninstall still has the property unset, so the ownership
          test in UnregisterTransportComServerIfOwned runs. That test is what protects an in-box
          transport which has taken the CLSID over.

          Same version upgrades are allowed because preview builds do not always carry a new
          version number, and without this two of them install side by side.
        -->
        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            DowngradeErrorMessage="A newer version of Windows MIDI Services Transports (Preview) is already installed. Uninstall it first to install this version." />

        <!--
          The separate transport installers this one replaces: Network MIDI 2.0 and RTP-MIDI,
          Bluetooth MIDI, Basic Loopback, and the General MIDI Synthesizer. Customers do not always
          uninstall those first, so they are removed here, before anything is installed. Whatever
          their removal does to the COM registrations, the actions below write them again for the
          files this package installs.
        -->
        <Upgrade Id="2d53aa96-4021-41fe-b5ef-6df7e345a0b9">
            <UpgradeVersion Minimum="0.0.0" Property="PREVIOUSNETWORKINSTALLER" />
        </Upgrade>

        <Upgrade Id="33ef0c51-c5d3-458b-a58f-d66253b7ed7f">
            <UpgradeVersion Minimum="0.0.0" Property="PREVIOUSBLUETOOTHINSTALLER" />
        </Upgrade>

        <Upgrade Id="10088473-9478-4e62-850b-3d2315e135b8">
            <UpgradeVersion Minimum="0.0.0" Property="PREVIOUSBASICLOOPBACKINSTALLER" />
        </Upgrade>

        <Upgrade Id="94a024e8-7551-469a-b3ae-03cf9d78a578">
            <UpgradeVersion Minimum="0.0.0" Property="PREVIOUSSYNTHINSTALLER" />
        </Upgrade>

        
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="ROOTINSTALLFOLDER" Name="Windows MIDI Services">
                <Directory Id="SERVICE_INSTALLFOLDER" Name="Service" />
            </Directory>
        </StandardDirectory>
        
        <!--
          Deliberately no SelfRegCost here. Self-registration also self-UNregisters, and
          DllUnregisterServer removes the CLSID no matter who owns it by then. Customers who
          uninstalled a preview transport after an in-box version had shipped were left with an
          in-box transport that could not load, because its CLSID and its transport plugin key had
          just been deleted. Registration is done from the custom actions at the bottom of this file
          instead, and removal only happens when the registration still points at the file this
          package installed.

          Each file keeps the component GUID it had in the separate installer that used to carry
          it. If that installer is still present, Windows Installer counts both as owners of the
          file, and removing one leaves it for the other.
        -->
        <Component Id="NetworkTransport"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="3727cc9a-c427-4237-a733-5c6b10b33a9d">

            <File Id="Midi2NetworkMidiTransportDll"
                  Source="$(TransportStagingFolder)\Midi2.NetworkMidiTransport.dll"
                  Vital="true" />
        </Component>

        <!-- RTP-MIDI (IETF RFC 6295) -->
        <Component Id="RtpMidiTransport"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="0e05cc7d-2760-420d-be52-c0dada692552">

            <File Id="Midi2RtpMidiTransportDll"
                  Source="$(TransportStagingFolder)\Midi2.RtpMidiTransport.dll"
                  Vital="true" />
        </Component>

        <Component Id="BasicLoopbackTransport"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="934b1877-4837-426c-acf8-6e9196604dbe">

            <File Id="Midi2BasicLoopbackMidiTransportDll"
                  Source="$(TransportStagingFolder)\Midi2.BasicLoopbackMidiTransport.dll"
                  Vital="true" />
        </Component>

        <!-- The synthesizer reads the sound set Windows already installs in System32, and its
             engine is a static library linked into the DLL, so the DLL is its whole payload. -->
        <Component Id="SynthTransport"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="5a2ef5ee-4af0-411b-8aa5-500a793f9576">

            <File Id="Midi2MidiSynthTransportDll"
                  Source="$(TransportStagingFolder)\Midi2.MidiSynthTransport.dll"
                  Vital="true" />
        </Component>

        <Component Id="BluetoothTransport"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="1613365a-91e4-454e-b8f6-06325da85204">

            <File Id="Midi2BluetoothMidiTransportDll"
                  Source="$(TransportStagingFolder)\Midi2.BluetoothMidiTransport.dll"
                  Vital="true" />
        </Component>
        

      <!-- midisrv only picks the transports up when it restarts -->
      <Component Id="RestartService"
                 Bitness="always64"
                 Directory="SERVICE_INSTALLFOLDER"
                 Guid="219de177-e969-403f-8938-609c7d4ddc75">

        <ServiceControl Id="midisrv" Name="midisrv"
                        Start="both"
                        Stop="both"/>

      </Component>


      <Feature Id="WindowsMIDIServices">
        <ComponentRef Id="NetworkTransport"/>
        <ComponentRef Id="RtpMidiTransport"/>
        <ComponentRef Id="BasicLoopbackTransport"/>
        <ComponentRef Id="SynthTransport"/>
        <ComponentRef Id="BluetoothTransport"/>
        <ComponentRef Id="RestartService"/>
      </Feature>


      <Binary Id="CustomActionBinary"
              SourceFile="$(var.customactions.TargetDir)$(var.customactions.TargetName).CA.dll" />

      <!-- The registry keys the transports need may be owned by an earlier in-box or preview
           install, so ownership is taken before anything is written to them. -->
      <CustomAction Id="Action_TakeRegistryOwnership"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="TakeRegistryOwnership"
                    Return="check"/>

      <!-- Deferred custom actions cannot read properties, so everything they need is handed over
           through CustomActionData. -->
      <SetProperty Id="Action_RegisterNetworkTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.NetworkMidiTransport.dll;Clsid=$(NetworkTransportClsid);PluginKeyName=$(NetworkTransportPluginKeyName)"
                   Before="Action_RegisterNetworkTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_RegisterNetworkTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RegisterTransportComServer"
                    Return="check" />

      <SetProperty Id="Action_UnregisterNetworkTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.NetworkMidiTransport.dll;Clsid=$(NetworkTransportClsid);PluginKeyName=$(NetworkTransportPluginKeyName)"
                   Before="Action_UnregisterNetworkTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_UnregisterNetworkTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="UnregisterTransportComServerIfOwned"
                    Return="check" />

      <SetProperty Id="Action_RegisterRtpMidiTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.RtpMidiTransport.dll;Clsid=$(RtpMidiTransportClsid);PluginKeyName=$(RtpMidiTransportPluginKeyName)"
                   Before="Action_RegisterRtpMidiTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_RegisterRtpMidiTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RegisterTransportComServer"
                    Return="check" />

      <SetProperty Id="Action_UnregisterRtpMidiTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.RtpMidiTransport.dll;Clsid=$(RtpMidiTransportClsid);PluginKeyName=$(RtpMidiTransportPluginKeyName)"
                   Before="Action_UnregisterRtpMidiTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_UnregisterRtpMidiTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="UnregisterTransportComServerIfOwned"
                    Return="check" />

      <SetProperty Id="Action_RegisterBasicLoopbackTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.BasicLoopbackMidiTransport.dll;Clsid=$(BasicLoopbackTransportClsid);PluginKeyName=$(BasicLoopbackTransportPluginKeyName)"
                   Before="Action_RegisterBasicLoopbackTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_RegisterBasicLoopbackTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RegisterTransportComServer"
                    Return="check" />

      <SetProperty Id="Action_UnregisterBasicLoopbackTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.BasicLoopbackMidiTransport.dll;Clsid=$(BasicLoopbackTransportClsid);PluginKeyName=$(BasicLoopbackTransportPluginKeyName)"
                   Before="Action_UnregisterBasicLoopbackTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_UnregisterBasicLoopbackTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="UnregisterTransportComServerIfOwned"
                    Return="check" />

      <SetProperty Id="Action_RegisterSynthTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.MidiSynthTransport.dll;Clsid=$(SynthTransportClsid);PluginKeyName=$(SynthTransportPluginKeyName)"
                   Before="Action_RegisterSynthTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_RegisterSynthTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RegisterTransportComServer"
                    Return="check" />

      <SetProperty Id="Action_UnregisterSynthTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.MidiSynthTransport.dll;Clsid=$(SynthTransportClsid);PluginKeyName=$(SynthTransportPluginKeyName)"
                   Before="Action_UnregisterSynthTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_UnregisterSynthTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="UnregisterTransportComServerIfOwned"
                    Return="check" />

      <SetProperty Id="Action_RegisterBluetoothTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.BluetoothMidiTransport.dll;Clsid=$(BluetoothTransportClsid);PluginKeyName=$(BluetoothTransportPluginKeyName)"
                   Before="Action_RegisterBluetoothTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_RegisterBluetoothTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RegisterTransportComServer"
                    Return="check" />

      <SetProperty Id="Action_UnregisterBluetoothTransport"
                   Value="DllPath=[SERVICE_INSTALLFOLDER]Midi2.BluetoothMidiTransport.dll;Clsid=$(BluetoothTransportClsid);PluginKeyName=$(BluetoothTransportPluginKeyName)"
                   Before="Action_UnregisterBluetoothTransport"
                   Sequence="execute" />

      <CustomAction Id="Action_UnregisterBluetoothTransport"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="UnregisterTransportComServerIfOwned"
                    Return="check" />

      <InstallExecuteSequence>
        <Custom Action="Action_TakeRegistryOwnership"
                Before="CreateFolders"
                Condition='(NOT Installed) AND NOT (REMOVE="ALL")' />

        <!-- After InstallFiles so the DLL regsvr32 is pointed at is already on disk -->
        <Custom Action="Action_RegisterNetworkTransport"
                After="InstallFiles"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_RegisterRtpMidiTransport"
                After="Action_RegisterNetworkTransport"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_RegisterBasicLoopbackTransport"
                After="Action_RegisterRtpMidiTransport"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_RegisterSynthTransport"
                After="Action_RegisterBasicLoopbackTransport"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_RegisterBluetoothTransport"
                After="Action_RegisterSynthTransport"
                Condition='NOT (REMOVE="ALL")' />

        <!-- Before RemoveFiles so each DLL is still there to unregister itself -->
        <Custom Action="Action_UnregisterNetworkTransport"
                Before="RemoveFiles"
                Condition='(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE' />

        <Custom Action="Action_UnregisterRtpMidiTransport"
                Before="Action_UnregisterNetworkTransport"
                Condition='(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE' />

        <Custom Action="Action_UnregisterBasicLoopbackTransport"
                Before="Action_UnregisterRtpMidiTransport"
                Condition='(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE' />

        <Custom Action="Action_UnregisterSynthTransport"
                Before="Action_UnregisterBasicLoopbackTransport"
                Condition='(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE' />

        <Custom Action="Action_UnregisterBluetoothTransport"
                Before="Action_UnregisterSynthTransport"
                Condition='(REMOVE="ALL") AND NOT UPGRADINGPRODUCTCODE' />
      </InstallExecuteSequence>

    </Package>
</Wix>
