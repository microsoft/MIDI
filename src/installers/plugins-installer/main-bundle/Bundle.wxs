<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" 
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     >

    <?define DependenciesSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\dependencies ?>
    <?define StagingSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\staging ?>
    <?define StagingVersionIncludeFile=$(StagingSourceRootFolder)\version\BundleInfo.wxi ?>

    <?include $(StagingVersionIncludeFile) ?>

    
    <!-- TODO: Gate on Windows 10 22H2 or later -->

    <Bundle Name="Windows MIDI Services Transports (Preview)" 
            Manufacturer="Microsoft Corporation" 
            Version="$(SetupVersionNumber)" 
            UpgradeCode="50f166b9-62e7-4101-8030-6fb3c248f994">

        <!-- The separate transport installers this one replaces. The package removes what they
             installed before it installs anything; these take their entries out of Installed
             apps afterwards. They also stop one of those being installed over this one later,
             because each now sees this bundle as its own newer version. -->
        <RelatedBundle Id="92fb6982-e97d-476f-8d27-44500086a690" Action="upgrade" /> <!-- Network MIDI 2.0 and RTP-MIDI -->
        <RelatedBundle Id="42eba498-e57e-4f5b-b8e2-7ff9642aeb3e" Action="upgrade" /> <!-- Bluetooth MIDI -->
        <RelatedBundle Id="e0cb850d-c41e-4950-a1e9-e0c2fb94647b" Action="upgrade" /> <!-- Basic Loopback -->
        <RelatedBundle Id="ec24011f-d8a9-4c25-8c9b-4f7bda884749" Action="upgrade" /> <!-- General MIDI Synthesizer -->

        <WixVariable Id="WixUIDialogBmp" Value="midi_installer_logo.bmp" />

        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication LicenseUrl="" 
                                                    Theme="hyperlinkLicense" 
                                                    SuppressOptionsUI="true"
                                                    SuppressRepair="true"
                                                    ShowVersion="true"
                                                    LogoFile="midi_installer_logo_square.png"/>        
        </BootstrapperApplication>

        <Chain>
          <PackageGroupRef Id="Prerequisites" />
          <PackageGroupRef Id="MidiServicesPackages" />
        </Chain>
    </Bundle>

    
    <Fragment>
      <PackageGroup Id="Prerequisites">

        <!-- C++ Runtime. The x64 download contains both Arm64 and X64 versions -->
        <ExePackage
            Vital="false"
            DisplayName="Microsoft Visual C++ Runtime"
            SourceFile="$(DependenciesSourceRootFolder)\VC_redist.x64.exe"
            Compressed="yes"
            InstallArguments="/install /passive /norestart /log midi_vcruntime_install_log.txt"
            Permanent="true"
                >
        </ExePackage>

      </PackageGroup>

      <PackageGroup Id="MidiServicesPackages">
            <MsiPackage
                Id="WindowsMIDIServicesTransportsSetup"
                Vital="true"
                Permanent="no"
                Compressed="yes"
                SourceFile="WindowsMIDIServicesTransportsSetup.msi">
            </MsiPackage>

        </PackageGroup>
        
    </Fragment>
</Wix>
