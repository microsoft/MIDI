<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?define StagingSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\staging ?>
  <?define StagingVersionIncludeFile=$(StagingSourceRootFolder)\version\AppSdkVersion.wxi ?>
  <?include $(StagingVersionIncludeFile) ?>

  <Package
          Name="Windows MIDI Services Console Tools $(var.Platform)"
          Manufacturer="Microsoft Corporation"
          Version="$(MidiSdkAndToolsVersion)"
          UpgradeCode="01eda8fd-3bb5-4610-a4f0-160ebbcf8394"
          Scope="perMachine"
          Compressed="true"
          UpgradeStrategy="majorUpgrade"
          >

        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="ROOTINSTALLFOLDER" Name="Windows MIDI Services">
                <Directory Id="TOOLSROOT_INSTALLFOLDER" Name="Tools">
                    <!-- One folder per GUI tool, each with its own copy of the SDK runtime.
                         These names are a contract with ToolLauncher.cpp in midi-settings, which
                         resolves the other tools by convention path.
                         NetworkSetup and BluetoothSetup are not here: those apps ship in the
                         installer that carries their transport. -->
                    <Directory Id="TOOL_SETTINGS_FOLDER" Name="Settings" />
                    <Directory Id="TOOL_LOOPSETUP_FOLDER" Name="LoopSetup" />
                    <Directory Id="TOOL_SCRATCHPAD_FOLDER" Name="ScratchPad" />
                    <Directory Id="TOOL_KEYBOARD_FOLDER" Name="Keyboard" />
                    <Directory Id="TOOL_PLAYER_FOLDER" Name="Player" />
                    <Directory Id="TOOL_CLOCK_FOLDER" Name="Clock" />
                    <Directory Id="TOOL_SYSEX_FOLDER" Name="SysEx" />
                    <Directory Id="TOOL_MONITOR_FOLDER" Name="Monitor" />
                    <Directory Id="TOOL_TROUBLESHOOTER_FOLDER" Name="Troubleshooter" />
                    <Directory Id="TOOL_NOTIFICATIONS_FOLDER" Name="Notifications" />
                </Directory>
                <Directory Id="COLLECTMIDILOGS_INSTALLFOLDER" Name="Collect MIDI Logs">
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- Shared endpoint and transport artwork. Every MIDI app reads it, and the customer's
             own endpoint pictures are stored alongside it, so it lives under ProgramData. -->
        <StandardDirectory Id="CommonAppDataFolder">
          <Directory Name="Microsoft">
            <Directory Id="CONFIGURATION_FOLDER" Name="MIDI">
              <Directory Id="CONFIGURATION_ASSETS_FOLDER" Name="Assets">
                <Directory Id="CONFIGURATION_ASSETS_ENDPOINTS_FOLDER" Name="Endpoints" />
                <Directory Id="CONFIGURATION_ASSETS_TRANSPORTS_FOLDER" Name="Transports" />
              </Directory>
            </Directory>
          </Directory>
        </StandardDirectory>

        <!--
            The SDK runtime, the in-box console tools and the in-box GUI tools are all listed in
            the generated _SetupFiles.wxs (ComponentGroup SdkRedistFiles). Start Menu shortcuts for
            the GUI tools are in the generated _StartMenu.wxs (ComponentGroup ToolAppShortcuts).
            build\build-sdk.ps1 writes both from $ConsoleTools/$GuiTools, so adding a tool is a
            one-line change there plus a Directory entry above.
        -->

        <Component Id="WindowsMidiServicesToolsRegistration"
                   Permanent="no"
                   Bitness="always64"
                   Directory="TOOLSROOT_INSTALLFOLDER"
                   Guid="7061b206-9a9a-4ed4-aace-35beeba89971">

          <!-- Add folder to path -->
          <Environment Id="AddToolsToSystemPath"
                          Name="PATH" Action="set" Part="last" System="yes"
                          Value="[TOOLSROOT_INSTALLFOLDER]" Permanent="no"/>

          <RegistryKey Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows MIDI Services\Desktop App SDK Runtime">
            <RegistryValue Type="string" Name="MidiDiag" Value="[TOOLSROOT_INSTALLFOLDER]mididiag.exe" KeyPath="yes" />
          </RegistryKey>

        </Component>

    <Component Id="WindowsMidiServicesCollectMidiLogsRegistration"
               Permanent="no"
               Bitness="always64"
               Directory="COLLECTMIDILOGS_INSTALLFOLDER"
               Guid="f8bb863f-8763-45d3-acdf-23293a83a6e5">

        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows MIDI Services\Desktop App SDK Runtime">

          <RegistryValue Type="string" Name="CollectMidiLogs" Value="[COLLECTMIDILOGS_INSTALLFOLDER]CollectMidiLogs.ps1" KeyPath="yes" />

        </RegistryKey>
    </Component>

    <!--
        MIDI file associations for the player.

        !! THIS DELIBERATELY DOES NOT TAKE THE DEFAULT ASSOCIATION. !!
        Windows does not allow an installer to choose which application opens a file type; that is
        the customer's decision and only they can make it. So this registers a ProgId, adds it to
        each extension's OpenWithProgIds list, and publishes the app's capabilities so it appears
        in Settings under Default apps. The extension's own default value is never written. Do not
        "fix" this by writing it - the shell detects hijacking and the association would be reset
        anyway, after showing the customer a warning about our app.

        The file type and application names are indirect string references into the executable, so
        they are localized along with the rest of the app rather than frozen in English here.
    -->
    <Component Id="WindowsMidiServicesMidiFileAssociation"
               Permanent="no"
               Bitness="always64"
               Directory="TOOL_PLAYER_FOLDER"
               Guid="2c8b4f6a-1d93-4e55-8a70-5b31c9e0d742">

      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\WindowsMidiServices.MidiFile" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="MIDI File" />
        <RegistryValue Type="string" Name="FriendlyTypeName" Value="@[#midiplayerExe],-101" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="[#midiplayerExe],0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[#midiplayerExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>

      <!-- Adding to the list, not replacing the default. -->
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.mid\OpenWithProgIds"  Name="WindowsMidiServices.MidiFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.midi\OpenWithProgIds" Name="WindowsMidiServices.MidiFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.kar\OpenWithProgIds"  Name="WindowsMidiServices.MidiFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.rmi\OpenWithProgIds"  Name="WindowsMidiServices.MidiFile" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.smf\OpenWithProgIds"  Name="WindowsMidiServices.MidiFile" Type="string" Value="" />

      <!-- What puts the app in the Open With list, and gives it a name there. -->
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\Applications\midiplayer.exe" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Name="FriendlyAppName" Value="@[#midiplayerExe],-102" />
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[#midiplayerExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryKey Key="SupportedTypes">
          <RegistryValue Type="string" Name=".mid" Value="" />
          <RegistryValue Type="string" Name=".midi" Value="" />
          <RegistryValue Type="string" Name=".kar" Value="" />
          <RegistryValue Type="string" Name=".rmi" Value="" />
          <RegistryValue Type="string" Name=".smf" Value="" />
        </RegistryKey>
      </RegistryKey>

      <!-- Default apps in Settings reads this. -->
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows MIDI Services\Player\Capabilities" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Name="ApplicationName" Value="@[#midiplayerExe],-102" />
        <RegistryValue Type="string" Name="ApplicationDescription" Value="Plays MIDI files through Windows MIDI Services." />
        <RegistryKey Key="FileAssociations">
          <RegistryValue Type="string" Name=".mid" Value="WindowsMidiServices.MidiFile" />
          <RegistryValue Type="string" Name=".midi" Value="WindowsMidiServices.MidiFile" />
          <RegistryValue Type="string" Name=".kar" Value="WindowsMidiServices.MidiFile" />
          <RegistryValue Type="string" Name=".rmi" Value="WindowsMidiServices.MidiFile" />
          <RegistryValue Type="string" Name=".smf" Value="WindowsMidiServices.MidiFile" />
        </RegistryKey>
      </RegistryKey>

      <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications"
                     Name="Windows MIDI Player"
                     Type="string"
                     Value="SOFTWARE\Microsoft\Windows MIDI Services\Player\Capabilities" />

      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows MIDI Services\Desktop App SDK Runtime">
        <RegistryValue Type="string" Name="MidiFileAssociation" Value="registered" KeyPath="yes" />
      </RegistryKey>

    </Component>

    <Feature Id="WindowsMIDIServices">
            <ComponentGroupRef Id="SdkRedistFiles" />
            <ComponentGroupRef Id="ToolAppShortcuts" />
            <ComponentRef Id="WindowsMidiServicesToolsRegistration" />
            <ComponentRef Id="WindowsMidiServicesCollectMidiLogsRegistration"/>
            <ComponentRef Id="WindowsMidiServicesMidiFileAssociation"/>
    </Feature>

    <!-- Only for a PC which already had the notifications app starting at sign-in, so that an
         upgrade puts back what the customer had rather than leaving them without it until they
         next sign in. A clean install starts nothing: see the Run entry search in _StartMenu.wxs
         for why the installer never turns this on by itself.
         Impersonated because a tray icon belongs to the installing user's session, not to SYSTEM,
         and asyncNoWait because the app runs until signed out and would otherwise hang setup.
         Starting a second copy is harmless: the app is single instance and the later one exits. -->
    <CustomAction Id="Action_StartNotificationsApp"
                  FileRef="midinotificationsExe"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="Action_StartNotificationsApp"
              After="InstallFinalize"
              Condition="NOT Installed AND MIDINOTIFICATIONSAUTOSTARTPRESENT" />
    </InstallExecuteSequence>

    </Package>
</Wix>
