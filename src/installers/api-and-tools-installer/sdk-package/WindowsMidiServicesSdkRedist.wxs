<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?define StagingSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\staging ?>
  <?define StagingVersionIncludeFile=$(StagingSourceRootFolder)\version\AppSdkVersion.wxi ?>
  <?include $(StagingVersionIncludeFile) ?>

  <Package
          Name="Windows MIDI Services Console Tools $(var.Platform)"
          Manufacturer="Microsoft Corporation"
          Version="$(MidiSdkAndToolsVersion)"
          UpgradeCode="01eda8fd-3bb5-4610-a4f0-160ebbcf8394"
          Scope="perMachine"
          Compressed="true"
          UpgradeStrategy="majorUpgrade"
          >

        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="ROOTINSTALLFOLDER" Name="Windows MIDI Services">
                <Directory Id="TOOLSROOT_INSTALLFOLDER" Name="Tools">
                    <!-- One folder per GUI tool, each with its own copy of the SDK runtime.
                         These names are a contract with ToolLauncher.cpp in midi-settings, which
                         resolves the other tools by convention path.
                         NetworkSetup and BluetoothSetup are not here: those apps ship in the
                         installer that carries their transport. -->
                    <Directory Id="TOOL_SETTINGS_FOLDER" Name="Settings" />
                    <Directory Id="TOOL_LOOPSETUP_FOLDER" Name="LoopSetup" />
                    <Directory Id="TOOL_SCRATCHPAD_FOLDER" Name="ScratchPad" />
                    <Directory Id="TOOL_SYSEX_FOLDER" Name="SysEx" />
                    <Directory Id="TOOL_MONITOR_FOLDER" Name="Monitor" />
                    <Directory Id="TOOL_TROUBLESHOOTER_FOLDER" Name="Troubleshooter" />
                </Directory>
                <Directory Id="COLLECTMIDILOGS_INSTALLFOLDER" Name="Collect MIDI Logs">
                </Directory>
            </Directory>
        </StandardDirectory>

        <!-- Shared endpoint and transport artwork. Every MIDI app reads it, and the customer's
             own endpoint pictures are stored alongside it, so it lives under ProgramData. -->
        <StandardDirectory Id="CommonAppDataFolder">
          <Directory Name="Microsoft">
            <Directory Id="CONFIGURATION_FOLDER" Name="MIDI">
              <Directory Id="CONFIGURATION_ASSETS_FOLDER" Name="Assets">
                <Directory Id="CONFIGURATION_ASSETS_ENDPOINTS_FOLDER" Name="Endpoints" />
                <Directory Id="CONFIGURATION_ASSETS_TRANSPORTS_FOLDER" Name="Transports" />
              </Directory>
            </Directory>
          </Directory>
        </StandardDirectory>

        <!--
            The SDK runtime, the in-box console tools and the in-box GUI tools are all listed in
            the generated _SetupFiles.wxs (ComponentGroup SdkRedistFiles). Start Menu shortcuts for
            the GUI tools are in the generated _StartMenu.wxs (ComponentGroup ToolAppShortcuts).
            build\build-sdk.ps1 writes both from $ConsoleTools/$GuiTools, so adding a tool is a
            one-line change there plus a Directory entry above.
        -->

        <Component Id="WindowsMidiServicesToolsRegistration"
                   Permanent="no"
                   Bitness="always64"
                   Directory="TOOLSROOT_INSTALLFOLDER"
                   Guid="7061b206-9a9a-4ed4-aace-35beeba89971">

          <!-- Add folder to path -->
          <Environment Id="AddToolsToSystemPath"
                          Name="PATH" Action="set" Part="last" System="yes"
                          Value="[TOOLSROOT_INSTALLFOLDER]" Permanent="no"/>

          <RegistryKey Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows MIDI Services\Desktop App SDK Runtime">
            <RegistryValue Type="string" Name="MidiDiag" Value="[TOOLSROOT_INSTALLFOLDER]mididiag.exe" KeyPath="yes" />
          </RegistryKey>

        </Component>

    <Component Id="WindowsMidiServicesCollectMidiLogsRegistration"
               Permanent="no"
               Bitness="always64"
               Directory="COLLECTMIDILOGS_INSTALLFOLDER"
               Guid="f8bb863f-8763-45d3-acdf-23293a83a6e5">

        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows MIDI Services\Desktop App SDK Runtime">

          <RegistryValue Type="string" Name="CollectMidiLogs" Value="[COLLECTMIDILOGS_INSTALLFOLDER]CollectMidiLogs.ps1" KeyPath="yes" />

        </RegistryKey>
    </Component>

    <Feature Id="WindowsMIDIServices">
            <ComponentGroupRef Id="SdkRedistFiles" />
            <ComponentGroupRef Id="ToolAppShortcuts" />
            <ComponentRef Id="WindowsMidiServicesToolsRegistration" />
            <ComponentRef Id="WindowsMidiServicesCollectMidiLogsRegistration"/>
    </Feature>

    </Package>
</Wix>
