<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
      Lets a notification send the customer to Network MIDI Setup. Referenced from the
      WindowsMIDIServices feature in WindowsMidiServicesSdkRedist.wxs.

      One scheme per app, so a request naming this one cannot be answered by another. A protocol
      handler can be invoked by anything on the machine, a web page included, so the app treats a
      URI as a request to show a page and nothing more. See network_setup_protocol_defs.h.

      Same GUID as in the Network MIDI 2.0 installer that used to register it, so removing that
      installer cannot take this registration with it.
  -->
  <Fragment>
    <Component Id="NetworkSetupProtocol"
               Bitness="always64"
               Directory="TOOLSROOT_INSTALLFOLDER"
               Guid="2d9f6b48-7c31-4e05-a9d2-83b1e5f47c60">

      <RegistryKey Root="HKCR" Key="ms-midi-network-setup">
        <RegistryValue Type="string" Value="URL:Windows MIDI Services Network Setup" KeyPath="yes" />
        <RegistryValue Type="string" Name="URL Protocol" Value="" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="[#midinetworksetupExe],0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[#midinetworksetupExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>
  </Fragment>

</Wix>
