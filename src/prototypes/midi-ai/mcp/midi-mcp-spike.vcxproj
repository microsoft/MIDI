<?xml version="1.0" encoding="utf-8"?>
<!--
  PROTOTYPE. Not part of any solution, not in any installer. See ..\README.md.

  Builds on its own: the C++/WinRT projection is generated here from the Windows SDK and from the
  Windows MIDI Services SDK winmd that an ordinary in-box build already produced, so building this
  never rebuilds, or even evaluates, the SDK project.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{5B0C6E3A-2F7D-4C1B-9E84-6A3D1F0B7C29}</ProjectGuid>
    <RootNamespace>midimcpspike</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <InBoxDir>$(MSBuildThisFileDirectory)..\..\..\in-box\</InBoxDir>
    <UserToolsDir>$(InBoxDir)user-tools\</UserToolsDir>
    <OutDir>$(MSBuildThisFileDirectory)..\out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\out\intermediate\$(Platform)\$(Configuration)\</IntDir>
    <TargetName>midi-mcp-spike</TargetName>

    <CppWinRTExe>$(InBoxDir)packages\Microsoft.Windows.CppWinRT.3.0.260520.1\bin\cppwinrt.exe</CppWinRTExe>
    <WilIncludeDir>$(InBoxDir)packages\Microsoft.Windows.ImplementationLibrary.1.0.260126.7\include\</WilIncludeDir>

    <!-- A winmd is the same on every platform, so an ARM64 build may borrow the x64 one -->
    <Midi2Winmd>$(InBoxDir)vsfiles-sdk\out\Windows.Devices.Midi2\$(Platform)\Release\Windows.Devices.Midi2.winmd</Midi2Winmd>
    <Midi2Winmd Condition="!Exists('$(Midi2Winmd)')">$(InBoxDir)vsfiles-sdk\out\Windows.Devices.Midi2\x64\Release\Windows.Devices.Midi2.winmd</Midi2Winmd>

    <ProjectionDir>$(MSBuildThisFileDirectory)..\out\projection\</ProjectionDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(ProjectionDir);$(WilIncludeDir);$(UserToolsDir)midi-app-shared;$(UserToolsDir)midi-glass\document;$(UserToolsDir)midi-glass\editor;$(UserToolsDir)midi-patchbay;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>%(AdditionalOptions) /utf-8 /bigobj</AdditionalOptions>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>windowsapp.lib;shell32.lib;shlwapi.lib;ole32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- The spike itself. McpServer.* is the protocol; everything else is tools. -->
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="McpServer.h" />
    <ClInclude Include="ToolText.h" />
    <ClInclude Include="EndpointTools.h" />
    <ClInclude Include="PatchbayTools.h" />
    <ClInclude Include="GlassTools.h" />
    <ClCompile Include="main.cpp" />
    <ClCompile Include="McpServer.cpp" />
    <ClCompile Include="ToolText.cpp" />
    <ClCompile Include="EndpointTools.cpp" />
    <ClCompile Include="PatchbayTools.cpp" />
    <ClCompile Include="GlassTools.cpp" />
  </ItemGroup>

  <!-- Compiled unchanged from the tools, the same way their own unit tests compile them -->
  <ItemGroup>
    <ClCompile Include="$(UserToolsDir)midi-app-shared\ContentProvenance.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-app-shared\EndpointCatalog.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-app-shared\EndpointMatch.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-app-shared\LfoWave.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-app-shared\MidiEndpointHelpers.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-app-shared\MidiServiceStatus.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\HexText.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\JsonText.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\LayoutModel.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\LayoutSerializer.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\LayoutStore.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\LayoutTemplates.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\LfoShape.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\MackieControl.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\PadGrid.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\PageTemplates.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\StepPattern.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\ThemeModel.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\document\ThemeStore.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-glass\editor\ControlFactory.cpp" />
    <ClCompile Include="$(UserToolsDir)midi-patchbay\PatchFolderMove.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CheckSpikeInputs" BeforeTargets="GenerateSpikeProjection">
    <Error Condition="!Exists('$(CppWinRTExe)')" Text="C++/WinRT is not restored. Build any in-box tool once so $(CppWinRTExe) exists." />
    <Error Condition="!Exists('$(Midi2Winmd)')" Text="Windows.Devices.Midi2.winmd was not found. Build the SDK (Release x64) once first. Looked for $(Midi2Winmd)" />
  </Target>

  <!-- The whole Windows SDK plus the MIDI SDK, from the same C++/WinRT the tools compile with -->
  <Target Name="GenerateSpikeProjection" BeforeTargets="ClCompile"
          Inputs="$(Midi2Winmd);$(CppWinRTExe)" Outputs="$(ProjectionDir)winrt\Windows.Devices.Midi2.h">
    <Exec Command="&quot;$(CppWinRTExe)&quot; -input $(TargetPlatformVersion) -input &quot;$(Midi2Winmd)&quot; -output &quot;$(ProjectionDir.TrimEnd('\'))&quot;" />
  </Target>

  <!-- The MIDI SDK is activated from beside the exe, the same way every in-box tool carries its own copy.
       The DLL has to be this platform's build, unlike the winmd. -->
  <Target Name="CopyMidiSdkBesideSpike" AfterTargets="Build">
    <PropertyGroup>
      <Midi2Dir>$(InBoxDir)vsfiles-sdk\out\Windows.Devices.Midi2\$(Platform)\Release\</Midi2Dir>
    </PropertyGroup>
    <Warning Condition="!Exists('$(Midi2Dir)Windows.Devices.Midi2.dll')" Text="No $(Platform) build of Windows.Devices.Midi2.dll, so the spike cannot reach the MIDI SDK until one is built." />
    <Copy Condition="Exists('$(Midi2Dir)Windows.Devices.Midi2.dll')" SourceFiles="$(Midi2Dir)Windows.Devices.Midi2.dll;$(Midi2Dir)Windows.Devices.Midi2.pri" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
