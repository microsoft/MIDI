<?xml version="1.0" encoding="utf-8"?>
<!--
  PROTOTYPE. Windows.Devices.Midi2.Transports.Rtp: the app API for the rtpMIDI transport.
  Deliberately not part of Midi2.sln or Midi2-AppSDK.sln.

  References the Windows.Devices.Midi2 metadata from the in-box SDK build, so build that
  (Release, same platform) first.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <InBoxDir>$(MSBuildThisFileDirectory)..\..\..\in-box\</InBoxDir>
    <CppWinRTPackageDir>$(InBoxDir)packages\Microsoft.Windows.CppWinRT.3.0.260520.1\</CppWinRTPackageDir>
    <WilPackageDir>$(InBoxDir)packages\Microsoft.Windows.ImplementationLibrary.1.0.260126.7\</WilPackageDir>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <Import Project="$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.props')" />

  <PropertyGroup Label="Globals">
    <ProjectName>Windows.Devices.Midi2.Transports.Rtp</ProjectName>
    <RootNamespace>Windows.Devices.Midi2.Transports.Rtp</RootNamespace>
    <ProjectGuid>{B3D1F6A8-2C47-4E95-8A0B-6F3E9D2C5A17}</ProjectGuid>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <CppWinRTModernIDL>true</CppWinRTModernIDL>
    <MinimalCoreWin>true</MinimalCoreWin>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.26100.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <GenerateManifest>false</GenerateManifest>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <DesktopCompatible>true</DesktopCompatible>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\out\$(Platform)\$(Configuration)\sdk\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\out\intermediate\sdk\$(Platform)\$(Configuration)\</IntDir>
    <GeneratedFilesDir>$(IntDir)GeneratedFiles\</GeneratedFilesDir>
    <Midi2Winmd>$(InBoxDir)vsfiles-sdk\out\Windows.Devices.Midi2\$(Platform)\$(Configuration)\Windows.Devices.Midi2.winmd</Midi2Winmd>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
      <PreprocessorDefinitions>_WINRT_DLL;WIN32_LEAN_AND_MEAN;WINRT_LEAN_AND_MEAN;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(InBoxDir)Inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
      <ModuleDefinitionFile>Windows.Devices.Midi2.Transports.Rtp.def</ModuleDefinitionFile>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="MidiRtpAdvertisedPeer.h" />
    <ClInclude Include="MidiRtpClientConfig.h" />
    <ClInclude Include="MidiRtpConfiguredClient.h" />
    <ClInclude Include="MidiRtpConfiguredHost.h" />
    <ClInclude Include="MidiRtpConnection.h" />
    <ClInclude Include="MidiRtpEntryRemovalConfig.h" />
    <ClInclude Include="MidiRtpHostConfig.h" />
    <ClInclude Include="MidiRtpOperationResponse.h" />
    <ClInclude Include="MidiRtpTransportManager.h" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="RtpSdkDefs.h" />
    <ClInclude Include="RtpSdkJson.h" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="MidiRtpAdvertisedPeer.cpp" />
    <ClCompile Include="MidiRtpClientConfig.cpp" />
    <ClCompile Include="MidiRtpConfiguredClient.cpp" />
    <ClCompile Include="MidiRtpConfiguredHost.cpp" />
    <ClCompile Include="MidiRtpConnection.cpp" />
    <ClCompile Include="MidiRtpEntryRemovalConfig.cpp" />
    <ClCompile Include="MidiRtpHostConfig.cpp" />
    <ClCompile Include="MidiRtpOperationResponse.cpp" />
    <ClCompile Include="MidiRtpTransportManager.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>

  <ItemGroup>
    <Midl Include="Windows.Devices.Midi2.Transports.Rtp.idl" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="Windows.Devices.Midi2.Transports.Rtp.rc" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Windows.Devices.Midi2.Transports.Rtp.def" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(Midi2Winmd)">
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.targets" Condition="Exists('$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.targets')" />
    <Import Project="$(WilPackageDir)build\native\Microsoft.Windows.ImplementationLibrary.targets" Condition="Exists('$(WilPackageDir)build\native\Microsoft.Windows.ImplementationLibrary.targets')" />
  </ImportGroup>

  <Target Name="EnsureInBoxInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(CppWinRTPackageDir)build\native\Microsoft.Windows.CppWinRT.targets')" Text="C++/WinRT is missing from $(InBoxDir)packages. Restore Midi2-AppSDK.sln first." />
    <Error Condition="!Exists('$(Midi2Winmd)')" Text="$(Midi2Winmd) is missing. Build Windows.Devices.Midi2 $(Configuration)|$(Platform) first." />
  </Target>
</Project>
