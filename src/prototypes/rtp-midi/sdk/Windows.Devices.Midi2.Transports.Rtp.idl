// ============================================================================
// PROTOTYPE. Windows MIDI Services rtpMIDI transport API.
//
// rtpMIDI (RTP-MIDI with Apple's connection protocol) is what macOS, iOS and many network MIDI
// interfaces use. Each connection with a remote device gets its own MIDI endpoint.
//
// Shaped after Windows.Devices.Midi2.Transports.Network so one settings app can present both.
// ============================================================================

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contractversion(1)]
    apicontract MidiTransportsRtpApiContract {};

    // The transport's own error codes come first. The rest are raised in this library.
    [contract(MidiTransportsRtpApiContract, 1)]
    enum MidiRtpErrorCode
    {
        None = 0,
        InvalidJson = 1,
        UnrecognizedCommand = 2,
        MissingEntryIdentifier = 3,
        InvalidEntryIdentifier = 4,
        EntryNotFound = 5,
        InvalidEntry = 6,
        TransportNotReady = 7,
        MissingRemote = 8,
        NameTooLong = 9,
        InvalidPort = 10,
        MissingConnectionId = 11,
        InvalidName = 12,

        ServiceUnavailable = 1000,
        HostStartTimeout = 1001,
        InvalidArgument = 1002,
        ClientApiException = 1003,
    };

    [contract(MidiTransportsRtpApiContract, 1)]
    enum MidiRtpClientEntryState
    {
        // configured, and waiting to find or reach the remote
        Pending = 0,

        // connected
        Active = 1,

        // the last attempt did not work, and the service tries again
        Failed = 2,

        // disconnected from this PC, or not answering with automatic reconnect off.
        // Call ReconnectClientAsync to try again.
        Unavailable = 3,
    };

    // One connection with a remote device, from either side
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpConnection
    {
        // unique within its host or client entry, for DisconnectConnectionAsync
        [noexcept] UInt32 ConnectionId{ get; };

        // the name the remote gave. The endpoint is named after it.
        [noexcept] String RemoteName{ get; };

        // live socket address, so it changes between reconnects. Display only, never for matching
        [noexcept] String RemoteAddress{ get; };
        [noexcept] UInt16 RemotePort{ get; };
        [noexcept] UInt16 LocalPort{ get; };

        // false while the two sides are still connecting
        [noexcept] Boolean IsConnected{ get; };

        // true when this PC sent the invitation
        [noexcept] Boolean ThisPcInvited{ get; };

        [noexcept] String EndpointDeviceId{ get; };

        // Clock sync round trip in MIDI timestamp ticks: the average of the recent exchanges,
        // and the best of them. Zero until the first exchange completes.
        [noexcept] UInt64 CurrentLatencyTicks{ get; };
        [noexcept] UInt64 BestLatencyTicks{ get; };

        [noexcept] UInt64 TotalCountNetworkPacketsSent{ get; };
        [noexcept] UInt64 TotalCountNetworkPacketsReceived{ get; };

        // rtpMIDI never resends. A lost packet is repaired from the recovery journal the next
        // packet carries, and a note that cannot be repaired is ended so it does not hang.
        [noexcept] UInt64 TotalCountPacketsLost{ get; };
        [noexcept] UInt64 TotalCountLossesRepairedFromJournal{ get; };
        [noexcept] UInt64 TotalCountNoteOffsRecovered{ get; };

        [noexcept] UInt64 TotalCountMessagesSent{ get; };
        [noexcept] UInt64 TotalCountMessagesReceived{ get; };
    };

    // This PC, offered on the network for remote devices to connect to
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpConfiguredHost
    {
        [noexcept] Guid HostId{ get; };

        // what remote devices show in their lists
        [noexcept] String Name{ get; };

        [noexcept] String ServiceInstanceName{ get; };

        // The name actually on the network. The DNS client renames a name another device
        // already uses rather than refusing it.
        [noexcept] String ActualServiceInstanceName{ get; };
        [noexcept] Boolean ServiceInstanceNameWasChanged{ get; };

        [noexcept] Boolean IsEnabled{ get; };
        [noexcept] Boolean HasStarted{ get; };
        [noexcept] Boolean Advertise{ get; };

        // what the host was configured to use, or "auto"
        [noexcept] String ConfiguredPort{ get; };
        [noexcept] String ActualPort{ get; };

        [noexcept] Boolean AllowPortFallback{ get; };

        // true when the configured port was taken and the host started on another one
        [noexcept] Boolean UsedPortFallback{ get; };

        [noexcept] Boolean SendRecoveryJournal{ get; };

        // the HRESULT of the last attempt to start or advertise the host, or 0
        [noexcept] Int32 LastErrorCode{ get; };

        [noexcept] Windows.Foundation.Collections.IVectorView<MidiRtpConnection> Connections{ get; };
    };

    // A remote device this PC connects to
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpConfiguredClient
    {
        [noexcept] Guid ClientId{ get; };

        // what the remote shows for this PC
        [noexcept] String Name{ get; };

        [noexcept] MidiRtpClientEntryState EntryState{ get; };

        // configured by address rather than found by name
        [noexcept] Boolean IsDirectConnection{ get; };
        [noexcept] String RemoteServiceInstanceName{ get; };
        [noexcept] String ConfiguredDirectAddress{ get; };
        [noexcept] UInt16 ConfiguredDirectPort{ get; };

        [noexcept] String CustomEndpointName{ get; };
        [noexcept] Boolean AutoReconnect{ get; };
        [noexcept] Boolean IsEnabled{ get; };
        [noexcept] Boolean SendRecoveryJournal{ get; };

        // the HRESULT of the last attempt, or 0
        [noexcept] Int32 LastErrorCode{ get; };

        // null when not connected
        [noexcept] MidiRtpConnection Connection{ get; };
    };

    // An rtpMIDI device advertising itself on the local network
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpAdvertisedPeer
    {
        // what to put in MidiRtpClientConfig.RemoteServiceInstanceName to connect to it
        [noexcept] String ServiceInstanceName{ get; };

        [noexcept] String HostName{ get; };
        [noexcept] UInt16 Port{ get; };
        [noexcept] Windows.Foundation.Collections.IVectorView<String> IPv4Addresses{ get; };
        [noexcept] Windows.Foundation.Collections.IVectorView<String> IPv6Addresses{ get; };

        // A host on this PC shows up in its own results. A list of devices to connect to should
        // leave it out.
        [noexcept] Boolean IsThisPc{ get; };
    };

    // Send with MidiRtpTransportManager.CreateHostAsync, and save with
    // MidiServiceTransportPluginConfigManager.SaveUpdate to keep it after a restart
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpHostConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        // with a new HostId
        MidiRtpHostConfig();

        [noexcept] Guid HostId;

        // what remote devices show. At most 63 bytes in UTF-8.
        [noexcept] String Name;

        // the name advertised on the network, when it should differ from Name. No periods.
        [noexcept] String ServiceInstanceName;

        // When true the host tries 5004, the port other rtpMIDI software looks at first, and
        // takes a free one if that is taken
        [noexcept] Boolean UseAutomaticPort;

        // 1024 to 65534. rtpMIDI also uses the port after it.
        [noexcept] UInt16 Port;

        [noexcept] Boolean AllowPortFallback;
        [noexcept] Boolean Advertise;
        [noexcept] Boolean SendRecoveryJournal;
    };

    // Send with MidiRtpTransportManager.ConnectClientAsync, and save with
    // MidiServiceTransportPluginConfigManager.SaveUpdate to reconnect after a restart
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpClientConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        // with a new ClientId
        MidiRtpClientConfig();

        [noexcept] Guid ClientId;

        // what the remote shows for this PC. At most 63 bytes in UTF-8.
        [noexcept] String Name;

        // Set this to connect to an advertised device, from MidiRtpAdvertisedPeer...
        [noexcept] String RemoteServiceInstanceName;

        // ...or these to connect to one at a fixed address. The address may be a host name.
        [noexcept] String RemoteAddress;
        [noexcept] UInt16 RemotePort;

        // Used instead of the remote's name for the endpoint. Empty to use the remote's name.
        [noexcept] String CustomEndpointName;

        [noexcept] Boolean AutoReconnect;
        [noexcept] Boolean SendRecoveryJournal;
    };

    // Save with MidiServiceTransportPluginConfigManager.SaveUpdate to take an entry out of the
    // configuration file. RemoveHostAsync and RemoveClientAsync take it out of the running service.
    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpEntryRemovalConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        MidiRtpEntryRemovalConfig(Guid entryId, Boolean isHost);

        [noexcept] Guid EntryId{ get; };
        [noexcept] Boolean IsHost{ get; };
    };

    [contract(MidiTransportsRtpApiContract, 1)]
    runtimeclass MidiRtpOperationResponse
    {
        [noexcept] Boolean Success{ get; };
        [noexcept] MidiRtpErrorCode ErrorCode{ get; };
        [noexcept] String ErrorMessage{ get; };

        // the host or client the operation was about
        [noexcept] Guid EntryId{ get; };
    };

    [contract(MidiTransportsRtpApiContract, 1)]
    static runtimeclass MidiRtpTransportManager
    {
        // true when the rtpMIDI transport is installed in the service
        [noexcept] static Boolean IsTransportAvailable{ get; };
        [noexcept] static Guid TransportId{ get; };

        // "_apple-midi._udp", the DNS-SD service type rtpMIDI devices advertise
        [noexcept] static String DnsSdServiceType{ get; };
        [noexcept] static UInt16 DefaultHostPort{ get; };

        // Returns once the host has started, or with HostStartTimeout if it has not after a few
        // seconds. The host keeps trying in the service either way.
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> CreateHostAsync(MidiRtpHostConfig config);

        // Ends every connection on the host and forgets it
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> RemoveHostAsync(Guid hostId);

        // A stopped host keeps its entry but ends its connections and is not reachable
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> StartHostAsync(Guid hostId);
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> StopHostAsync(Guid hostId);

        // Returns once the service has the entry. Connecting happens in the background: watch
        // the entry's EntryState, or wait for its endpoint to appear.
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> ConnectClientAsync(MidiRtpClientConfig config);

        // Ends the client's connection and forgets it
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> RemoveClientAsync(Guid clientId);

        // Tries again now, rather than after the retry wait
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> ReconnectClientAsync(Guid clientId);

        // Ends one connection on a host or a client. A remote may connect to a host again. A
        // client ended this way stays disconnected until ReconnectClientAsync.
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiRtpOperationResponse> DisconnectConnectionAsync(Guid entryId, UInt32 connectionId);

        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiRtpConfiguredHost> GetConfiguredHosts();
        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiRtpConfiguredClient> GetConfiguredClients();

        // the rtpMIDI devices the service can see advertised on the local network right now
        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiRtpAdvertisedPeer> GetAdvertisedPeers();
    };
}
