STRINGTABLE
BEGIN
    IDS_PROJNAME                            "Midi2.RtpMidiTransport"

    IDS_PLUGIN_METADATA_VERSION             "0.1.0.0"
    IDS_PLUGIN_METADATA_NAME                "rtpMIDI Network MIDI Prototype"
    IDS_PLUGIN_METADATA_DESCRIPTION         "(Prototype) Network MIDI 1.0 connections with Macs, iPhones, iPads and other rtpMIDI devices"
    IDS_PLUGIN_METADATA_AUTHOR              "Microsoft"

    IDS_RTP_PARENT_DEVICE_NAME              "rtpMIDI Network MIDI Endpoints"
    IDS_RTP_ENDPOINT_DESCRIPTION_HOST       "rtpMIDI network connection. The other device connected to this PC."
    IDS_RTP_ENDPOINT_DESCRIPTION_CLIENT     "rtpMIDI network connection. This PC connected to the other device."

    IDS_RTP_ERROR_INVALID_JSON              "The rtpMIDI transport configuration is not valid JSON."
    IDS_RTP_ERROR_UNRECOGNIZED_COMMAND      "The rtpMIDI transport does not support this command."
    IDS_RTP_ERROR_MISSING_ENTRY_IDENTIFIER  "The command needs an entry identifier."
    IDS_RTP_ERROR_INVALID_ENTRY_IDENTIFIER  "The entry identifier is not a valid GUID."
    IDS_RTP_ERROR_ENTRY_NOT_FOUND           "There is no rtpMIDI host or client with this entry identifier."
    IDS_RTP_ERROR_INVALID_ENTRY             "One or more rtpMIDI entries could not be read and were skipped."
    IDS_RTP_ERROR_NOT_READY                 "The rtpMIDI transport has not finished starting. Try again in a moment."
    IDS_RTP_ERROR_MISSING_REMOTE            "A client needs either an advertised name or an address and port to connect to."
    IDS_RTP_ERROR_NAME_TOO_LONG             "A name can be at most 63 bytes long in UTF-8."
    IDS_RTP_ERROR_INVALID_PORT              "The port must be between 1024 and 65534."
    IDS_RTP_ERROR_MISSING_CONNECTION_ID     "The command needs a connection identifier."
    IDS_RTP_ERROR_INVALID_NAME              "A name needs at least one character, and a name advertised on the network cannot contain a period."
END

