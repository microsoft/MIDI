#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // Disconnecting and forgetting are separate steps. Passing this to DisconnectDeviceAsync
    // drops the connection now; passing it to MidiServiceTransportPluginConfigManager.SaveUpdate
    // also stops the device being reconnected when the service restarts.
    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothDeviceDisconnectConfig", UUID_IMidiBluetoothDeviceDisconnectConfig)]
    [constructor_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothDeviceDisconnectConfigFactory", UUID_IMidiBluetoothDeviceDisconnectConfigFactory)]
    runtimeclass MidiBluetoothDeviceDisconnectConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        MidiBluetoothDeviceDisconnectConfig(String bluetoothDeviceId);
        MidiBluetoothDeviceDisconnectConfig(String bluetoothDeviceId, Boolean removeFromConfiguration);

        [noexcept] String BluetoothDeviceId;

        // When false, saving keeps the device listed but stops it connecting on its own. When
        // true, saving removes the entry entirely.
        [noexcept] Boolean RemoveFromConfiguration;
    }
}
