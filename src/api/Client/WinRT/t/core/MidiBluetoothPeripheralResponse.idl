#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiBluetoothPeripheralErrorCodeEnum.idl";
import "MidiBluetoothPeripheralStatus.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothPeripheralResponse", UUID_IMidiBluetoothPeripheralResponse)]
    runtimeclass MidiBluetoothPeripheralResponse
    {
        [noexcept] Boolean Success{ get; };

        [noexcept] MidiBluetoothPeripheralErrorCode ErrorCode{ get; };
        [noexcept] String ErrorMessage{ get; };

        [noexcept] Int32 ErrorHResult{ get; };

        // The state after the operation, whether or not it succeeded
        [noexcept] MidiBluetoothPeripheralStatus Status{ get; };
    }
}
