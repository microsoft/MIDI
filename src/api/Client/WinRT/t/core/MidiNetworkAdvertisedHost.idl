#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkAdvertisedHost", UUID_IMidiNetworkAdvertisedHost)]
    runtimeclass MidiNetworkAdvertisedHost
    {
        // Kept in the form Windows.Devices.Enumeration used, because configuration files store
        // it as the client match id.
        [noexcept] String DeviceId { get; };
        [noexcept] String DeviceName{ get; };

        // from PTR and SRV records
        [noexcept] String FullName{ get; };
        [noexcept] String ServiceInstanceName{ get; };
        [noexcept] String ServiceType{ get; };
        [noexcept] String HostName{ get; };
        [noexcept] UInt16 Port{ get; };
        [noexcept] String Domain{ get; };

        // from TXT record
        [noexcept] String UmpEndpointName{ get; };
        [noexcept] String ProductInstanceId{ get; };

        // Everything the TXT record carried, so a device using a key this SDK predates is still
        // readable without an SDK update.
        [noexcept] Windows.Foundation.Collections.IMapView<String, String> TextAttributes{ get; };

        // from A and AAAA records
        [noexcept] IVectorView<String> IPAddresses{ get; };
        [noexcept] IVectorView<String> IPv4Addresses{ get; };
        [noexcept] IVectorView<String> IPv6Addresses{ get; };

        // When this host was last heard from, for a UI which shows how stale an entry is.
        [noexcept] Windows.Foundation.DateTime LastSeenTime{ get; };
    };
}

