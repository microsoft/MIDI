#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiBluetoothDeviceInformation.idl";

import "MidiBluetoothDeviceConnectConfig.idl";
import "MidiBluetoothDeviceConnectResponse.idl";

import "MidiBluetoothDeviceDisconnectConfig.idl";
import "MidiBluetoothDeviceDisconnectResponse.idl";

import "MidiBluetoothPeripheralConfig.idl";
import "MidiBluetoothPeripheralResponse.idl";
import "MidiBluetoothPeripheralStatus.idl";
import "MidiBluetoothRadioInformation.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // One manager covers both Bluetooth Low Energy MIDI 1.0 and 2.0. Which protocol a device
    // speaks is chosen by the transport, which prefers MIDI 2.0 whenever a device offers it.
    [static_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothTransportManagerStatics", UUID_IMidiBluetoothTransportManagerStatics)]
    static runtimeclass MidiBluetoothTransportManager
    {
        [noexcept] static Boolean IsTransportAvailable{ get; };

        [noexcept] static Guid TransportId{ get; };

        // Every Bluetooth MIDI device this PC has seen advertising, whether or not it is connected
        [noexcept] static IVectorView<MidiBluetoothDeviceInformation> GetAvailableDevices();

        // Null when no device with that address has been discovered
        [noexcept] static MidiBluetoothDeviceInformation GetDevice(String bluetoothDeviceId);

        // Connecting takes seconds: the radio has to find the device, open its GATT service, and
        // subscribe to a characteristic.
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiBluetoothDeviceConnectResponse> ConnectDeviceAsync(
            MidiBluetoothDeviceConnectConfig connectConfig);

        [noexcept] static Windows.Foundation.IAsyncOperation<MidiBluetoothDeviceDisconnectResponse> DisconnectDeviceAsync(
            MidiBluetoothDeviceDisconnectConfig disconnectConfig);

        // Publishes this PC so other devices can connect to it
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiBluetoothPeripheralResponse> StartPeripheralAsync(
            MidiBluetoothPeripheralConfig peripheralConfig);

        [noexcept] static Windows.Foundation.IAsyncOperation<MidiBluetoothPeripheralResponse> StopPeripheralAsync();

        [noexcept] static MidiBluetoothPeripheralStatus GetPeripheralStatus();

        // Null when the transport did not report it, which is what an older service looks like.
        // Otherwise this is how an application explains a machine with no usable Bluetooth.
        [noexcept] static MidiBluetoothRadioInformation GetRadioInformation();
    }
}
