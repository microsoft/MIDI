#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



namespace Windows.Devices.Midi2.Transports.Network
{
    // What actually changed about an advertised host, so a handler can ignore an update it does
    // not care about rather than re-reading everything.
    [contract(MidiTransportsNetworkApiContract, 1)]
    [flags]
    enum MidiNetworkAdvertisedHostChangedProperties
    {
        None =                  0x00000000,
        HostName =              0x00000001,
        Port =                  0x00000002,
        IPv4Addresses =         0x00000004,
        IPv6Addresses =         0x00000008,
        TextAttributes =        0x00000010,
    };
}
