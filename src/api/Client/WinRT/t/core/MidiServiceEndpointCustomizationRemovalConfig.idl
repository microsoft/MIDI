#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiServiceConfigEndpointMatchCriteria.idl";

namespace Windows.Devices.Midi2.ServiceConfig
{
    [contract(MidiServiceConfigApiContract, 1)]

    // Deletes a stored endpoint customization outright, rather than overwriting it with empty
    // values. Saving a customization merges into what is already there, so this is the only way
    // to take an entry back out of the configuration file.
    [interface_name("Windows.Devices.Midi2.ServiceConfig.IMidiServiceEndpointCustomizationRemovalConfig", UUID_IMidiServiceEndpointCustomizationRemovalConfig)]
    [constructor_name("Windows.Devices.Midi2.ServiceConfig.IMidiServiceEndpointCustomizationRemovalConfigFactory", UUID_IMidiServiceEndpointCustomizationRemovalConfigFactory)]
    runtimeclass MidiServiceEndpointCustomizationRemovalConfig : IMidiServiceTransportPluginConfig
    {
        MidiServiceEndpointCustomizationRemovalConfig(Guid transportId);
        MidiServiceEndpointCustomizationRemovalConfig(Guid transportId, MidiServiceConfigEndpointMatchCriteria matchCriteria);

        [noexcept] MidiServiceConfigEndpointMatchCriteria MatchCriteria;
    }
}
