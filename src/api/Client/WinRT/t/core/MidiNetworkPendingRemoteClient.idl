#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



import "IMidiServiceTransportPluginConfig.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkPendingRemoteClient")]
    runtimeclass MidiNetworkPendingRemoteClient : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        Guid HostId{ get; };

        String HostServiceInstanceName{ get; };
        String HostUmpEndpointName{ get; };

        String UmpEndpointName{ get; };
        String ProductInstanceId{ get;};
        String RemoteAddress{ get; };

        Windows.Foundation.DateTime RequestTime{ get; };

    }
}
