#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    enum MidiNetworkClientEntryState
    {
        // configured, and waiting for the service to connect it
        Pending = 0,

        // the service has created the client. Use IsSessionActive for whether MIDI is flowing
        Active = 1,

        // the configuration entry itself was rejected, so retrying cannot help
        Failed = 2,

        // A direct connection which stopped answering. Nothing advertises its return, so the
        // service will not retry it until an app calls ConnectNetworkClientAsync again.
        Unavailable = 3,
    };
}
