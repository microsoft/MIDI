#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

// error codes shared with the service
#include "..\..\..\..\Transport\BleMidi2Transport\bluetooth_transport_error_codes.h"

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    enum MidiBluetoothDeviceConnectErrorCode
    {
        Success =                       0,

        UnrecognizedCommand =           BLUETOOTH_MIDI_ERROR_CODE_UNRECOGNIZED_COMMAND,
        InvalidJson =                   BLUETOOTH_MIDI_ERROR_CODE_INVALID_JSON,

        MissingBluetoothDeviceId =      BLUETOOTH_MIDI_ERROR_CODE_MISSING_DEVICE_ID,
        InvalidBluetoothDeviceId =      BLUETOOTH_MIDI_ERROR_CODE_INVALID_DEVICE_ID,

        TransportNotAvailable =         BLUETOOTH_MIDI_ERROR_CODE_TRANSPORT_NOT_AVAILABLE,

        // never seen advertising, so there is nothing to connect to yet
        DeviceNotDiscovered =           BLUETOOTH_MIDI_ERROR_CODE_DEVICE_NOT_DISCOVERED,

        // discovered, but Windows could not open it
        DeviceNotAvailable =            BLUETOOTH_MIDI_ERROR_CODE_DEVICE_NOT_AVAILABLE,

        // it answered, but it has no Bluetooth MIDI service
        MidiServiceNotFound =           BLUETOOTH_MIDI_ERROR_CODE_MIDI_SERVICE_NOT_FOUND,

        // it has the MIDI service, but neither a MIDI 1.0 nor a UMP characteristic
        MidiCharacteristicNotFound =    BLUETOOTH_MIDI_ERROR_CODE_MIDI_CHARACTERISTIC_NOT_FOUND,

        // did not answer at all. Usually asleep, out of range, or connected to another host.
        DeviceUnreachable =             BLUETOOTH_MIDI_ERROR_CODE_DEVICE_UNREACHABLE,

        GattAccessDenied =              BLUETOOTH_MIDI_ERROR_CODE_GATT_ACCESS_DENIED,
        GattProtocolError =             BLUETOOTH_MIDI_ERROR_CODE_GATT_PROTOCOL_ERROR,

        // something else holds the device's MIDI service open, most often the older in-box
        // Windows Bluetooth MIDI 1.0 support, which claims paired devices exclusively
        DeviceInUse =                   BLUETOOTH_MIDI_ERROR_CODE_DEVICE_IN_USE,

        AlreadyConnected =              BLUETOOTH_MIDI_ERROR_CODE_ALREADY_CONNECTED,
        SessionCreationFailed =         BLUETOOTH_MIDI_ERROR_CODE_SESSION_CREATION_FAILED,
        OperationAborted =              BLUETOOTH_MIDI_ERROR_CODE_OPERATION_ABORTED,
        NotifyFailed =                  BLUETOOTH_MIDI_ERROR_CODE_NOTIFY_FAILED,
        EndpointCreationFailed =        BLUETOOTH_MIDI_ERROR_CODE_ENDPOINT_CREATION_FAILED,

        RadioNotAvailable =             BLUETOOTH_MIDI_ERROR_CODE_RADIO_NOT_AVAILABLE,

        Unexpected =                    0x11002011,
    };
}
