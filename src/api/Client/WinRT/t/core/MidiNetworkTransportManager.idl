#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



import "MidiNetworkHostCreationResponse.idl";
import "MidiNetworkHostCreationConfig.idl";
import "MidiNetworkHostRemovalResponse.idl";
import "MidiNetworkHostRemovalConfig.idl";
import "MidiNetworkHostUpdateResponse.idl";


import "MidiNetworkClientConnectResponse.idl";
import "MidiNetworkClientConnectConfig.idl";

import "MidiNetworkClientDisconnectResponse.idl";
import "MidiNetworkClientDisconnectConfig.idl";

import "MidiNetworkAdvertisedHost.idl";

import "MidiNetworkConfiguredHost.idl";
import "MidiNetworkConfiguredClient.idl";

import "MidiNetworkRemoteClientApprovalConfig.idl";
import "MidiNetworkRemoteClientApprovalResponse.idl";
import "MidiNetworkRemoteClientDisconnectConfig.idl";
import "MidiNetworkRemoteClientDisconnectResponse.idl";
import "MidiNetworkPendingRemoteClient.idl";
import "MidiNetworkTransportSettings.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [static_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkTransportManagerStatics", UUID_IMidiNetworkTransportManagerStatics)]
    static runtimeclass MidiNetworkTransportManager
    {
        [noexcept] static Boolean IsTransportAvailable{ get; };
        [noexcept] static Guid TransportId{ get; };


        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkHostCreationResponse> CreateNetworkHostAsync(
            MidiNetworkHostCreationConfig creationConfig);

        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkHostRemovalResponse> RemoveNetworkHostAsync(
            MidiNetworkHostRemovalConfig removalConfig);

        // keeps the host entry in memory, but closes all connections
        // stops advertising, and refuses any new connections
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkHostUpdateResponse> StopNetworkHostAsync(Guid hostId);
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkHostUpdateResponse> StartNetworkHostAsync(Guid hostId);


        // Sends new client info to the service
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkClientConnectResponse> ConnectNetworkClientAsync(
            MidiNetworkClientConnectConfig connectConfig);

        // Closes the connection and removes the entry in the service
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkClientDisconnectResponse> DisconnectNetworkClientAsync(
            MidiNetworkClientDisconnectConfig disconnectConfig);

        // Approves or denies a pending client connection request. 
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkRemoteClientApprovalResponse> ApproveOrDenyRemoteClientConnectRequestAsync(
            MidiNetworkRemoteClientApprovalConfig approvalConfig);

        // Ends one remote client's session with a host on this PC. Nothing is recorded, so the
        // remote may connect again. Denying it through ApproveOrDenyRemoteClientConnectRequestAsync
        // is what refuses it in future.
        [noexcept] static Windows.Foundation.IAsyncOperation<MidiNetworkRemoteClientDisconnectResponse> DisconnectRemoteClientAsync(
            MidiNetworkRemoteClientDisconnectConfig disconnectConfig);



        // returns info about what is configured inside the service
        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiNetworkConfiguredHost> GetConfiguredHosts();
        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiNetworkConfiguredClient> GetConfiguredClients();

        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiNetworkPendingRemoteClient> GetPendingRemoteClients();

        // The settings the transport is running with right now. These are not necessarily what
        // the configuration file says: a value out of range or of the wrong type is corrected
        // when it is read.
        [noexcept] static MidiNetworkTransportSettings GetTransportSettings();


        // list the external hosts currently visible to this PC
        [noexcept] static Windows.Foundation.Collections.IVectorView<MidiNetworkAdvertisedHost> GetAdvertisedHosts();


        [noexcept] static String MidiNetworkUdpDnsServiceType{ get; };
        [noexcept] static String MidiNetworkUdpDnsDomain { get; };

        // The full DNS-SD query name, "_midi2._udp.local", as passed to DnsServiceBrowse.
        [noexcept] static String MidiNetworkUdpDnsSdQueryName{ get; };

        // A free UDP port for a host to keep. Deliberately below the Windows dynamic range, so
        // the OS will not hand it to another process while the service is not running. Zero if
        // nothing suitable could be found.
        [noexcept] static UInt16 GenerateAvailableHostPort();

        // For validating a port a user typed in before trying to create the host with it.
        [noexcept] static Boolean IsHostPortAvailable(UInt16 port);

    }
}
