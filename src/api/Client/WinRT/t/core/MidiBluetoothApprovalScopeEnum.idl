#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // How long a decision about a remote Central applies for. Always is only accepted for a
    // device whose address does not rotate, which MidiBluetoothPeripheralClient.IsRememberable
    // reports.
    enum MidiBluetoothApprovalScope
    {
        // Applies to the connection which is waiting right now and nothing beyond it, so the
        // same device connecting again asks again.
        Once = 0,

        // Held in memory, so a service restart forgets it.
        UntilRestart = 1,

        // The service applies this immediately but does not write it down. It survives a restart
        // only if the caller also records it in the configuration file.
        Always = 2,
    };
}
