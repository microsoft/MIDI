#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Virtual
{
    [contract(MidiTransportsVirtualApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.Transports.Virtual.IMidiVirtualDeviceClientEndpointInUseChangedEventArgs", UUID_IMidiVirtualDeviceClientEndpointInUseChangedEventArgs)]
    runtimeclass MidiVirtualDeviceClientEndpointInUseChangedEventArgs
    {
        // True when one or more applications are connected to this device's client-visible
        // endpoint. This is a connected/not-connected signal, not a count.
        [noexcept] Boolean IsClientEndpointInUse{ get; };
    }
}
