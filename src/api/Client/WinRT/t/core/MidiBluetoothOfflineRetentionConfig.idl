#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiBluetoothOfflineRetentionEnum.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // Sets how long a MIDI endpoint outlives its device going offline, either for one device or
    // for the transport as a whole. Send it to apply it now, save it to keep it across a service
    // restart; both are usually wanted.
    //
    // A device entry is merged into the configuration file by its Bluetooth device id, so setting
    // one device leaves the others alone.
    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothOfflineRetentionConfig", UUID_IMidiBluetoothOfflineRetentionConfig)]
    [constructor_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothOfflineRetentionConfigFactory", UUID_IMidiBluetoothOfflineRetentionConfigFactory)]
    runtimeclass MidiBluetoothOfflineRetentionConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        // The transport-wide default, used by every device set to UseTransportDefault. This one
        // cannot itself be UseTransportDefault, because there is nothing above it to defer to.
        MidiBluetoothOfflineRetentionConfig(Int32 retentionSeconds);

        // A single device. Pass UseTransportDefault to drop the override.
        MidiBluetoothOfflineRetentionConfig(String bluetoothDeviceId, Int32 retentionSeconds);
    }
}
