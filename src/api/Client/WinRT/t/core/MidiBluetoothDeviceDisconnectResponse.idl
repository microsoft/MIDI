import "MidiApiContracts.idl";

import "MidiBluetoothDeviceDisconnectErrorCodeEnum.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothDeviceDisconnectResponse", UUID_IMidiBluetoothDeviceDisconnectResponse)]
