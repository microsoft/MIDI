import "MidiApiContracts.idl";


import "MidiNetworkRemoteClientApprovalErrorCodeEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkRemoteClientApprovalResponse", UUID_IMidiNetworkRemoteClientApprovalResponse)]
    runtimeclass MidiNetworkRemoteClientApprovalResponse
    {
[noexcept] Guid HostId{ get; };
        [noexcept] Guid ClientId{ get; };

        [noexcept] String RemoteClientName{ get; };
        [noexcept] String RemoteClientProductInstanceId{ get; };

        [noexcept] Boolean Success{ get; };
        [noexcept] MidiNetworkRemoteClientApprovalErrorCode ErrorCode{ get; };
        [noexcept] String ErrorMessage{ get; };

    };
}
