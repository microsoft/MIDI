#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";


import "MidiNetworkRemoteClientApprovalErrorCodeEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkRemoteClientApprovalResponse")]
    runtimeclass MidiNetworkRemoteClientApprovalResponse
    {
        Guid HostId{ get; };
        Guid ClientId{ get; };  

        String RemoteClientName{ get; };
        String RemoteClientProductInstanceId{ get; };

        Boolean Success{ get; };
        MidiNetworkRemoteClientApprovalErrorCode ErrorCode{ get; };
        String ErrorMessage{ get; };

    };
}
