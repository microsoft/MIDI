#include "..\..\shared\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



namespace Windows.Devices.Midi2.Transports.Network
{
    [experimental]
    [contract(MidiTransportsNetworkApiContract, 1)]
    runtimeclass MidiNetworkConfiguredClient
    {
        Guid ClientId{ get; };  // internal id we use to match up in config file
        Guid HostId{ get; }; // the id of the host this client is connected to

        //Boolean IsEnabled;                    // true if this is allows to connect. Mostly for pre-configured connections
        Boolean IsSessionActive{ get; };                // true if a session is active

        String ConnectedRemoteAddress{ get; };
        String ConnectedRemotePort{ get; };
        String ConnectedLocalAddress{ get; };
        String ConnectedLocalPort{ get; };              // need to see if I can get this in the service

        String EndpointDeviceId{ get; };                // the created MIDI endpoint's id

        UInt32 RetransmitCount{ get; };                 // number of times we've retransmitted messages to this client, for telemetry and debugging purposes
        UInt32 RetransmitRequestCount{ get; };          // number of times we've received a retransmit request from this client, for telemetry and debugging purposes
        UInt64 CurrentLatencyTicks{ get; };             // latency in ticks, for telemetry and debugging purposes
        UInt64 TotalCountNetworkPacketsSent{ get; };
        UInt64 TotalCountNetworkPacketsReceived{ get; };

    };
}

