  </data>
  <data name="CommandLineErrorMissingValue" xml:space="preserve">
    <value>The option {0} needs a value after it.</value>
  </data>
  <data name="CommandLineErrorInvalidGroup" xml:space="preserve">
    <value>The group must be a number from 1 to 16. Value supplied: {0}</value>
  </data>
  <data name="CommandLineErrorInvalidChannel" xml:space="preserve">
