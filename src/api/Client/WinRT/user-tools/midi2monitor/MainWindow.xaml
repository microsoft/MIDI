<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midi2monitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midi2monitor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="1"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xEC4F;"
                      FontSize="16"
                      Margin="16,0,10,0"
                      VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- ============================ Top: what to listen to ============================ -->
        <Border Grid.Row="1"
                Margin="12,4,12,8"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="EndpointImageBorder"
                        Width="96"
                        Height="64"
                        CornerRadius="6"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <Image x:Name="EndpointImage" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="10">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Uid="EndpointPickerLabel"
                                   Text="MIDI device to watch"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="EndpointComboBox"
                                  x:Uid="EndpointPicker"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnEndpointSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:EndpointChoice">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4" Width="230">
                        <TextBlock x:Uid="GroupPickerLabel"
                                   Text="Group"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="GroupComboBox"
                                  x:Uid="GroupPicker"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnGroupSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:NamedChoice">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4" Width="120">
                        <TextBlock x:Uid="ChannelPickerLabel"
                                   Text="Channel"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="ChannelComboBox"
                                  x:Uid="ChannelPicker"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnChannelSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="local:NamedChoice">
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom">
                        <Button x:Name="StartButton"
                                x:Uid="StartMonitoringButton"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnStartMonitoringClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Uid="StartMonitoringButtonText" Text="Start listening" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton"
                                x:Uid="StopMonitoringButton"
                                IsEnabled="False"
                                Click="OnStopMonitoringClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock x:Uid="StopMonitoringButtonText" Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Everything below the fold. Collapsed unless the customer goes looking. -->
                <Expander x:Name="OptionsExpander"
                          x:Uid="OptionsExpander"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          IsExpanded="False">
                    <Expander.Header>
                        <TextBlock x:Uid="OptionsExpanderHeader" Text="Filters and display options" />
                    </Expander.Header>

                    <StackPanel Spacing="14" Margin="0,6,0,2">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <ToggleSwitch x:Name="ShowClockToggle"
                                          x:Uid="ShowClockToggle"
                                          Header="Show Clock messages"
                                          Toggled="OnShowClockToggled" />
                            <ToggleSwitch x:Name="ShowActiveSenseToggle"
                                          x:Uid="ShowActiveSenseToggle"
                                          Header="Show Active Sense messages"
                                          Toggled="OnShowActiveSenseToggled" />
                            <ToggleSwitch x:Name="AlwaysOnTopToggle"
                                          x:Uid="AlwaysOnTopToggle"
                                          Header="Always on top"
                                          Toggled="OnAlwaysOnTopToggled" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Spacing="4" Width="260">
                                <TextBlock x:Uid="TimestampFormatLabel"
                                           Text="Show message time as"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="TimestampFormatComboBox"
                                          x:Uid="TimestampFormatPicker"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnTimestampFormatChanged">
                                    <ComboBoxItem x:Uid="TimestampFormatTicks" Content="Clock Ticks since PC startup" />
                                    <ComboBoxItem x:Uid="TimestampFormatMicroseconds" Content="Microseconds since start" />
                                    <ComboBoxItem x:Uid="TimestampFormatMilliseconds" Content="Milliseconds since start" />
                                    <ComboBoxItem x:Uid="TimestampFormatSeconds" Content="Seconds since start" />
                                </ComboBox>
                            </StackPanel>

                            <Button x:Name="ColumnsButton"
                                    x:Uid="ColumnsButton"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE71D;" FontSize="14" />
                                    <TextBlock x:Uid="ColumnsButtonText" Text="Columns" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="8" Width="290">
                                            <TextBlock x:Uid="ColumnsFlyoutHeader"
                                                       Text="Choose and order the columns"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ItemsControl x:Name="ColumnsItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:MonitorColumn">
                                                        <Grid ColumnSpacing="4" Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      Content="{x:Bind Header}"
                                                                      IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                                                      IsEnabled="{x:Bind CanHide}"
                                                                      Checked="OnColumnVisibilityChanged"
                                                                      Unchecked="OnColumnVisibilityChanged" />
                                                            <Button Grid.Column="1"
                                                                    x:Uid="MoveColumnUpButton"
                                                                    Padding="6"
                                                                    Tag="{x:Bind ColumnId}"
                                                                    Click="OnMoveColumnUpClick">
                                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70E;" FontSize="12" />
                                                            </Button>
                                                            <Button Grid.Column="2"
                                                                    x:Uid="MoveColumnDownButton"
                                                                    Padding="6"
                                                                    Tag="{x:Bind ColumnId}"
                                                                    Click="OnMoveColumnDownClick">
                                                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70D;" FontSize="12" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <CheckBox x:Name="AutoHideColumnsCheckBox"
                                                      x:Uid="AutoHideColumnsCheckBox"
                                                      Content="Hide extra columns when the window is narrow"
                                                      Checked="OnAutoHideColumnsChanged"
                                                      Unchecked="OnAutoHideColumnsChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button x:Name="ClearButton"
                                    x:Uid="ClearCaptureButton"
                                    VerticalAlignment="Bottom"
                                    Click="OnClearCaptureClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Uid="ClearCaptureButtonText" Text="Clear" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="SettingsButton"
                                    x:Uid="SettingsButton"
                                    VerticalAlignment="Bottom"
                                    Click="OnSettingsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock x:Uid="SettingsButtonText" Text="Settings" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Middle: the messages ============================== -->
        <Border Grid.Row="2"
                Margin="12,0,12,8"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="0,8,0,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <local:MessageRowPanel x:Name="HeaderRowPanel">
                        <Border />
                        <TextBlock x:Name="IndexHeaderText" x:Uid="ColumnHeaderIndex" Text="#" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="TimestampHeaderText" x:Uid="ColumnHeaderTimestamp" Text="Message Time" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="DataHeaderText" x:Uid="ColumnHeaderData" Text="Message" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="GroupHeaderText" x:Uid="ColumnHeaderGroup" Text="Group" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="ChannelHeaderText" x:Uid="ColumnHeaderChannel" Text="Channel" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="DecodedHeaderText" x:Uid="ColumnHeaderDecoded" Text="Details" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                        <TextBlock x:Name="DeltaHeaderText" x:Uid="ColumnHeaderDelta" Text="Since last" Style="{StaticResource MidiMonitorHeaderTextStyle}" />
                    </local:MessageRowPanel>
                </Border>

                <ListView x:Name="MessagesListView"
                          Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ShowsScrollingPlaceholders="False"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical"
                                             ItemsUpdatingScrollMode="KeepLastItemInView"
                                             CacheLength="1.0" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <!-- Entrance and reposition animations stagger when rows arrive in bursts,
                         which lets a later row land before an earlier one -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MidiMessageViewModel">
                            <Grid Background="{x:Bind RowBackground}" Padding="0,3,0,3">

                                <local:MessageRowPanel Visibility="{x:Bind MessageVisibility}">
                                    <Button Padding="0"
                                            Width="22"
                                            Height="22"
                                            Margin="2,0,2,0"
                                            VerticalAlignment="Top"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            x:Uid="AddCommentButton">
                                        <Grid>
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Glyph="&#xE90A;"
                                                      FontSize="12"
                                                      Opacity="0.35" />
                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Glyph="&#xE939;"
                                                      FontSize="12"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{x:Bind CommentGlyphVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="8" Width="320">
                                                    <TextBlock x:Uid="CommentFlyoutHeader"
                                                               Text="Add a note to this message"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <TextBox x:Uid="CommentTextBox"
                                                             AcceptsReturn="False"
                                                             PlaceholderText="Type a note"
                                                             Text="{x:Bind Comment, Mode=OneTime}"
                                                             TextChanged="OnCommentTextChanged" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <TextBlock Text="{x:Bind IndexText}" Style="{StaticResource MidiMonitorCellTextStyle}" />
                                    <TextBlock Style="{StaticResource MidiMonitorCellTextStyle}">
                                        <Run Text="{x:Bind TimestampText}" />
                                        <Run Text="{x:Bind TimestampUnit}" Foreground="{ThemeResource MidiTimeUnitBrush}" />
                                    </TextBlock>

                                    <StackPanel Spacing="2" Padding="6,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind Word0Text}" Style="{StaticResource MidiMonitorWordTextStyle}" Foreground="{ThemeResource MidiWord0Brush}" />
                                            <TextBlock Text="{x:Bind Word1Text}" Visibility="{x:Bind Word1Visibility}" Style="{StaticResource MidiMonitorWordTextStyle}" Foreground="{ThemeResource MidiWord1Brush}" />
                                            <TextBlock Text="{x:Bind Word2Text}" Visibility="{x:Bind Word2Visibility}" Style="{StaticResource MidiMonitorWordTextStyle}" Foreground="{ThemeResource MidiWord2Brush}" />
                                            <TextBlock Text="{x:Bind Word3Text}" Visibility="{x:Bind Word3Visibility}" Style="{StaticResource MidiMonitorWordTextStyle}" Foreground="{ThemeResource MidiWord3Brush}" />
                                        </StackPanel>
                                        <Border Background="{x:Bind MessageNameBackground}"
                                                Visibility="{x:Bind MessageNameVisibility}"
                                                CornerRadius="9"
                                                Padding="8,1,8,1"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind MessageName}"
                                                       FontSize="{StaticResource MidiMonitorChicletFontSize}"
                                                       Foreground="{x:Bind MessageNameForeground}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind GroupText}" Style="{StaticResource MidiMonitorCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ChannelText}" Style="{StaticResource MidiMonitorCellTextStyle}" />
                                    <TextBlock Style="{StaticResource MidiMonitorCellTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Detail0Label}" />
                                        <Run Text="{x:Bind Detail0Value}" Foreground="{ThemeResource MidiDetailValueBrush}" FontWeight="SemiBold" />
                                        <Run Text="{x:Bind Detail1Label}" />
                                        <Run Text="{x:Bind Detail1Value}" Foreground="{ThemeResource MidiDetailValueBrush}" FontWeight="SemiBold" />
                                        <Run Text="{x:Bind Detail2Label}" />
                                        <Run Text="{x:Bind Detail2Value}" Foreground="{ThemeResource MidiDetailValueBrush}" FontWeight="SemiBold" />
                                        <Run Text="{x:Bind Detail3Label}" />
                                        <Run Text="{x:Bind Detail3Value}" Foreground="{ThemeResource MidiDetailValueBrush}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MidiMonitorCellTextStyle}">
                                        <Run Text="{x:Bind DeltaText}" />
                                        <Run Text="{x:Bind DeltaUnit}" Foreground="{ThemeResource MidiTimeUnitBrush}" />
                                    </TextBlock>
                                </local:MessageRowPanel>

                                <Border Visibility="{x:Bind NoticeVisibility}"
                                        Margin="28,2,8,2"
                                        Padding="10,3,10,3"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind NoticeText}"
                                               FontSize="12"
                                               FontStyle="Italic"
                                               Foreground="{ThemeResource MidiNoticeBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            MaxWidth="420">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xEC4F;"
                              FontSize="36"
                              Opacity="0.4" />
                    <TextBlock x:Uid="EmptyStateTitle"
                               Text="Nothing to show yet"
                               HorizontalAlignment="Center"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="EmptyStateBody"
                               Text="Pick a device above and select Start listening. Play a note or move a control, and the messages will appear here."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================== Bottom: status =============================== -->
        <Grid Grid.Row="3" Margin="18,0,18,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock x:Name="TotalCountText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="RealTimeCountText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DroppedCountText"
                           Visibility="Collapsed"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="ExportButton"
                    x:Uid="ExportButton"
                    Click="OnExportClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDE1;" FontSize="14" />
                    <TextBlock x:Uid="ExportButtonText" Text="Save to a file" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
