<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midiloopbacksetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midiloopbacksetup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="EndpointIdTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint"
                Grid.Row="0"
                Grid.RowSpan="2"
                Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Loopback Setup"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ================================= Navigation ================================= -->
        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="240"
                        PaneDisplayMode="Left"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <!-- Basic first: it is the kind of loopback most customers already know. -->
                <NavigationViewItem x:Name="BasicLoopbacksNavigationItem"
                                    x:Uid="BasicLoopbacksNavigationItem"
                                    Content="MIDI 1.0 Basic Loopbacks"
                                    Tag="bloop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LoopbacksNavigationItem"
                                    x:Uid="LoopbacksNavigationItem"
                                    Content="MIDI 2.0 Loopbacks"
                                    Tag="loop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ===================== Page 2: MIDI 2.0 style loopback pairs ==================== -->
                <Grid x:Name="LoopbacksPanel" Margin="16,8,16,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Uid="LoopbacksHeader"
                                       Text="MIDI 2.0 Loopbacks"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="LoopbacksDescription"
                                       Text="A loopback is a pair of MIDI endpoints wired together. Anything an app sends to one side arrives on the other, so two apps on this PC can talk to each other."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <!-- Only offered while the well known default pair is missing, which
                                 is the one case where there is nothing to fill in. -->
                            <Button x:Name="CreateDefaultLoopbackButton"
                                    x:Uid="CreateDefaultLoopbackButton"
                                    Content="Create default loopback"
                                    Visibility="Collapsed"
                                    Click="OnCreateDefaultLoopbackClick" />

                            <Button x:Name="CreateLoopbackButton"
                                    x:Uid="CreateLoopbackButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnCreateLoopbackClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock x:Uid="CreateLoopbackButtonText" Text="New loopback" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- The diagram art carries no width or height of its own (the svg root is
                         100% x 100%), so both dimensions are set here. Keep them in the source's
                         1467 x 230 ratio when changing the width. -->
                    <Image x:Name="LoopbackDiagram"
                           x:Uid="LoopbackDiagram"
                           Grid.Row="1"
                           Width="500"
                           Height="78"
                           Margin="0,4,0,12"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <!-- Shown instead of the list when the transport is missing from this PC.
                         The message says which of the two reasons applies, so it is set from
                         code rather than declared here. -->
                    <InfoBar x:Name="LoopbackUnavailableBar"
                             x:Uid="LoopbackUnavailableBar"
                             Grid.Row="2"
                             Margin="0,0,0,8"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="False" />

                    <ListView x:Name="LoopbacksListView"
                              x:Uid="LoopbacksListView"
                              Grid.Row="3"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              CanDragItems="True"
                              CanReorderItems="True"
                              ReorderMode="Enabled"
                              KeyboardAcceleratorPlacementMode="Hidden"
                              DragItemsStarting="OnLoopbacksDragStarting"
                              DragItemsCompleted="OnLoopbacksReordered"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <!-- the list's own Ctrl+Shift+Arrow reorder does nothing with
                             SelectionMode="None", so dragging would otherwise be the only way -->
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="Up" Invoked="OnMoveLoopbackUp" />
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="Down" Invoked="OnMoveLoopbackDown" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LoopbackItem">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;"
                                                      FontSize="20"
                                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />

                                            <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                                   Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <!-- Drawn straight over the icon the mute glyph was
                                                 unreadable, so it sits smaller on a solid disc in
                                                 the corner. The 28px box gives it room without
                                                 negative margins. -->
                                            <Grid HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom"
                                                  Visibility="{x:Bind MutedBadgeVisibility, Mode=OneWay}">
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <!-- the critical fill is light in dark theme and
                                                     dark in light theme, so the glyph takes the
                                                      page background color to stay legible -->
                                                <FontIcon Glyph="&#xE74F;"
                                                          FontSize="10"
                                                          Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="{x:Bind PersistenceText, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind NameA, Mode=OneWay}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind DescriptionA, Mode=OneWay}"
                                                           Visibility="{x:Bind DescriptionAVisibility, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind EndpointDeviceIdA, Mode=OneWay}"
                                                           Style="{StaticResource EndpointIdTextStyle}" />
                                            </StackPanel>

                                            <StackPanel Spacing="2" Visibility="{x:Bind SecondEndpointVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind NameB, Mode=OneWay}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind DescriptionB, Mode=OneWay}"
                                                           Visibility="{x:Bind DescriptionBVisibility, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind EndpointDeviceIdB, Mode=OneWay}"
                                                           Style="{StaticResource EndpointIdTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Visibility="{x:Bind MuteVisibility, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanMute, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind MuteButtonAccessibleName, Mode=OneWay}"
                                                    Click="OnToggleMuteClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind MuteButtonGlyph, Mode=OneWay}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind MuteButtonLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Uid="DeleteLoopbackButton"
                                                    Content="Delete"
                                                    AutomationProperties.Name="{x:Bind DeleteButtonAccessibleName, Mode=OneWay}"
                                                    Click="OnDeleteLoopbackClick" />
                                            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                          Width="20"
                                                          Height="20" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoLoopbacksText"
                               x:Uid="NoLoopbacksText"
                               Grid.Row="3"
                               Text="There are no loopbacks on this PC yet. Create one so two apps can send MIDI to each other."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="460"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="LoopbackStatusText"
                               Grid.Row="4"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ======================== Page 1: basic MIDI 1.0 loopbacks ====================== -->
                <Grid x:Name="BasicLoopbacksPanel" Margin="16,8,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Uid="BasicLoopbacksHeader"
                                       Text="MIDI 1.0 Basic Loopbacks"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="BasicLoopbacksDescription"
                                       Text="A basic loopback is a single MIDI 1.0 endpoint which sends back everything it receives. Use one when an app expects a single port with matching input and output, the way older loopback drivers work."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="CreateDefaultBasicLoopbackButton"
                                    x:Uid="CreateDefaultBasicLoopbackButton"
                                    Content="Create default basic loopback"
                                    Visibility="Collapsed"
                                    Click="OnCreateDefaultBasicLoopbackClick" />

                            <Button x:Name="CreateBasicLoopbackButton"
                                    x:Uid="CreateBasicLoopbackButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnCreateBasicLoopbackClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock x:Uid="CreateBasicLoopbackButtonText" Text="New basic loopback" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- source art is 1211 x 230; keep that ratio when changing the width -->
                    <Image x:Name="BasicLoopbackDiagram"
                           x:Uid="BasicLoopbackDiagram"
                           Grid.Row="1"
                           Width="500"
                           Height="95"
                           Margin="0,4,0,12"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" />

                    <InfoBar x:Name="BasicLoopbackUnavailableBar"
                             x:Uid="BasicLoopbackUnavailableBar"
                             Grid.Row="2"
                             Margin="0,0,0,8"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="False" />

                    <ListView x:Name="BasicLoopbacksListView"
                              x:Uid="BasicLoopbacksListView"
                              Grid.Row="3"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              CanDragItems="True"
                              CanReorderItems="True"
                              ReorderMode="Enabled"
                              KeyboardAcceleratorPlacementMode="Hidden"
                              DragItemsStarting="OnBasicLoopbacksDragStarting"
                              DragItemsCompleted="OnBasicLoopbacksReordered"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="Up" Invoked="OnMoveBasicLoopbackUp" />
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="Down" Invoked="OnMoveBasicLoopbackDown" />
                        </ListView.KeyboardAccelerators>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LoopbackItem">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE72C;"
                                                      FontSize="20"
                                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />

                                            <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                                   Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                            <Grid HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom"
                                                  Visibility="{x:Bind MutedBadgeVisibility, Mode=OneWay}">
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <FontIcon Glyph="&#xE74F;"
                                                          FontSize="10"
                                                          Foreground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="{x:Bind DescriptionA, Mode=OneWay}"
                                                       Visibility="{x:Bind DescriptionAVisibility, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <TextBlock Text="{x:Bind PersistenceText, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <TextBlock Text="{x:Bind EndpointDeviceIdA, Mode=OneWay}"
                                                       Style="{StaticResource EndpointIdTextStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button Visibility="{x:Bind MuteVisibility, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanMute, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind MuteButtonAccessibleName, Mode=OneWay}"
                                                    Click="OnToggleBasicMuteClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind MuteButtonGlyph, Mode=OneWay}" FontSize="14" />
                                                    <TextBlock Text="{x:Bind MuteButtonLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Uid="DeleteBasicLoopbackButton"
                                                    Content="Delete"
                                                    AutomationProperties.Name="{x:Bind DeleteButtonAccessibleName, Mode=OneWay}"
                                                    Click="OnDeleteBasicLoopbackClick" />
                                            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                          Width="20"
                                                          Height="20" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoBasicLoopbacksText"
                               x:Uid="NoBasicLoopbacksText"
                               Grid.Row="3"
                               Text="There are no basic loopbacks on this PC yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="460"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="BasicLoopbackStatusText"
                               Grid.Row="4"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Declared here rather than built in code so the fields stay localizable through the
             normal x:Uid pipeline. A ContentDialog draws nothing until it is shown. -->
        <ContentDialog x:Name="CreateLoopbackDialog"
                       x:Uid="CreateLoopbackDialog"
                       Title="New loopback"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <StackPanel Spacing="12" Width="440" Margin="0,4,4,4">
                    <StackPanel Spacing="4">
                        <TextBox x:Name="LoopbackNameTextBox"
                                 x:Uid="LoopbackNameTextBox"
                                 Header="Name"
                                 TextChanged="OnCreateLoopbackFieldChanged" />
                        <TextBlock x:Uid="LoopbackNameHelp"
                                   Text="The two endpoints are named after this, with (A) and (B) on the end."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBox x:Name="LoopbackDescriptionTextBox"
                             x:Uid="LoopbackDescriptionTextBox"
                             Header="Description"
                             TextChanged="OnCreateLoopbackFieldChanged" />

                    <!-- Hidden unless the transport says it honors a picture, so the customer is
                         never offered one that would silently never appear. -->
                    <StackPanel x:Name="LoopbackImagePanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Uid="LoopbackImageHeader"
                                   Text="Picture"
                                   Style="{ThemeResource BodyTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Image x:Name="LoopbackImagePreview"
                                       x:Uid="LoopbackImagePreview"
                                       Margin="4"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="LoopbackChooseImageButton"
                                            x:Uid="LoopbackChooseImageButton"
                                            Content="Choose picture..."
                                            Click="OnChooseLoopbackImageClick" />
                                    <Button x:Name="LoopbackClearImageButton"
                                            x:Uid="LoopbackClearImageButton"
                                            Content="Clear"
                                            IsEnabled="False"
                                            Click="OnClearLoopbackImageClick" />
                                </StackPanel>
                                <TextBlock x:Name="LoopbackImageNameText"
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="LoopbackPersistCheckBox"
                              x:Uid="LoopbackPersistCheckBox"
                              Content="Keep this loopback after a restart"
                              IsChecked="True" />

                    <Expander x:Uid="LoopbackAdvancedExpander"
                              Header="Advanced"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,4,0,4">
                            <StackPanel Spacing="4">
                                <TextBox x:Name="LoopbackUniqueIdTextBox"
                                         x:Uid="LoopbackUniqueIdTextBox"
                                         Header="Unique identifier"
                                         TextChanged="OnCreateLoopbackFieldChanged" />
                                <TextBlock x:Uid="LoopbackUniqueIdHelp"
                                           Text="Keeps the endpoints recognizable to apps across restarts. Letters and digits only."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock x:Uid="LoopbackSeparateNamesHelp"
                                       Text="Leave these empty to use the name above. Fill in both to name each side yourself."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBox x:Name="LoopbackNameATextBox"
                                     x:Uid="LoopbackNameATextBox"
                                     Header="Name of the A side"
                                     TextChanged="OnCreateLoopbackFieldChanged" />

                            <TextBox x:Name="LoopbackDescriptionATextBox"
                                     x:Uid="LoopbackDescriptionATextBox"
                                     Header="Description of the A side" />

                            <TextBox x:Name="LoopbackNameBTextBox"
                                     x:Uid="LoopbackNameBTextBox"
                                     Header="Name of the B side"
                                     TextChanged="OnCreateLoopbackFieldChanged" />

                            <TextBox x:Name="LoopbackDescriptionBTextBox"
                                     x:Uid="LoopbackDescriptionBTextBox"
                                     Header="Description of the B side" />
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="CreateLoopbackStatusText"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="CreateBasicLoopbackDialog"
                       x:Uid="CreateBasicLoopbackDialog"
                       Title="New basic loopback"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <StackPanel Spacing="12" Width="440" Margin="0,4,4,4">
                    <TextBox x:Name="BasicLoopbackNameTextBox"
                             x:Uid="BasicLoopbackNameTextBox"
                             Header="Name"
                             TextChanged="OnCreateBasicLoopbackFieldChanged" />

                    <TextBox x:Name="BasicLoopbackDescriptionTextBox"
                             x:Uid="BasicLoopbackDescriptionTextBox"
                             Header="Description"
                             TextChanged="OnCreateBasicLoopbackFieldChanged" />

                    <StackPanel x:Name="BasicLoopbackImagePanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Uid="BasicLoopbackImageHeader"
                                   Text="Picture"
                                   Style="{ThemeResource BodyTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Image x:Name="BasicLoopbackImagePreview"
                                       x:Uid="BasicLoopbackImagePreview"
                                       Margin="4"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BasicLoopbackChooseImageButton"
                                            x:Uid="BasicLoopbackChooseImageButton"
                                            Content="Choose picture..."
                                            Click="OnChooseBasicLoopbackImageClick" />
                                    <Button x:Name="BasicLoopbackClearImageButton"
                                            x:Uid="BasicLoopbackClearImageButton"
                                            Content="Clear"
                                            IsEnabled="False"
                                            Click="OnClearBasicLoopbackImageClick" />
                                </StackPanel>
                                <TextBlock x:Name="BasicLoopbackImageNameText"
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="BasicLoopbackPersistCheckBox"
                              x:Uid="BasicLoopbackPersistCheckBox"
                              Content="Keep this loopback after a restart"
                              IsChecked="True" />

                    <Expander x:Uid="BasicLoopbackAdvancedExpander"
                              Header="Advanced"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="4" Margin="0,4,0,4">
                            <TextBox x:Name="BasicLoopbackUniqueIdTextBox"
                                     x:Uid="BasicLoopbackUniqueIdTextBox"
                                     Header="Unique identifier"
                                     TextChanged="OnCreateBasicLoopbackFieldChanged" />
                            <TextBlock x:Uid="BasicLoopbackUniqueIdHelp"
                                       Text="Keeps the endpoint recognizable to apps across restarts. Letters and digits only."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="CreateBasicLoopbackStatusText"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="ConfirmDialog"
                       x:Uid="ConfirmDialog"
                       PrimaryButtonText="Yes"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap" MaxWidth="420" />
        </ContentDialog>
    </Grid>
</Window>
