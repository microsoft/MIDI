# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.c text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.def text eol=crlf
*.vcxproj.user text eol=crlf
packages.config text eol=crlf
*.idl text eol=crlf
*.rgs text eol=crlf
*.json text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.wprp text eol=crlf
*.psm1 text eol=crlf

# Resource scripts are stored as UTF-16LE. Line ending conversion rewrites the
# 0x0A low byte of a UTF-16 LF into a raw CRLF, which misaligns the rest of the
# file and silently corrupts it on checkout. These must NOT be treated as text.
# The UTF-16LE diff driver keeps them producing readable diffs.
*.rc -text diff=UTF-16LE
*.rc2 -text diff=UTF-16LE

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.zip binary
*.ico binary
*.aps binary

