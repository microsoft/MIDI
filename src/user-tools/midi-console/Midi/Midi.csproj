<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject></StartupObject>
    <AssemblyName>midi</AssemblyName>
    <RootNamespace>Microsoft.Midi.ConsoleApp</RootNamespace>
    <!--<PlatformTargets>x64, ARM64</PlatformTargets>-->
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

      <!-- MSIX requires a loose-file layout, so single-file/trimming/AOT stay off.
           SelfContained is set by the publish profiles so normal builds and F5 stay framework-dependent. -->
      <PublishSingleFile>false</PublishSingleFile>
      <PublishTrimmed>false</PublishTrimmed>
      <PublishAot>false</PublishAot>
      <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
      <!-- Without this, the build script gets "NETSDK1083: The specified RuntimeIdentifier 'win10-x64' is not recognized" -->
      <!-- <UseRidGraph>true</UseRidGraph> -->

      <!-- Needed for System.Management for viewing service details -->
      <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
      
      <!-- Keep in sync with the MSIX package version. MSIX requires a 4-part version with revision 0. -->
      <MidiConsolePackageVersion>1.0.0.0</MidiConsolePackageVersion>
      <Version>1.0.0</Version>
      <AssemblyVersion>1.0.0.0</AssemblyVersion>
      <FileVersion>1.0.0.0</FileVersion>

        <!-- needed to copy the required winrt implmentation dlls to bin folder -->
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

      <RollForward>LatestMinor</RollForward>

      <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>

      <NoWin32Manifest>true</NoWin32Manifest>

      <GenerateNeutralResourcesLanguageAttribute>true</GenerateNeutralResourcesLanguageAttribute>
      <Description>Windows MIDI Services Console</Description>
      <Authors>Pete Brown</Authors>
      <Company>Microsoft Corporation</Company>
    
  </PropertyGroup>

  <PropertyGroup>
    <CsWinRTIncludes>
      Windows.Devices.Midi2
      Windows.Devices.Midi2.CapabilityInquiry
      Windows.Devices.Midi2.ClientPlugins
      Windows.Devices.Midi2.Diagnostics
      Windows.Devices.Midi2.Enumeration
      Windows.Devices.Midi2.Enumeration.Legacy
      Windows.Devices.Midi2.Reporting
      Windows.Devices.Midi2.ServiceConfig
      Windows.Devices.Midi2.Transports
      Windows.Devices.Midi2.Transports.BasicLoopback
      Windows.Devices.Midi2.Transports.Loopback
      Windows.Devices.Midi2.Transports.Network
      Windows.Devices.Midi2.Transports.Virtual
      Windows.Devices.Midi2.Utilities.Messages
      Windows.Devices.Midi2.Utilities.SysEx
    </CsWinRTIncludes>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8625;CS8618;CS8305</NoWarn>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- For versioning info: https://learn.microsoft.com/en-us/nuget/concepts/dependency-resolution#floating-versions -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.53.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.0" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\api\Client\WinRT\NuGet\Windows.Devices.Midi2.NuGet\Windows.Devices.Midi2.NuGet.csproj">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>True</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\shared\Microsoft.Devices.Midi2.Tools.Shared\Microsoft.Devices.Midi2.Tools.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>



</Project>
