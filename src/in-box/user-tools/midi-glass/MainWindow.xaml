<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midiglass.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midiglass"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.Resources>

            <!-- Every brush here comes from the theme, so the customer's choice of light, dark or
                 system, and their backdrop and window color, decide what the library looks like.
                 Only the layout, the proportions and the type scale are ours. -->

            <!-- A pill is drawn as a shape rather than a Border, because a Border rounds its
                 corner radius to whole pixels along with its bounds and the arc ends up stepped.
                 A Rectangle goes through the shape rasterizer and stays smooth at any scale. -->
            <Style x:Key="ChipShapeStyle" TargetType="Rectangle">
                <Setter Property="RadiusX" Value="11" />
                <Setter Property="RadiusY" Value="11" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="UseLayoutRounding" Value="False" />
            </Style>

            <Style x:Key="ChipPanelStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="9,0,9,0" />
            </Style>

            <Style x:Key="ChipTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ChipGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubtleToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>

            <!-- The status strip under each card: which one is visible carries the meaning, so
                 the color is never the only thing saying it. -->
            <DataTemplate x:Key="CardStatusTemplate" x:DataType="local:LayoutCard">
                <Grid AutomationProperties.Name="{x:Bind StatusText}" VerticalAlignment="Center">
                    <Grid Visibility="{x:Bind ReadyVisibility}">
                        <Rectangle Style="{StaticResource ChipShapeStyle}"
                                   Fill="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                   Stroke="{ThemeResource SystemFillColorSuccessBrush}" />
                        <StackPanel Style="{StaticResource ChipPanelStyle}">
                            <FontIcon Glyph="&#xE73E;"
                                      Style="{StaticResource ChipGlyphStyle}"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Bind StatusText}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{x:Bind WarningVisibility}">
                        <Rectangle Style="{StaticResource ChipShapeStyle}"
                                   Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                   Stroke="{ThemeResource SystemFillColorCautionBrush}" />
                        <StackPanel Style="{StaticResource ChipPanelStyle}">
                            <FontIcon Glyph="&#xE7BA;"
                                      Style="{StaticResource ChipGlyphStyle}"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{x:Bind StatusText}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{x:Bind InfoVisibility}">
                        <Rectangle Style="{StaticResource ChipShapeStyle}"
                                   Fill="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                   Stroke="{ThemeResource SystemFillColorAttentionBrush}" />
                        <StackPanel Style="{StaticResource ChipPanelStyle}">
                            <FontIcon Glyph="&#xE946;"
                                      Style="{StaticResource ChipGlyphStyle}"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                            <TextBlock Text="{x:Bind StatusText}"
                                       Style="{StaticResource ChipTextStyle}"
                                       Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- The menu behind the card's More button, its right tap and the context menu key. -->
            <MenuFlyout x:Key="CardMenuFlyout" Opening="OnCardMenuOpening">
                <MenuFlyoutItem x:Uid="CardMenuRun" Text="Run" Click="OnCardMenuRun">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuEdit" Text="Edit" Click="OnCardMenuEdit">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CardMenuDuplicate" Text="Duplicate" Click="OnCardMenuDuplicate">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuRename" Text="Rename…" Click="OnCardMenuRename">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuDescribe" Text="Edit description…" Click="OnCardMenuDescribe">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Tag="favorite" Text="Add to favorites" Click="OnCardMenuFavorite">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuShowInFolder" Text="Show in folder" Click="OnCardMenuShowInFolder">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CardMenuBackUp" Text="Back up now" Click="OnCardMenuBackUp">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuRestore" Text="Restore from a backup…" Click="OnCardMenuRestore">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Uid="CardMenuPackage" Text="Package for another PC…" Click="OnCardMenuPackage">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="CardMenuDelete" Text="Delete" Click="OnCardMenuDelete"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>

            <!-- ===================================================== a layout card -->
            <DataTemplate x:Key="GridCardTemplate" x:DataType="local:LayoutCard">
                <!-- Fixed height, not Auto. A layout with no description collapses that block
                     and the card ends up shorter than the ones beside it, which makes a tidy
                     grid look broken. -->
                <Grid Width="232"
                      Height="246"
                      PointerEntered="OnCardPointerEntered"
                      PointerExited="OnCardPointerExited"
                      GotFocus="OnCardGotFocus"
                      LostFocus="OnCardLostFocus"
                      ContextFlyout="{StaticResource CardMenuFlyout}"
                      AutomationProperties.Name="{x:Bind CardAccessibleName}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The surface the card is drawn on. It carries no border of its own: the
                         outline is a shape on top, so the thumbnail can reach the very edge
                         instead of leaving a lighter frame around it. -->
                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                    <Border Grid.Row="0"
                            Height="145"
                            CornerRadius="8,8,0,0"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />

                            <FontIcon Glyph="&#xE735;"
                                      FontSize="13"
                                      Margin="0,8,8,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Visibility="{x:Bind FavoriteVisibility}"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                            <!-- Run is the primary action. Pointer, pen or keyboard focus reveals
                                 it; a tap anywhere on the card runs it, and the menu is on right
                                 tap. Run is the accent; the other two are outlines, so they do
                                 not compete with it. -->
                            <Grid x:Name="HoverBar"
                                  Height="40"
                                  VerticalAlignment="Bottom"
                                  Padding="8,0,8,6"
                                  Opacity="0"
                                  ColumnSpacing="6">
                                <Grid.Resources>
                                    <!-- Edit is not here yet, but it is a real button that is
                                         coming, not a broken one, so it keeps a readable label
                                         rather than the barely visible disabled ink. -->
                                    <StaticResource x:Key="ButtonForegroundDisabled"
                                                    ResourceKey="TextFillColorSecondaryBrush" />
                                </Grid.Resources>
                                <Grid.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.1" />
                                </Grid.OpacityTransition>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Height="28"
                                        Padding="10,0,10,0"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnRunLayoutClick"
                                        AutomationProperties.Name="{x:Bind RunAccessibleName}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                        <TextBlock x:Uid="LibraryRunLabel" Text="Run" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Height="28"
                                        Padding="10,0,10,0"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        Click="OnEditLayoutClick"
                                        AutomationProperties.Name="{x:Bind EditAccessibleName}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                        <TextBlock x:Uid="LibraryEditLabel" Text="Edit" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        Width="32"
                                        Height="28"
                                        Padding="0"
                                        Click="OnCardMoreClick"
                                        AutomationProperties.Name="{x:Bind MoreAccessibleName}">
                                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                                </Button>
                            </Grid>

                            <Rectangle Height="1"
                                       VerticalAlignment="Bottom"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                    </Border>

                    <!-- name, description, status -->
                    <Grid Grid.Row="1" Padding="11,9,11,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{x:Bind DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind Description}"
                                   Visibility="{x:Bind DescriptionVisibility}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   VerticalAlignment="Top"
                                   MaxHeight="30"
                                   LineHeight="15"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <Grid Grid.Row="2" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            IsTabStop="False"
                                            ContentTemplate="{StaticResource CardStatusTemplate}"
                                            Content="{x:Bind}" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind RelativeDate}"
                                       FontSize="10.5"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Grid>

                    <Rectangle Grid.Row="0"
                               Grid.RowSpan="2"
                               RadiusX="8"
                               RadiusY="8"
                               StrokeThickness="1"
                               UseLayoutRounding="False"
                               IsHitTestVisible="False"
                               Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />
                </Grid>
            </DataTemplate>

            <!-- ===================================================== a layout row -->
            <DataTemplate x:Key="ListRowTemplate" x:DataType="local:LayoutCard">
                <Grid Height="64"
                      ContextFlyout="{StaticResource CardMenuFlyout}"
                      AutomationProperties.Name="{x:Bind CardAccessibleName}">
                    <Border CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                    <Grid Padding="6,0,10,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="84"
                            Height="52"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                    </Border>

                    <FontIcon Grid.Column="1"
                              Glyph="&#xE735;"
                              FontSize="13"
                              VerticalAlignment="Center"
                              Visibility="{x:Bind FavoriteVisibility}"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind DetailText}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <ContentControl Grid.Column="3"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    ContentTemplate="{StaticResource CardStatusTemplate}"
                                    Content="{x:Bind}" />

                    <TextBlock Grid.Column="4"
                               Text="{x:Bind RelativeDate}"
                               FontSize="11"
                               MinWidth="84"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Height="28"
                                Padding="10,0,10,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnRunLayoutClick"
                                AutomationProperties.Name="{x:Bind RunAccessibleName}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="12" />
                                <TextBlock x:Uid="LibraryRunLabel2" Text="Run" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Width="32"
                                Height="28"
                                Padding="0"
                                Click="OnCardMoreClick"
                                AutomationProperties.Name="{x:Bind MoreAccessibleName}">
                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    </Grid>

                    <Rectangle RadiusX="6"
                               RadiusY="6"
                               StrokeThickness="1"
                               UseLayoutRounding="False"
                               IsHitTestVisible="False"
                               Stroke="{ThemeResource CardStrokeColorDefaultBrush}" />
                </Grid>
            </DataTemplate>

            <!-- ============================================== the new layout tile -->
            <DataTemplate x:Key="NewTileTemplate" x:DataType="local:LayoutCard">
                <Grid Width="232"
                      Height="246"
                      AutomationProperties.Name="{x:Bind CardAccessibleName}">
                    <!-- Dashed, because nothing is here yet. A Border cannot dash, so the
                         outline is a shape, which also keeps its corners smooth. -->
                    <Rectangle RadiusX="8"
                               RadiusY="8"
                               StrokeThickness="1"
                               StrokeDashArray="4,3"
                               StrokeDashCap="Flat"
                               UseLayoutRounding="False"
                               Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="24"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Uid="NewTileHeading"
                                   Text="New layout"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Uid="NewTileBody"
                                   Text="Start blank, or from a mixer, DJ deck, drum pad or transport template"
                                   FontSize="10.5"
                                   Margin="18,0,18,0"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="15"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <local:LayoutCardTemplateSelector x:Key="CardTemplateSelector"
                                              CardTemplate="{StaticResource GridCardTemplate}"
                                              NewTileTemplate="{StaticResource NewTileTemplate}" />

            <!-- A card draws its own surface, so the container adds nothing but selection and
                 focus. Anything it painted would show as an inset frame around the thumbnail. -->
            <Style x:Key="LayoutItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="0,0,14,14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="4"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" />

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Glass"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h.
                 The pill is a shape, not a Border: a Border snaps its corner radius to whole
                 pixels along with its bounds and the arc comes out stepped. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE840;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ============================================================ toolbar -->
        <Border Grid.Row="1"
                Height="44"
                Padding="12,0,12,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="NewLayoutButton"
                        x:Uid="NewLayoutButton"
                        Grid.Column="0"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="32"
                        Padding="12,0,12,0"
                        VerticalAlignment="Center"
                        Click="OnNewLayoutClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="NewLayoutLabel" x:Uid="NewLayoutLabel" Text="New layout" FontSize="13" />
                    </StackPanel>
                </Button>

                <AutoSuggestBox x:Name="SearchBox"
                                x:Uid="SearchBox"
                                Grid.Column="1"
                                Width="250"
                                Height="32"
                                VerticalAlignment="Center"
                                QueryIcon="Find"
                                PlaceholderText="Search layouts"
                                TextChanged="OnSearchTextChanged" />

                <Rectangle Grid.Column="2"
                           Width="1"
                           Height="20"
                           Margin="3,0,3,0"
                           VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <ComboBox x:Name="SortSelector"
                          x:Uid="SortSelector"
                          Grid.Column="3"
                          Width="176"
                          Height="32"
                          VerticalAlignment="Center"
                          SelectionChanged="OnSortSelectionChanged" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="GridViewToggle"
                                  x:Uid="GridViewToggle"
                                  Width="38"
                                  Height="32"
                                  Padding="0"
                                  CornerRadius="4,0,0,4"
                                  Click="OnGridViewToggled">
                        <FontIcon Glyph="&#xE80A;" FontSize="13" />
                    </ToggleButton>
                    <ToggleButton x:Name="ListViewToggle"
                                  x:Uid="ListViewToggle"
                                  Width="38"
                                  Height="32"
                                  Padding="0"
                                  Margin="-1,0,0,0"
                                  CornerRadius="0,4,4,0"
                                  Click="OnListViewToggled">
                        <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                    </ToggleButton>
                </StackPanel>

                <Button x:Name="OpenFileButton"
                        x:Uid="OpenFileButton"
                        Grid.Column="6"
                        Style="{StaticResource SubtleToolbarButtonStyle}"
                        Click="OnOpenFileClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock x:Name="OpenFileLabel" x:Uid="OpenFileLabel" Text="Open a file…" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- The commands that are about this PC rather than about one layout. A layout's
                     own commands live on its card, where the thing they act on is visible. -->
                <Button x:Name="LibraryMoreButton"
                        x:Uid="LibraryMoreButton"
                        Grid.Column="7"
                        Width="38"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource SubtleToolbarButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="LibraryMenuImport" Text="Import a layout package…" Click="OnImportPackageClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="LibraryMenuBackupsFolder" Text="Show the backups folder" Click="OnShowBackupsFolderClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8DA;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="KeepAwakeMenuItem"
                                                  x:Uid="LibraryMenuKeepAwake"
                                                  Text="Keep this PC awake while a layout runs"
                                                  Click="OnKeepAwakeClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <!-- =============================================================== body -->
        <ScrollViewer Grid.Row="2"
                      Padding="24,14,24,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      SizeChanged="OnLibrarySizeChanged">
            <StackPanel>

                <StackPanel x:Name="FavoritesSection">
                    <Grid Margin="0,2,0,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE735;"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                        <TextBlock x:Name="FavoritesHeading"
                                   x:Uid="FavoritesHeading"
                                   Grid.Column="1"
                                   Text="Favorites"
                                   Style="{StaticResource SectionHeadingStyle}" />

                        <TextBlock x:Name="FavoritesCount"
                                   Grid.Column="2"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <GridView x:Name="FavoritesGrid"
                              x:Uid="FavoritesGrid"
                              Padding="0"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnLayoutItemClick"
                              GotFocus="OnGridGotFocus"
                              LostFocus="OnGridLostFocus"
                              ItemTemplateSelector="{StaticResource CardTemplateSelector}"
                              ItemContainerStyle="{StaticResource LayoutItemStyle}"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <!-- The library is rebuilt whole whenever a device arrives or leaves, so
                             an entrance animation would replay every time and read as a loop. -->
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                    </GridView>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Margin="0,8,0,0">
                    <Grid Margin="0,2,0,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE823;"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <TextBlock x:Name="RecentHeading"
                                   x:Uid="RecentHeading"
                                   Grid.Column="1"
                                   Text="Recent"
                                   Style="{StaticResource SectionHeadingStyle}" />

                        <TextBlock x:Name="RecentCount"
                                   Grid.Column="2"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <GridView x:Name="RecentGrid"
                              x:Uid="RecentGrid"
                              Padding="0"
                              Margin="0,0,0,16"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnLayoutItemClick"
                              GotFocus="OnGridGotFocus"
                              LostFocus="OnGridLostFocus"
                              ItemTemplateSelector="{StaticResource CardTemplateSelector}"
                              ItemContainerStyle="{StaticResource LayoutItemStyle}"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                    </GridView>
                </StackPanel>

                <StackPanel x:Name="EmptyLibraryPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520"
                            Margin="0,80,0,0"
                            Spacing="12"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7F4;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <TextBlock x:Name="EmptyHeading"
                               x:Uid="EmptyHeading"
                               Text="No layouts yet"
                               HorizontalAlignment="Center"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock x:Name="EmptyBody"
                               x:Uid="EmptyBody"
                               Text="Make one from a template and it is ready to play. Pick the device it should send to and MIDI Glass builds the rest."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="EmptyNewLayoutButton"
                            x:Uid="EmptyNewLayoutButton"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnNewLayoutClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="NewLayoutLabel2" Text="New layout" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================= status bar -->
        <Border Grid.Row="3"
                Height="30"
                Padding="16,0,16,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE8B7;"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock x:Name="FolderStatusText"
                           Grid.Column="1"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <Grid Grid.Column="2" Height="19" VerticalAlignment="Center">
                    <Rectangle x:Name="ServiceChipShape"
                               RadiusX="9.5"
                               RadiusY="9.5"
                               StrokeThickness="1"
                               UseLayoutRounding="False" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,8,0">
                        <FontIcon x:Name="ServiceChipIcon"
                                  Glyph="&#xE73E;"
                                  FontSize="10"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="ServiceChipText"
                                   FontSize="10"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
