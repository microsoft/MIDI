<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midiglass.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midiglass"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Glass"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h. -->
            <Border x:Name="PreviewChiclet"
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="18"
                    Padding="9,0,9,0"
                    CornerRadius="9"
                    IsHitTestVisible="False"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Border>

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE840;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- The library: every layout in Documents\MIDI Layouts, with a card drawn from the
             layout itself rather than captured from a window, so it is right for one that has
             never been opened on this PC. -->
        <Grid Grid.Row="1" Padding="16,0,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LibraryHeading"
                           x:Uid="LibraryHeading"
                           Grid.Column="0"
                           Text="Layouts"
                           VerticalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Button x:Name="NewLayoutButton"
                        x:Uid="NewLayoutButton"
                        Grid.Column="1"
                        Click="OnNewLayoutClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Name="NewLayoutLabel" x:Uid="NewLayoutLabel" Text="New starter layout" />
                    </StackPanel>
                </Button>

                <Button x:Name="OpenFolderButton"
                        x:Uid="OpenFolderButton"
                        Grid.Column="2"
                        Click="OnOpenFolderClick">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>

                <Button x:Name="RefreshButton"
                        x:Uid="RefreshButton"
                        Grid.Column="3"
                        Click="OnRefreshClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <GridView x:Name="LayoutGrid"
                      x:Uid="LayoutGrid"
                      Grid.Row="1"
                      IsItemClickEnabled="True"
                      ItemClick="OnLayoutItemClick"
                      SelectionMode="Single">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:LayoutCard">
                        <Grid Width="272"
                              Padding="0,0,0,10"
                              AutomationProperties.Name="{x:Bind CardAccessibleName}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Height="170"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       Text="{x:Bind DisplayName}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

                            <TextBlock Grid.Row="2"
                                       Text="{x:Bind Description}"
                                       Visibility="{x:Bind DescriptionVisibility}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock Grid.Row="3"
                                       Text="{x:Bind DetailText}"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
                                <Button Click="OnRunLayoutClick"
                                        Tag="{x:Bind FilePath}"
                                        AutomationProperties.Name="{x:Bind RunAccessibleName}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock x:Uid="LibraryRunLabel" Text="Run" />
                                    </StackPanel>
                                </Button>

                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          Visibility="{x:Bind ImportedVisibility}"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel x:Name="EmptyLibraryPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="520"
                        Spacing="12"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE7F4;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <TextBlock x:Name="EmptyHeading"
                           x:Uid="EmptyHeading"
                           Text="No layouts yet"
                           HorizontalAlignment="Center"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                <TextBlock x:Name="EmptyBody"
                           x:Uid="EmptyBody"
                           Text="Pick a device and make a starter layout. It gives you eight faders, eight knobs and eight pads, ready to run."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
