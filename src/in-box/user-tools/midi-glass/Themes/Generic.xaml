<!--
    The default template for GlassControl.

    Everything a control looks like is drawn by composition, so this template holds nothing but a
    Border for the background. That Border is not decoration: a Control with no template renders
    nothing, and a XAML element that renders nothing **cannot be hit by a pointer at all**. The
    surface was driveable through UI Automation and not with a mouse or a finger until this
    existed, because automation reaches the peer without going through the visual tree.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midiglass">

    <Style TargetType="local:GlassControl">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GlassControl">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
