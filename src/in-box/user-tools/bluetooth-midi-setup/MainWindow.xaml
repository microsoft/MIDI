<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midibluetoothsetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midibluetoothsetup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint"
                Grid.Row="0"
                Grid.RowSpan="2"
                Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Bluetooth Setup"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ================================= Navigation ================================= -->
        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="220"
                        PaneDisplayMode="Left"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DevicesNavigationItem"
                                    x:Uid="DevicesNavigationItem"
                                    Content="Bluetooth devices"
                                    Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE702;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ThisPcNavigationItem"
                                    x:Uid="ThisPcNavigationItem"
                                    Content="This PC"
                                    Tag="thispc">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem"
                                    x:Uid="SettingsNavigationItem"
                                    Content="Transport settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Above both pages, because a device connects to this PC whichever page is
                     showing, and it is connected but getting nothing until this is answered. -->
                <InfoBar x:Name="PendingClientsBar"
                         x:Uid="PendingClientsBar"
                         Grid.Row="0"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Title="A device is waiting for permission"
                         Margin="16,12,16,0">
                    <InfoBar.Content>
                        <ItemsControl x:Name="PendingClientsList" Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PendingClientItem">
                                    <StackPanel Margin="0,0,0,10" Spacing="4">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Headline, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button x:Uid="AllowOnceButton"
                                                        Content="Allow once"
                                                        IsEnabled="{x:Bind CanDecide, Mode=OneWay}"
                                                        Click="OnAllowClientOnceClick" />

                                                <!-- Disabled rather than hidden for a rotating
                                                     address, so it is clear the choice exists but
                                                     cannot apply to this device. -->
                                                <Button x:Uid="AllowAlwaysButton"
                                                        Content="Always allow"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        IsEnabled="{x:Bind CanDecidePermanently, Mode=OneWay}"
                                                        Click="OnAllowClientAlwaysClick" />
                                                <Button x:Uid="DenyOnceButton"
                                                        Content="Deny"
                                                        IsEnabled="{x:Bind CanDecide, Mode=OneWay}"
                                                        Click="OnDenyClientOnceClick" />
                                                <Button x:Uid="BlockClientButton"
                                                        Content="Block"
                                                        IsEnabled="{x:Bind CanDecidePermanently, Mode=OneWay}"
                                                        Click="OnBlockClientClick" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Uid="RotatingAddressHint"
                                                   Text="This device's Bluetooth address changes periodically, so it cannot be remembered. Pair it with this PC to give it a stable identity."
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind RotatingAddressHintVisibility, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </InfoBar.Content>
                </InfoBar>

                <!-- A radio which cannot do what is being asked is not a failure of any one
                     operation, so it is said once here rather than on every button. -->
                <InfoBar x:Name="RadioLimitationBar"
                         x:Uid="RadioLimitationBar"
                         Grid.Row="1"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Title="Bluetooth is limited on this PC"
                         Margin="16,12,16,0" />

                <Grid Grid.Row="2">
                    <!-- Shown instead of everything else when the transport is missing -->
                    <InfoBar x:Name="TransportUnavailableBar"
                             x:Uid="TransportUnavailableBar"
                             VerticalAlignment="Top"
                             Margin="16,12,16,12"
                             Canvas.ZIndex="1"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="False"
                             Title="Bluetooth MIDI is not available"
                             Message="The Bluetooth MIDI transport is not installed, so this tool has nothing to work with." />

                    <!-- ======================== Page 1: Bluetooth devices ======================== -->
                    <Grid x:Name="DevicesPanel" Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Uid="DevicesHeader"
                                           Text="Bluetooth MIDI devices"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock x:Uid="DevicesDescription"
                                           Text="Devices are found by listening for advertisements, so a device which is switched off, asleep, or already connected to another host will not be listed."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="NoDevicesText"
                                   x:Uid="NoDevicesText"
                                   Grid.Row="1"
                                   Text="No Bluetooth MIDI devices have been discovered yet. Wake a device so it advertises, then wait a moment."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Visibility="Collapsed"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <ListView x:Name="DevicesListView"
                                  x:Uid="DevicesListView"
                                  Grid.Row="1"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4,0,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:BluetoothDeviceItem">
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                    <!-- fixed so that every row lines up whether or not
                                                         it currently has a signal trace to draw -->
                                                    <ColumnDefinition Width="172" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE702;" FontSize="20" />
                                                    <!-- drawn as a badge in the lower right of its own
                                                         box, so it overlays without offsets -->
                                                    <FontIcon Glyph="&#xF386;"
                                                              FontSize="20"
                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                               TextWrapping="Wrap"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </StackPanel>

                                                <!-- Signal history. The geometry is generated against a
                                                     fixed 300x40 box in BluetoothDeviceItem, so this size
                                                     must match. A connected device stops advertising, so
                                                     the trace disappears rather than freezing. -->
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Spacing="2"
                                                            Visibility="{x:Bind SignalGraphVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind SignalText, Mode=OneWay}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,0,2,0"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                                    <Border Width="160"
                                                            Height="32"
                                                            HorizontalAlignment="Center"
                                                            CornerRadius="4"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            BorderThickness="1"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                        <Grid>
                                                            <Polygon Points="{x:Bind SignalFillPoints, Mode=OneWay}"
                                                                     Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                     Opacity="0.45" />
                                                            <Polyline Points="{x:Bind SignalLinePoints, Mode=OneWay}"
                                                                      Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                      StrokeThickness="1.5"
                                                                      StrokeLineJoin="Round" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <Button x:Uid="ConnectButton"
                                                            Content="Connect"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            Visibility="{x:Bind ConnectVisibility, Mode=OneWay}"
                                                            Click="OnConnectDeviceClick" />
                                                    <Button x:Uid="DisconnectButton"
                                                            Content="Disconnect"
                                                            Visibility="{x:Bind DisconnectVisibility, Mode=OneWay}"
                                                            Click="OnDisconnectDeviceClick" />
                                                    <Button x:Uid="ForgetButton"
                                                            Content="Forget"
                                                            Visibility="{x:Bind ForgetVisibility, Mode=OneWay}"
                                                            Click="OnForgetDeviceClick" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Everything here is diagnostic or occasional, so it is out of the
                                                 way until it is wanted. -->
                                            <Expander x:Uid="DeviceDetailsExpander"
                                                      Header="Details"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      Background="Transparent"
                                                      BorderThickness="0">
                                                <Grid Margin="0,4,0,4"
                                                      ColumnSpacing="12"
                                                      RowSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MinWidth="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock x:Uid="DeviceAddressLabel"
                                                               Grid.Row="0" Grid.Column="0"
                                                               Text="Address"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{x:Bind SubtitleText, Mode=OneWay}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />

                                                    <TextBlock x:Uid="EndpointDeviceIdLabel"
                                                               Grid.Row="1" Grid.Column="0"
                                                               Text="Endpoint device id"
                                                               Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                                               Text="{x:Bind EndpointDeviceId, Mode=OneWay}"
                                                               TextWrapping="Wrap"
                                                               IsTextSelectionEnabled="True"
                                                               Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />

                                                    <!-- These sit against the id rather than at the far right of the row.
                                                         ColumnSpacing already contributes 12, so the margin makes it 20. -->
                                                    <StackPanel Grid.Row="1" Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Top"
                                                                Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}">
                                                        <Button x:Uid="CopyEndpointIdButton"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Click="OnCopyEndpointDeviceIdClick">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                        </Button>
                                                        <Button x:Uid="MonitorEndpointButton"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Visibility="{x:Bind MonitorVisibility, Mode=OneWay}"
                                                                Click="OnMonitorEndpointClick">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                                                <TextBlock x:Uid="MonitorEndpointButtonText" Text="Monitor" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>

                                                    <TextBlock x:Uid="ConnectionIntervalLabel"
                                                               Grid.Row="2" Grid.Column="0"
                                                               Text="Connection interval"
                                                               Visibility="{x:Bind IntervalVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                                               Text="{x:Bind IntervalText, Mode=OneWay}"
                                                               Visibility="{x:Bind IntervalVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />

                                                    <TextBlock x:Uid="DeviceStatisticsLabel"
                                                               Grid.Row="3" Grid.Column="0"
                                                               Text="Messages"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                                               Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                               TextWrapping="Wrap"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />

                                                    <!-- An app using WinMM or WinRT MIDI 1.0 cannot ask whether a
                                                         device is present, so whether the endpoint exists is the
                                                         only signal it gets. -->
                                                    <TextBlock x:Uid="OfflineRetentionLabel"
                                                               Grid.Row="4" Grid.Column="0"
                                                               Text="Keep endpoint when offline"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Visibility="{x:Bind OfflineRetentionVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <StackPanel Grid.Row="4" Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center"
                                                                Visibility="{x:Bind OfflineRetentionVisibility, Mode=OneWay}">
                                                        <ComboBox MinWidth="170"
                                                                  SelectedIndex="{x:Bind OfflineRetentionIndex, Mode=OneWay}"
                                                                  SelectionChanged="OnOfflineRetentionChanged">
                                                            <ComboBoxItem x:Uid="OfflineRetentionUseDefaultItem" Content="Use default" />
                                                            <ComboBoxItem x:Uid="OfflineRetentionAlwaysItem" Content="Always" />
                                                            <ComboBoxItem x:Uid="OfflineRetentionImmediateItem" Content="Remove immediately" />
                                                            <ComboBoxItem x:Uid="OfflineRetention30SecondsItem" Content="After 30 seconds" />
                                                            <ComboBoxItem x:Uid="OfflineRetention5MinutesItem" Content="After 5 minutes" />
                                                        </ComboBox>
                                                        <!-- What the setting resolves to. The combo shows no selection
                                                             for a duration which is not one of its presets, so this is
                                                             the only place that value appears. -->
                                                        <TextBlock Text="{x:Bind OfflineRetentionText, Mode=OneWay}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <Button x:Uid="CustomizeButton"
                                                            Grid.Row="4" Grid.Column="2"
                                                            Content="Rename"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind CustomizeVisibility, Mode=OneWay}"
                                                            Click="OnCustomizeDeviceClick" />
                                                </Grid>
                                            </Expander>

                                            <!-- The transport's own wording, which is more specific than
                                                 an error code can be. -->
                                            <TextBlock Text="{x:Bind LastErrorText, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind LastErrorVisibility, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="DevicesStatusText"
                                   Grid.Row="2"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- ============================ Page 2: This PC ============================ -->
                    <ScrollViewer x:Name="ThisPcPanel"
                                  Margin="16,12,16,16"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel Spacing="12" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock x:Uid="ThisPcHeader"
                                           Text="Publish this PC"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock x:Uid="ThisPcDescription"
                                           Text="Other devices, such as a phone or tablet, can connect to this PC and appear as a MIDI endpoint. The endpoint represents the device which connected, so it exists only while something is connected."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE977;"
                                                  FontSize="20"
                                                  VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="PeripheralNameText"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="PeripheralStateText"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <ComboBox x:Name="PeripheralProtocolCombo"
                                                      x:Uid="PeripheralProtocolCombo"
                                                      MinWidth="190"
                                                      Header="Protocol" />
                                            <Button x:Name="StartPeripheralButton"
                                                    x:Uid="StartPeripheralButton"
                                                    Content="Publish"
                                                    VerticalAlignment="Bottom"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Click="OnStartPeripheralClick" />
                                            <Button x:Name="StopPeripheralButton"
                                                    x:Uid="StopPeripheralButton"
                                                    Content="Stop"
                                                    VerticalAlignment="Bottom"
                                                    Visibility="Collapsed"
                                                    Click="OnStopPeripheralClick" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Windows takes the advertised name from the computer name and
                                         the GATT service provider gives an application no way to
                                         override it, so this is reported rather than editable. -->
                                    <TextBlock x:Uid="AdvertisedNameNote"
                                               Text="The name a remote device sees is this PC's Bluetooth name, which is changed in Windows Settings."
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Uid="ConnectedDeviceHeader"
                                       Text="Connected device"
                                       Style="{StaticResource SectionHeaderTextStyle}" />

                            <TextBlock x:Name="NoPeripheralClientText"
                                       x:Uid="NoPeripheralClientText"
                                       Text="Nothing is connected. A MIDI endpoint appears when a device connects to this PC."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <ItemsControl x:Name="PeripheralClientsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:PeripheralClientItem">
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Grid.Column="0"
                                                              Glyph="&#xE8EA;"
                                                              FontSize="20"
                                                              VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind AddressText, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind IntervalText, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <Button x:Uid="CustomizeButton"
                                                                Content="Rename"
                                                                Click="OnCustomizePeripheralClick" />
                                                        <Button x:Uid="CopyEndpointIdButton"
                                                                Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                                Click="OnCopyPeripheralEndpointDeviceIdClick">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Uid="GenericNameHint"
                                                           Text="This device is reporting a generic name. Phones and tablets withhold their real name from a PC they are not paired with."
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind GenericNameHintVisibility, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                                                <TextBlock x:Uid="PairingHint"
                                                           Text="This device is not paired with this PC, so it has no stable identity. Pair from the device itself to give it one. Until then, a name set here applies to any unpaired device which connects."
                                                           TextWrapping="Wrap"
                                                           Visibility="{x:Bind PairingHintVisibility, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="PeripheralStatusText"
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ====================== Page 3: Transport settings ====================== -->
                    <ScrollViewer x:Name="SettingsPanel"
                                  Margin="16,12,16,16"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel Spacing="12" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock x:Uid="SettingsHeader"
                                           Text="Transport settings"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock x:Uid="SettingsDescription"
                                           Text="These apply to every Bluetooth MIDI device unless a device has been given its own setting."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Uid="DefaultOfflineRetentionHeader"
                                               Text="Keep endpoints when a device goes offline"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                    <!-- An app using WinMM or WinRT MIDI 1.0 cannot ask whether a device is
                                         present, so whether the endpoint exists is the only signal it gets
                                         that the device has gone. -->
                                    <TextBlock x:Uid="DefaultOfflineRetentionDescription"
                                               Text="Keeping an endpoint means applications hold on to their MIDI ports while a device is switched off or out of range. Removing it means the ports disappear, which is the only way most applications can tell the device is gone."
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <ComboBox x:Name="DefaultOfflineRetentionCombo"
                                              MinWidth="200"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="OnDefaultOfflineRetentionChanged">
                                        <ComboBoxItem x:Uid="OfflineRetentionAlwaysItem" Content="Always" />
                                        <ComboBoxItem x:Uid="OfflineRetentionImmediateItem" Content="Remove immediately" />
                                        <ComboBoxItem x:Uid="OfflineRetention30SecondsItem" Content="After 30 seconds" />
                                        <ComboBoxItem x:Uid="OfflineRetention5MinutesItem" Content="After 5 minutes" />
                                    </ComboBox>

                                    <TextBlock x:Name="DefaultOfflineRetentionStatusText"
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- ================================== Dialogs ================================== -->
        <ContentDialog x:Name="ConfirmDialog"
                       x:Uid="ConfirmDialog"
                       PrimaryButtonText="Yes"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog x:Name="CustomizeDialog"
                       x:Uid="CustomizeDialog"
                       Title="Rename this device"
                       PrimaryButtonText="Save"
                       SecondaryButtonText="Reset"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="12" Width="420">
                <TextBlock x:Name="CustomizeTransportNameText"
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBox x:Name="CustomizeNameBox"
                         x:Uid="CustomizeNameBox"
                         Header="Name" />

                <TextBox x:Name="CustomizeDescriptionBox"
                         x:Uid="CustomizeDescriptionBox"
                         Header="Description"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="CustomizeImageBox"
                             x:Uid="CustomizeImageBox"
                             Grid.Column="0"
                             Header="Image file name" />

                    <Button x:Name="CustomizeBrowseImageButton"
                            x:Uid="CustomizeBrowseImageButton"
                            Grid.Column="1"
                            Content="Browse..."
                            VerticalAlignment="Bottom"
                            Click="OnBrowseForImageClick" />

                    <Button x:Name="CustomizeRemoveImageButton"
                            x:Uid="CustomizeRemoveImageButton"
                            Grid.Column="2"
                            Content="Remove"
                            VerticalAlignment="Bottom"
                            Click="OnRemoveImageClick" />
                </Grid>

                <TextBlock x:Uid="CustomizeHelpText"
                           Text="Leave a box empty to use what the device reports. Browsing for an image copies it into the shared endpoint images folder. Remove clears the image from this device without deleting the file."
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
