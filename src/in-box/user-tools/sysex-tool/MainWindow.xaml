<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midisysextool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midisysextool"
    xmlns:shared="using:MidiAppShared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill" Grid.Row="0" Grid.RowSpan="4"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        <Border x:Name="WindowTint" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon" Grid.Column="1" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock" Grid.Column="2"
                       Text="Windows MIDI SysEx Utility"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <ToggleButton x:Name="AlwaysOnTopToggle" x:Uid="AlwaysOnTopToggle"
                          Grid.Column="3" Width="46" Height="32"
                          VerticalAlignment="Top" Padding="0" BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ============================== Destination header ============================= -->
        <Border Grid.Row="1" Margin="12,4,12,8" Padding="12,10,12,10" CornerRadius="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="150" />
                    <ColumnDefinition Width="*" MinWidth="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Uid="EndpointPickerLabel" Text="MIDI Device"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="EndpointComboBox" x:Uid="EndpointPicker" TabIndex="1"
                              HorizontalAlignment="Stretch" PlaceholderText="Choose a device"
                              SelectionChanged="OnEndpointSelectionChanged">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="shared:EndpointChoice">
                                <Grid ColumnSpacing="8" Loaded="OnEndpointChoiceLoaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Image x:Name="EndpointChoiceImage" Grid.Column="1" Height="18" MaxWidth="32"
                                           Source="{x:Bind ImageSource}" Visibility="{x:Bind ImageVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Uid="GroupPickerLabel" Text="Group"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="GroupComboBox" x:Uid="GroupPicker" TabIndex="2"
                              HorizontalAlignment="Stretch" SelectionChanged="OnGroupSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="shared:NamedChoice">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                    <TextBlock x:Uid="ModePickerLabel" Text="Task" TextWrapping="NoWrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="SendModeButton" x:Uid="SendModeButton" GroupName="TaskMode"
                                     Content="Send a file" TabIndex="3" Checked="OnTaskModeChanged" />
                        <RadioButton x:Name="ReceiveModeButton" x:Uid="ReceiveModeButton" GroupName="TaskMode"
                                     Content="Receive" TabIndex="4" Checked="OnTaskModeChanged" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================== Work area ================================= -->
        <Grid Grid.Row="2" Margin="12,0,12,8">

            <!-- ============================= Send panel ============================ -->
            <Grid x:Name="SendPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SendFilePathBox" x:Uid="SendFilePathBox" Grid.Column="0"
                             Header="SysEx file" IsReadOnly="True" TabIndex="5" />
                    <Button x:Name="BrowseSendFileButton" x:Uid="BrowseSendFileButton" Grid.Column="1"
                            Content="Browse..." VerticalAlignment="Bottom" TabIndex="6"
                            Click="OnBrowseSendFileClick" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                    <NumberBox x:Name="MessageCountBox" x:Uid="MessageCountBox"
                               Header="Messages per transfer" Width="200"
                               Minimum="1" Maximum="4096" SpinButtonPlacementMode="Compact"
                               TabIndex="7" ValueChanged="OnTransferSettingChanged" />
                    <NumberBox x:Name="SpacingBox" x:Uid="SpacingBox"
                               Header="Delay between transfers (ms)" Width="220"
                               Minimum="0" Maximum="5000" SpinButtonPlacementMode="Compact"
                               TabIndex="8" ValueChanged="OnTransferSettingChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8" VerticalAlignment="Top">
                    <ProgressBar x:Name="SendProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" />
                    <TextBlock x:Name="SendProgressText" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- =========================== Receive panel ========================== -->
            <Grid x:Name="ReceivePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="10,0,0,4">
                    <TextBlock x:Uid="ColumnHeaderMessage" Text="Message" Width="60"
                               TextAlignment="Right"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="ColumnHeaderWords" Text="UMP words" Width="180"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="ColumnHeaderBytes" Text="System Exclusive bytes"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView x:Name="DumpListView"
                              x:Uid="DumpListView"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ContainerContentChanging="OnDumpContainerContentChanging"
                              ScrollViewer.HorizontalScrollMode="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="8,1,8,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SysExRow">
                                <!-- the font goes on each TextBlock: the default ListViewItem
                                     style sets FontFamily, so it never inherits from the ListView -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind MessageNumber}" FontSize="12" Width="60"
                                               FontFamily="Cascadia Mono, Consolas, Courier New"
                                               TextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <!-- foreground set from WordKind in OnDumpContainerContentChanging -->
                                    <TextBlock Text="{x:Bind Words}" FontSize="12" Width="180"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" />
                                    <!-- built as runs so F0 and F7 stand out from the data bytes -->
                                    <TextBlock FontSize="12"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================= Status bar ================================= -->
        <Grid Grid.Row="3" Margin="12,0,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SettingsButton" x:Uid="SettingsButton" Grid.Column="0"
                    Width="36" Height="32" Padding="0" TabIndex="20" Click="OnSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>

            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" x:Uid="SaveButton" Content="Save..." TabIndex="11"
                        Visibility="Collapsed" Click="OnSaveClick" />
                <Button x:Name="ClearButton" x:Uid="ClearButton" Content="Clear" TabIndex="12"
                        Visibility="Collapsed" Click="OnClearClick" />
                <Button x:Name="PrimaryButton" x:Uid="PrimaryButton" MinWidth="140" TabIndex="10"
                        Style="{ThemeResource AccentButtonStyle}" Click="OnPrimaryClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PrimaryButtonIcon" Glyph="&#xE724;" FontSize="14" />
                        <TextBlock x:Name="PrimaryButtonText" Text="Send" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
