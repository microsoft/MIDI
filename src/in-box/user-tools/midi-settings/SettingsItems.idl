// Row types for the lists in this app. They implement INotifyPropertyChanged because the
// endpoint watcher updates rows in place: rebuilding the collection would throw away the
// scroll position and the customer's selection every time a device announced itself.
namespace midisettings
{
    // One MIDI endpoint, shown as a card or as a list row.
    [default_interface]
    runtimeclass EndpointItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        EndpointItem();

        String EndpointDeviceId{ get; };
        String Name{ get; };
        String Description{ get; };
        String TransportCode{ get; };
        String DetailText{ get; };

        // Resolved from the customer's own picture, then the transport's default art. Built on
        // first use, because a file path string will not bind to Image.Source.
        Microsoft.UI.Xaml.Media.ImageSource Image{ get; };

        Microsoft.UI.Xaml.Visibility DescriptionVisibility{ get; };
        Microsoft.UI.Xaml.Visibility MonitorVisibility{ get; };

        // A card or row shows several separate text elements, but a screen reader announces the
        // container's name only, so they are composed here.
        String RowAccessibleName{ get; };
        String MonitorAccessibleName{ get; };
        String PanicAccessibleName{ get; };
    }

    // One WinMM / WinRT MIDI 1.0 port belonging to an endpoint.
    [default_interface]
    runtimeclass Midi1PortItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Midi1PortItem();

        String PortDeviceId{ get; };
        String Name{ get; };
        String DetailText{ get; };

        String RowAccessibleName{ get; };
    }

    // One row in the MIDI 1.0 port naming grids. The three generated names are shown side by
    // side so the customer can see what each naming approach would produce before choosing,
    // and CustomName overrides whichever of them is selected.
    [default_interface]
    runtimeclass Midi1PortNameItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        Midi1PortNameItem();

        UInt8 GroupIndex{ get; };
        String GroupNumberText{ get; };
        String CurrentName{ get; };
        String LegacyCompatibleName{ get; };
        String NewStyleName{ get; };

        // Two-way bound to the text box in the row.
        String CustomName;
    }

    // An entry in the transport filter drop-down. An empty code means every transport.
    [default_interface]
    runtimeclass TransportChoice
    {
        TransportChoice();

        String DisplayName{ get; };
        String TransportCode{ get; };
    }

    // A stored customization which no longer matches any endpoint on this PC. Everything shown
    // here is there so the customer can recognize their own work: the picture they chose, the
    // name they gave it, and a summary of what would be lost if they deleted it.
    [default_interface]
    runtimeclass OrphanedCustomizationItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        OrphanedCustomizationItem();

        String DisplayName{ get; };
        String Description{ get; };
        String ContentSummary{ get; };
        String ProvenanceText{ get; };
        String StoredId{ get; };
        String TransportCode{ get; };

        Microsoft.UI.Xaml.Media.ImageSource Image{ get; };
        Microsoft.UI.Xaml.Visibility DescriptionVisibility{ get; };
        Microsoft.UI.Xaml.Visibility ProvenanceVisibility{ get; };
    }

    // An endpoint a stored customization could be moved onto.
    [default_interface]
    runtimeclass RelinkCandidateItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        RelinkCandidateItem();

        String Name{ get; };
        String EndpointDeviceId{ get; };

        // Why this one is near the top, in the customer's terms. Never a score.
        String ReasonText{ get; };

        Microsoft.UI.Xaml.Visibility ReasonVisibility{ get; };
        Microsoft.UI.Xaml.Visibility WarningVisibility{ get; };
    }

    // A configuration file found in the machine configuration folder.
    [default_interface]
    runtimeclass ConfigFileChoice
    {
        ConfigFileChoice();

        String DisplayName{ get; };
        String FileName{ get; };
    }
}
