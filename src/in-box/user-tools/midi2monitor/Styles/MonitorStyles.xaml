<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Shades of one base color for the MIDI words, per theme, so they stay readable -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MidiWord0Brush" Color="#FF9CC6FF" />
            <SolidColorBrush x:Key="MidiWord1Brush" Color="#FF7FB0F2" />
            <SolidColorBrush x:Key="MidiWord2Brush" Color="#FF6699DE" />
            <SolidColorBrush x:Key="MidiWord3Brush" Color="#FF5083C6" />
            <SolidColorBrush x:Key="MidiNoticeBrush" Color="#FFB9A3F0" />
            <SolidColorBrush x:Key="MidiDetailValueBrush" Color="#FF7ED9A7" />
            <SolidColorBrush x:Key="MidiTimeUnitBrush" Color="#FF9AA4B2" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MidiWord0Brush" Color="#FF1A4F9C" />
            <SolidColorBrush x:Key="MidiWord1Brush" Color="#FF2C64B5" />
            <SolidColorBrush x:Key="MidiWord2Brush" Color="#FF437ACB" />
            <SolidColorBrush x:Key="MidiWord3Brush" Color="#FF5B90DE" />
            <SolidColorBrush x:Key="MidiNoticeBrush" Color="#FF5B3FA8" />
            <SolidColorBrush x:Key="MidiDetailValueBrush" Color="#FF116B43" />
            <SolidColorBrush x:Key="MidiTimeUnitBrush" Color="#FF6B7280" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MidiWord0Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiWord1Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiWord2Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiWord3Brush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiNoticeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiDetailValueBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MidiTimeUnitBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Message type chiclets, in the comps' colors (src\prototypes\midi-monitor\design):
         bright mid tones with near black text, which reads in both themes. Theme independent,
         because they're resolved from code. Windows MIDI Patchbay's watch windows use the same
         colors. Order: utility, system, MIDI 1.0, MIDI 2.0, data, flex, stream, other. -->
    <SolidColorBrush x:Key="MidiMessageType0BackgroundBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="MidiMessageType1BackgroundBrush" Color="#FFE8A33D" />
    <SolidColorBrush x:Key="MidiMessageType2BackgroundBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="MidiMessageType3BackgroundBrush" Color="#FF3FD1A6" />
    <SolidColorBrush x:Key="MidiMessageType4BackgroundBrush" Color="#FFC38BFF" />
    <SolidColorBrush x:Key="MidiMessageType5BackgroundBrush" Color="#FFFF8FB1" />
    <SolidColorBrush x:Key="MidiMessageType6BackgroundBrush" Color="#FFB9B96A" />
    <SolidColorBrush x:Key="MidiMessageType7BackgroundBrush" Color="#FF8A8A8A" />

    <SolidColorBrush x:Key="MidiMessageType0ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType1ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType2ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType3ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType4ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType5ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType6ForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="MidiMessageType7ForegroundBrush" Color="#FF000000" />

    <!-- Batch striping. Low alpha gray works over either theme's list background. -->
    <SolidColorBrush x:Key="MidiRowBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MidiRowAlternateBackgroundBrush" Color="#16808080" />

    <!-- Advanced mode: one color for each source, used as a bar beside its rows and as a swatch
         in the Sources list. Mid tones, so they read over both themes. -->
    <SolidColorBrush x:Key="MidiSource0Brush" Color="#FF3AA6E0" />
    <SolidColorBrush x:Key="MidiSource1Brush" Color="#FFE88A3A" />
    <SolidColorBrush x:Key="MidiSource2Brush" Color="#FF8B6FE0" />
    <SolidColorBrush x:Key="MidiSource3Brush" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="MidiSource4Brush" Color="#FFE06C93" />
    <SolidColorBrush x:Key="MidiSource5Brush" Color="#FFC9A227" />
    <SolidColorBrush x:Key="MidiSource6Brush" Color="#FF26A69A" />
    <SolidColorBrush x:Key="MidiSource7Brush" Color="#FFB0B8C4" />

    <!-- Font sizes are deliberately absent: the table inherits its size from the list, so the
         zoom control can scale it at runtime. -->
    <Style x:Key="MidiMonitorCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Padding" Value="6,0,6,0" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="MidiMonitorWordTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="MidiMonitorHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Padding" Value="6,0,6,0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
