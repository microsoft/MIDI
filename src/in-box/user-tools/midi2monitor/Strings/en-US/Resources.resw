  </data>
  <data name="CommandLineErrorGroupWithoutEndpoint" xml:space="preserve">
    <value>A group can only be supplied together with an endpoint device id.</value>
  </data>
  <data name="CommandLineErrorChannelWithoutGroup" xml:space="preserve">
    <value>A channel can only be supplied together with a group.</value>
  </data>
  <data name="CommandLineErrorGeneral" xml:space="preserve">
    <value>The command line could not be read.</value>
  </data>

