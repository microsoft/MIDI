<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midinetworksetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midinetworksetup"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <!-- The button before a setting on a card ("Speed...", "Ports..."). A button rather than
                 a link: a link takes the accent color, which can be close to the text color, and
                 it was lost in the text. One width for all of them, the widest label's
                 ("Adapter..."), so they line up. At the top of their row, with their text at the
                 top of the padding: the setting's text gets the same border and padding around it,
                 so both are rounded alike and share a baseline. -->
            <Style x:Key="RowChangeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,2,10,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="76" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint"
                Grid.Row="0"
                Grid.RowSpan="2"
                Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Network Setup"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <!-- A shape, not a Border: a Border snaps its corner radius to whole pixels
                     along with its bounds, so at 125% scaling the arc comes out stepped. -->
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ================================= Navigation ================================= -->
        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="220"
                        PaneDisplayMode="Left"
                        SelectionChanged="OnNavigationSelectionChanged">
            <!-- In a narrow window the pane folds behind its menu button, and the header is only
                 there to give that button a row (set in code). The template would put the header
                 44 below the top in a large title font; it only needs the button's height. -->
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewMinimalHeaderMargin">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!-- The headers and the RTP-MIDI items are shown in code, and only when the
                     RTP-MIDI transport is installed. Without it the list reads as it always has. -->
                <NavigationViewItemHeader x:Name="NetworkMidi2NavigationHeader"
                                          x:Uid="NetworkMidi2NavigationHeader"
                                          Content="Network MIDI 2.0"
                                          Visibility="Collapsed" />
                <NavigationViewItem x:Name="RemoteHostsNavigationItem"
                                    x:Uid="RemoteHostsNavigationItem"
                                    Content="Network devices"
                                    Tag="remote">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LocalHostsNavigationItem"
                                    x:Uid="LocalHostsNavigationItem"
                                    Content="This PC"
                                    Tag="local">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavigationItem"
                                    x:Uid="SettingsNavigationItem"
                                    Content="Transport settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="RtpNavigationHeader"
                                          x:Uid="RtpNavigationHeader"
                                          Content="RTP-MIDI"
                                          Visibility="Collapsed" />
                <NavigationViewItem x:Name="RtpRemoteHostsNavigationItem"
                                    x:Uid="RtpRemoteHostsNavigationItem"
                                    Content="Network devices"
                                    Tag="rtp-remote"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RtpLocalHostsNavigationItem"
                                    x:Uid="RtpLocalHostsNavigationItem"
                                    Content="This PC"
                                    Tag="rtp-local"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- The firewall is about the MIDI service, not either transport, so it sits apart -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="FirewallNavigationItem"
                                    x:Uid="FirewallNavigationItem"
                                    Content="Firewall"
                                    Tag="firewall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shown only while the notifications app is not running. Nothing on this PC
                     watches for a device asking to connect unless the customer has asked for it,
                     so this explains what they are missing and offers to turn it on. The message
                     is set in code, because it depends on whether MIDI Settings is installed. -->
                <InfoBar x:Name="NotificationsBar"
                         x:Uid="NotificationsBar"
                         Grid.Row="0"
                         Severity="Informational"
                         IsOpen="False"
                         IsClosable="True"
                         Title="You will not be told when a device asks to connect"
                         CloseButtonClick="OnNotificationsBarCloseClick"
                         Margin="16,12,16,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="NotificationsBarButton"
                                x:Uid="NotificationsBarButton"
                                Content="Set up notifications"
                                Click="OnNotificationsBarButtonClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Time sensitive: someone is waiting on the customer to decide, so this sits
                     above both pages rather than inside either one -->
                <InfoBar x:Name="PendingInvitationsBar"
                         x:Uid="PendingInvitationsBar"
                         Grid.Row="1"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Title="Devices are waiting for permission"
                         Margin="16,12,16,0">
                    <InfoBar.Content>
                        <ItemsControl x:Name="PendingInvitationsList" Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PendingInvitationItem">
                                    <Grid Margin="0,0,0,10" ColumnSpacing="12"
                                          AutomationProperties.Name="{x:Bind Headline, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Headline, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button x:Uid="AllowOnceButton"
                                                    Content="Allow once"
                                                    Click="OnAllowInvitationOnceClick" />
                                            <Button x:Uid="AllowAlwaysButton"
                                                    Content="Always allow"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Click="OnAllowInvitationAlwaysClick" />
                                            <Button x:Uid="DenyOnceButton"
                                                    Content="Deny"
                                                    Click="OnDenyInvitationOnceClick" />
                                            <Button x:Uid="BlockButton"
                                                    Content="Block"
                                                    Click="OnBlockInvitationClick" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </InfoBar.Content>
                </InfoBar>

                <Grid Grid.Row="2">
                <!-- Shown instead of everything else when neither transport is usable -->
                <InfoBar x:Name="TransportUnavailableBar"
                         x:Uid="TransportUnavailableBar"
                         VerticalAlignment="Top"
                         Margin="16,12,16,12"
                         Canvas.ZIndex="1"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="False"
                         Title="Network MIDI is not available"
                         Message="A compatible version of Network MIDI 2.0 or RTP-MIDI is either not installed or not enabled on this PC." />

                <!-- ========================== Page 1: network devices ========================== -->
                <Grid x:Name="RemoteHostsPanel" Margin="16,8,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Uid="RemoteHostsHeader"
                                       Text="Network MIDI 2.0 devices"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="RemoteHostsDescription"
                                       Text="Devices found on your network, and the ones this PC is connected to."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- The devices and the Connect by address form scroll together, so the form always
                         comes after the last device, and a short window scrolls the page rather than
                         squeezing the list. The scroll bar sits in the page's right margin, clear of the
                         cards. -->
                    <ScrollViewer x:Name="RemoteHostsScroller"
                                  Grid.Row="1"
                                  Margin="0,0,-16,0"
                                  Padding="0,0,16,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ListView x:Name="RemoteHostsListView"
                                      x:Uid="RemoteHostsListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,4,0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RemoteHostItem">
                                        <Border Style="{StaticResource CardBorderStyle}"
                                                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                            <StackPanel Spacing="6">
                                                <!-- The details take what the buttons and the graph under them leave.
                                                     In a narrow window the graph and the address give way
                                                     (PageLayout); what can be acted on stays. -->
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- level with the name, not the middle of the details -->
                                                    <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <FontIcon Glyph="&#xE968;"
                                                                  FontSize="20" />
                                                        <!-- NetworkConnectedCheckmark is drawn as a badge in the
                                                             lower right of its own box, so it overlays without offsets -->
                                                        <FontIcon Glyph="&#xF386;"
                                                                  FontSize="20"
                                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                  Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>

                                                    <!-- The settings, under the details: each button before what it changes, well away
                                                         from the card's own buttons at the top right. -->
                                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                                        <!-- The value and the way to change it sit together on the row,
                                                             so the speed is not hidden in Details. The text wraps beside
                                                             the button, never under it. -->
                                                        <Grid ColumnSpacing="12"
                                                              Margin="0,6,0,0"
                                                              Visibility="{x:Bind SendSpeedVisibility, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Uid="ChangeSendSpeedLink"
                                                                    Grid.Column="0"
                                                                    Content="Speed..."
                                                                    Style="{StaticResource RowChangeButtonStyle}"
                                                                    Click="OnChangeRemoteHostSendSpeedClick" />
                                                            <!-- the button's own border and padding, invisible, so this text and the
                                                                 button's are rounded alike and share a baseline at any scale -->
                                                            <Border Grid.Column="1"
                                                                    BorderThickness="0,1,0,1"
                                                                    Padding="0,2,0,3"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                           TextWrapping="Wrap"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- The ports this PC creates when the device doesn't
                                                             describe its own groups, next to the speed for the same reason -->
                                                        <Grid ColumnSpacing="12"
                                                              Margin="0,6,0,0"
                                                              Visibility="{x:Bind Midi1PortsVisibility, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Uid="ChangeMidi1PortsLink"
                                                                    Grid.Column="0"
                                                                    Content="Ports..."
                                                                    Style="{StaticResource RowChangeButtonStyle}"
                                                                    Click="OnChangeRemoteHostMidi1PortsClick" />
                                                            <!-- the button's own border and padding, invisible, so this text and the
                                                                 button's are rounded alike and share a baseline at any scale -->
                                                            <Border Grid.Column="1"
                                                                    BorderThickness="0,1,0,1"
                                                                    Padding="0,2,0,3"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind Midi1PortsText, Mode=OneWay}"
                                                                           TextWrapping="Wrap"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Latency history. The geometry is generated against a
                                                         fixed 360x44 box in RemoteHostItem, so this size must match.
                                                         Not shown in a narrow window. Not indented further.
                                                         Ends at the right, in line with the buttons above it. -->
                                                    <Border Grid.Row="1" Grid.Column="2"
                                                            Margin="0,6,0,0"
                                                            VerticalAlignment="Top"
                                                            Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"
                                                                Spacing="2"
                                                                Visibility="{x:Bind LatencyGraphVisibility, Mode=OneWay}">
                                                        <!-- the scale sits above the plot rather than inside it,
                                                             because the trace reaches the top of the box by design -->
                                                        <TextBlock Text="{x:Bind LatencyPeakText, Mode=OneWay}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,2,0"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                                        <Border Width="360"
                                                                Height="44"
                                                                HorizontalAlignment="Right"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderThickness="1"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                            <Grid>
                                                                <Polygon Points="{x:Bind LatencyFillPoints, Mode=OneWay}"
                                                                         Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                         Opacity="0.45" />
                                                                <Polyline Points="{x:Bind LatencyLinePoints, Mode=OneWay}"
                                                                          Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round" />
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                                   HorizontalAlignment="Right"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Top">
                                                        <!-- before the buttons, so the last one ends in line with the card's Details -->
                                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                                      Width="20"
                                                                      Height="20" />
                                                        <Button x:Uid="ConnectButton"
                                                                Content="Connect"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Visibility="{x:Bind ConnectVisibility, Mode=OneWay}"
                                                                Click="OnConnectRemoteHostClick" />
                                                        <Button x:Uid="RetryButton"
                                                                Content="Try again"
                                                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}"
                                                                Click="OnRetryRemoteHostClick" />
                                                        <Button Content="{x:Bind DisconnectLabel, Mode=OneWay}"
                                                                Visibility="{x:Bind DisconnectVisibility, Mode=OneWay}"
                                                                Click="OnDisconnectRemoteHostClick" />
                                                    </StackPanel>
                                                </Grid>

                                                <Expander x:Uid="RemoteHostDetailsExpander"
                                                          Header="Details"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          Background="Transparent"
                                                          BorderThickness="0">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="72"
                                                                Height="72"
                                                                VerticalAlignment="Top"
                                                                Margin="0,4,0,0"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind ImageVisibility, Mode=OneWay}">
                                                            <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                                                   Stretch="Uniform" />
                                                        </Border>

                                                    <Grid Grid.Column="1"
                                                          Margin="0,4,0,4"
                                                          ColumnSpacing="12"
                                                          RowSpacing="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="{x:Bind ProductInstanceIdLabel, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                                   Text="{x:Bind ProductInstanceId, Mode=OneWay}"
                                                                   IsTextSelectionEnabled="True"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />

                                                        <TextBlock x:Uid="AddressesLabel"
                                                                   Grid.Row="1" Grid.Column="0"
                                                                   Text="Addresses"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                                   Text="{x:Bind AddressesText, Mode=OneWay}"
                                                                   IsTextSelectionEnabled="True"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />

                                                        <TextBlock x:Uid="EndpointDeviceIdLabel"
                                                                   Grid.Row="2" Grid.Column="0"
                                                                   Text="MIDI Endpoint"
                                                                   Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                                   Text="{x:Bind EndpointDeviceId, Mode=OneWay}"
                                                                   IsTextSelectionEnabled="True"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                        <!-- These sit against the id rather than at the far right of the row.
                                                             A network endpoint is bidirectional, so Monitor needs no test for
                                                             whether the device sends anything: it always can. -->
                                                        <StackPanel Grid.Row="2" Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Top"
                                                                    Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}">
                                                            <Button x:Uid="CopyEndpointDeviceIdButton"
                                                                    Padding="6,2,6,2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="OnCopyEndpointDeviceIdClick">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                            </Button>
                                                            <Button x:Uid="MonitorEndpointButton"
                                                                    Padding="6,2,6,2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="OnMonitorRemoteHostClick">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                                                    <TextBlock x:Uid="MonitorEndpointButtonText" Text="Monitor" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>

                                                        <TextBlock x:Uid="RemoteHostNotAdvertisedText"
                                                                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="This device is no longer being advertised on the network."
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{x:Bind NotAdvertisedVisibility, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                        <Button x:Uid="ReassociateButton"
                                                                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                Content="Relink to..."
                                                                Visibility="{x:Bind ReassociateVisibility, Mode=OneWay}"
                                                                Click="OnReassociateRemoteHostClick" />

                                                        <Button x:Uid="CustomizeButton"
                                                                Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                                                Margin="0,8,0,0"
                                                                HorizontalAlignment="Left"
                                                                Content="Customize..."
                                                                Visibility="{x:Bind CustomizeVisibility, Mode=OneWay}"
                                                                Click="OnCustomizeRemoteHostClick" />
                                                    </Grid>
                                                    </Grid>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="NoRemoteHostsText"
                                       x:Uid="NoRemoteHostsText"
                                       Text="Looking for Network MIDI 2.0 devices..."
                                       Margin="0,24,0,24"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Expander x:Name="ManualConnectExpander"
                                      x:Uid="ManualConnectExpander"
                                      Header="Connect to a device by address"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Expanding="OnManualConnectExpanding"
                                      SizeChanged="OnManualConnectFormSizeChanged">
                                <StackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock x:Uid="ManualConnectDescription"
                                               Text="Use this when a device is not advertised on your network. Windows will keep the entry and try again later if the device is not answering now."
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!-- Two columns at any width, so no header wraps and the boxes stay the
                                         same height. The address, the port and Connect read like an address
                                         bar; the names and the speed come in pairs below. -->
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="ManualAddressTextBox"
                                                     x:Uid="ManualAddressTextBox"
                                                     Grid.Column="0"
                                                     Header="Host name or IP address"
                                                     PlaceholderText="192.168.1.100"
                                                     TextChanged="OnManualConnectFieldChanged" />

                                            <NumberBox x:Name="ManualPortNumberBox"
                                                       x:Uid="ManualPortNumberBox"
                                                       Grid.Column="1"
                                                       Header="Port"
                                                       Width="120"
                                                       Minimum="1"
                                                       Maximum="65535"
                                                       Value="5004"
                                                       SpinButtonPlacementMode="Hidden"
                                                       ValueChanged="OnManualConnectPortChanged" />

                                            <Button x:Name="ManualConnectButton"
                                                    x:Uid="ManualConnectButton"
                                                    Grid.Column="2"
                                                    Content="Connect"
                                                    VerticalAlignment="Bottom"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="OnManualConnectClick" />
                                        </Grid>

                                        <TextBox x:Name="ManualNameTextBox"
                                                 x:Uid="ManualNameTextBox"
                                                 Grid.Row="1" Grid.Column="0"
                                                 Margin="0,4,0,0"
                                                 Header="Name that device will see"
                                                 TextChanged="OnManualConnectFieldChanged" />

                                        <TextBox x:Name="ManualCustomNameTextBox"
                                                 x:Uid="ManualCustomNameTextBox"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Margin="0,4,0,0"
                                                 Header="Name to show in Windows"
                                                 PlaceholderText="Optional" />

                                        <ComboBox x:Name="ManualSendSpeedLimitComboBox"
                                                  x:Uid="SendSpeedLimitComboBox"
                                                  Grid.Row="2" Grid.Column="0"
                                                  Margin="0,4,0,0"
                                                  Header="Sending speed"
                                                  HorizontalAlignment="Stretch" />

                                        <CheckBox x:Name="ManualReduceSendSpeedCheckBox"
                                                  x:Uid="ReduceSendSpeedCheckBox"
                                                  Grid.Row="2" Grid.Column="1"
                                                  VerticalAlignment="Bottom"
                                                  Content="Slow down when a device misses data" />

                                        <TextBlock x:Uid="SendSpeedLimitHelp"
                                                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <TextBlock x:Uid="ReduceSendSpeedHelp"
                                                   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="When a device asks for data again, Windows sends more slowly, down to MIDI 1.0 wire speed. It speeds back up once the device stops asking."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <CheckBox x:Name="ManualSkipInBetweenValuesCheckBox"
                                                  x:Uid="SkipInBetweenValuesCheckBox"
                                                  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,8,0,0"
                                                  Content="Skip in-between values to catch up"
                                                  IsChecked="True" />

                                        <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                                   Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <!-- Network MIDI 2.0, on a transport which can name ports -->
                                    <StackPanel x:Name="ManualConnectMidi1PortsPanel"
                                                Spacing="4"
                                                Margin="0,8,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="ManualConnectMidi1PortsText" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <Button x:Uid="CustomizeMidi1PortsButton"
                                                Content="Customize groups and MIDI 1.0 ports"
                                                Click="OnManualConnectMidi1PortsClick" />
                                        <TextBlock x:Uid="ConnectMidi1PortsHelp"
                                                   Text="Only used when the device doesn't describe its own groups, such as another Windows PC."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="RemoteStatusText"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- =========================== Page 2: hosts on this PC ========================= -->
                <Grid x:Name="LocalHostsPanel" Margin="16,8,16,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Uid="LocalHostsHeader"
                                       Text="Network MIDI 2.0 hosts on this PC"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="LocalHostsDescription"
                                       Text="A host lets other devices on your network connect to this PC. Most people need only one."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Name="CreateHostButton"
                                x:Uid="CreateHostButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnCreateHostClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Uid="CreateHostButtonText" Text="Create host" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="LocalHostsListView"
                              x:Uid="LocalHostsListView"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LocalHostItem">
                                <Border Style="{StaticResource CardBorderStyle}"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE977;"
                                                      FontSize="20"
                                                      VerticalAlignment="Top"
                                                      Margin="0,2,0,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ConnectionCountText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <!-- Network MIDI 2.0: why a device which already has a session with this PC was turned away -->
                                                <TextBlock Text="{x:Bind RefusalsText, Mode=OneWay}"
                                                           Visibility="{x:Bind RefusalsVisibility, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>

                                            <!-- The settings, under the details: each button before what it changes, well away
                                                 from the card's own buttons at the top right. -->
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <!-- On the card rather than in Details, so it is easy to find -->
                                                <Grid ColumnSpacing="12"
                                                      Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Uid="ChangeHostSendSpeedLink"
                                                            Grid.Column="0"
                                                            Content="Speed..."
                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                            Click="OnChangeHostSendSpeedClick" />
                                                    <!-- the button's own border and padding, invisible, so this text and the
                                                         button's are rounded alike and share a baseline at any scale -->
                                                    <Border Grid.Column="1"
                                                            BorderThickness="0,1,0,1"
                                                            Padding="0,2,0,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- What each device gets unless it has ports of its own.
                                                     Not named here: every device would get the same names. -->
                                                <Grid ColumnSpacing="12"
                                                      Margin="0,6,0,0"
                                                      Visibility="{x:Bind Midi1PortsVisibility, Mode=OneWay}">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Uid="ChangeMidi1PortsLink"
                                                            Grid.Column="0"
                                                            Content="Ports..."
                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                            Click="OnChangeHostMidi1PortsClick" />
                                                    <!-- the button's own border and padding, invisible, so this text and the
                                                         button's are rounded alike and share a baseline at any scale -->
                                                    <Border Grid.Column="1"
                                                            BorderThickness="0,1,0,1"
                                                            Padding="0,2,0,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind Midi1PortsText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Top">
                                                <!-- before the buttons, so the last one ends in line with the card's Details -->
                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Width="20"
                                                              Height="20" />
                                                <Button Content="{x:Bind StartStopLabel, Mode=OneWay}"
                                                        Click="OnStartStopHostClick" />
                                                <Button x:Uid="DeleteHostButton"
                                                        Content="Delete"
                                                        Click="OnDeleteHostClick" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Stays until the adapter is back or another is chosen, so it cannot be closed -->
                                        <InfoBar Severity="Warning"
                                                 IsClosable="False"
                                                 IsOpen="{x:Bind IsNetworkAdapterWarningOpen, Mode=OneWay}"
                                                 Message="{x:Bind NetworkAdapterWarningText, Mode=OneWay}">
                                            <InfoBar.ActionButton>
                                                <Button x:Uid="ChooseHostAdapterButton"
                                                        Content="Choose adapter"
                                                        Tag="{x:Bind}"
                                                        Click="OnChangeHostAdapterClick" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>

                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="NoConnectedDevicesText"
                                                       Text="No devices are connected to this host."
                                                       Visibility="{x:Bind NoConnectionsVisibility, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <ItemsControl ItemsSource="{x:Bind Connections, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:HostConnectionItem">
                                                        <Border Margin="0,0,0,6"
                                                                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                                Padding="10,6,10,6"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderThickness="1"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" MinWidth="120" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                <FontIcon Glyph="&#xE968;"
                                                                          FontSize="18" />
                                                                <!-- NetworkConnectedCheckmark badges itself into the lower
                                                                     right of its own box, so it needs no offset -->
                                                                <FontIcon Glyph="&#xF386;"
                                                                          FontSize="18"
                                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                          Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}" />
                                                            </Grid>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                           TextWrapping="Wrap"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>

                                                            <!-- The settings, under the details: each button before what it changes, well away
                                                                 from the card's own buttons at the top right. -->
                                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                                <Grid ColumnSpacing="12"
                                                                      Margin="0,6,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button x:Uid="ChangeSendSpeedLink"
                                                                            Grid.Column="0"
                                                                            Content="Speed..."
                                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                                            Visibility="{x:Bind ChangeSendSpeedVisibility, Mode=OneWay}"
                                                                            Click="OnChangeRemoteClientSendSpeedClick" />
                                                                    <!-- the button's own border and padding, invisible, so this text and the
                                                                         button's are rounded alike and share a baseline at any scale -->
                                                                    <Border Grid.Column="1"
                                                                            BorderThickness="0,1,0,1"
                                                                            Padding="0,2,0,3"
                                                                            VerticalAlignment="Top">
                                                                        <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                                   TextWrapping="Wrap"
                                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                </Grid>

                                                                <!-- Like the speed, the host's or this device's own -->
                                                                <Grid ColumnSpacing="12"
                                                                      Margin="0,6,0,0"
                                                                      Visibility="{x:Bind Midi1PortsVisibility, Mode=OneWay}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button x:Uid="ChangeMidi1PortsLink"
                                                                            Grid.Column="0"
                                                                            Content="Ports..."
                                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                                            Visibility="{x:Bind ChangeMidi1PortsVisibility, Mode=OneWay}"
                                                                            Click="OnChangeRemoteClientMidi1PortsClick" />
                                                                    <!-- the button's own border and padding, invisible, so this text and the
                                                                         button's are rounded alike and share a baseline at any scale -->
                                                                    <Border Grid.Column="1"
                                                                            BorderThickness="0,1,0,1"
                                                                            Padding="0,2,0,3"
                                                                            VerticalAlignment="Top">
                                                                        <TextBlock Text="{x:Bind Midi1PortsText, Mode=OneWay}"
                                                                                   TextWrapping="Wrap"
                                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </StackPanel>

                                                            <!-- Latency history. The geometry is generated against a
                                                                 fixed 240x32 box in HostConnectionItem, so this must match.
                                                                 Ends at the right, in line with the buttons above it. -->
                                                            <Border Grid.Row="1" Grid.Column="2"
                                                                    Margin="0,6,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}">
                                                            <StackPanel VerticalAlignment="Center"
                                                                        HorizontalAlignment="Right"
                                                                        Spacing="2"
                                                                        Visibility="{x:Bind LatencyGraphVisibility, Mode=OneWay}">
                                                                <TextBlock Text="{x:Bind LatencyPeakText, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           Margin="0,0,2,0"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                                                <Border Width="240"
                                                                        Height="32"
                                                                        HorizontalAlignment="Right"
                                                                        CornerRadius="4"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                                    <Grid>
                                                                        <Polygon Points="{x:Bind LatencyFillPoints, Mode=OneWay}"
                                                                                 Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                                 Opacity="0.45" />
                                                                        <Polyline Points="{x:Bind LatencyLinePoints, Mode=OneWay}"
                                                                                  Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                  StrokeThickness="1.5"
                                                                                  StrokeLineJoin="Round" />
                                                                    </Grid>
                                                                </Border>

                                                                <TextBlock Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>
                                                            </Border>

                                                            <StackPanel Grid.Column="2"
                                                                        HorizontalAlignment="Right"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Top">
                                                                <Button x:Uid="MonitorEndpointButton"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Visibility="{x:Bind MonitorVisibility, Mode=OneWay}"
                                                                        Click="OnMonitorHostConnectionClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                                                        <TextBlock x:Uid="MonitorEndpointButtonText" Text="Monitor" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button x:Uid="DisconnectRemoteClientButton"
                                                                        Content="Disconnect"
                                                                        Click="OnDisconnectRemoteClientClick" />
                                                                <Button x:Uid="BlockRemoteClientButton"
                                                                        Content="Block"
                                                                        Click="OnBlockRemoteClientClick" />
                                                            </StackPanel>
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Expander x:Uid="RememberedDevicesExpander"
                                                  Header="Remembered decisions"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind KnownClientsVisibility, Mode=OneWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <StackPanel Spacing="4" Margin="0,4,0,4">
                                                <ItemsControl ItemsSource="{x:Bind KnownClients, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:KnownClientItem">
                                                            <Grid ColumnSpacing="12" Margin="0,4,0,4"
                                                                  AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind DecisionText}"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <Button Grid.Column="1"
                                                                        x:Uid="ForgetClientButton"
                                                                        Content="Forget"
                                                                        VerticalAlignment="Center"
                                                                        Click="OnForgetKnownClientClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Kept like the decisions above, so a device which is away
                                             keeps its settings and they can still be changed here. A
                                             device can have its own speed, its own MIDI 1.0 ports, or both. -->
                                        <Expander x:Uid="RemoteClientSettingsExpander"
                                                  Header="Devices with their own settings"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind RemoteClientSpeedsVisibility, Mode=OneWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <StackPanel Spacing="4" Margin="0,4,0,4">
                                                <ItemsControl ItemsSource="{x:Bind RemoteClientSpeeds, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:RemoteClientSpeedItem">
                                                            <Grid ColumnSpacing="12" Margin="0,4,0,4"
                                                                  AutomationProperties.Name="{x:Bind DisplayName}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- Each setting has its own Change, as on the rows above -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>

                                                                <!-- The settings, under the details: each button before what it changes, well away
                                                                     from the card's own buttons at the top right. -->
                                                                <StackPanel Grid.Row="1" Grid.Column="0">
                                                                    <Grid ColumnSpacing="12"
                                                                          Margin="0,6,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                            <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button x:Uid="ChangeSendSpeedLink"
                                                                                Grid.Column="0"
                                                                                Content="Speed..."
                                                                                Style="{StaticResource RowChangeButtonStyle}"
                                                                                Click="OnChangeRemoteClientSpeedEntryClick" />
                                                                        <!-- the button's own border and padding, invisible, so this text and the
                                                                             button's are rounded alike and share a baseline at any scale -->
                                                                        <Border Grid.Column="1"
                                                                                BorderThickness="0,1,0,1"
                                                                                Padding="0,2,0,3"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{x:Bind SendSpeedText}"
                                                                                       TextWrapping="Wrap"
                                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                    <Grid ColumnSpacing="12"
                                                                          Margin="0,6,0,0"
                                                                          Visibility="{x:Bind Midi1PortsVisibility}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                            <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button x:Uid="ChangeMidi1PortsLink"
                                                                                Grid.Column="0"
                                                                                Content="Ports..."
                                                                                Style="{StaticResource RowChangeButtonStyle}"
                                                                                Click="OnChangeRemoteClientMidi1PortsEntryClick" />
                                                                        <!-- the button's own border and padding, invisible, so this text and the
                                                                             button's are rounded alike and share a baseline at any scale -->
                                                                        <Border Grid.Column="1"
                                                                                BorderThickness="0,1,0,1"
                                                                                Padding="0,2,0,3"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{x:Bind Midi1PortsText}"
                                                                                       TextWrapping="Wrap"
                                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- only for a device with a speed of its own -->
                                                                <Button x:Uid="RemoteClientSpeedUseHostButton"
                                                                        Grid.Column="1"
                                                                        Content="Use host's speed"
                                                                        VerticalAlignment="Top"
                                                                        Visibility="{x:Bind UseHostSpeedVisibility}"
                                                                        Click="OnUseHostSpeedForRemoteClientClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="HostDetailsExpander"
                                                  Header="Details"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <Grid Margin="0,4,0,4"
                                                  ColumnSpacing="12"
                                                  RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Uid="ServiceInstanceNameLabel"
                                                           Grid.Row="0" Grid.Column="0"
                                                           Text="Network service name"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{x:Bind ServiceInstanceName, Mode=OneWay}"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <TextBlock x:Uid="HostProductInstanceIdLabel"
                                                           Grid.Row="1" Grid.Column="0"
                                                           Text="Product Instance Id"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind ProductInstanceId, Mode=OneWay}"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <TextBlock x:Uid="HostAddressLabel"
                                                           Grid.Row="2" Grid.Column="0"
                                                           Text="Address"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{x:Bind AddressText, Mode=OneWay}"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <TextBlock x:Uid="HostDetailsPolicyLabel"
                                                           Grid.Row="3" Grid.Column="0"
                                                           Text="New connections"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="3" Grid.Column="1"
                                                           Text="{x:Bind PolicyText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <Border Grid.Row="4" Grid.Column="0"
                                                        BorderThickness="0,1,0,1"
                                                        Padding="0,2,0,3"
                                                        VerticalAlignment="Top">
                                                    <TextBlock x:Uid="HostNetworkAdapterLabel"
                                                               Text="Network adapter"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Row="4" Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="12">
                                                    <!-- the button's border and padding, so the name and the button share a baseline -->
                                                    <Border BorderThickness="0,1,0,1"
                                                            Padding="0,2,0,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind NetworkAdapterText, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Button x:Uid="ChangeHostAdapterLink"
                                                            Content="Adapter..."
                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                            Click="OnChangeHostAdapterClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoLocalHostsText"
                               x:Uid="NoLocalHostsText"
                               Grid.Row="1"
                               Text="This PC does not have a Network MIDI 2.0 host yet. Create one so other devices can connect to it."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="LocalStatusText"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ========================= Page 3: transport settings ========================= -->
                <ScrollViewer x:Name="SettingsPanel"
                              Margin="16,8,16,12"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Spacing="12" Margin="0,0,4,0" MaxWidth="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Uid="SettingsHeader"
                                       Text="Transport settings"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="SettingsDescription"
                                       Text="These apply to every Network MIDI 2.0 host and client on this PC. The defaults suit almost every network, so change them only if you have a reason to."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingMaxHostConnectionsHeader"
                                           x:Name="SettingMaxHostConnectionsHeader"
                                           Text="Most devices allowed at once"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="MaxHostConnectionsDescriptionText"
                                           x:Uid="SettingMaxHostConnectionsDescription"
                                           Text="How many remote devices any one host on this PC will accept at the same time."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="MaxHostConnectionsBox"
                                           AutomationProperties.LabeledBy="{x:Bind SettingMaxHostConnectionsHeader}"
                                           MinWidth="160"
                                           HorizontalAlignment="Left"
                                           SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnTransportSettingChanged" />
                                <TextBlock x:Uid="SettingEffectImmediate"
                                           Text="Takes effect right away. Devices already connected are not disconnected."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingInvitationPendingTimeoutHeader"
                                           x:Name="SettingInvitationPendingTimeoutHeader"
                                           Text="How long to wait for your permission"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="InvitationPendingTimeoutDescriptionText"
                                           x:Uid="SettingInvitationPendingTimeoutDescription"
                                           Text="How long a device asking to connect stays in the waiting list before it is dropped, in milliseconds."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <NumberBox x:Name="InvitationPendingTimeoutBox"
                                               AutomationProperties.LabeledBy="{x:Bind SettingInvitationPendingTimeoutHeader}"
                                               MinWidth="160"
                                               HorizontalAlignment="Left"
                                               SpinButtonPlacementMode="Hidden"
                                               SmallChange="1000"
                                               LargeChange="10000"
                                               ValueChanged="OnTransportSettingChanged" />
                                    <TextBlock x:Name="InvitationPendingTimeoutSecondsText"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Uid="SettingEffectNextRequest"
                                           Text="Applies to the next device which asks to connect. Devices already waiting keep the old timeout."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingScanIntervalHeader"
                                           x:Name="SettingScanIntervalHeader"
                                           Text="How often to retry a device which is not answering"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="DirectConnectionScanIntervalDescriptionText"
                                           x:Uid="SettingScanIntervalDescription"
                                           Text="How often this PC tries again, in milliseconds, to reach a device you connected to by address while it is not answering."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <NumberBox x:Name="DirectConnectionScanIntervalBox"
                                               AutomationProperties.LabeledBy="{x:Bind SettingScanIntervalHeader}"
                                               MinWidth="160"
                                               HorizontalAlignment="Left"
                                               SpinButtonPlacementMode="Hidden"
                                               SmallChange="1000"
                                               LargeChange="10000"
                                               ValueChanged="OnTransportSettingChanged" />
                                    <TextBlock x:Name="DirectConnectionScanIntervalSecondsText"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Uid="SettingEffectNextScan"
                                           Text="Takes effect within one retry, so up to the old interval from now."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingPingIntervalHeader"
                                           x:Name="SettingPingIntervalHeader"
                                           Text="How often to check a quiet connection"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="OutboundPingIntervalDescriptionText"
                                           x:Uid="SettingPingIntervalDescription"
                                           Text="How often a connection with nothing to send checks that the other end is still there, in milliseconds. Shorter notices a dropped device sooner and sends slightly more network traffic."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <NumberBox x:Name="OutboundPingIntervalBox"
                                               AutomationProperties.LabeledBy="{x:Bind SettingPingIntervalHeader}"
                                               MinWidth="160"
                                               HorizontalAlignment="Left"
                                               SpinButtonPlacementMode="Hidden"
                                               SmallChange="250"
                                               LargeChange="1000"
                                               ValueChanged="OnTransportSettingChanged" />
                                    <TextBlock x:Name="OutboundPingIntervalSecondsText"
                                               VerticalAlignment="Center"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Uid="SettingEffectWithinOneInterval"
                                           Text="Reaches connections which are already open within one interval."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingFecPacketsHeader"
                                           x:Name="SettingFecPacketsHeader"
                                           Text="Repeated messages per packet"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="MaxFecPacketsDescriptionText"
                                           x:Uid="SettingFecPacketsDescription"
                                           Text="How many recently sent messages are repeated in each network packet, so a lost packet can be recovered without asking for it again. Higher values cope better with an unreliable network and make each packet larger."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="MaxFecPacketsBox"
                                           AutomationProperties.LabeledBy="{x:Bind SettingFecPacketsHeader}"
                                           MinWidth="160"
                                           HorizontalAlignment="Left"
                                           SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnTransportSettingChanged" />
                                <TextBlock x:Uid="SettingEffectNewConnections"
                                           Text="Applies to new connections. Reconnect a device for it to take effect there."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="SettingRetransmitBufferHeader"
                                           x:Name="SettingRetransmitBufferHeader"
                                           Text="Messages kept for resending"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="MaxRetransmitBufferDescriptionText"
                                           x:Uid="SettingRetransmitBufferDescription"
                                           Text="How many sent messages are held on to in case the other end asks for them again. Higher values recover from longer gaps and use more memory per connection."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <NumberBox x:Name="MaxRetransmitBufferBox"
                                           AutomationProperties.LabeledBy="{x:Bind SettingRetransmitBufferHeader}"
                                           MinWidth="160"
                                           HorizontalAlignment="Left"
                                           SpinButtonPlacementMode="Hidden"
                                           SmallChange="10"
                                           LargeChange="100"
                                           ValueChanged="OnTransportSettingChanged" />
                                <TextBlock x:Uid="SettingEffectNewConnections2"
                                           Text="Applies to new connections. Reconnect a device for it to take effect there."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="RestoreSettingDefaultsButton"
                                    x:Uid="RestoreSettingDefaultsButton"
                                    Content="Restore defaults"
                                    Click="OnRestoreTransportSettingDefaultsClick" />
                            <TextBlock x:Name="SettingsStatusText"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ====================== Page 4: RTP-MIDI network devices ====================== -->
                <Grid x:Name="RtpRemoteHostsPanel" Margin="16,8,16,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Uid="RtpRemoteHostsHeader"
                                   Text="RTP-MIDI devices"
                                   Style="{StaticResource SectionHeaderTextStyle}" />
                        <TextBlock x:Uid="RtpRemoteHostsDescription"
                                   Text="RTP-MIDI sessions found on your network, and the ones this PC is connected to. Apple devices and many network MIDI interfaces use RTP-MIDI."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Scrolls as one, like the Network MIDI 2.0 devices page -->
                    <ScrollViewer x:Name="RtpRemoteHostsScroller"
                                  Grid.Row="1"
                                  Margin="0,0,-16,0"
                                  Padding="0,0,16,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ListView x:Name="RtpRemoteHostsListView"
                                      x:Uid="RtpRemoteHostsListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,4,0,4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:RtpRemoteHostItem">
                                        <Border Style="{StaticResource CardBorderStyle}"
                                                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" MinWidth="140" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <FontIcon Glyph="&#xE968;"
                                                                  FontSize="20" />
                                                        <FontIcon Glyph="&#xF386;"
                                                                  FontSize="20"
                                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                  Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>

                                                    <!-- The settings, under the details: each button before what it changes, well away
                                                         from the card's own buttons at the top right. -->
                                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                                        <Grid ColumnSpacing="12"
                                                              Margin="0,6,0,0"
                                                              Visibility="{x:Bind SendSpeedVisibility, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Uid="ChangeSendSpeedLink"
                                                                    Grid.Column="0"
                                                                    Content="Speed..."
                                                                    Style="{StaticResource RowChangeButtonStyle}"
                                                                    Click="OnChangeRtpRemoteHostSendSpeedClick" />
                                                            <!-- the button's own border and padding, invisible, so this text and the
                                                                 button's are rounded alike and share a baseline at any scale -->
                                                            <Border Grid.Column="1"
                                                                    BorderThickness="0,1,0,1"
                                                                    Padding="0,2,0,3"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                           TextWrapping="Wrap"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <!-- a line without a button starts where the labels do -->
                                                        <Grid ColumnSpacing="12"
                                                              Margin="0,6,0,0"
                                                              Visibility="{x:Bind NetworkMidi2Visibility, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Uid="RtpAlsoNetworkMidi2Text"
                                                                       Grid.Column="1"
                                                                       Text="This device also offers Network MIDI 2.0, which is the better choice when a device supports both."
                                                                       TextWrapping="Wrap"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- The geometry is generated against a fixed 360x44 box in
                                                         RtpRemoteHostItem, so this size must match.
                                                         Ends at the right, in line with the buttons above it. -->
                                                    <Border Grid.Row="1" Grid.Column="2"
                                                            Margin="0,6,0,0"
                                                            VerticalAlignment="Top"
                                                            Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"
                                                                Spacing="2"
                                                                Visibility="{x:Bind LatencyGraphVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind LatencyPeakText, Mode=OneWay}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,2,0"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                                        <Border Width="360"
                                                                Height="44"
                                                                HorizontalAlignment="Right"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderThickness="1"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                            <Grid>
                                                                <Polygon Points="{x:Bind LatencyFillPoints, Mode=OneWay}"
                                                                         Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                         Opacity="0.45" />
                                                                <Polyline Points="{x:Bind LatencyLinePoints, Mode=OneWay}"
                                                                          Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                          StrokeThickness="1.5"
                                                                          StrokeLineJoin="Round" />
                                                            </Grid>
                                                        </Border>

                                                        <TextBlock Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                                   HorizontalAlignment="Right"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    </Border>

                                                    <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Top">
                                                        <!-- before the buttons, so the last one ends in line with the card's Details -->
                                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                                      Width="20"
                                                                      Height="20" />
                                                        <Button x:Uid="ConnectButton"
                                                                Content="Connect"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Visibility="{x:Bind ConnectVisibility, Mode=OneWay}"
                                                                Click="OnConnectRtpRemoteHostClick" />
                                                        <Button x:Uid="RetryButton"
                                                                Content="Try again"
                                                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}"
                                                                Click="OnRetryRtpRemoteHostClick" />
                                                        <Button Content="{x:Bind DisconnectLabel, Mode=OneWay}"
                                                                Visibility="{x:Bind DisconnectVisibility, Mode=OneWay}"
                                                                Click="OnDisconnectRtpRemoteHostClick" />
                                                    </StackPanel>
                                                </Grid>

                                                <Expander x:Uid="RemoteHostDetailsExpander"
                                                          Header="Details"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          Background="Transparent"
                                                          BorderThickness="0">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="72"
                                                                Height="72"
                                                                VerticalAlignment="Top"
                                                                Margin="0,4,0,0"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind ImageVisibility, Mode=OneWay}">
                                                            <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                                                   Stretch="Uniform" />
                                                        </Border>

                                                        <Grid Grid.Column="1"
                                                              Margin="0,4,0,4"
                                                              ColumnSpacing="12"
                                                              RowSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <TextBlock x:Uid="RtpHostNameLabel"
                                                                       Grid.Row="0" Grid.Column="0"
                                                                       Text="Host name"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                                       Text="{x:Bind HostName, Mode=OneWay}"
                                                                       IsTextSelectionEnabled="True"
                                                                       TextWrapping="Wrap"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}" />

                                                            <TextBlock x:Uid="AddressesLabel"
                                                                       Grid.Row="1" Grid.Column="0"
                                                                       Text="Addresses"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                                       Text="{x:Bind AddressesText, Mode=OneWay}"
                                                                       IsTextSelectionEnabled="True"
                                                                       TextWrapping="Wrap"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}" />

                                                            <TextBlock x:Uid="EndpointDeviceIdLabel"
                                                                       Grid.Row="2" Grid.Column="0"
                                                                       Text="MIDI Endpoint"
                                                                       Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                                       Text="{x:Bind EndpointDeviceId, Mode=OneWay}"
                                                                       IsTextSelectionEnabled="True"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                                            <StackPanel Grid.Row="2" Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        VerticalAlignment="Top"
                                                                        Visibility="{x:Bind EndpointDeviceIdVisibility, Mode=OneWay}">
                                                                <Button x:Uid="CopyEndpointDeviceIdButton"
                                                                        Padding="6,2,6,2"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="OnCopyRtpEndpointDeviceIdClick">
                                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                                </Button>
                                                                <Button x:Uid="MonitorEndpointButton"
                                                                        Padding="6,2,6,2"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="OnMonitorRtpRemoteHostClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                                                        <TextBlock x:Uid="MonitorEndpointButtonText" Text="Monitor" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>

                                                            <TextBlock x:Uid="RemoteHostNotAdvertisedText"
                                                                       Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                                       Text="This device is no longer being advertised on the network."
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{x:Bind NotAdvertisedVisibility, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                            <!-- Same choices as Bluetooth MIDI, without "Use default": RTP-MIDI has no
                                                                 setting for the whole transport -->
                                                            <TextBlock x:Uid="OfflineRetentionLabel"
                                                                       Grid.Row="4" Grid.Column="0"
                                                                       Text="Keep endpoint when offline"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{x:Bind OfflineRetentionVisibility, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{x:Bind OfflineRetentionVisibility, Mode=OneWay}">
                                                                <ComboBox x:Uid="OfflineRetentionCombo"
                                                                          MinWidth="170"
                                                                          SelectedIndex="{x:Bind OfflineRetentionIndex, Mode=OneWay}"
                                                                          SelectionChanged="OnRtpOfflineRetentionChanged">
                                                                    <ComboBoxItem x:Uid="OfflineRetentionAlwaysItem" Content="Always" />
                                                                    <ComboBoxItem x:Uid="OfflineRetentionImmediateItem" Content="Remove immediately" />
                                                                    <ComboBoxItem x:Uid="OfflineRetention30SecondsItem" Content="After 30 seconds" />
                                                                    <ComboBoxItem x:Uid="OfflineRetention5MinutesItem" Content="After 5 minutes" />
                                                                </ComboBox>
                                                                <!-- a duration set some other way shows no selection, so it only appears here -->
                                                                <TextBlock Text="{x:Bind OfflineRetentionText, Mode=OneWay}"
                                                                           VerticalAlignment="Center"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>

                                                            <Button x:Uid="CustomizeButton"
                                                                    Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                                                    Margin="0,8,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Content="Customize..."
                                                                    Visibility="{x:Bind CustomizeVisibility, Mode=OneWay}"
                                                                    Click="OnCustomizeRtpRemoteHostClick" />
                                                        </Grid>
                                                    </Grid>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock x:Name="NoRtpRemoteHostsText"
                                       x:Uid="NoRtpRemoteHostsText"
                                       Text="Looking for RTP-MIDI devices..."
                                       Margin="0,24,0,24"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <Expander x:Name="RtpManualConnectExpander"
                                      x:Uid="ManualConnectExpander"
                                      Header="Connect to a device by address"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Expanding="OnManualConnectExpanding"
                                      SizeChanged="OnManualConnectFormSizeChanged">
                                <StackPanel Spacing="8" Margin="0,4,0,4">
                                    <TextBlock x:Uid="ManualConnectDescription"
                                               Text="Use this when a device is not advertised on your network. Windows will keep the entry and try again later if the device is not answering now."
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <!-- The same two columns as the Network MIDI 2.0 form -->
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="RtpManualAddressTextBox"
                                                     x:Uid="ManualAddressTextBox"
                                                     Grid.Column="0"
                                                     Header="Host name or IP address"
                                                     PlaceholderText="192.168.1.100"
                                                     TextChanged="OnRtpManualConnectFieldChanged" />

                                            <!-- RTP-MIDI also uses the port after this one, so 65535 cannot be one -->
                                            <NumberBox x:Name="RtpManualPortNumberBox"
                                                       x:Uid="ManualPortNumberBox"
                                                       Grid.Column="1"
                                                       Header="Port"
                                                       Width="120"
                                                       Minimum="1024"
                                                       Maximum="65534"
                                                       Value="5004"
                                                       SpinButtonPlacementMode="Hidden"
                                                       ValueChanged="OnRtpManualConnectPortChanged" />

                                            <Button x:Name="RtpManualConnectButton"
                                                    x:Uid="ManualConnectButton"
                                                    Grid.Column="2"
                                                    Content="Connect"
                                                    VerticalAlignment="Bottom"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    IsEnabled="False"
                                                    Click="OnRtpManualConnectClick" />
                                        </Grid>

                                        <TextBox x:Name="RtpManualNameTextBox"
                                                 x:Uid="RtpManualNameTextBox"
                                                 Grid.Row="1" Grid.Column="0"
                                                 Margin="0,4,0,0"
                                                 Header="Name that device will see"
                                                 PlaceholderText="This PC's name" />

                                        <TextBox x:Name="RtpManualCustomNameTextBox"
                                                 x:Uid="ManualCustomNameTextBox"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Margin="0,4,0,0"
                                                 Header="Name to show in Windows"
                                                 PlaceholderText="Optional" />

                                        <!-- RTP-MIDI cannot tell that a device missed data, so there is
                                             no choice to slow down by itself -->
                                        <ComboBox x:Name="RtpManualSendSpeedLimitComboBox"
                                                  x:Uid="SendSpeedLimitComboBox"
                                                  Grid.Row="2" Grid.Column="0"
                                                  Margin="0,4,0,0"
                                                  Header="Sending speed"
                                                  HorizontalAlignment="Stretch" />

                                        <TextBlock x:Uid="SendSpeedLimitHelp"
                                                   Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <TextBlock x:Uid="RtpNoReduceSendSpeedHelp"
                                                   Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="Windows can't slow down by itself for RTP-MIDI devices, because they don't tell this PC when they miss data."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <CheckBox x:Name="RtpManualSkipInBetweenValuesCheckBox"
                                                  x:Uid="SkipInBetweenValuesCheckBox"
                                                  Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,8,0,0"
                                                  Content="Skip in-between values to catch up"
                                                  IsChecked="True" />

                                        <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                                   Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <CheckBox x:Name="RtpManualSendRecoveryJournalCheckBox"
                                                  x:Uid="RtpSendRecoveryJournalCheckBox"
                                                  Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                                  Margin="0,8,0,0"
                                                  Content="Help other devices recover notes lost on the network"
                                                  IsChecked="True" />

                                        <TextBlock x:Uid="RtpSendRecoveryJournalHelp"
                                                   Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                                                   Text="Each packet carries a short summary of recent notes, so a device that misses a packet can still end a note that would otherwise hang. Turn this off only for a device that plays extra notes, or notes that don't stop, while this is on."
                                                   TextWrapping="Wrap"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock x:Name="RtpRemoteStatusText"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ======================== Page 5: RTP-MIDI hosts on this PC ======================= -->
                <Grid x:Name="RtpLocalHostsPanel" Margin="16,8,16,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Uid="RtpLocalHostsHeader"
                                       Text="RTP-MIDI hosts on this PC"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="RtpLocalHostsDescription"
                                       Text="A host lets Apple devices and other RTP-MIDI software on your network connect to this PC. Most people need only one."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:Name="CreateRtpHostButton"
                                x:Uid="CreateRtpHostButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnCreateRtpHostClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Uid="CreateHostButtonText" Text="Create host" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView x:Name="RtpLocalHostsListView"
                              x:Uid="RtpLocalHostsListView"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,4,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LocalHostItem">
                                <Border Style="{StaticResource CardBorderStyle}"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" MinWidth="140" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE977;"
                                                      FontSize="20"
                                                      VerticalAlignment="Top"
                                                      Margin="0,2,0,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ConnectionCountText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- The settings, under the details: each button before what it changes, well away
                                                 from the card's own buttons at the top right. -->
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <!-- On the card rather than in Details, so it is easy to find -->
                                                <Grid ColumnSpacing="12"
                                                      Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                        <ColumnDefinition Width="Auto" MinWidth="76" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Uid="ChangeHostSendSpeedLink"
                                                            Grid.Column="0"
                                                            Content="Speed..."
                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                            Click="OnChangeRtpHostSendSpeedClick" />
                                                    <!-- the button's own border and padding, invisible, so this text and the
                                                         button's are rounded alike and share a baseline at any scale -->
                                                    <Border Grid.Column="1"
                                                            BorderThickness="0,1,0,1"
                                                            Padding="0,2,0,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                   TextWrapping="Wrap"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Top">
                                                <!-- before the buttons, so the last one ends in line with the card's Details -->
                                                <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                              Width="20"
                                                              Height="20" />
                                                <Button Content="{x:Bind StartStopLabel, Mode=OneWay}"
                                                        Click="OnStartStopRtpHostClick" />
                                                <Button x:Uid="DeleteHostButton"
                                                        Content="Delete"
                                                        Click="OnDeleteRtpHostClick" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Stays until the adapter is back or another is chosen, so it cannot be closed -->
                                        <InfoBar Severity="Warning"
                                                 IsClosable="False"
                                                 IsOpen="{x:Bind IsNetworkAdapterWarningOpen, Mode=OneWay}"
                                                 Message="{x:Bind NetworkAdapterWarningText, Mode=OneWay}">
                                            <InfoBar.ActionButton>
                                                <Button x:Uid="ChooseHostAdapterButton"
                                                        Content="Choose adapter"
                                                        Tag="{x:Bind}"
                                                        Click="OnChangeRtpHostAdapterClick" />
                                            </InfoBar.ActionButton>
                                        </InfoBar>

                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="NoConnectedDevicesText"
                                                       Text="No devices are connected to this host."
                                                       Visibility="{x:Bind NoConnectionsVisibility, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <ItemsControl ItemsSource="{x:Bind Connections, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="local:HostConnectionItem">
                                                        <Border Margin="0,0,0,6"
                                                                AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                                                Padding="10,6,10,6"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderThickness="1"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                    <FontIcon Glyph="&#xE968;"
                                                                              FontSize="18" />
                                                                    <FontIcon Glyph="&#xF386;"
                                                                              FontSize="18"
                                                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                              Visibility="{x:Bind ConnectedBadgeVisibility, Mode=OneWay}" />
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                                               TextWrapping="Wrap"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <!-- The settings, under the details: each button before what it changes, well away
                                                                     from the card's own buttons at the top right. -->
                                                                <StackPanel Grid.Row="1" Grid.Column="1">
                                                                    <Grid ColumnSpacing="12"
                                                                          Margin="0,6,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <!-- as wide as the buttons, so the labels line up when one is hidden -->
                                                                            <ColumnDefinition Width="Auto" MinWidth="76" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Button x:Uid="ChangeDeviceSettingsLink"
                                                                                Grid.Column="0"
                                                                                Content="Settings..."
                                                                                Style="{StaticResource RowChangeButtonStyle}"
                                                                                Visibility="{x:Bind ChangeSendSpeedVisibility, Mode=OneWay}"
                                                                                Click="OnChangeRemoteClientSendSpeedClick" />
                                                                        <!-- the button's own border and padding, invisible, so this text and the
                                                                             button's are rounded alike and share a baseline at any scale -->
                                                                        <Border Grid.Column="1"
                                                                                BorderThickness="0,1,0,1"
                                                                                Padding="0,2,0,3"
                                                                                VerticalAlignment="Top">
                                                                            <TextBlock Text="{x:Bind SendSpeedText, Mode=OneWay}"
                                                                                       TextWrapping="Wrap"
                                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- The geometry is generated against a fixed 240x32 box in
                                                                     HostConnectionItem, so this must match.
                                                                     Ends at the right, in line with the buttons above it. -->
                                                                <Border Grid.Row="1" Grid.Column="2"
                                                                        Margin="0,6,0,0"
                                                                        VerticalAlignment="Top"
                                                                        Visibility="{x:Bind local:PageLayout.Current.WideVisibility, Mode=OneWay}">
                                                                <StackPanel VerticalAlignment="Center"
                                                                            HorizontalAlignment="Right"
                                                                            Spacing="2"
                                                                            Visibility="{x:Bind LatencyGraphVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind LatencyPeakText, Mode=OneWay}"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="0,0,2,0"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                                                    <Border Width="240"
                                                                            Height="32"
                                                                            HorizontalAlignment="Right"
                                                                            CornerRadius="4"
                                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                            BorderThickness="1"
                                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                                        <Grid>
                                                                            <Polygon Points="{x:Bind LatencyFillPoints, Mode=OneWay}"
                                                                                     Fill="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                                     Opacity="0.45" />
                                                                            <Polyline Points="{x:Bind LatencyLinePoints, Mode=OneWay}"
                                                                                      Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                                                      StrokeThickness="1.5"
                                                                                      StrokeLineJoin="Round" />
                                                                        </Grid>
                                                                    </Border>

                                                                    <TextBlock Text="{x:Bind StatisticsText, Mode=OneWay}"
                                                                               HorizontalAlignment="Right"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>
                                                                </Border>

                                                                <StackPanel Grid.Column="2"
                                                                            HorizontalAlignment="Right"
                                                                            Orientation="Horizontal"
                                                                            Spacing="8"
                                                                            VerticalAlignment="Top">
                                                                    <Button x:Uid="MonitorEndpointButton"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Visibility="{x:Bind MonitorVisibility, Mode=OneWay}"
                                                                            Click="OnMonitorRtpHostConnectionClick">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                                                            <TextBlock x:Uid="MonitorEndpointButtonText" Text="Monitor" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button x:Uid="DisconnectRemoteClientButton"
                                                                            Content="Disconnect"
                                                                            Click="OnDisconnectRtpRemoteClientClick" />
                                                                    <Button x:Uid="BlockRemoteClientButton"
                                                                            Content="Block"
                                                                            Click="OnBlockRtpRemoteClientClick" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Expander x:Uid="RememberedDevicesExpander"
                                                  Header="Remembered decisions"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind KnownClientsVisibility, Mode=OneWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <StackPanel Spacing="4" Margin="0,4,0,4">
                                                <ItemsControl ItemsSource="{x:Bind KnownClients, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:KnownClientItem">
                                                            <Grid ColumnSpacing="12" Margin="0,4,0,4"
                                                                  AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind DecisionText}"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <Button Grid.Column="1"
                                                                        x:Uid="ForgetClientButton"
                                                                        Content="Forget"
                                                                        VerticalAlignment="Center"
                                                                        Click="OnForgetRtpKnownClientClick" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="RemoteClientSettingsExpander"
                                                  Header="Devices with their own settings"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Visibility="{x:Bind RemoteClientSpeedsVisibility, Mode=OneWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <StackPanel Spacing="4" Margin="0,4,0,4">
                                                <ItemsControl ItemsSource="{x:Bind RemoteClientSpeeds, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:RemoteClientSpeedItem">
                                                            <Grid ColumnSpacing="12" Margin="0,4,0,4"
                                                                  AutomationProperties.Name="{x:Bind DisplayName}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind SendSpeedText}"
                                                                               TextWrapping="Wrap"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock Text="{x:Bind OfflineRetentionText}"
                                                                               Visibility="{x:Bind OfflineRetentionVisibility}"
                                                                               TextWrapping="Wrap"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    <TextBlock x:Uid="RemoteClientKeptOfflineText"
                                                                               Text="Offline, endpoint kept"
                                                                               Visibility="{x:Bind KeptOfflineVisibility}"
                                                                               TextWrapping="Wrap"
                                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1"
                                                                            Orientation="Horizontal"
                                                                            Spacing="8"
                                                                            VerticalAlignment="Center">
                                                                    <Button x:Uid="RemoteClientSettingsChangeButton"
                                                                            Content="Change"
                                                                            Click="OnChangeRemoteClientSpeedEntryClick" />
                                                                    <Button x:Uid="RemoteClientSettingsUseHostButton"
                                                                            Content="Use the host's settings"
                                                                            Click="OnUseHostSpeedForRemoteClientClick" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Uid="HostDetailsExpander"
                                                  Header="Details"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                            <Grid Margin="0,4,0,4"
                                                  ColumnSpacing="12"
                                                  RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Uid="RtpAdvertisedNameLabel"
                                                           Grid.Row="0" Grid.Column="0"
                                                           Text="Name advertised on the network"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{x:Bind ServiceInstanceName, Mode=OneWay}"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <TextBlock x:Uid="HostAddressLabel"
                                                           Grid.Row="1" Grid.Column="0"
                                                           Text="Address"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind AddressText, Mode=OneWay}"
                                                           IsTextSelectionEnabled="True"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <TextBlock x:Uid="HostDetailsPolicyLabel"
                                                           Grid.Row="2" Grid.Column="0"
                                                           Text="New connections"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1"
                                                           Text="{x:Bind PolicyText, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />

                                                <Border Grid.Row="3" Grid.Column="0"
                                                        BorderThickness="0,1,0,1"
                                                        Padding="0,2,0,3"
                                                        VerticalAlignment="Top">
                                                    <TextBlock x:Uid="HostNetworkAdapterLabel"
                                                               Text="Network adapter"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Row="3" Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="12">
                                                    <!-- the button's border and padding, so the name and the button share a baseline -->
                                                    <Border BorderThickness="0,1,0,1"
                                                            Padding="0,2,0,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{x:Bind NetworkAdapterText, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </Border>
                                                    <Button x:Uid="ChangeHostAdapterLink"
                                                            Content="Adapter..."
                                                            Style="{StaticResource RowChangeButtonStyle}"
                                                            Click="OnChangeRtpHostAdapterClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="NoRtpLocalHostsText"
                               x:Uid="NoRtpLocalHostsText"
                               Grid.Row="1"
                               Text="This PC does not have an RTP-MIDI host yet. Create one so Apple devices and other RTP-MIDI software can connect to it."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="RtpLocalStatusText"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- ========================== Page 6: Windows Firewall ========================== -->
                <ScrollViewer x:Name="FirewallPanel"
                              Margin="16,8,16,12"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Spacing="12" Margin="0,0,4,0" MaxWidth="720" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Uid="FirewallHeader"
                                       Text="Windows Firewall"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock x:Uid="FirewallDescription"
                                       Text="Devices on your network connect to this PC's hosts through the MIDI service, and Windows Firewall keeps them out until the service is allowed in. Windows may have asked whether to let this app through the firewall, but that answer covers this app only. The MIDI service runs in the background with no window, so it cannot ask."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="FirewallSymptomHeader"
                                           Text="Can other devices see this PC, but not connect to it?"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="FirewallSymptomDescription"
                                           Text="Windows announces this PC's hosts on the network for the MIDI service, so other devices can list them even while the firewall blocks the service. If another device lists this PC but cannot connect to it, or it connects and no MIDI ever arrives, the firewall is the most likely reason."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="FirewallAllowHeader"
                                           Text="Allow the MIDI service through Windows Firewall"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                <!-- What the firewall does with the service on the networks this PC
                                     is connected to now, and each of those networks. Filled in from code. -->
                                <InfoBar x:Name="FirewallStateBar"
                                         IsOpen="False"
                                         IsClosable="False">
                                    <StackPanel x:Name="FirewallNetworksPanel"
                                                Spacing="2"
                                                Margin="0,0,0,12"
                                                Visibility="Collapsed">
                                        <TextBlock x:Uid="FirewallNetworksHeader"
                                                   Text="Networks this PC is connected to now"
                                                   FontWeight="SemiBold"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="FirewallNetworksText"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </InfoBar>

                                <!-- The text is set in code, which also marks the type of network
                                     in use now. The domain box only shows on a PC joined to a domain. -->
                                <StackPanel>
                                    <CheckBox x:Name="FirewallDomainCheckBox"
                                              Visibility="Collapsed"
                                              Checked="OnFirewallNetworkChoiceChanged"
                                              Unchecked="OnFirewallNetworkChoiceChanged" />
                                    <CheckBox x:Name="FirewallPrivateCheckBox"
                                              Checked="OnFirewallNetworkChoiceChanged"
                                              Unchecked="OnFirewallNetworkChoiceChanged" />
                                    <CheckBox x:Name="FirewallPublicCheckBox"
                                              Checked="OnFirewallNetworkChoiceChanged"
                                              Unchecked="OnFirewallNetworkChoiceChanged" />
                                </StackPanel>

                                <TextBlock x:Uid="FirewallNetworkTypeHelp"
                                           Text="Windows treats a network as public until you mark it as private, so your home or studio network might be public. Only allow public networks if you trust the other devices on them."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock x:Uid="FirewallAllowNote"
                                           Text="Windows asks for administrator permission first. This adds one rule for the MIDI service to Windows Firewall, and using it again changes that same rule. Rules you made yourself in Windows Firewall are left as they are."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <!-- the result sits beside the button, so an empty one takes no room -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="FirewallAllowButton"
                                            x:Uid="FirewallAllowButton"
                                            Grid.Column="0"
                                            Content="Allow through Windows Firewall"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            IsEnabled="False"
                                            Click="OnAllowThroughFirewallClick" />
                                    <ProgressRing x:Name="FirewallProgressRing"
                                                  Grid.Column="1"
                                                  IsActive="False"
                                                  Width="20"
                                                  Height="20" />
                                    <TextBlock x:Name="FirewallStatusText"
                                               Grid.Column="2"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="FirewallOtherHeader"
                                           Text="Using a different firewall?"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="FirewallOtherDescription"
                                           Text="This page changes Windows Firewall only. Some PCs use a firewall from another company instead, often one that comes with antivirus software. If yours does, follow that company's instructions for letting a program accept incoming connections, and choose the MIDI service program shown here."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="FirewallServicePathLabel"
                                               Text="MIDI service program"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="FirewallServicePathText"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap"
                                               Style="{ThemeResource BodyTextBlockStyle}" />
                                </StackPanel>
                                <HyperlinkButton x:Uid="FirewallHelpLink"
                                                 Content="How to allow the MIDI service through Windows Firewall yourself"
                                                 NavigateUri="https://microsoft.github.io/MIDI/kb/network-midi-firewall/"
                                                 Padding="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Declared here rather than built in code so the fields stay localizable through the
             normal x:Uid pipeline. A ContentDialog draws nothing until it is shown. -->
        <ContentDialog x:Name="CreateHostDialog"
                       x:Uid="CreateHostDialog"
                       Title="Create a Network MIDI 2.0 host"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       PrimaryButtonClick="OnCreateHostPrimaryButtonClick"
                       DefaultButton="Primary">
            <!-- Wider than a dialog's default, so the help text takes fewer lines. The template sizes
                 itself from this key, not from MaxWidth. MaxWidth on the content, not Width, so the
                 dialog still fits a narrow window. -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer x:Name="CreateHostScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MaxWidth="580" Margin="0,4,4,4">
                    <TextBox x:Name="HostNameTextBox"
                             x:Uid="HostNameTextBox"
                             Header="Name other devices will see"
                             TextChanged="OnCreateHostFieldChanged" />

                    <StackPanel Spacing="4">
                        <TextBox x:Name="HostServiceInstanceNameTextBox"
                                 x:Uid="HostServiceInstanceNameTextBox"
                                 Header="Network service name"
                                 TextChanged="OnCreateHostFieldChanged" />
                        <TextBlock x:Uid="HostServiceInstanceNameHelp"
                                   Text="This has to be different from every other host on this PC, and from anything else on your network. Periods are removed."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HostPolicyLabel"
                                   Text="When a device asks to connect"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <RadioButton x:Name="HostPolicyAskRadio"
                                     x:Uid="HostPolicyAskRadio"
                                     Content="Ask me first"
                                     GroupName="HostPolicy"
                                     IsChecked="True" />
                        <RadioButton x:Name="HostPolicyAllowAnyRadio"
                                     x:Uid="HostPolicyAllowAnyRadio"
                                     Content="Let any device connect"
                                     GroupName="HostPolicy" />
                    </StackPanel>

                    <CheckBox x:Name="HostAdvertiseCheckBox"
                              x:Uid="HostAdvertiseCheckBox"
                              Content="Advertise this host on the network"
                              IsChecked="True" />

                    <!-- above the MIDI 1.0 ports, so it shows without scrolling -->
                    <StackPanel Spacing="4">
                        <ComboBox x:Name="HostSendSpeedLimitComboBox"
                                  x:Uid="SendSpeedLimitComboBox"
                                  Header="Sending speed"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock x:Uid="SendSpeedLimitHelp"
                                   Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="HostReduceSendSpeedCheckBox"
                                  x:Uid="ReduceSendSpeedCheckBox"
                                  Content="Slow down when a device misses data" />
                        <TextBlock x:Uid="ReduceSendSpeedHelp"
                                   Text="When a device asks for data again, Windows sends more slowly, down to MIDI 1.0 wire speed. It speeds back up once the device stops asking."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="HostSkipInBetweenValuesCheckBox"
                                  x:Uid="SkipInBetweenValuesCheckBox"
                                  Content="Skip in-between values to catch up" />
                        <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                   Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <CheckBox x:Name="HostCreateMidi1PortsCheckBox"
                              x:Uid="HostCreateMidi1PortsCheckBox"
                              Content="Also create MIDI 1.0 ports for connected devices"
                              IsChecked="True" />

                    <StackPanel x:Name="HostFallbackMidi1PortCountPanel" Spacing="4">
                        <NumberBox x:Name="HostFallbackMidi1PortCountBox"
                                   x:Uid="HostFallbackMidi1PortCountBox"
                                   Header="MIDI 1.0 ports to create for a device that does not describe itself"
                                   Minimum="1"
                                   Maximum="16"
                                   HorizontalAlignment="Stretch"
                                   SpinButtonPlacementMode="Hidden" />
                        <TextBlock x:Uid="HostFallbackMidi1PortCountHint"
                                   Text="Most devices say how many ports they have, and this is not used for them. It is only for a device that never tells us."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- In place of the number above, on a transport which can name ports. The button
                         steps aside for the MIDI 1.0 ports dialog, which brings this one back. -->
                    <StackPanel x:Name="HostMidi1PortGroupsPanel" Spacing="4">
                        <TextBlock x:Name="HostMidi1PortsText" TextWrapping="Wrap" />
                        <Button x:Uid="CustomizeMidi1PortsButton"
                                Content="Customize groups and MIDI 1.0 ports"
                                Click="OnStepAsideForMidi1PortsClick" />
                        <TextBlock x:Uid="ConnectMidi1PortsHelp"
                                   Text="Only used when the device doesn't describe its own groups, such as another Windows PC."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Expander x:Uid="HostAdvancedExpander"
                              Header="Advanced"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,4,0,4">
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="HostNetworkAdapterComboBox"
                                          x:Uid="HostNetworkAdapterComboBox"
                                          Header="Network adapter"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnNetworkAdapterChoiceChanged" />
                                <TextBlock x:Uid="HostNetworkAdapterHelp"
                                           Text="Choose one adapter to keep this host on one network, like the wired network at a show. Most people can leave this on every adapter."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="HostNetworkAdapterFallbackCheckBox"
                                          x:Uid="HostNetworkAdapterFallbackCheckBox"
                                          Content="If this adapter is missing, use every adapter until it is back"
                                          IsChecked="True"
                                          IsEnabled="False" />
                                <TextBlock x:Uid="HostNetworkAdapterFallbackHelp"
                                           Text="Turn this off to keep the host off your other networks. It waits instead, and starts by itself when the adapter is back."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBox x:Name="HostProductInstanceIdTextBox"
                                         x:Uid="HostProductInstanceIdTextBox"
                                         Header="Product instance id"
                                         TextChanged="OnCreateHostFieldChanged" />
                                <TextBlock x:Uid="HostProductInstanceIdHelp"
                                           Text="Identifies this PC to other devices. 42 characters or fewer."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <CheckBox x:Name="HostAutomaticPortCheckBox"
                                      x:Uid="HostAutomaticPortCheckBox"
                                      Content="Let Windows choose a new port each time"
                                      IsChecked="False"
                                      Checked="OnCreateHostPortModeChanged"
                                      Unchecked="OnCreateHostPortModeChanged" />

                            <NumberBox x:Name="HostPortNumberBox"
                                       x:Uid="HostPortNumberBox"
                                       Header="Port"
                                       Width="140"
                                       HorizontalAlignment="Left"
                                       Minimum="1"
                                       Maximum="65535"
                                       Value="5004"
                                       SpinButtonPlacementMode="Hidden" />

                            <TextBlock x:Uid="HostPortHelp"
                                       Text="Keeping one port makes it easier for other devices to find this PC again after a restart."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <CheckBox x:Name="HostAllowPortFallbackCheckBox"
                                      x:Uid="HostAllowPortFallbackCheckBox"
                                      Content="If this port is unavailable, use another one"
                                      IsChecked="True" />

                            <TextBlock x:Uid="HostAllowPortFallbackHelp"
                                       Text="Something else on this PC could claim the port first. Windows will still start this host, and tell you the port changed."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="CreateHostStatusText"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="CreateRtpHostDialog"
                       x:Uid="CreateRtpHostDialog"
                       Title="Create an RTP-MIDI host"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- as wide as the Network MIDI 2.0 one -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <ScrollViewer x:Name="CreateRtpHostScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MaxWidth="580" Margin="0,4,4,4">
                    <StackPanel Spacing="4">
                        <TextBox x:Name="RtpHostNameTextBox"
                                 x:Uid="HostNameTextBox"
                                 Header="Name other devices will see"
                                 TextChanged="OnCreateRtpHostFieldChanged" />
                        <TextBlock x:Uid="RtpHostNameHelp"
                                   Text="Leave this empty to use this PC's name."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBox x:Name="RtpHostServiceInstanceNameTextBox"
                                 x:Uid="RtpHostServiceInstanceNameTextBox"
                                 Header="Name advertised on the network"
                                 TextChanged="OnCreateRtpHostFieldChanged" />
                        <TextBlock x:Uid="RtpHostServiceInstanceNameHelp"
                                   Text="Leave this empty to advertise the name above. Periods are removed. If another device on your network already uses the name, Windows picks a slightly different one."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="HostPolicyLabel"
                                   Text="When a device asks to connect"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <RadioButton x:Name="RtpHostPolicyAskRadio"
                                     x:Uid="HostPolicyAskRadio"
                                     Content="Ask me first"
                                     GroupName="RtpHostPolicy"
                                     IsChecked="True" />
                        <RadioButton x:Name="RtpHostPolicyAllowAnyRadio"
                                     x:Uid="HostPolicyAllowAnyRadio"
                                     Content="Let any device connect"
                                     GroupName="RtpHostPolicy" />
                    </StackPanel>

                    <CheckBox x:Name="RtpHostAdvertiseCheckBox"
                              x:Uid="HostAdvertiseCheckBox"
                              Content="Advertise this host on the network"
                              IsChecked="True" />

                    <StackPanel Spacing="4">
                        <ComboBox x:Name="RtpHostSendSpeedLimitComboBox"
                                  x:Uid="SendSpeedLimitComboBox"
                                  Header="Sending speed"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock x:Uid="SendSpeedLimitHelp"
                                   Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="RtpNoReduceSendSpeedHelp"
                                   Text="Windows can't slow down by itself for RTP-MIDI devices, because they don't tell this PC when they miss data."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="RtpHostSkipInBetweenValuesCheckBox"
                                  x:Uid="SkipInBetweenValuesCheckBox"
                                  Content="Skip in-between values to catch up"
                                  IsChecked="True" />
                        <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                   Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Expander x:Uid="HostAdvancedExpander"
                              Header="Advanced"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,4,0,4">
                            <StackPanel Spacing="4">
                                <ComboBox x:Name="RtpHostNetworkAdapterComboBox"
                                          x:Uid="HostNetworkAdapterComboBox"
                                          Header="Network adapter"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnNetworkAdapterChoiceChanged" />
                                <TextBlock x:Uid="HostNetworkAdapterHelp"
                                           Text="Choose one adapter to keep this host on one network, like the wired network at a show. Most people can leave this on every adapter."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="RtpHostNetworkAdapterFallbackCheckBox"
                                          x:Uid="HostNetworkAdapterFallbackCheckBox"
                                          Content="If this adapter is missing, use every adapter until it is back"
                                          IsChecked="True"
                                          IsEnabled="False" />
                                <TextBlock x:Uid="HostNetworkAdapterFallbackHelp"
                                           Text="Turn this off to keep the host off your other networks. It waits instead, and starts by itself when the adapter is back."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <CheckBox x:Name="RtpHostAutomaticPortCheckBox"
                                          x:Uid="RtpHostAutomaticPortCheckBox"
                                          Content="Let Windows choose the port"
                                          IsChecked="True"
                                          Checked="OnCreateRtpHostPortModeChanged"
                                          Unchecked="OnCreateRtpHostPortModeChanged" />
                                <TextBlock x:Uid="RtpHostAutomaticPortHelp"
                                           Text="Windows tries port 5004 first, which is where other RTP-MIDI software looks, and takes another one if that is in use."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- RTP-MIDI also uses the port after this one, so 65535 cannot be one -->
                            <NumberBox x:Name="RtpHostPortNumberBox"
                                       x:Uid="HostPortNumberBox"
                                       Header="Port"
                                       Width="140"
                                       HorizontalAlignment="Left"
                                       Minimum="1024"
                                       Maximum="65534"
                                       Value="5004"
                                       IsEnabled="False"
                                       SpinButtonPlacementMode="Hidden" />

                            <TextBlock x:Uid="RtpHostPortHelp"
                                       Text="RTP-MIDI also uses the next port up. Keeping one port makes it easier for other devices to find this PC again after a restart."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <CheckBox x:Name="RtpHostAllowPortFallbackCheckBox"
                                      x:Uid="HostAllowPortFallbackCheckBox"
                                      Content="If this port is unavailable, use another one"
                                      IsChecked="True"
                                      IsEnabled="False" />

                            <TextBlock x:Uid="HostAllowPortFallbackHelp"
                                       Text="Something else on this PC could claim the port first. Windows will still start this host, and tell you the port changed."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Spacing="4">
                                <CheckBox x:Name="RtpHostSendRecoveryJournalCheckBox"
                                          x:Uid="RtpSendRecoveryJournalCheckBox"
                                          Content="Help other devices recover notes lost on the network"
                                          IsChecked="True" />
                                <TextBlock x:Uid="RtpSendRecoveryJournalHelp"
                                           Text="Each packet carries a short summary of recent notes, so a device that misses a packet can still end a note that would otherwise hang. Turn this off only for a device that plays extra notes, or notes that don't stop, while this is on."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Name="RtpCreateHostStatusText"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="ConfirmDialog"
                       x:Uid="ConfirmDialog"
                       PrimaryButtonText="Yes"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap" MaxWidth="420" />
        </ContentDialog>

        <!-- Used for hosts of both transports. The title names the host, so it is set in code. -->
        <ContentDialog x:Name="ChangeHostAdapterDialog"
                       x:Uid="ChangeHostAdapterDialog"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- as wide as the other forms -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="12" MaxWidth="580" Margin="0,4,4,4">
                <TextBlock x:Uid="ChangeHostAdapterIntro"
                           Text="Choose the network this host uses. If you change it, the host restarts, and the devices connected to it are disconnected."
                           TextWrapping="Wrap" />
                <ComboBox x:Name="ChangeHostAdapterComboBox"
                          x:Uid="HostNetworkAdapterComboBox"
                          Header="Network adapter"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnNetworkAdapterChoiceChanged" />
                <StackPanel Spacing="4">
                    <CheckBox x:Name="ChangeHostAdapterFallbackCheckBox"
                              x:Uid="HostNetworkAdapterFallbackCheckBox"
                              Content="If this adapter is missing, use every adapter until it is back" />
                    <TextBlock x:Uid="HostNetworkAdapterFallbackHelp"
                               Text="Turn this off to keep the host off your other networks. It waits instead, and starts by itself when the adapter is back."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ContentDialog>

        <!-- Used for hosts and for one device on a host, on both transports. The title names
             what is being changed, so it is set in code. -->
        <ContentDialog x:Name="ChangeSendSpeedDialog"
                       x:Uid="ChangeSendSpeedDialog"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- as wide as the other forms -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <!-- Scrolls, because the dialog's own template never does and an RTP-MIDI device's
                 settings make it taller than a short window -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="580" Margin="0,4,4,4">
                <!-- Only for one device on a host. The check box text names the host's speed,
                     so it is set in code. -->
                <StackPanel x:Name="ChangeSendSpeedDevicePanel" Spacing="8">
                    <TextBlock x:Name="ChangeSendSpeedDeviceIntroText"
                               x:Uid="ChangeSendSpeedDeviceIntro"
                               Text="This changes only how fast this host sends to this device. Windows remembers it, and uses it again the next time the device connects."
                               TextWrapping="Wrap" />
                    <!-- RTP-MIDI devices, in place of the one above -->
                    <TextBlock x:Name="ChangeDeviceSettingsIntroText"
                               x:Uid="ChangeDeviceSettingsIntro"
                               Text="These settings are only for this device on this host. Windows remembers them by the device's name, and uses them again the next time it connects."
                               TextWrapping="Wrap" />
                    <CheckBox x:Name="ChangeSendSpeedUseHostCheckBox"
                              Checked="OnChangeSendSpeedUseHostChanged"
                              Unchecked="OnChangeSendSpeedUseHostChanged" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <ComboBox x:Name="ChangeSendSpeedLimitComboBox"
                              x:Uid="SendSpeedLimitComboBox"
                              Header="Sending speed"
                              HorizontalAlignment="Stretch" />
                    <TextBlock x:Uid="SendSpeedLimitHelp"
                               Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Network MIDI 2.0 only. RTP-MIDI cannot tell that a device missed data. -->
                <StackPanel x:Name="ChangeReduceSendSpeedPanel" Spacing="4">
                    <CheckBox x:Name="ChangeReduceSendSpeedCheckBox"
                              x:Uid="ReduceSendSpeedCheckBox"
                              Content="Slow down when a device misses data" />
                    <TextBlock x:Uid="ReduceSendSpeedHelp"
                               Text="When a device asks for data again, Windows sends more slowly, down to MIDI 1.0 wire speed. It speeds back up once the device stops asking."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- RTP-MIDI only, in place of the check box -->
                <TextBlock x:Name="ChangeRtpNoReduceSendSpeedText"
                           x:Uid="RtpNoReduceSendSpeedHelp"
                           Text="Windows can't slow down by itself for RTP-MIDI devices, because they don't tell this PC when they miss data."
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- both transports -->
                <StackPanel Spacing="4">
                    <CheckBox x:Name="ChangeSkipInBetweenValuesCheckBox"
                              x:Uid="SkipInBetweenValuesCheckBox"
                              Content="Skip in-between values to catch up" />
                    <TextBlock x:Uid="SkipInBetweenValuesHelp"
                               Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- RTP-MIDI devices on a host only. The same choices as an RTP-MIDI device this
                     PC connects to. The caption shows a duration none of the choices match. -->
                <StackPanel x:Name="ChangeOfflineRetentionPanel" Spacing="4">
                    <ComboBox x:Name="ChangeOfflineRetentionComboBox"
                              x:Uid="ChangeOfflineRetentionComboBox"
                              Header="Keep endpoint when offline"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem x:Uid="OfflineRetentionAlwaysItem" Content="Always" />
                        <ComboBoxItem x:Uid="OfflineRetentionImmediateItem" Content="Remove immediately" />
                        <ComboBoxItem x:Uid="OfflineRetention30SecondsItem" Content="After 30 seconds" />
                        <ComboBoxItem x:Uid="OfflineRetention5MinutesItem" Content="After 5 minutes" />
                    </ComboBox>
                    <TextBlock x:Name="ChangeOfflineRetentionCaption"
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="OfflineRetentionHelp"
                               Text="Keeping the endpoint means apps hold on to their MIDI ports while the device is off, so they keep their setup. Anything sent to it then is lost. Removing it means the ports go away, which is the only way most apps can tell the device is gone."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- The MIDI 1.0 ports a Network MIDI 2.0 connection gets when the device doesn't describe
             its own groups. Shared by Connect, Connect by address, Customize, Create host, a host's
             card and one device on a host. Connect, Customize and Create host step aside for it,
             because only one dialog can be open at a time. The title, the intro and the primary
             button depend on what is being changed, so they're set in code. -->
        <ContentDialog x:Name="Midi1PortGroupsDialog"
                       x:Uid="Midi1PortGroupsDialog"
                       PrimaryButtonText="OK"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnMidi1PortGroupsPrimaryButtonClick">
            <!-- The template sizes itself from this key, not from MaxWidth -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
            </ContentDialog.Resources>

            <!-- A dialog cuts its content off rather than scrolling. The outer scrolling is only for
                 a small window; the groups scroll on their own under fixed headers. The width is set
                 in code: narrower for a host, whose rows have no names. -->
            <ScrollViewer x:Name="Midi1PortGroupsScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Midi1PortGroupsContent" Spacing="8" Width="640" Margin="0,4,12,4">
                    <TextBlock x:Name="Midi1PortGroupsIntroText" TextWrapping="Wrap" />

                    <!-- Only for one device on a host. The text names the host's ports, so it's set in code. -->
                    <CheckBox x:Name="Midi1PortGroupsUseHostCheckBox"
                              Checked="OnMidi1PortGroupsUseHostChanged"
                              Unchecked="OnMidi1PortGroupsUseHostChanged" />

                    <!-- The same columns as each row below. The name column sizes to its box, so a
                         host's rows, which have no names, leave no gap where it would be. The right
                         margin leaves room for the scroll bar the rows get. -->
                    <Grid ColumnSpacing="12" Margin="0,4,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="Midi1PortGroupsGroupHeader"
                                   Grid.Column="0"
                                   Text="Group"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="Midi1PortGroupsNameHeader"
                                   x:Uid="Midi1PortGroupsNameHeader"
                                   Grid.Column="1"
                                   Width="272"
                                   Text="Name"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- centered over the check boxes, and free to wrap in a longer language -->
                        <TextBlock x:Uid="Midi1PortGroupsInputHeader"
                                   Grid.Column="2"
                                   Text="Source (In)"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Uid="Midi1PortGroupsOutputHeader"
                                   Grid.Column="3"
                                   Text="Destination (Out)"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Seven rows and about 60% of the eighth, so it's clear the list scrolls. The
                         height is set in code, because a row with a name box is a little taller. -->
                    <ScrollViewer x:Name="Midi1PortGroupsListScroller" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Midi1PortGroupsList"
                                      x:Uid="Midi1PortGroupsList"
                                      Margin="0,0,16,0"
                                      IsTabStop="False">
                            <!-- space between the rows, so the name boxes don't run together -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:Midi1PortGroupItem">
                                    <Grid ColumnSpacing="12"
                                          AutomationProperties.Name="{x:Bind GroupText}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind GroupText}"
                                                   VerticalAlignment="Center" />

                                        <!-- 31 is the longest port name a MIDI 1.0 app can show -->
                                        <TextBox x:Uid="Midi1PortGroupNameBox"
                                                 Grid.Column="1"
                                                 Width="272"
                                                 Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Automatic"
                                                 MaxLength="31"
                                                 Visibility="{x:Bind NameVisibility}"
                                                 AutomationProperties.Name="{x:Bind NameAutomationName}" />

                                        <!-- No label, so no minimum width or label padding. That also
                                             centers the focus rectangle on the box, and the box under
                                             its header. -->
                                        <CheckBox Grid.Column="2"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{x:Bind HasInput, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind InputAutomationName}" />
                                        <CheckBox Grid.Column="3"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{x:Bind HasOutput, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind OutputAutomationName}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- A problem takes the hint's place while it shows, so the dialog grows as little
                         as it can. In one cell, a closed InfoBar leaves no gap either. -->
                    <Grid>
                        <TextBlock x:Name="Midi1PortGroupsHintText"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <InfoBar x:Name="Midi1PortGroupsErrorBar"
                                 Severity="Error"
                                 IsClosable="False"
                                 IsOpen="False" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog x:Name="ConnectNameDialog"
                       x:Uid="ConnectNameDialog"
                       Title="Connect to this device"
                       PrimaryButtonText="Connect"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- as wide as the other forms, so the help text takes fewer lines -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <!-- A dialog cuts its content off rather than scrolling, and the RTP-MIDI choices make
                 this one taller. Scrolling here is only for a small window. -->
            <ScrollViewer x:Name="ConnectNameScroller" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" MaxWidth="580" Margin="0,0,12,0">
                    <TextBlock x:Name="ConnectNameDialogText" TextWrapping="Wrap" />
                    <TextBox x:Name="ConnectNameDialogTextBox"
                             x:Uid="ConnectNameDialogTextBox"
                             Header="Name to show in Windows"
                             PlaceholderText="Optional" />
                    <TextBlock x:Uid="ConnectNameDialogHint"
                               Text="Leave this empty to use the name the device reports."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <ComboBox x:Name="ConnectSendSpeedLimitComboBox"
                                  x:Uid="SendSpeedLimitComboBox"
                                  Header="Sending speed"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock x:Uid="SendSpeedLimitHelp"
                                   Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Network MIDI 2.0 only. RTP-MIDI cannot tell that a device missed data. -->
                    <StackPanel x:Name="ConnectReduceSendSpeedPanel" Spacing="4">
                        <CheckBox x:Name="ConnectReduceSendSpeedCheckBox"
                                  x:Uid="ReduceSendSpeedCheckBox"
                                  Content="Slow down when a device misses data" />
                        <TextBlock x:Uid="ReduceSendSpeedHelp"
                                   Text="When a device asks for data again, Windows sends more slowly, down to MIDI 1.0 wire speed. It speeds back up once the device stops asking."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- RTP-MIDI only, in place of the check box -->
                    <TextBlock x:Name="ConnectRtpNoReduceSendSpeedText"
                               x:Uid="RtpNoReduceSendSpeedHelp"
                               Text="Windows can't slow down by itself for RTP-MIDI devices, because they don't tell this PC when they miss data."
                               TextWrapping="Wrap"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- both transports -->
                    <StackPanel Spacing="4">
                        <CheckBox x:Name="ConnectSkipInBetweenValuesCheckBox"
                                  x:Uid="SkipInBetweenValuesCheckBox"
                                  Content="Skip in-between values to catch up" />
                        <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                   Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Network MIDI 2.0 only, on a transport which can name ports. The button steps
                         aside for the MIDI 1.0 ports dialog, which brings this one back. -->
                    <StackPanel x:Name="ConnectMidi1PortsPanel" Spacing="4" Margin="0,8,0,0">
                        <TextBlock x:Name="ConnectMidi1PortsText" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Button x:Uid="CustomizeMidi1PortsButton"
                                Content="Customize groups and MIDI 1.0 ports"
                                Click="OnStepAsideForMidi1PortsClick" />
                        <TextBlock x:Uid="ConnectMidi1PortsHelp"
                                   Text="Only used when the device doesn't describe its own groups, such as another Windows PC."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- RTP-MIDI only. Network MIDI 2.0 has no recovery journal. -->
                    <StackPanel x:Name="ConnectRtpSendRecoveryJournalPanel" Spacing="4" Margin="0,8,0,0">
                        <CheckBox x:Name="ConnectRtpSendRecoveryJournalCheckBox"
                                  x:Uid="RtpSendRecoveryJournalCheckBox"
                                  Content="Help other devices recover notes lost on the network"
                                  IsChecked="True" />
                        <TextBlock x:Uid="RtpSendRecoveryJournalHelp"
                                   Text="Each packet carries a short summary of recent notes, so a device that misses a packet can still end a note that would otherwise hang. Turn this off only for a device that plays extra notes, or notes that don't stop, while this is on."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- RTP-MIDI only for now -->
                    <StackPanel x:Name="ConnectRtpOfflineRetentionPanel" Spacing="4" Margin="0,8,0,0">
                        <ComboBox x:Name="ConnectRtpOfflineRetentionComboBox"
                                  x:Uid="ConnectOfflineRetentionComboBox"
                                  Header="Keep endpoint when offline"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem x:Uid="OfflineRetentionAlwaysItem" Content="Always" />
                            <ComboBoxItem x:Uid="OfflineRetentionImmediateItem" Content="Remove immediately" />
                            <ComboBoxItem x:Uid="OfflineRetention30SecondsItem" Content="After 30 seconds" />
                            <ComboBoxItem x:Uid="OfflineRetention5MinutesItem" Content="After 5 minutes" />
                        </ComboBox>
                        <TextBlock x:Uid="OfflineRetentionHelp"
                                   Text="Keeping the endpoint means apps hold on to their MIDI ports while the device is off, so they keep their setup. Anything sent to it then is lost. Removing it means the ports go away, which is the only way most apps can tell the device is gone."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
        <ContentDialog x:Name="ReassociateDialog"
                       x:Uid="ReassociateDialog"
                       Title="Relink this to a different device"
                       PrimaryButtonText="Relink"
                       CloseButtonText="Cancel"
                       DefaultButton="Close"
                       IsPrimaryButtonEnabled="False">
            <!-- as wide as the other forms -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="8" MaxWidth="580">
                <TextBlock x:Name="ReassociateDialogText" TextWrapping="Wrap" />
                <ListView x:Name="ReassociateDialogList"
                          x:Uid="ReassociateDialogList"
                          SelectionMode="Single"
                          MaxHeight="260"
                          SelectionChanged="OnReassociateSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:RemoteHostItem">
                            <StackPanel Margin="0,4,0,4"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Uid="ReassociateDialogHint"
                           Text="The name you chose is kept. The MIDI endpoint takes its identity from the device, so anything saved against the old endpoint does not follow."
                           TextWrapping="Wrap"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="CustomizeDialog"
                       x:Uid="CustomizeDialog"
                       Title="Customize this device"
                       PrimaryButtonText="Save"
                       SecondaryButtonText="Reset"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- The template sizes itself from this key, not from MaxWidth -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
            </ContentDialog.Resources>

            <!-- Two columns, because one ran off the bottom, and a dialog cuts its content off rather
                 than scrolling. Scrolling here is only for a small window. -->
            <ScrollViewer x:Name="CustomizeScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto">
                <StackPanel Orientation="Horizontal" Spacing="32" Margin="0,0,12,0">
                    <StackPanel Spacing="12" Width="400">
                        <TextBlock x:Name="CustomizeTransportNameText"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBox x:Name="CustomizeNameBox"
                                 x:Uid="CustomizeNameBox"
                                 Header="Name" />

                        <TextBox x:Name="CustomizeDescriptionBox"
                                 x:Uid="CustomizeDescriptionBox"
                                 Header="Description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="CustomizeImageBox"
                                     x:Uid="CustomizeImageBox"
                                     Grid.Column="0"
                                     Header="Image file name" />

                            <Button x:Name="CustomizeBrowseImageButton"
                                    x:Uid="CustomizeBrowseImageButton"
                                    Grid.Column="1"
                                    Content="Browse..."
                                    VerticalAlignment="Bottom"
                                    Click="OnBrowseForImageClick" />

                            <Button x:Name="CustomizeRemoveImageButton"
                                    x:Uid="CustomizeRemoveImageButton"
                                    Grid.Column="2"
                                    Content="Remove"
                                    VerticalAlignment="Bottom"
                                    Click="OnRemoveImageClick" />
                        </Grid>

                        <TextBlock x:Uid="CustomizeHelpText"
                                   Text="Leave a box empty to use what the device reports. Browsing for an image copies it into the shared endpoint images folder. Remove clears the image from this device without deleting the file."
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- How this PC connects to the device. Collapsed in code when it holds nothing.
                         Wider than the left column, so a MIDI 1.0 ports line such as "2 sources (In)
                         and 2 destinations (Out), some named by you" fits on one line. -->
                    <StackPanel x:Name="CustomizeConnectionPanel" Spacing="12" Width="464">
                        <!-- Network MIDI 2.0 only. An RTP-MIDI endpoint always has its one MIDI 1.0 port. -->
                        <StackPanel x:Name="CustomizeMidi1PortsPanel" Spacing="12">
                            <CheckBox x:Name="CustomizeCreateMidi1PortsCheckBox"
                                      x:Uid="CustomizeCreateMidi1PortsCheckBox"
                                      Content="Create MIDI 1.0 ports for this device" />

                            <TextBlock x:Uid="CustomizeCreateMidi1PortsHint"
                                       Text="Turning this on or off takes effect the next time this device connects. The number of ports below applies right away."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <StackPanel x:Name="CustomizeFallbackMidi1PortCountPanel" Spacing="4">
                                <NumberBox x:Name="CustomizeFallbackMidi1PortCountBox"
                                           x:Uid="CustomizeFallbackMidi1PortCountBox"
                                           Header="MIDI 1.0 ports to create if this device does not describe itself"
                                           Minimum="1"
                                           Maximum="16"
                                           HorizontalAlignment="Stretch"
                                           SpinButtonPlacementMode="Hidden" />
                                <TextBlock x:Uid="CustomizeFallbackMidi1PortCountHint"
                                           Text="Most devices say how many ports they have, and this is not used for them. It is only for a device that never tells us."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <!-- In place of the number above, on a transport which can name ports. The
                                 button steps aside for the MIDI 1.0 ports dialog, which brings this one back. -->
                            <StackPanel x:Name="CustomizeMidi1PortGroupsPanel" Spacing="4">
                                <TextBlock x:Name="CustomizeMidi1PortsText" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <Button x:Uid="CustomizeMidi1PortsButton"
                                        Content="Customize groups and MIDI 1.0 ports"
                                        Click="OnStepAsideForMidi1PortsClick" />
                                <TextBlock x:Uid="ConnectMidi1PortsHelp"
                                           Text="Only used when the device doesn't describe its own groups, such as another Windows PC."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Only for a device this PC connects to. A host's speed is set on the host. -->
                        <StackPanel x:Name="CustomizeSendSpeedPanel" Spacing="4">
                            <ComboBox x:Name="CustomizeSendSpeedLimitComboBox"
                                      x:Uid="SendSpeedLimitComboBox"
                                      Header="Sending speed"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock x:Uid="SendSpeedLimitHelp"
                                       Text="Some devices lose data when a lot of it arrives at once, like a long SysEx transfer. If a device misses messages, choose a slower speed. A single note or knob turn is never held back."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <!-- Network MIDI 2.0 only. RTP-MIDI cannot tell that a device missed data. -->
                            <StackPanel x:Name="CustomizeReduceSendSpeedPanel" Spacing="4">
                                <CheckBox x:Name="CustomizeReduceSendSpeedCheckBox"
                                          x:Uid="ReduceSendSpeedCheckBox"
                                          Content="Slow down when a device misses data" />
                                <TextBlock x:Uid="ReduceSendSpeedHelp"
                                           Text="When a device asks for data again, Windows sends more slowly, down to MIDI 1.0 wire speed. It speeds back up once the device stops asking."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <!-- RTP-MIDI only, in place of the check box -->
                            <TextBlock x:Name="CustomizeRtpNoReduceSendSpeedText"
                                       x:Uid="RtpNoReduceSendSpeedHelp"
                                       Text="Windows can't slow down by itself for RTP-MIDI devices, because they don't tell this PC when they miss data."
                                       TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <!-- both transports -->
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="CustomizeSkipInBetweenValuesCheckBox"
                                          x:Uid="SkipInBetweenValuesCheckBox"
                                          Content="Skip in-between values to catch up" />
                                <TextBlock x:Uid="SkipInBetweenValuesHelp"
                                           Text="When messages pile up behind this speed, some in-between steps of long control change, pressure and pitch bend moves are skipped so the device catches up. Turn this off if every message has to arrive, such as for a knob that sends how far it turned."
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
