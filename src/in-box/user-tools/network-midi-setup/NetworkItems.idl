// Row types for the lists in this tool. They implement INotifyPropertyChanged because the
// pages poll the service every couple of seconds: rebuilding the collections instead would
// throw away the selection, the scroll position and any open expander on every tick.
namespace midinetworksetup
{
    // A remote client waiting for the customer to allow or deny it. Shown in the attention
    // banner at the top of the first page.
    [default_interface]
    runtimeclass PendingInvitationItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        PendingInvitationItem();

        // identity, in the form the approval command wants it
        String HostId{ get; };
        String RemoteName{ get; };
        String RemoteProductInstanceId{ get; };

        // which transport's approval command answers it
        Boolean IsRtpMidi{ get; };

        String Headline{ get; };
        String Detail{ get; };

        Boolean IsBusy;
    }

    // One remote Network MIDI 2.0 host. Discovered hosts and this PC's configured client
    // entries are folded into a single row, because to the customer they are one thing.
    [default_interface]
    runtimeclass RemoteHostItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        RemoteHostItem();

        // stable across refreshes, so rows can be matched rather than recreated
        String MatchKey{ get; };

        String DisplayName{ get; };
        String SubtitleText{ get; };

        String ProductInstanceId{ get; };

        // Says whether the value above is what the device is reporting now, or what the saved
        // entry is still looking for.
        String ProductInstanceIdLabel{ get; };
        String AddressesText{ get; };
        String DeviceId{ get; };

        // the address the service is asked to invite. The service has no discovery based
        // connect command, so a discovered host is reached by its resolved address, while the
        // configuration entry keeps the device id so a restart rediscovers it.
        String ConnectAddress{ get; };
        UInt16 ConnectPort{ get; };

        String StatusText{ get; };
        String StatisticsText{ get; };
        String EndpointDeviceId{ get; };

        // Full path to the endpoint's image in the shared assets folder, empty when it has none.
        String ImagePath{ get; };

        // The same image ready to bind, because a path on its own will not bind to Image.Source.
        Microsoft.UI.Xaml.Media.ImageSource ImageSource{ get; };

        // empty when this PC has no configured client entry for the host
        String ClientId{ get; };

        Boolean IsConnected{ get; };
        Boolean IsConfigured{ get; };
        Boolean IsAdvertised{ get; };

        // Disconnecting always forgets the entry, so the label says so when there is no session
        // to end and the only thing the button does is remove it.
        String DisconnectLabel{ get; };
        Boolean IsBusy;

        Microsoft.UI.Xaml.Visibility ConnectVisibility{ get; };
        Microsoft.UI.Xaml.Visibility RetryVisibility{ get; };

        // Only for a saved entry whose device is not on the network, which is the case where
        // pointing it at a different device is a sensible thing to offer.
        Microsoft.UI.Xaml.Visibility ReassociateVisibility{ get; };
        Microsoft.UI.Xaml.Visibility DisconnectVisibility{ get; };
        Microsoft.UI.Xaml.Visibility NotAdvertisedVisibility{ get; };
        Microsoft.UI.Xaml.Visibility ConnectedBadgeVisibility{ get; };
        Microsoft.UI.Xaml.Visibility EndpointDeviceIdVisibility{ get; };

        Microsoft.UI.Xaml.Visibility ImageVisibility{ get; };

        // Only once there is an endpoint, because that is what a customization is keyed on.
        Microsoft.UI.Xaml.Visibility CustomizeVisibility{ get; };

        // Round trip latency over the last several polls, newest at the right. Rendered as a
        // filled sparkline, so the geometry is produced here rather than in the template.
        Microsoft.UI.Xaml.Visibility LatencyGraphVisibility{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyLinePoints{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyFillPoints{ get; };
        String LatencyPeakText{ get; };
    }

    // One remote client which has reached a host on this PC.
    [default_interface]
    runtimeclass HostConnectionItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        HostConnectionItem();

        String MatchKey{ get; };
        String HostId{ get; };

        // RTP-MIDI only: what the disconnect command names the connection by
        UInt32 ConnectionId{ get; };

        String DisplayName{ get; };
        String ProductInstanceId{ get; };
        String AddressText{ get; };
        String StatusText{ get; };
        String StatisticsText{ get; };

        // empty until the session is up and the host has created an endpoint for this client
        String EndpointDeviceId{ get; };

        Boolean IsPendingApproval{ get; };
        Boolean IsBusy;

        Microsoft.UI.Xaml.Visibility MonitorVisibility{ get; };

        // matches the remote host rows: round trip latency over a rolling window
        Microsoft.UI.Xaml.Visibility ConnectedBadgeVisibility{ get; };
        Microsoft.UI.Xaml.Visibility LatencyGraphVisibility{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyLinePoints{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyFillPoints{ get; };
        String LatencyPeakText{ get; };
    }

    // A remote client this PC remembers deciding about, from a host's allow or deny list.
    [default_interface]
    runtimeclass KnownClientItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        KnownClientItem();

        String MatchKey{ get; };
        String HostId{ get; };

        String DisplayName{ get; };
        String ProductInstanceId{ get; };
        String DecisionText{ get; };

        Boolean IsAllowed{ get; };
    }

    // One Network MIDI 2.0 host running on this PC.
    [default_interface]
    runtimeclass LocalHostItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        LocalHostItem();

        String HostId{ get; };

        String DisplayName{ get; };
        String ServiceInstanceName{ get; };
        String ProductInstanceId{ get; };
        String AddressText{ get; };
        String PortText{ get; };
        String StatusText{ get; };
        String PolicyText{ get; };
        String ConnectionCountText{ get; };
        String StartStopLabel{ get; };

        Boolean HasStarted{ get; };
        Boolean IsBusy;
        Boolean CreatesMidi1Ports{ get; };

        // Which network adapter the host is limited to, as shown, and a warning when it is missing
        String NetworkAdapterText{ get; };
        String NetworkAdapterWarningText{ get; };
        Boolean IsNetworkAdapterWarningOpen{ get; };

        // What is configured, for changing it. An empty id is every adapter.
        String NetworkAdapterId{ get; };
        String NetworkAdapterName{ get; };
        Boolean AllowNetworkAdapterFallback{ get; };

        // How fast the host sends to each device, as shown, and what is configured, for changing
        // it. The limit is a multiple of MIDI 1.0 wire speed, and 0 is no limit.
        String SendSpeedText{ get; };
        UInt32 SendSpeedLimit{ get; };
        Boolean ReduceSendSpeedAutomatically{ get; };

        Microsoft.UI.Xaml.Visibility NoConnectionsVisibility{ get; };
        Microsoft.UI.Xaml.Visibility NoKnownClientsVisibility{ get; };
        Microsoft.UI.Xaml.Visibility KnownClientsVisibility{ get; };

        Windows.Foundation.Collections.IObservableVector<HostConnectionItem> Connections{ get; };
        Windows.Foundation.Collections.IObservableVector<KnownClientItem> KnownClients{ get; };
    }

    // One remote RTP-MIDI session. Folded together with this PC's client entry for it, the same
    // way RemoteHostItem does for Network MIDI 2.0.
    [default_interface]
    runtimeclass RtpRemoteHostItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        RtpRemoteHostItem();

        String MatchKey{ get; };

        String DisplayName{ get; };
        String SubtitleText{ get; };
        String HostName{ get; };
        String AddressesText{ get; };

        // how a new client entry finds the session: by its advertised name when it has one,
        // otherwise by address and port
        String ServiceInstanceName{ get; };
        String ConnectAddress{ get; };
        UInt16 ConnectPort{ get; };

        String StatusText{ get; };
        String StatisticsText{ get; };
        String EndpointDeviceId{ get; };
        String ImagePath{ get; };
        Microsoft.UI.Xaml.Media.ImageSource ImageSource{ get; };

        // empty when this PC has no client entry for the session
        String ClientId{ get; };

        Boolean IsConnected{ get; };
        Boolean IsConfigured{ get; };
        Boolean IsAdvertised{ get; };

        // the same machine also offers Network MIDI 2.0, which is the better choice
        Boolean AlsoOffersNetworkMidi2{ get; };

        String DisconnectLabel{ get; };
        Boolean IsBusy;

        Microsoft.UI.Xaml.Visibility ConnectVisibility{ get; };
        Microsoft.UI.Xaml.Visibility RetryVisibility{ get; };
        Microsoft.UI.Xaml.Visibility DisconnectVisibility{ get; };
        Microsoft.UI.Xaml.Visibility NotAdvertisedVisibility{ get; };
        Microsoft.UI.Xaml.Visibility NetworkMidi2Visibility{ get; };
        Microsoft.UI.Xaml.Visibility ConnectedBadgeVisibility{ get; };
        Microsoft.UI.Xaml.Visibility EndpointDeviceIdVisibility{ get; };
        Microsoft.UI.Xaml.Visibility ImageVisibility{ get; };
        Microsoft.UI.Xaml.Visibility CustomizeVisibility{ get; };

        Microsoft.UI.Xaml.Visibility LatencyGraphVisibility{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyLinePoints{ get; };
        Microsoft.UI.Xaml.Media.PointCollection LatencyFillPoints{ get; };
        String LatencyPeakText{ get; };
    }
}
