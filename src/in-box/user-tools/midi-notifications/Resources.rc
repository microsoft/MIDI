#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APPICON ICON "Assets\\AppIcon.ico"

STRINGTABLE
BEGIN
    IDS_APP_TITLE                           "Windows MIDI Services Notifications"
    IDS_TRAY_TOOLTIP                        "Windows MIDI Services"
    IDS_MENU_OPEN_NETWORK_SETUP             "Open Network MIDI Setup"
    IDS_MENU_EXIT                           "Exit"

    IDS_NOTIFICATION_TITLE                  "Windows MIDI Services"

    // %s is the name the remote device announced. It is sanitized before it gets here.
    IDS_NOTIFICATION_NETWORK_APPROVAL_ONE   "%s wants to connect to this PC."

    // %s is a count of devices.
    IDS_NOTIFICATION_NETWORK_APPROVAL_MANY  "%s devices want to connect to this PC."

    IDS_NOTIFICATION_NETWORK_ATTRIBUTION    "Network MIDI 2.0"
    IDS_NOTIFICATION_REVIEW_BUTTON          "Review"

    // %s is the name the customer gave the loopback. It is sanitized before it gets here.
    IDS_NOTIFICATION_LOOPBACK_FEEDBACK_ONE  "A feedback loop was detected in %s, so the loopback was muted. Fix the loop, then unmute it in MIDI Loopback Setup."

    // %s is a count of loopbacks.
    IDS_NOTIFICATION_LOOPBACK_FEEDBACK_MANY "Feedback loops were detected in %s loopbacks, so they were muted. Fix the loops, then unmute them in MIDI Loopback Setup."

    IDS_NOTIFICATION_LOOPBACK_ATTRIBUTION   "MIDI loopbacks"
    IDS_NOTIFICATION_OPEN_LOOPBACK_SETUP_BUTTON "Open Loopback Setup"

    IDS_NOTIFICATION_NETWORK_HOST_ADAPTER_TITLE         "Unable to start a Network MIDI 2.0 host"
    IDS_NOTIFICATION_NETWORK_HOST_ADAPTER_TITLE_MANY    "Unable to start Network MIDI 2.0 hosts"
    IDS_NOTIFICATION_RTP_HOST_ADAPTER_TITLE             "Unable to start an RTP-MIDI host"
    IDS_NOTIFICATION_RTP_HOST_ADAPTER_TITLE_MANY        "Unable to start RTP-MIDI hosts"

    // The first %s is the host's name and the second is the network adapter's name, such as
    // Ethernet 3. Both are sanitized before they get here.
    IDS_NOTIFICATION_HOST_ADAPTER_ONE   "The host %s uses the network adapter %s, which is missing. It starts by itself when the adapter is back, or you can choose another one."

    // %s is a count of hosts.
    IDS_NOTIFICATION_HOST_ADAPTER_MANY  "%s hosts use network adapters which are missing. They start by themselves when the adapters are back, or you can choose other ones."

    IDS_NOTIFICATION_RTP_ATTRIBUTION    "RTP-MIDI"
    IDS_NOTIFICATION_HOST_UNNAMED       "(no name)"
    IDS_NOTIFICATION_ADAPTER_UNNAMED    "(unknown)"
END
