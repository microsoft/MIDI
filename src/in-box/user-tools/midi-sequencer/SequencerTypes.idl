namespace midisequencer
{
    // Children left to right, starting a new row when the next one doesn't fit.
    [default_interface]
    runtimeclass WrapPanel : Microsoft.UI.Xaml.Controls.Panel
    {
        WrapPanel();
    }

    // Where the timeline's scroll bar is drawn (TimelineBar.h). It tells UI Automation it's a
    // scroll bar, whose value is the bar the view starts at.
    [default_interface]
    runtimeclass TimelineBarHost : Microsoft.UI.Xaml.Controls.Grid
    {
        TimelineBarHost();
    }

    [default_interface]
    runtimeclass TimelineBarAutomationPeer : Microsoft.UI.Xaml.Automation.Peers.FrameworkElementAutomationPeer, Microsoft.UI.Xaml.Automation.Provider.IRangeValueProvider
    {
        TimelineBarAutomationPeer(TimelineBarHost owner);
    }

    // One entry in a device list: the name, the id needed to connect, the device's picture from
    // MIDI Settings (or its transport's), and its description for a tooltip.
    [default_interface]
    runtimeclass DeviceChoice
    {
        DeviceChoice();

        String DisplayName{ get; };
        String EndpointDeviceId{ get; };
        Microsoft.UI.Xaml.Media.ImageSource Picture{ get; };
        Microsoft.UI.Xaml.Visibility PictureVisibility{ get; };

        // Null when there's nothing to say, so no empty tooltip shows.
        Object Tip{ get; };
    }
}
