// The tile shown for each saved clock. It implements INotifyPropertyChanged because a clock
// starting, stopping or having its tempo nudged has to redraw one tile, not rebuild the whole
// wall of them and lose the customer's selection.
namespace midiclock
{
    [default_interface]
    runtimeclass ClockItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        ClockItem();

        String Id{ get; };

        // what the customer called it, or the endpoint name when they did not name it
        String DisplayName{ get; };

        // the headline number on the tile
        String TempoText{ get; };

        // What the headline number is: beats per minute, or frames per second for time code.
        String UnitText{ get; };

        // "<endpoint>  ·  Group 3", or the endpoint alone when it sends to every group
        String DestinationText{ get; };

        // The divider, the swing and the offset, when any of them is not at its default. Empty
        // for a plain clock, which is most of them.
        String TimingText{ get; };
        Microsoft.UI.Xaml.Visibility TimingVisibility{ get; };

        String StatusText{ get; };

        Boolean IsRunning{ get; };
        Boolean IsBusy{ get; };

        // false only while the clock is being started or stopped
        Boolean IsStartStopEnabled{ get; };

        // true while the endpoint this clock points at is not present
        Boolean IsEndpointMissing{ get; };

        Microsoft.UI.Xaml.Visibility RunningVisibility{ get; };
        Microsoft.UI.Xaml.Visibility WarningVisibility{ get; };

        String StartStopLabel{ get; };
        String StartStopGlyph{ get; };

        // Every tile carries the same three buttons, so the visible label alone would give a
        // screen reader the same name over and over. These name the clock as well.
        String StartStopAccessibleName{ get; };
        String EditAccessibleName{ get; };
        String SelectAccessibleName{ get; };

        // What a screen reader announces for the whole tile. The tile shows four separate text
        // elements, but only the container's name is spoken.
        String TileAccessibleName{ get; };

        // included in "start selected"; two way, driven by the tile's check box
        Boolean IsSelected;
    }
}
