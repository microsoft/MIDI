<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midiclock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midiclock"
    xmlns:shared="using:MidiAppShared"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Loaded="OnRootLoaded"
          Background="Transparent">

        <Grid.Resources>
            <!-- ============================== One saved clock ============================== -->
            <DataTemplate x:Key="ClockTileTemplate" x:DataType="local:ClockItem">
                <Grid Margin="0,0,0,0">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10,12,12"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                            Tapped="OnTileTapped">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- selection, name and edit -->
                            <Grid Grid.Row="0" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          MinWidth="0"
                                          Margin="0,0,-6,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="{x:Bind SelectAccessibleName, Mode=OneWay}"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind DisplayName, Mode=OneWay}" />

                                <Button Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Tag="{x:Bind Id}"
                                        AutomationProperties.Name="{x:Bind EditAccessibleName, Mode=OneWay}"
                                        Click="OnTileEditClick">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                </Button>
                            </Grid>

                            <!-- the number this app exists to show -->
                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="48"
                                           FontWeight="SemiBold"
                                           LineHeight="52"
                                           TextWrapping="NoWrap"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Text="{x:Bind TempoText, Mode=OneWay}" />
                                <TextBlock x:Uid="TileBpmCaption"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <!-- where it goes -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind WarningVisibility, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind DestinationText, Mode=OneWay}" />
                            </StackPanel>

                            <Button Grid.Row="3"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Tag="{x:Bind Id}"
                                    IsEnabled="{x:Bind IsStartStopEnabled, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind StartStopAccessibleName, Mode=OneWay}"
                                    Click="OnTileStartStopClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="12" Glyph="{x:Bind StartStopGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StartStopLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- a separate layer, so the card keeps its own border when it is not running -->
                    <Border IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <!-- ============================ Endpoint picker rows ============================ -->
            <DataTemplate x:Key="EndpointChoiceTemplate" x:DataType="shared:EndpointChoice">
                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center"
                           Source="{x:Bind ImageSource}"
                           Visibility="{x:Bind ImageVisibility}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Bind DisplayName}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NamedChoiceTemplate" x:DataType="shared:NamedChoice">
                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint"
                Grid.Row="0"
                Grid.RowSpan="3"
                Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <StackPanel.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </StackPanel.Resources>

                <ToggleButton x:Name="SettingsToggle"
                              x:Uid="SettingsToggle"
                              AutomationProperties.AutomationId="SettingsToggle"
                              Width="46"
                              Height="32"
                              Padding="0"
                              BorderThickness="0"
                              Click="OnSettingsToggleClick">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </ToggleButton>

                <ToggleButton x:Name="AlwaysOnTopToggle"
                              x:Uid="AlwaysOnTopToggle"
                              AutomationProperties.AutomationId="AlwaysOnTopToggle"
                              Width="46"
                              Height="32"
                              Padding="0"
                              BorderThickness="0"
                              Click="OnAlwaysOnTopToggled">
                    <FontIcon Glyph="&#xE718;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- ================================ The clock wall ================================ -->
        <ScrollViewer x:Name="TileScroller"
                      Grid.Row="1"
                      Padding="16,4,16,12"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <muxc:ItemsRepeater x:Name="ClockRepeater"
                                AutomationProperties.AutomationId="ClockRepeater"
                                ItemTemplate="{StaticResource ClockTileTemplate}">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="236"
                                            MinItemHeight="212"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="12"
                                            ItemsStretch="Fill" />
                </muxc:ItemsRepeater.Layout>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    Spacing="8"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon Glyph="&#xE916;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Uid="EmptyStateTitle"
                       HorizontalAlignment="Center"
                       Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="EmptyStateDescription"
                       HorizontalAlignment="Center"
                       MaxWidth="420"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ================================= Command bar ================================= -->
        <Border Grid.Row="2"
                Padding="16,10,16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="40" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="AddClockButton"
                        x:Uid="AddClockButton"
                        Grid.Column="0"
                        AutomationProperties.AutomationId="AddClockButton"
                        Click="OnAddClockClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock x:Uid="AddClockButtonText" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{ThemeResource CaptionTextBlockStyle}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartSelectedButton"
                            x:Uid="StartSelectedButton"
                            AutomationProperties.AutomationId="StartSelectedButton"
                            Click="OnStartSelectedClick" />
                    <Button x:Name="StartAllButton"
                            x:Uid="StartAllButton"
                            AutomationProperties.AutomationId="StartAllButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnStartAllClick" />
                    <Button x:Name="StopAllButton"
                            x:Uid="StopAllButton"
                            AutomationProperties.AutomationId="StopAllButton"
                            Click="OnStopAllClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================== The clock editor =============================== -->
        <ContentDialog x:Name="EditDialog"
                       Grid.Row="0"
                       Grid.RowSpan="3"
                       DefaultButton="Primary"
                       PrimaryButtonClick="OnEditDialogSaveClick"
                       SecondaryButtonClick="OnEditDialogDeleteClick">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
            </ContentDialog.Resources>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,4,0">
                <StackPanel Spacing="10" MinWidth="460">
                    <TextBox x:Name="EditNameTextBox"
                             x:Uid="EditNameTextBox"
                             AutomationProperties.AutomationId="EditNameTextBox"
                             MaxLength="64" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <muxc:NumberBox x:Name="EditTempoNumberBox"
                                            x:Uid="EditTempoNumberBox"
                                            AutomationProperties.AutomationId="EditTempoNumberBox"
                                            SpinButtonPlacementMode="Inline"
                                            SmallChange="1"
                                            LargeChange="10"
                                            ValueChanged="OnEditTempoValueChanged" />
                            <Slider x:Name="EditTempoSlider"
                                    x:Uid="EditTempoSlider"
                                    AutomationProperties.AutomationId="EditTempoSlider"
                                    StepFrequency="0.5"
                                    TickFrequency="20"
                                    ValueChanged="OnEditTempoSliderChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                            <Button x:Name="TapTempoButton"
                                    x:Uid="TapTempoButton"
                                    AutomationProperties.AutomationId="TapTempoButton"
                                    Width="132"
                                    Height="80"
                                    Click="OnTapTempoClick">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="18" HorizontalAlignment="Center" />
                                    <TextBlock x:Uid="TapTempoButtonText"
                                               HorizontalAlignment="Center"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TapTempoHintTextBlock"
                                       HorizontalAlignment="Center"
                                       MaxWidth="132"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>

                    <ComboBox x:Name="EditEndpointComboBox"
                              x:Uid="EditEndpointComboBox"
                              AutomationProperties.AutomationId="EditEndpointComboBox"
                              HorizontalAlignment="Stretch"
                              ItemTemplate="{StaticResource EndpointChoiceTemplate}"
                              SelectionChanged="OnEditEndpointSelectionChanged" />

                    <ComboBox x:Name="EditGroupComboBox"
                              x:Uid="EditGroupComboBox"
                              AutomationProperties.AutomationId="EditGroupComboBox"
                              HorizontalAlignment="Stretch"
                              ItemTemplate="{StaticResource NamedChoiceTemplate}" />

                    <ToggleSwitch x:Name="EditSendStartStopToggle"
                                  x:Uid="EditSendStartStopToggle"
                                  AutomationProperties.AutomationId="EditSendStartStopToggle" />

                    <InfoBar x:Name="EditInfoBar"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Warning" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
