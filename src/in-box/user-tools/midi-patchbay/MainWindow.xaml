<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midipatchbay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midipatchbay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,4,10,4" />
                <Setter Property="Height" Value="32" />
            </Style>
            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="MaxWidth" Value="600" />
                <Setter Property="MaxHeight" Value="720" />
            </Style>

            <!-- The palette's step tiles: three to a row, square, sized in code to the palette's width. -->
            <!-- Not an ItemsWrapGrid: that one throws its tiles away and builds them again each
                 time their size changes, which flickers while the palette is resized. -->
            <ItemsPanelTemplate x:Key="PaletteTilesPanel">
                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
            </ItemsPanelTemplate>
            <Style x:Key="PaletteTileContainerStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- ====================== Theme brushes for visuals built in code ======================
             The canvas and the details panel are built in code, and code cannot hold a
             {ThemeResource} reference. Looking these up in Application.Resources returns the
             brush for the system theme, which is wrong whenever the customer has overridden the
             theme for this window. Each border below carries one brush that XAML re-resolves on
             every theme change, and ThemeBrushes hands it to the code that needs it.
             Zero sized rather than collapsed, so nothing here can be skipped as unrealized. -->
        <Grid x:Name="ThemeBrushSource" Grid.Row="0" Width="0" Height="0"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border x:Name="TextFillColorPrimaryBrush" Background="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border x:Name="TextFillColorSecondaryBrush" Background="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="TextFillColorTertiaryBrush" Background="{ThemeResource TextFillColorTertiaryBrush}" />
            <Border x:Name="AccentFillColorDefaultBrush" Background="{ThemeResource AccentFillColorDefaultBrush}" />
            <Border x:Name="SystemFillColorCriticalBrush" Background="{ThemeResource SystemFillColorCriticalBrush}" />
            <Border x:Name="SystemFillColorCriticalBackgroundBrush" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            <Border x:Name="SystemFillColorCautionBrush" Background="{ThemeResource SystemFillColorCautionBrush}" />
            <Border x:Name="SystemFillColorSuccessBrush" Background="{ThemeResource SystemFillColorSuccessBrush}" />
            <Border x:Name="DividerStrokeColorDefaultBrush" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="ControlAltFillColorSecondaryBrush" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" />
            <Border x:Name="SolidBackgroundFillColorSecondaryBrush" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
            <Border x:Name="SolidBackgroundFillColorTertiaryBrush" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            <Border x:Name="CardBackgroundFillColorDefaultBrush" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Border x:Name="CardBackgroundFillColorSecondaryBrush" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Border x:Name="CardStrokeColorDefaultBrush" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Grid>

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Patchbay"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <!-- A shape, not a Border: a Border snaps its corner radius to whole pixels
                     along with its bounds, so at 125% scaling the arc comes out stepped. -->
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>

            <!-- Every patch has a window of its own, so the way back to the rest of them is here. -->
            <Button x:Name="LibraryButton"
                    x:Uid="LibraryButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnLibraryButtonClick">
                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
            </Button>
        </Grid>

        <!-- =================================== Editor =================================== -->
            <Grid x:Name="ContentRoot" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============================ patch header ============================ -->
                <Grid x:Name="PatchHeader" Grid.Row="0" Margin="20,10,16,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PatchNameText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PatchDescriptionText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Border x:Name="StateChip"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            CornerRadius="11"
                            Padding="10,3,10,3"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBlock x:Name="StateChipText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <ToggleButton x:Name="RoutingToggle"
                                  x:Uid="RoutingToggle"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Click="OnRoutingToggleClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock x:Name="RoutingToggleText" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleSwitch x:Name="AutoStartSwitch"
                                  x:Uid="AutoStartSwitch"
                                  Grid.Column="3"
                                  VerticalAlignment="Center"
                                  OnContent="Start automatically"
                                  OffContent="Start automatically"
                                  Toggled="OnAutoStartToggled" />

                    <Button x:Name="SavePatchButton"
                            x:Uid="SavePatchButton"
                            Grid.Column="4"
                            Content="Save"
                            VerticalAlignment="Center"
                            Click="OnSavePatchClick" />

                    <Button x:Name="PatchMenuButton"
                            x:Uid="PatchMenuButton"
                            Grid.Column="5"
                            Width="36"
                            VerticalAlignment="Center"
                            Click="OnPatchMenuClick">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- ============================== messages ============================== -->
                <StackPanel x:Name="MessageBars" Grid.Row="1" Margin="20,0,16,0" Spacing="6">
                    <!-- A patch from an earlier version was turned into steps when it was read.
                         The original file is kept, and this is where the customer finds it. -->
                    <InfoBar x:Name="ConversionBar"
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="True"
                             CloseButtonClick="OnConversionBarCloseClick">
                        <InfoBar.ActionButton>
                            <Button x:Name="ConversionShowButton"
                                    x:Uid="ConversionShowButton"
                                    Content="Show the original"
                                    Click="OnShowEarlierVersionClick" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- The toggle in the header is easy to miss, and a patch that is not routing
                         looks exactly like one that is until a note fails to arrive. -->
                    <InfoBar x:Name="NotRoutingBar"
                             x:Uid="NotRoutingBar"
                             Severity="Warning"
                             IsOpen="False"
                             IsClosable="False"
                             Title="This patch isn't routing"
                             Message="Nothing passes through its connections until you start routing.">
                        <InfoBar.ActionButton>
                            <Button x:Name="NotRoutingStartButton"
                                    x:Uid="NotRoutingStartButton"
                                    Content="Start routing"
                                    Click="OnNotRoutingStartClick" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- A patch routing today looks set up for good, and after a restart it is not. -->
                    <InfoBar x:Name="AutoStartBar"
                             x:Uid="AutoStartBar"
                             Severity="Warning"
                             IsOpen="False"
                             IsClosable="True"
                             Title="This patch doesn't automatically start with the Patchbay app"
                             CloseButtonClick="OnAutoStartBarCloseClick" />

                    <InfoBar x:Name="ServiceBar"
                             x:Uid="ServiceBar"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="False"
                             Title="Windows MIDI Services is not responding"
                             Message="Patches cannot route until the service is running." />

                    <InfoBar x:Name="LoopBar"
                             Severity="Error"
                             IsOpen="False"
                             IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button x:Name="LoopShowButton"
                                    x:Uid="LoopShowButton"
                                    Content="Show loop"
                                    Click="OnShowLoopClick" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar x:Name="OfflineBar"
                             Severity="Warning"
                             IsOpen="False"
                             IsClosable="True" />

                    <InfoBar x:Name="StatusBar"
                             Severity="Informational"
                             IsOpen="False"
                             IsClosable="True" />
                </StackPanel>

                <!-- ============================== toolbar =============================== -->
                <Grid x:Name="CanvasToolbar" Grid.Row="2" Height="48" Margin="16,4,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                        <Button x:Name="UndoButton"
                                x:Uid="UndoButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                IsEnabled="False"
                                Click="OnUndoClick">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        </Button>
                        <Button x:Name="RedoButton"
                                x:Uid="RedoButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                IsEnabled="False"
                                Click="OnRedoClick">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        </Button>
                        <Border Width="1" Height="20" Margin="4,0,4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="CutButton"
                                x:Uid="CutButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                IsEnabled="False"
                                Click="OnCutClick">
                            <FontIcon Glyph="&#xE8C6;" FontSize="14" />
                        </Button>
                        <Button x:Name="CopyButton"
                                x:Uid="CopyButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                IsEnabled="False"
                                Click="OnCopyClick">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                        <Button x:Name="PasteButton"
                                x:Uid="PasteButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                Click="OnPasteClick">
                            <FontIcon Glyph="&#xE77F;" FontSize="14" />
                        </Button>
                        <Button x:Name="DeleteButton"
                                x:Uid="DeleteButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="36"
                                IsEnabled="False"
                                Click="OnDeleteClick">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                        <Border Width="1" Height="20" Margin="4,0,4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="AddEndpointButton"
                                x:Uid="AddEndpointButton"
                                Content="Add endpoint"
                                Height="32"
                                Click="OnAddEndpointClick" />
                        <Button x:Name="CreateLoopbackButton"
                                x:Uid="CreateLoopbackButton"
                                Content="Create loopback"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="OnCreateLoopbackClick" />
                        <Border Width="1" Height="20" Margin="4,0,4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="AutoArrangeButton"
                                x:Uid="AutoArrangeButton"
                                Content="Auto arrange"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnAutoArrangeClick" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <Button x:Name="ZoomOutButton"
                                x:Uid="ZoomOutButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="32"
                                Click="OnZoomOutClick">
                            <FontIcon Glyph="&#xE71F;" FontSize="14" />
                        </Button>
                        <Button x:Name="ZoomButton"
                                x:Uid="ZoomButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                MinWidth="52"
                                Padding="4,0,4,0">
                            <TextBlock x:Name="ZoomText"
                                       TextAlignment="Center"
                                       Style="{StaticResource StatusTextStyle}" />
                            <Button.Flyout>
                                <Flyout x:Name="ZoomFlyout" Opening="OnZoomFlyoutOpening">
                                    <StackPanel Spacing="10" Width="188">
                                        <Button x:Name="ZoomFitButton"
                                                x:Uid="ZoomFitButton"
                                                Content="Fit to screen"
                                                HorizontalAlignment="Stretch"
                                                Click="OnZoomFitClick" />
                                        <NumberBox x:Name="ZoomInputBox"
                                                   x:Uid="ZoomInputBox"
                                                   Header="Zoom (%)"
                                                   Minimum="10"
                                                   Maximum="400"
                                                   SmallChange="5"
                                                   LargeChange="10"
                                                   SpinButtonPlacementMode="Inline"
                                                   ValidationMode="InvalidInputOverwritten"
                                                   ValueChanged="OnZoomValueChanged" />
                                        <Button x:Name="ZoomApplyButton"
                                                x:Uid="ZoomApplyButton"
                                                Content="Apply"
                                                HorizontalAlignment="Right"
                                                Click="OnZoomApplyClick" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ZoomInButton"
                                x:Uid="ZoomInButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="32"
                                Click="OnZoomInClick">
                            <FontIcon Glyph="&#xE8A3;" FontSize="14" />
                        </Button>
                        <Border Width="1" Height="20" Margin="4,0,4,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button x:Name="TestButton"
                                x:Uid="TestButton"
                                Content="Test"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnTestClick" />
                    </StackPanel>
                </Grid>

                <!-- =============================== canvas =============================== -->
                <Grid Grid.Row="3" Margin="16,8,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- WinUI has no splitter, so each resize bar is a border with pointer handlers:
                         a grab area as wide as the gap between the panels, with a line down the
                         middle that lights up under the pointer. -->
                    <Border x:Name="PaletteSplitter"
                            x:Uid="PaletteSplitter"
                            Grid.Column="1"
                            Width="12"
                            Background="Transparent"
                            Tag="palette"
                            PointerPressed="OnSplitterPressed"
                            PointerMoved="OnSplitterMoved"
                            PointerReleased="OnSplitterReleased"
                            PointerCaptureLost="OnSplitterReleased"
                            PointerEntered="OnSplitterEntered"
                            PointerExited="OnSplitterExited">
                        <Grid>
                            <Rectangle Width="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       HorizontalAlignment="Center"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Rectangle Width="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       HorizontalAlignment="Center"
                                       Opacity="0"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Border>

                    <Border x:Name="InspectorSplitter"
                            x:Uid="InspectorSplitter"
                            Grid.Column="3"
                            Width="12"
                            Background="Transparent"
                            Visibility="Collapsed"
                            Tag="inspector"
                            PointerPressed="OnSplitterPressed"
                            PointerMoved="OnSplitterMoved"
                            PointerReleased="OnSplitterReleased"
                            PointerCaptureLost="OnSplitterReleased"
                            PointerEntered="OnSplitterEntered"
                            PointerExited="OnSplitterExited">
                        <Grid>
                            <Rectangle Width="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       HorizontalAlignment="Center"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Rectangle Width="2"
                                       RadiusX="1"
                                       RadiusY="1"
                                       HorizontalAlignment="Center"
                                       Opacity="0"
                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </Border>

                    <!-- ============================== palette =============================== -->
                    <Border x:Name="PalettePanel"
                            Grid.Column="0"
                            Width="240"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <SelectorBar x:Name="PaletteTabs"
                                         x:Uid="PaletteTabs"
                                         Grid.Row="0"
                                         Margin="4,2,4,0"
                                         SelectionChanged="OnPaletteTabChanged">
                                <SelectorBarItem x:Name="PaletteStepsTab"
                                                 x:Uid="PaletteStepsTab"
                                                 Text="Steps"
                                                 IsSelected="True" />
                                <SelectorBarItem x:Name="PaletteEndpointsTab"
                                                 x:Uid="PaletteEndpointsTab"
                                                 Text="Endpoints" />
                            </SelectorBar>

                            <TextBox x:Name="PaletteSearchBox"
                                     x:Uid="PaletteSearchBox"
                                     Grid.Row="1"
                                     Margin="10,4,10,8"
                                     PlaceholderText="Search"
                                     TextChanged="OnPaletteSearchChanged" />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PaletteContent"
                                            Spacing="4"
                                            Padding="10,0,10,12"
                                            SizeChanged="OnPaletteContentSizeChanged" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
                        <Grid>
                            <ScrollViewer x:Name="CanvasScroller"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Auto"
                                          ZoomMode="Enabled"
                                          MinZoomFactor="0.1"
                                          MaxZoomFactor="4"
                                          Padding="0">
                                <Canvas x:Name="CanvasSurface"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="Transparent" />
                            </ScrollViewer>

                            <StackPanel x:Name="EmptyCanvasPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                <FontIcon Glyph="&#xE71B;"
                                          FontSize="34"
                                          Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                                <TextBlock x:Name="EmptyCanvasTitle"
                                           x:Uid="EmptyCanvasTitle"
                                           Text="Nothing on this patch yet"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="EmptyCanvasSubtitle"
                                           x:Uid="EmptyCanvasSubtitle"
                                           Text="Add the endpoints you want to route between, then drag from an Out connection point to an In connection point. Nothing is sent until you do."
                                           FontSize="12"
                                           MaxWidth="360"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button x:Name="EmptyCanvasAddButton"
                                        x:Uid="EmptyCanvasAddButton"
                                        Content="Add endpoint"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0"
                                        Click="OnAddEndpointClick" />
                            </StackPanel>

                            <Border x:Name="MinimapPanel"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,14,14"
                                    Padding="6"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Canvas x:Name="MinimapSurface" Width="170" Height="116" Background="Transparent" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="InspectorPanel"
                            Grid.Column="4"
                            Width="300"
                            CornerRadius="6"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="44" Padding="14,0,8,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InspectorTitle"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="InspectorPopOutButton"
                                        x:Uid="InspectorPopOutButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Visibility="Collapsed">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                </Button>
                                <Button x:Name="InspectorCloseButton"
                                        x:Uid="InspectorCloseButton"
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnInspectorCloseClick">
                                    <FontIcon Glyph="&#xE711;" FontSize="13" />
                                </Button>
                            </Grid>

                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <ScrollViewer Grid.Row="1" Padding="14,12,14,14">
                                <StackPanel x:Name="InspectorContent" Spacing="14" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================== status bar ============================ -->
                <Grid Grid.Row="4" Height="34" Margin="20,4,20,4">
                    <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusEndpointsText" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock x:Name="StatusStepsText" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock x:Name="StatusConnectionsText" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock x:Name="StatusRateText" Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusLoopText"
                               HorizontalAlignment="Right"
                               Style="{StaticResource StatusTextStyle}" />
                </Grid>
            </Grid>

        <!-- ================================== dialogs =================================== -->
        <ContentDialog x:Name="SavePatchDialog"
                       x:Uid="SavePatchDialog"
                       Title="Save patch"
                       PrimaryButtonText="Save"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="14" Width="480">
                <TextBlock x:Name="SavePatchIntroText"
                           x:Uid="SavePatchIntroText"
                           Text="Patches are files in Documents, MIDI Patchbay. You can copy one to another PC, but the endpoints have to be matched there."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SavePatchNameBox"
                         x:Uid="SavePatchNameBox"
                         Header="Name"
                         MaxLength="96"
                         TextChanged="OnSavePatchNameChanged" />
                <TextBox x:Name="SavePatchDescriptionBox"
                         x:Uid="SavePatchDescriptionBox"
                         Header="Description (optional)"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxLength="400"
                         Height="80" />
                <TextBlock x:Uid="SavePatchDescriptionHint"
                           Text="Shown when you hover the patch in the list."
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <RadioButton x:Name="SavePatchKeepRadio"
                             x:Uid="SavePatchKeepRadio"
                             Content="Saved"
                             GroupName="SavePatchKind"
                             IsChecked="True" />
                <TextBlock x:Uid="SavePatchKeepHint"
                           Text="Saved to disk and offered again next time Patchbay starts."
                           FontSize="11"
                           Margin="30,-8,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <RadioButton x:Name="SavePatchTemporaryRadio"
                             x:Uid="SavePatchTemporaryRadio"
                             Content="Temporary"
                             GroupName="SavePatchKind" />
                <TextBlock x:Uid="SavePatchTemporaryHint"
                           Text="Routes now, disappears when Patchbay closes. Nothing is written to disk."
                           FontSize="11"
                           Margin="30,-8,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <CheckBox x:Name="SavePatchStartupCheck"
                          x:Uid="SavePatchStartupCheck"
                          Content="Start automatically"
                          IsChecked="True" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="CreateLoopbackDialog"
                       x:Uid="CreateLoopbackDialog"
                       Title="Create loopback"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="12" Width="480">
                <TextBlock x:Uid="CreateLoopbackIntroText"
                           Text="A loopback is what a DAW or another app connects to. Patchbay can only route a message source to a message destination, so a loopback is how you get messages into software that is not on this canvas."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <RadioButton x:Name="LoopbackBasicRadio"
                             x:Uid="LoopbackBasicRadio"
                             Content="MIDI 1.0 basic loopback"
                             GroupName="LoopbackKind"
                             IsChecked="True" />
                <TextBlock x:Uid="LoopbackBasicHint"
                           Text="One endpoint that echoes back to itself. The simplest thing for most apps."
                           FontSize="11"
                           Margin="30,-8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <RadioButton x:Name="LoopbackPairRadio"
                             x:Uid="LoopbackPairRadio"
                             Content="MIDI 2.0 loopback pair (A and B)"
                             GroupName="LoopbackKind" />
                <TextBlock x:Uid="LoopbackPairHint"
                           Text="Two endpoints. Send into A, read from B. UMP, full MIDI 2.0."
                           FontSize="11"
                           Margin="30,-8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="LoopbackNameBox"
                         x:Uid="LoopbackNameBox"
                         Header="Name"
                         MaxLength="96"
                         TextChanged="OnLoopbackNameChanged" />
                <CheckBox x:Name="LoopbackKeepCheck"
                          x:Uid="LoopbackKeepCheck"
                          Content="Keep after Patchbay closes"
                          IsChecked="True" />
                <InfoBar x:Uid="LoopbackInfoBar"
                         Severity="Informational"
                         IsOpen="True"
                         IsClosable="False"
                         Message="Loopbacks are real MIDI endpoints on this PC. Every app sees them, not just Patchbay." />
                <TextBlock x:Name="LoopbackErrorText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ConfirmDeleteDialog"
                       x:Uid="ConfirmDeleteDialog"
                       Title="Delete this patch?"
                       PrimaryButtonText="Delete"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmDeleteText" TextWrapping="Wrap" />
        </ContentDialog>

        <ContentDialog x:Name="ConfirmRemoveDialog"
                       x:Uid="ConfirmRemoveDialog"
                       Title="Remove this from the patch?"
                       PrimaryButtonText="Remove"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <StackPanel Spacing="14" Width="400">
                <TextBlock x:Name="ConfirmRemoveText" TextWrapping="Wrap" />
                <CheckBox x:Name="ConfirmRemoveSkipCheck"
                          x:Uid="ConfirmRemoveSkipCheck"
                          Content="Don't ask again" />
            </StackPanel>
        </ContentDialog>

        <!-- One dialog for every kind of step. Its sections are built in code for the kind being
             edited, and it works on a copy, so Cancel leaves a running patch alone. -->
        <ContentDialog x:Name="BlockDialog"
                       x:Uid="BlockDialog"
                       Title="Step"
                       PrimaryButtonText="Apply"
                       SecondaryButtonText="Reset"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <!-- Sized in code to the window, so a long step shows all at once on a large screen. The
                 template's own limits are lifted so the content decides. -->
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">10000</x:Double>
                <x:Double x:Key="ContentDialogMaxHeight">10000</x:Double>
            </ContentDialog.Resources>
            <Grid x:Name="BlockDialogBody" Width="760" MaxHeight="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="BlockDialogIntroText"
                           Grid.Row="0"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel x:Name="BlockDialogContent" Spacing="16" />
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="0,14,0,0"
                        Padding="12,10,12,10"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock x:Name="BlockSummaryText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </ContentDialog>
    </Grid>
</Window>
