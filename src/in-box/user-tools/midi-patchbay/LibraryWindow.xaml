<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="midipatchbay.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:midipatchbay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SubtleToolbarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- One part of a segmented choice, filled only when it is the one chosen. A shape draws
                 the fill, because the default template's Border steps its corners at 125%. -->
            <Style x:Key="SegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <VisualState.Setters>
                                                <Setter Target="Face.Fill" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Rectangle x:Name="Face"
                                           RadiusX="3"
                                           RadiusY="3"
                                           UseLayoutRounding="False"
                                           Fill="{ThemeResource SubtleFillColorTransparentBrush}" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A tile draws its own surface, so the container adds nothing but focus. Anything it
                 painted would show as a frame around the map. -->
            <Style x:Key="PatchItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,14,14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- ====================== Theme brushes for visuals built in code ======================
             The tiles here and the canvas in every editor are built in code, and code cannot
             hold a {ThemeResource} reference. Each border below carries one brush that XAML
             re-resolves on every theme change, and ThemeBrushes hands it to the code that needs
             it. This window lives as long as the app, so every editor borrows these.
             Zero sized rather than collapsed, so nothing here can be skipped as unrealized. -->
        <Grid x:Name="ThemeBrushSource" Grid.Row="0" Width="0" Height="0"
              Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border x:Name="TextFillColorPrimaryBrush" Background="{ThemeResource TextFillColorPrimaryBrush}" />
            <Border x:Name="TextFillColorSecondaryBrush" Background="{ThemeResource TextFillColorSecondaryBrush}" />
            <Border x:Name="TextFillColorTertiaryBrush" Background="{ThemeResource TextFillColorTertiaryBrush}" />
            <Border x:Name="AccentFillColorDefaultBrush" Background="{ThemeResource AccentFillColorDefaultBrush}" />
            <Border x:Name="SystemFillColorCriticalBrush" Background="{ThemeResource SystemFillColorCriticalBrush}" />
            <Border x:Name="SystemFillColorCriticalBackgroundBrush" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            <Border x:Name="SystemFillColorCautionBrush" Background="{ThemeResource SystemFillColorCautionBrush}" />
            <Border x:Name="SystemFillColorSuccessBrush" Background="{ThemeResource SystemFillColorSuccessBrush}" />
            <Border x:Name="DividerStrokeColorDefaultBrush" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border x:Name="ControlAltFillColorSecondaryBrush" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" />
            <Border x:Name="SolidBackgroundFillColorSecondaryBrush" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" />
            <Border x:Name="SolidBackgroundFillColorTertiaryBrush" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            <Border x:Name="CardBackgroundFillColorDefaultBrush" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Border x:Name="CardBackgroundFillColorSecondaryBrush" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Border x:Name="CardStrokeColorDefaultBrush" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Border x:Name="SubtleFillColorSecondaryBrush" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="ControlStrokeColorDefaultBrush" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Border x:Name="ControlStrongStrokeColorDefaultBrush" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Border x:Name="ControlSolidFillColorDefaultBrush" Background="{ThemeResource ControlSolidFillColorDefaultBrush}" />
            <Border x:Name="SystemFillColorSuccessBackgroundBrush" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
            <Border x:Name="SystemFillColorCautionBackgroundBrush" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
            <Border x:Name="SystemFillColorAttentionBrush" Background="{ThemeResource SystemFillColorAttentionBrush}" />
            <Border x:Name="SystemFillColorAttentionBackgroundBrush" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
            <Border x:Name="AccentTextFillColorPrimaryBrush" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Border x:Name="CanvasSurfaceBrush" Background="{ThemeResource CanvasSurfaceBrush}" />
        </Grid>

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Text="Windows MIDI Patchbay"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <!-- A shape, not a Border: a Border snaps its corner radius to whole pixels
                     along with its bounds, so at 125% scaling the arc comes out stepped. -->
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- =================================== Library =================================== -->
        <Grid x:Name="ContentRoot" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================== toolbar =============================== -->
            <Border Grid.Row="0"
                    Height="48"
                    Padding="12,0,12,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="8">
                    <!-- The search box gives up its width before anything on the right is cut off. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1000*" MinWidth="140" MaxWidth="250" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="NewPatchButton"
                            x:Uid="NewPatchButton"
                            Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="32"
                            Padding="12,0,12,0"
                            VerticalAlignment="Center"
                            Click="OnNewPatchClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="NewPatchText" Text="New patch" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NewQuickPatchButton"
                            x:Uid="NewQuickPatchButton"
                            Grid.Column="1"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnNewQuickPatchClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="14" />
                            <TextBlock x:Uid="NewQuickPatchText" Text="New quick patch" />
                        </StackPanel>
                    </Button>

                    <Rectangle Grid.Column="2"
                               Width="1"
                               Height="20"
                               Margin="3,0,3,0"
                               VerticalAlignment="Center"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <AutoSuggestBox x:Name="SearchBox"
                                    x:Uid="SearchBox"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    QueryIcon="Find"
                                    PlaceholderText="Search patches"
                                    TextChanged="OnSearchTextChanged" />

                    <ComboBox x:Name="SortSelector"
                              x:Uid="SortSelector"
                              Grid.Column="4"
                              MinWidth="176"
                              VerticalAlignment="Center"
                              SelectionChanged="OnSortSelectionChanged" />

                    <!-- Framed like the filter, with the chosen view filled. -->
                    <Grid Grid.Column="5" VerticalAlignment="Center">
                        <Rectangle RadiusX="4.5"
                                   RadiusY="4.5"
                                   StrokeThickness="1"
                                   UseLayoutRounding="False"
                                   Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   Fill="{ThemeResource ControlFillColorDefaultBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="3">
                            <ToggleButton x:Name="GridViewToggle"
                                          x:Uid="GridViewToggle"
                                          Style="{StaticResource SegmentStyle}"
                                          Width="34"
                                          Height="26"
                                          Padding="0"
                                          Click="OnGridViewToggled">
                                <FontIcon Glyph="&#xE80A;" FontSize="13" />
                            </ToggleButton>
                            <ToggleButton x:Name="ListViewToggle"
                                          x:Uid="ListViewToggle"
                                          Style="{StaticResource SegmentStyle}"
                                          Width="34"
                                          Height="26"
                                          Padding="0"
                                          Click="OnListViewToggled">
                                <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                        <!-- Copies a starting prompt for the customer's own AI assistant. Nothing is sent from here. -->
                        <Button x:Name="AssistantButton"
                                x:Uid="AssistantButton"
                                Style="{StaticResource SubtleToolbarButtonStyle}"
                                Click="OnAssistantClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F2;" FontSize="14" />
                                <TextBlock x:Uid="AssistantText" Text="Ask an AI assistant…" />
                            </StackPanel>
                        </Button>

                        <!-- A patch written somewhere else, by an agent or a friend, comes in here. -->
                        <Button x:Name="ImportPatchButton"
                                x:Uid="ImportPatchButton"
                                Style="{StaticResource SubtleToolbarButtonStyle}"
                                Click="OnImportPatchClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock x:Uid="ImportPatchText" Text="Import patch…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="LibraryMoreButton"
                            x:Uid="LibraryMoreButton"
                            Grid.Column="8"
                            Width="38"
                            Padding="0"
                            Style="{StaticResource SubtleToolbarButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="LibraryMenuOpenFolder" Text="Open patch folder" Click="OnOpenFolderClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================== messages ============================== -->
            <StackPanel Grid.Row="1" Margin="24,10,24,0" Spacing="6">
                <InfoBar x:Name="ServiceBar"
                         x:Uid="ServiceBar"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="False"
                         Title="Windows MIDI Services is not responding"
                         Message="Patches cannot route until the service is running." />

                <InfoBar x:Name="StatusBar"
                         Severity="Informational"
                         IsOpen="False"
                         IsClosable="True" />
            </StackPanel>

            <!-- ================================ tiles ================================= -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="PatchesHeadingRow" Margin="24,14,24,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PatchesHeading"
                               x:Uid="PatchesHeading"
                               Text="Patches"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="PatchesCount"
                               Grid.Column="1"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!-- Each part says how many patches it would show, so what needs a look is
                         plain before anything is clicked. -->
                    <Grid x:Name="FilterSegments"
                          Grid.Column="3"
                          VerticalAlignment="Center">
                        <Rectangle RadiusX="4.5"
                                   RadiusY="4.5"
                                   StrokeThickness="1"
                                   UseLayoutRounding="False"
                                   Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   Fill="{ThemeResource ControlFillColorDefaultBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="3">
                            <ToggleButton x:Name="FilterAllItem"
                                          Style="{StaticResource SegmentStyle}"
                                          IsChecked="True"
                                          Click="OnFilterClick">
                                <TextBlock x:Name="FilterAllText" x:Uid="FilterAllText" Text="All" />
                            </ToggleButton>
                            <ToggleButton x:Name="FilterRoutingItem"
                                          Style="{StaticResource SegmentStyle}"
                                          Click="OnFilterClick">
                                <TextBlock x:Name="FilterRoutingText" />
                            </ToggleButton>
                            <ToggleButton x:Name="FilterStoppedItem"
                                          Style="{StaticResource SegmentStyle}"
                                          Click="OnFilterClick">
                                <TextBlock x:Name="FilterStoppedText" />
                            </ToggleButton>
                            <ToggleButton x:Name="FilterAttentionItem"
                                          Style="{StaticResource SegmentStyle}"
                                          Click="OnFilterClick">
                                <TextBlock x:Name="FilterAttentionText" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Grid>

                <GridView x:Name="PatchGrid"
                          x:Uid="PatchGrid"
                          Grid.Row="1"
                          Padding="24,0,10,10"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{StaticResource PatchItemStyle}"
                          ItemClick="OnPatchTileClick"
                          SizeChanged="OnPatchGridSizeChanged">
                    <!-- The tiles are built again whenever a device comes or goes, so an entrance
                         animation would play every time and read as a glitch. -->
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection />
                    </GridView.ItemContainerTransitions>
                </GridView>

                <StackPanel x:Name="EmptyPanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE71B;"
                              FontSize="34"
                              Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                    <TextBlock x:Uid="LibraryEmptyTitle"
                               Text="No patches yet"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Uid="LibraryEmptySubtitle"
                               Text="A patch connects MIDI devices and apps, and can change messages on the way. Each one opens in a window of its own."
                               FontSize="12"
                               MaxWidth="380"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button x:Name="EmptyNewPatchButton"
                            x:Uid="EmptyNewPatchButton"
                            Content="New patch"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnNewPatchClick" />
                </StackPanel>

                <TextBlock x:Name="NoMatchesText"
                           x:Uid="NoMatchesText"
                           Grid.Row="1"
                           Text="No patches match."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>

            <!-- ============================== status bar ============================ -->
            <Border Grid.Row="3"
                    Height="30"
                    Padding="16,0,16,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE8B7;"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <TextBlock x:Name="FolderStatusText" Grid.Column="1" Style="{StaticResource StatusTextStyle}" />

                    <TextBlock x:Name="ActivityStatusText" Grid.Column="2" Style="{StaticResource StatusTextStyle}" />

                    <!-- The pill is a shape, not a Border: a Border snaps its corner radius to
                         whole pixels along with its bounds and the arc comes out stepped. -->
                    <Grid Grid.Column="3" Height="19" VerticalAlignment="Center">
                        <Rectangle x:Name="ServiceChipShape"
                                   RadiusX="9.5"
                                   RadiusY="9.5"
                                   StrokeThickness="1"
                                   UseLayoutRounding="False" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0,8,0">
                            <FontIcon x:Name="ServiceChipIcon"
                                      Glyph="&#xE73E;"
                                      FontSize="10"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="ServiceChipText"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================== dialogs =================================== -->
        <ContentDialog x:Name="QuickPatchDialog"
                       x:Uid="QuickPatchDialog"
                       Title="New quick patch"
                       PrimaryButtonText="Create"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
            </ContentDialog.Resources>
            <StackPanel Spacing="12" Width="480">
                <TextBlock x:Uid="QuickPatchIntroText"
                           Text="One route, from one endpoint to another. It opens as an ordinary patch, so you can add steps to it, edit it or save it afterwards."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="QuickPatchSourceCombo"
                              x:Uid="QuickPatchSourceCombo"
                              Header="Source"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnQuickPatchSourceChanged" />
                    <ComboBox x:Name="QuickPatchSourceGroupCombo"
                              x:Uid="QuickPatchSourceGroupCombo"
                              Grid.Column="1"
                              Width="190"
                              Header="Group"
                              SelectionChanged="OnQuickPatchGroupChanged" />
                </Grid>

                <FontIcon Glyph="&#xE70D;"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="QuickPatchDestinationCombo"
                              x:Uid="QuickPatchDestinationCombo"
                              Header="Destination"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnQuickPatchDestinationChanged" />
                    <ComboBox x:Name="QuickPatchDestinationGroupCombo"
                              x:Uid="QuickPatchDestinationGroupCombo"
                              Grid.Column="1"
                              Width="190"
                              Header="Group"
                              SelectionChanged="OnQuickPatchGroupChanged" />
                </Grid>

                <TextBlock x:Name="QuickPatchErrorText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ConfirmDeleteDialog"
                       x:Uid="ConfirmDeleteDialog"
                       Title="Delete this patch?"
                       PrimaryButtonText="Delete"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmDeleteText" TextWrapping="Wrap" />
        </ContentDialog>

        <!-- Closing the app stops every route, which is easy to do by accident. -->
        <ContentDialog x:Name="ConfirmExitDialog"
                       x:Uid="ConfirmExitDialog"
                       Title="Stop routing and close?"
                       PrimaryButtonText="Close"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <TextBlock x:Name="ConfirmExitText" TextWrapping="Wrap" MaxWidth="440" />
        </ContentDialog>
    </Grid>
</Window>
