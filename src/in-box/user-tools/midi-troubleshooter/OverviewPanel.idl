namespace miditroubleshooter
{
    // The Overview page: a dashboard of every check on the other pages. A control of its own,
    // so the main window only hosts it and feeds it results.
    [default_interface]
    runtimeclass OverviewPanel : Microsoft.UI.Xaml.Controls.UserControl
    {
        OverviewPanel();
    }
}
