<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="miditroubleshooter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:miditroubleshooter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="PropertyLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PropertyValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="OutputTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
                <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
            </Style>

            <!-- One glyph per state rather than a brush built in code, so the colors follow the
                 theme when the customer switches it from the appearance flyout. A registry entry
                 is one row of a table: state, name, value, and what it does. -->
            <DataTemplate x:Key="RegistryEntryTemplate" x:DataType="local:RegistryEntryItem">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Padding="0,10,0,10"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind OkVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind WarningVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Value, Mode=OneWay}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" Margin="0,2,0,0"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Comment, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Transports get their own row: the class id and module path are far too long for
                 the table columns. Where the transport is installed shows as a tag. -->
            <DataTemplate x:Key="RegistryTransportTemplate" x:DataType="local:RegistryEntryItem">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Padding="0,10,0,10"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <Grid ColumnSpacing="12" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind OkVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind WarningVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Comment, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <local:StatusPill Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top"
                                          Severity="{x:Bind TagSeverity, Mode=OneWay}"
                                          Text="{x:Bind TagText, Mode=OneWay}"
                                          Visibility="{x:Bind TagVisibility, Mode=OneWay}" />

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind Detail, Mode=OneWay}" />
                            <LineBreak />
                            <Run Text="{x:Bind Value, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- the column headings above a registry table -->
            <Style x:Key="TableHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <!-- One transport: what it is, whether it loaded, and the switch to turn it off. The
                 same template serves the In Windows and Preview groups. -->
            <DataTemplate x:Key="TransportRowTemplate" x:DataType="local:TransportItem">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4"
                        AutomationProperties.Name="{x:Bind RowAccessibleName, Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource LeadIconBoxStyle}">
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource LeadIconGlyphStyle}" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                       Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                                       Style="{StaticResource RowDetailStyle}" />
                            <TextBlock Text="{x:Bind ReasonText, Mode=OneWay}"
                                       Visibility="{x:Bind ReasonVisibility, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="{x:Bind DetailText, Mode=OneWay}" />
                                <LineBreak />
                                <Run Text="{x:Bind ModuleText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <local:StatusPill Severity="{x:Bind PillSeverity, Mode=OneWay}"
                                              Text="{x:Bind StateText, Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="20" Height="20" />
                            <!-- the built-in transports can't be turned off; the button keeps its
                                 place so the tags line up down the list -->
                            <Grid MinWidth="100">
                                <Button Content="{x:Bind ToggleText, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind ToggleAccessibleName, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                        Visibility="{x:Bind ToggleVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnToggleTransportClick" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <!-- hidden when a system backdrop is in use, so the material shows through -->
        <Border x:Name="WindowFill"
                Grid.Row="0"
                Grid.RowSpan="3"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />

        <!-- a separate layer, so switching back to the default color just hides it and the
             theme bound fill underneath returns -->
        <Border x:Name="WindowTint"
                Grid.Row="0"
                Grid.RowSpan="3"
                Visibility="Collapsed" />

        <!-- ============================ Title bar drag region ============================ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppTitleBarIcon"
                   Grid.Column="1"
                   Width="16"
                   Height="16"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center" />

            <TextBlock x:Name="AppTitleTextBlock"
                       Grid.Column="2"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <!-- Spans every column so it sits in the middle of the window rather than the middle
                 of the stretchy column. Not hit testable, so it stays part of the drag region.
                 Hidden when this is not a preview build; see midi-app-shared\PreviewBuild.h. -->
            <Grid x:Name="PreviewChiclet"
                  Grid.Column="0"
                  Grid.ColumnSpan="6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Height="18"
                  IsHitTestVisible="False">
                <!-- A shape, not a Border: a Border snaps its corner radius to whole pixels
                     along with its bounds, so at 125% scaling the arc comes out stepped. -->
                <Rectangle RadiusX="9"
                           RadiusY="9"
                           StrokeThickness="1"
                           UseLayoutRounding="False"
                           Stroke="{ThemeResource SystemFillColorCautionBrush}"
                           Fill="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                <TextBlock x:Name="PreviewChicletText"
                           x:Uid="PreviewChicletText"
                           Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="9,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </Grid>

            <Button x:Name="AppearanceButton"
                    x:Uid="AppearanceButton"
                    Grid.Column="3"
                    Width="46"
                    Height="32"
                    VerticalAlignment="Top"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="OnAppearanceButtonClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <ToggleButton x:Name="AlwaysOnTopToggle"
                          x:Uid="AlwaysOnTopToggle"
                          Grid.Column="4"
                          Width="46"
                          Height="32"
                          VerticalAlignment="Top"
                          Padding="0"
                          BorderThickness="0"
                          Click="OnAlwaysOnTopToggled">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                </ToggleButton.Resources>
                <FontIcon Glyph="&#xE718;" FontSize="14" />
            </ToggleButton>
        </Grid>

        <!-- ===================== System information, above every page ===================== -->
        <!-- Outside the navigation frame on purpose: a support engineer needs these numbers
             whichever page the customer happens to be looking at. -->
        <Border Grid.Row="1"
                Margin="16,0,16,8"
                Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="10" RowSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="SystemInfoWindowsLabel" Grid.Row="0" Grid.Column="0"
                           Text="Windows" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoWindowsValue" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource PropertyValueStyle}" />

                <TextBlock x:Uid="SystemInfoArchitectureLabel" Grid.Row="0" Grid.Column="2"
                           Text="Architecture" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoArchitectureValue" Grid.Row="0" Grid.Column="3"
                           Style="{StaticResource PropertyValueStyle}" />

                <TextBlock x:Uid="SystemInfoCultureLabel" Grid.Row="0" Grid.Column="4"
                           Text="Culture" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoCultureValue" Grid.Row="0" Grid.Column="5"
                           Style="{StaticResource PropertyValueStyle}" />

                <TextBlock x:Uid="SystemInfoWindowsAppSdkLabel" Grid.Row="1" Grid.Column="0"
                           Text="Windows App SDK" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoWindowsAppSdkValue" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource PropertyValueStyle}" />

                <TextBlock x:Uid="SystemInfoApiModeLabel" Grid.Row="1" Grid.Column="2"
                           Text="API mode" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoApiModeValue" Grid.Row="1" Grid.Column="3"
                           Style="{StaticResource PropertyValueStyle}" />

                <TextBlock x:Uid="SystemInfoDeveloperModeLabel" Grid.Row="1" Grid.Column="4"
                           Text="Developer mode" Style="{StaticResource PropertyLabelStyle}" />
                <TextBlock x:Name="SystemInfoDeveloperModeValue" Grid.Row="1" Grid.Column="5"
                           Style="{StaticResource PropertyValueStyle}" />
            </Grid>
        </Border>

        <!-- ================================= Navigation ================================= -->
        <NavigationView x:Name="MainNavigation"
                        Grid.Row="2"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="230"
                        PaneDisplayMode="Left"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewNavigationItem" x:Uid="OverviewNavigationItem"
                                    Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ApiModeNavigationItem" x:Uid="ApiModeNavigationItem"
                                    Content="API mode" Tag="apimode">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DiagnosticsNavigationItem" x:Uid="DiagnosticsNavigationItem"
                                    Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CaptureNavigationItem" x:Uid="CaptureNavigationItem"
                                    Content="Capture repro log" Tag="capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- "latency" is kept for the MIDI device latency page that is planned -->
                <NavigationViewItem x:Name="LatencyCheckNavigationItem" x:Uid="LatencyCheckNavigationItem"
                                    Content="DPC latency check" Tag="dpclatency">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CrashDumpsNavigationItem" x:Uid="CrashDumpsNavigationItem"
                                    Content="Crash dumps" Tag="crashdumps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBE8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader x:Name="ServiceHealthHeader" x:Uid="ServiceHealthHeader"
                                          Content="Service health" />

                <NavigationViewItem x:Name="SessionsNavigationItem" x:Uid="SessionsNavigationItem"
                                    Content="Active sessions" Tag="sessions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TransportsNavigationItem" x:Uid="TransportsNavigationItem"
                                    Content="Transports" Tag="transports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServiceNavigationItem" x:Uid="ServiceNavigationItem"
                                    Content="MIDI service" Tag="service">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF156;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader x:Name="RegistryAndDriversHeader" x:Uid="RegistryAndDriversHeader"
                                          Content="Registry and drivers" />

                <NavigationViewItem x:Name="RegistryNavigationItem" x:Uid="RegistryNavigationItem"
                                    Content="Registry" Tag="registry">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DriversNavigationItem" x:Uid="DriversNavigationItem"
                                    Content="Drivers" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE977;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shown above every page, because almost every repair here needs it and the
                     customer should not have to find out one failed action at a time. -->
                <InfoBar x:Name="ElevationBar"
                         x:Uid="ElevationBar"
                         Grid.Row="0"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Title="Running without administrator rights"
                         Message="Diagnostics and reports work, but repairs, the API mode and the service controls do not."
                         Margin="32,16,32,0">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RestartElevatedButton"
                                Content="Restart as administrator"
                                Click="OnRestartElevatedClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ================================ Overview ================================ -->
                <!-- a control of its own, in OverviewPanel.xaml -->
                <local:OverviewPanel x:Name="OverviewPagePanel" Grid.Row="1" Visibility="Collapsed" />

                <!-- ================================ API mode ================================ -->
                <ScrollViewer x:Name="ApiModePanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="ApiModePageTitle" Text="API mode" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock x:Uid="ApiModePageDescription"
                                       Text="The API mode decides which MIDI stack Windows uses. Changing it needs a restart."
                                       Style="{StaticResource PageDescriptionStyle}" />
                            <HyperlinkButton x:Uid="ApiModeLearnMoreLink"
                                             Content="Read about the API modes"
                                             NavigateUri="https://microsoft.github.io/MIDI/kb/how-to-change-api-mode/"
                                             Style="{StaticResource PageLinkStyle}" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <RadioButton x:Name="ApiModeServicesRadio" x:Uid="ApiModeServicesRadio"
                                             GroupName="ApiModeGroup"
                                             Checked="OnApiModeSelectionChanged">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="ApiModeServicesName" Text="0 - Windows MIDI Services"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="ApiModeServicesDescription"
                                                   Text="The default. Multi-client MIDI, loopback endpoints, Network MIDI 2.0, Bluetooth LE MIDI and MIDI 2.0 devices."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ApiModeLegacyRadio" x:Uid="ApiModeLegacyRadio"
                                             GroupName="ApiModeGroup"
                                             Checked="OnApiModeSelectionChanged">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="ApiModeLegacyName" Text="1 - Legacy MIDI"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="ApiModeLegacyDescription"
                                                   Text="The MIDI stack as it was before Windows MIDI Services. No multi-client access and no MIDI 2.0 devices. These transports aren't available: Bluetooth LE MIDI, Network MIDI 2.0, RTP-MIDI, the MIDI 2.0 General MIDI Synth, the built-in MIDI loopbacks, and virtual devices that apps create. MIDI tools that need the MIDI service, such as MIDI Settings, can't be used. Choose this if you have an application, driver, or device incompatibility with Windows MIDI Services, or you need to use legacy WinMM user-mode drivers (typically &quot;.drv&quot;), or DirectMusic drivers."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="ApiModeHybridRadio" x:Uid="ApiModeHybridRadio"
                                             GroupName="ApiModeGroup"
                                             Checked="OnApiModeSelectionChanged">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="ApiModeHybridName" Text="2 - Hybrid"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="ApiModeHybridDescription"
                                                   Text="Not recommended for most customers. Devices on a MIDI 1.0 driver appear only to the old APIs, and devices on the new driver only to the new API. The two do not see each other."
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ApplyApiModeButton" x:Uid="ApplyApiModeButton"
                                    Content="Apply and prompt to restart"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnApplyApiModeClick" />
                            <TextBlock x:Name="ApiModeStatusText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================== Diagnostics =============================== -->
                <!-- The background is what lets the busy pointer show in the gaps between controls. -->
                <Grid x:Name="DiagnosticsPanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed"
                      RowSpacing="16" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="24" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Uid="DiagnosticsPageTitle" Text="Diagnostics" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock x:Uid="DiagnosticsPageDescription"
                                       Text="These reports are what support asks for first. Run them, then attach them to your issue or email."
                                       Style="{StaticResource PageDescriptionStyle}" />
                        </StackPanel>

                        <!-- always available: with no report run yet, it asks for a file -->
                        <Button x:Name="ViewMidiDiagReportButton" x:Uid="ViewMidiDiagReportButton" Grid.Column="1"
                                VerticalAlignment="Top" Click="OnViewMidiDiagReportClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A1;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock x:Uid="ViewMidiDiagReportButtonText" Text="View report..." />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- mididiag -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LeadIconBoxStyle}">
                                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource LeadIconGlyphStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="MidiDiagCardTitle" Text="MIDI diagnostics report (mididiag)"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="MidiDiagCardDescription"
                                               Text="Everything about the MIDI service, transports and ports. Save it as a zip file, because the full text is often too long to paste into a GitHub issue."
                                               Style="{StaticResource RowDetailStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RunMidiDiagButton" x:Uid="RunMidiDiagButton" Grid.Column="0"
                                        Style="{ThemeResource AccentButtonStyle}" Click="OnRunMidiDiagClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" Style="{StaticResource ButtonGlyphStyle}" />
                                        <TextBlock x:Uid="RunMidiDiagButtonText" Text="Run mididiag" />
                                    </StackPanel>
                                </Button>
                                <Rectangle Grid.Column="1" Width="1" Height="20" Margin="4,0,4,0"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button x:Name="SaveMidiDiagZipButton" x:Uid="SaveMidiDiagZipButton" Grid.Column="2"
                                        Content="Save as zip..." IsEnabled="False" Click="OnSaveMidiDiagZipClick" />
                                <Button x:Name="SaveMidiDiagButton" x:Uid="SaveMidiDiagButton" Grid.Column="3"
                                        Content="Save as..." IsEnabled="False" Click="OnSaveMidiDiagClick" />
                                <Button x:Name="CopyMidiDiagButton" x:Uid="CopyMidiDiagButton" Grid.Column="4"
                                        Content="Copy all" IsEnabled="False" Click="OnCopyMidiDiagClick" />
                                <TextBlock x:Name="MidiDiagStatusText" Grid.Column="5"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <!-- opened when mididiag reports that the MIDI service stopped answering -->
                            <InfoBar x:Name="MidiServiceStuckInfoBar" Grid.Row="2"
                                     Severity="Warning" IsOpen="False" IsClosable="True">
                                <InfoBar.ActionButton>
                                    <Button x:Name="SaveServiceDumpButton" x:Uid="SaveServiceDumpButton"
                                            Content="Save a memory dump..." Click="OnSaveServiceDumpClick" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <TextBox x:Name="MidiDiagOutputBox" x:Uid="MidiDiagOutputBox" Grid.Row="3"
                                     Style="{StaticResource OutputTextBoxStyle}" MinHeight="120" />
                        </Grid>
                    </Border>

                    <!-- midiksinfo -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource LeadIconBoxStyle}">
                                    <FontIcon Glyph="&#xE88E;" Style="{StaticResource LeadIconGlyphStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Uid="MidiKsInfoCardTitle" Text="Kernel streaming report (midiksinfo)"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Uid="MidiKsInfoCardDescription"
                                               Text="What each MIDI driver reports about its devices and pins."
                                               Style="{StaticResource RowDetailStyle}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="RunMidiKsInfoButton" x:Uid="RunMidiKsInfoButton" Grid.Column="0"
                                        Style="{ThemeResource AccentButtonStyle}" Click="OnRunMidiKsInfoClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" Style="{StaticResource ButtonGlyphStyle}" />
                                        <TextBlock x:Uid="RunMidiKsInfoButtonText" Text="Run midiksinfo" />
                                    </StackPanel>
                                </Button>
                                <Rectangle Grid.Column="1" Width="1" Height="20" Margin="4,0,4,0"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button x:Name="SaveMidiKsInfoButton" x:Uid="SaveMidiKsInfoButton" Grid.Column="2"
                                        Content="Save as..." IsEnabled="False" Click="OnSaveMidiKsInfoClick" />
                                <Button x:Name="CopyMidiKsInfoButton" x:Uid="CopyMidiKsInfoButton" Grid.Column="3"
                                        Content="Copy all" IsEnabled="False" Click="OnCopyMidiKsInfoClick" />
                                <TextBlock x:Name="MidiKsInfoStatusText" Grid.Column="4"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <TextBox x:Name="MidiKsInfoOutputBox" x:Uid="MidiKsInfoOutputBox" Grid.Row="2"
                                     Style="{StaticResource OutputTextBoxStyle}" MinHeight="120" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================ Capture repro log ============================ -->
                <Grid x:Name="CapturePanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed"
                      RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                        <TextBlock x:Uid="CapturePageTitle" Text="Capture a repro log" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Uid="CapturePageDescription"
                                   Text="Start the capture, reproduce the problem, then stop it. Everything is collected into a single zip file to attach to your issue or send to support."
                                   Style="{StaticResource PageDescriptionStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <CheckBox x:Name="CaptureSystemInfoCheck" x:Uid="CaptureSystemInfoCheck"
                                      Content="Include system reports (ddodiag, dxdiag, plug and play state)"
                                      IsChecked="True" />
                            <CheckBox x:Name="CaptureMidiDiagCheck" x:Uid="CaptureMidiDiagCheck"
                                      Content="Include mididiag output" IsChecked="True" />
                            <CheckBox x:Name="CaptureMidiKsInfoCheck" x:Uid="CaptureMidiKsInfoCheck"
                                      Content="Include midiksinfo output" IsChecked="True" />
                            <CheckBox x:Name="CaptureTimeTravelCheck" x:Uid="CaptureTimeTravelCheck"
                                      Content="Include a time travel trace of the MIDI service and any Windows MIDI Services apps that are open"
                                      IsChecked="True" />
                            <TextBlock x:Name="CaptureTimeTravelCaption" x:Uid="CaptureTimeTravelCaption"
                                       Margin="32,-4,0,0" MaxWidth="700" HorizontalAlignment="Left"
                                       Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap"
                                       Text="The most useful information you can send, but much larger, and it needs a reboot or a MIDI service restart afterwards. Open the MIDI app you're having trouble with, such as Windows MIDI Monitor or midi1rtmonitor, before you start. Apps you open after that aren't included." />
                            <TextBlock x:Name="CaptureProfileText"
                                       Style="{StaticResource PropertyLabelStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartCaptureButton" x:Uid="StartCaptureButton" Grid.Column="0"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnStartCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C8;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock x:Uid="StartCaptureButtonText" Text="Start capture" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopCaptureButton" x:Uid="StopCaptureButton" Grid.Column="1"
                                Content="Stop and save..." IsEnabled="False" Click="OnStopCaptureClick" />
                        <Button x:Name="CancelCaptureButton" x:Uid="CancelCaptureButton" Grid.Column="2"
                                Content="Cancel capture" IsEnabled="False" Click="OnCancelCaptureClick" />
                        <ProgressRing x:Name="CaptureProgressRing" Grid.Column="3"
                                      Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                        <TextBlock x:Name="CaptureStatusText" Grid.Column="4"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <!-- time travel tracing cannot detach from a running process, so the service
                         carries the recording overhead until it is restarted -->
                    <InfoBar x:Name="CaptureTimeTravelInfoBar" x:Uid="CaptureTimeTravelInfoBar"
                             Grid.Row="3" Severity="Warning" IsOpen="False"
                             Title="The MIDI service will run slowly until it is restarted"
                             Message="Time travel tracing cannot detach from a process once it has attached, so the Windows MIDI service keeps the recording overhead. MIDI still works, but with noticeably more latency. Restart Windows to clear it. Restarting only the MIDI service works as well, but every MIDI application has to be closed first, including background ones you did not start yourself. Any Windows MIDI Services app that was traced stays slow too, until you close it and open it again." />

                    <TextBox x:Name="CaptureLogBox" x:Uid="CaptureLogBox" Grid.Row="4"
                             Style="{StaticResource OutputTextBoxStyle}"
                             TextWrapping="Wrap" MinHeight="120" />
                </Grid>

                <!-- ============================ DPC latency check ============================ -->
                <!-- a control of its own, in LatencyCheckPanel.xaml -->
                <local:LatencyCheckPanel x:Name="LatencyPanel" Grid.Row="1" Visibility="Collapsed" />

                <!-- ================================ Crash dumps ================================ -->
                <!-- a control of its own, in CrashDumpsPanel.xaml -->
                <local:CrashDumpsPanel x:Name="CrashDumpsPagePanel" Grid.Row="1" Visibility="Collapsed" />

                <!-- ============================= Active sessions ============================= -->
                <ScrollViewer x:Name="SessionsPanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="SessionsPageTitle" Text="Active sessions" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="SessionsPageDescription"
                                           Text="Apps that have the MIDI service open right now, and the MIDI ports each one is using."
                                           Style="{StaticResource PageDescriptionStyle}" />
                            </StackPanel>

                            <Button x:Name="RefreshSessionsButton" x:Uid="RefreshSessionsButton" Grid.Column="1"
                                    VerticalAlignment="Top" Click="OnRefreshServiceHealthClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RefreshButtonText" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <local:SummaryBanner x:Name="SessionsSummary" Glyph="&#xE7EE;" />

                        <ItemsControl x:Name="SessionsListView" x:Uid="SessionsListView">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:SessionItem">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Margin="0,0,0,4"
                                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                        <Expander.Header>
                                            <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource LeadIconBoxStyle}">
                                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource LeadIconGlyphStyle}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               Style="{StaticResource RowTitleStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}"
                                                               Style="{StaticResource RowDetailStyle}" />
                                                </StackPanel>

                                                <local:StatusPill Grid.Column="2"
                                                                  Severity="{x:Bind ConnectionPillSeverity, Mode=OneWay}"
                                                                  Text="{x:Bind ConnectionCountText, Mode=OneWay}" />
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{x:Bind Connections, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:SessionConnectionItem">
                                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                            BorderThickness="0,0,0,1" Padding="0,10,0,10"
                                                            AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16"
                                                                      AutomationProperties.AccessibilityView="Raw"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind KindText, Mode=OneWay}"
                                                                           Style="{StaticResource RowDetailStyle}" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ConnectedSinceText, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource RowDetailStyle}" />
                                                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}"
                                                                           HorizontalAlignment="Right"
                                                                           Style="{StaticResource RowDetailStyle}" />
                                                            </StackPanel>

                                                            <!-- the endpoint id is long and rarely read, so it lives
                                                                 behind a copy button and its tooltip -->
                                                            <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    AutomationProperties.Name="{x:Bind CopyAccessibleName, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="{x:Bind EndpointDeviceId, Mode=OneWay}"
                                                                    Click="OnCopyEndpointIdClick">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================ Transports ================================ -->
                <ScrollViewer x:Name="TransportsPanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="TransportsPageTitle" Text="Transports" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="TransportsPageDescription"
                                           Text="Transports connect the MIDI service to each kind of device."
                                           Style="{StaticResource PageDescriptionStyle}" />
                                <HyperlinkButton x:Uid="TransportsLearnMoreLink"
                                                 Content="Why a transport may not load"
                                                 NavigateUri="https://microsoft.github.io/MIDI/kb/service-plugin-not-loaded/"
                                                 Style="{StaticResource PageLinkStyle}" />
                            </StackPanel>

                            <Button x:Name="RefreshTransportsButton" x:Uid="RefreshTransportsButton" Grid.Column="1"
                                    VerticalAlignment="Top" Click="OnRefreshServiceHealthClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RefreshButtonText" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <local:SummaryBanner x:Name="TransportsSummary">
                                <local:SummaryBanner.Chips>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:StatusPill x:Name="TransportsInWindowsPill" Severity="3" />
                                        <local:StatusPill x:Name="TransportsPreviewPill" Severity="5" />
                                        <local:StatusPill x:Name="TransportsOffPill" Severity="4" Visibility="Collapsed" />
                                    </StackPanel>
                                </local:SummaryBanner.Chips>
                                <local:SummaryBanner.Action>
                                    <!-- shown only while a change is waiting for the service to restart -->
                                    <Button x:Name="TransportsRestartServiceButton" x:Uid="TransportsRestartServiceButton"
                                            Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed"
                                            Click="OnRestartServiceForTransportsClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE777;" Style="{StaticResource ButtonGlyphStyle}" />
                                            <TextBlock x:Uid="TransportsRestartServiceButtonText" Text="Restart the MIDI service" />
                                        </StackPanel>
                                    </Button>
                                </local:SummaryBanner.Action>
                            </local:SummaryBanner>

                            <!-- The last change and how it went. Kept out of the summary, which every
                                 refresh rewrites. -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TransportsActionText" Grid.Column="0" Margin="2,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ProgressRing x:Name="TransportsProgressRing" Grid.Column="1"
                                              Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TransportsInWindowsHeader" x:Uid="TransportsInWindowsHeader"
                                       Text="In Windows" Style="{StaticResource SectionTitleStyle}" />
                            <ItemsControl x:Name="TransportsListView" x:Uid="TransportsListView"
                                          ItemTemplate="{StaticResource TransportRowTemplate}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TransportsPreviewHeader" x:Uid="TransportsPreviewHeader"
                                       Text="Preview" Style="{StaticResource SectionTitleStyle}" Visibility="Collapsed" />
                            <ItemsControl x:Name="TransportsPreviewListView" x:Uid="TransportsPreviewListView"
                                          ItemTemplate="{StaticResource TransportRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================== MIDI service ============================== -->
                <ScrollViewer x:Name="ServicePanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="ServicePageTitle" Text="MIDI service" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="ServicePageDescription"
                                           Text="The Windows service that every MIDI app talks to. Restarting it disconnects every app that's using MIDI."
                                           Style="{StaticResource PageDescriptionStyle}" />
                            </StackPanel>

                            <Button x:Name="RefreshServiceButton" x:Uid="RefreshServiceButton" Grid.Column="1"
                                    VerticalAlignment="Top" Click="OnRefreshServiceHealthClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RefreshButtonText" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Uid="ServiceStateLabel" Grid.Row="0" Grid.Column="0"
                                           Text="Status" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceStateValue" Grid.Row="0" Grid.Column="1"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                <TextBlock x:Uid="ServiceStartModeLabel" Grid.Row="1" Grid.Column="0"
                                           Text="Startup type" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceStartModeValue" Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource PropertyValueStyle}" />

                                <TextBlock x:Uid="ServiceAccountLabel" Grid.Row="2" Grid.Column="0"
                                           Text="Runs as" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceAccountValue" Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource PropertyValueStyle}" />

                                <TextBlock x:Uid="ServiceProcessLabel" Grid.Row="3" Grid.Column="0"
                                           Text="Process" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceProcessValue" Grid.Row="3" Grid.Column="1"
                                           Style="{StaticResource PropertyValueStyle}" />

                                <TextBlock x:Uid="ServiceImageLabel" Grid.Row="4" Grid.Column="0"
                                           Text="Image" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceImageValue" Grid.Row="4" Grid.Column="1"
                                           Style="{StaticResource PropertyValueStyle}"
                                           TextWrapping="Wrap" TextTrimming="None" />

                                <TextBlock x:Uid="ServiceVersionLabel" Grid.Row="5" Grid.Column="0"
                                           Text="Version" Style="{StaticResource PropertyLabelStyle}" />
                                <TextBlock x:Name="ServiceVersionValue" Grid.Row="5" Grid.Column="1"
                                           Style="{StaticResource PropertyValueStyle}" />
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RestartServiceButton" x:Uid="RestartServiceButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnRestartServiceClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RestartServiceButtonText" Text="Restart the MIDI service" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="ServiceProgressRing" Width="20" Height="20"
                                          IsActive="False" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="ServiceStartWithWindowsTitle"
                                           Text="Start with Windows"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="ServiceStartWithWindowsDescription"
                                           Text="The service normally starts on demand when the first MIDI application asks for it. Starting it with Windows will reduce first-app app startup time for DAWs and other apps which use MIDI, and is the recommended option for musicians and anyone who uses MIDI regularly."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SetAutomaticStartButton" x:Uid="SetAutomaticStartButton"
                                            Content="Start automatically" Click="OnSetAutomaticStartClick" />
                                    <Button x:Name="SetManualStartButton" x:Uid="SetManualStartButton"
                                            Content="Start on demand" Click="OnSetManualStartClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ServiceStatusText" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================ Registry ================================ -->
                <ScrollViewer x:Name="RegistryPanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="RegistryPageTitle" Text="Registry" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="RegistryPageDescription"
                                           Text="Windows MIDI Services needs a few registry entries. Installers and port reordering tools sometimes break them."
                                           Style="{StaticResource PageDescriptionStyle}" />
                                <HyperlinkButton x:Uid="RegistryLearnMoreLink"
                                                 Content="Which registry entries Windows MIDI Services needs"
                                                 NavigateUri="https://microsoft.github.io/MIDI/kb/required-registry-entries/"
                                                 Style="{StaticResource PageLinkStyle}" />
                            </StackPanel>

                            <Button x:Name="RefreshRegistryButton" x:Uid="RefreshRegistryButton" Grid.Column="1"
                                    VerticalAlignment="Top" Click="OnRefreshRegistryClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RefreshButtonText" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <local:SummaryBanner x:Name="RegistrySummary">
                                <local:SummaryBanner.Chips>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <local:StatusPill x:Name="RegistryOkPill" Severity="0" />
                                        <local:StatusPill x:Name="RegistryRepairPill" Severity="2" Visibility="Collapsed" />
                                        <local:StatusPill x:Name="RegistryReviewPill" Severity="1" Visibility="Collapsed" />
                                    </StackPanel>
                                </local:SummaryBanner.Chips>
                                <local:SummaryBanner.Action>
                                    <Button x:Name="RepairRegistryButton" x:Uid="RepairRegistryButton"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="Collapsed" IsEnabled="False"
                                            Click="OnRepairRegistryClick">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE90F;" Style="{StaticResource ButtonGlyphStyle}" />
                                            <TextBlock x:Name="RepairRegistryButtonText" Text="Repair" />
                                        </StackPanel>
                                    </Button>
                                </local:SummaryBanner.Action>
                            </local:SummaryBanner>

                            <!-- scans and repairs in progress, and how the last repair went -->
                            <TextBlock x:Name="RegistryStatusText" Margin="2,0,0,0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Expander x:Name="Drivers64Expander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE977;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="RegistryDrivers64Title" Text="MIDI drivers for 64-bit apps" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="RegistryDrivers64Description" Text="Which drivers 64-bit apps load for MIDI. Drivers32 key." Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>
                                        <local:StatusPill x:Name="Drivers64Pill" Grid.Column="2" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid ColumnSpacing="12" Padding="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" x:Uid="RegistryHeadingEntry" Text="Entry" Style="{StaticResource TableHeadingStyle}" />
                                        <TextBlock Grid.Column="2" x:Uid="RegistryHeadingValue" Text="Value" Style="{StaticResource TableHeadingStyle}" />
                                        <TextBlock Grid.Column="3" x:Uid="RegistryHeadingPurpose" Text="What it does" Style="{StaticResource TableHeadingStyle}" />
                                    </Grid>
                                    <ItemsControl x:Name="Drivers32ItemsControl" ItemTemplate="{StaticResource RegistryEntryTemplate}" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="Drivers32Expander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE977;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="RegistryDrivers32Title" Text="MIDI drivers for 32-bit apps" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="RegistryDrivers32Description" Text="Which drivers 32-bit apps load for MIDI. Drivers32 key under WOW6432Node." Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>
                                        <local:StatusPill x:Name="Drivers32Pill" Grid.Column="2" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid ColumnSpacing="12" Padding="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" x:Uid="RegistryHeadingEntry" Text="Entry" Style="{StaticResource TableHeadingStyle}" />
                                        <TextBlock Grid.Column="2" x:Uid="RegistryHeadingValue" Text="Value" Style="{StaticResource TableHeadingStyle}" />
                                        <TextBlock Grid.Column="3" x:Uid="RegistryHeadingPurpose" Text="What it does" Style="{StaticResource TableHeadingStyle}" />
                                    </Grid>
                                    <ItemsControl x:Name="Drivers32WowItemsControl" ItemTemplate="{StaticResource RegistryEntryTemplate}" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ServiceRootExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE713;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="RegistryServiceRootTitle" Text="Windows MIDI Services" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="RegistryServiceRootDescription" Text="The configuration file the MIDI service reads when it starts." Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>
                                        <local:StatusPill x:Name="ServiceRootPill" Grid.Column="2" />
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl x:Name="ServiceRootItemsControl" ItemTemplate="{StaticResource RegistryEntryTemplate}" />
                            </Expander>

                            <Expander x:Name="RegistryTransportsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE968;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="RegistryTransportsTitle" Text="Registered transports" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="RegistryTransportsDescription" Text="The plugins the MIDI service loads for USB, Bluetooth, network and app-to-app MIDI." Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>
                                        <local:StatusPill x:Name="RegistryTransportsPill" Grid.Column="2" />
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl x:Name="RegistryTransportsItemsControl" ItemTemplate="{StaticResource RegistryTransportTemplate}" />
                            </Expander>

                            <Expander x:Name="MmcssExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid ColumnSpacing="16" Padding="0,10,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE945;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="RegistryMmcssHeader" Text="Multimedia Class Scheduler (MMCSS)" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="RegistryMmcssDescription"
                                                       Text="Windows settings that music apps use to get priority, and the limit on how many threads each app can register. Tweak guides and optimizer apps sometimes change them. Repair doesn't change these."
                                                       Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>
                                        <local:StatusPill x:Name="MmcssPill" Grid.Column="2" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <HyperlinkButton x:Uid="RegistryMmcssLearnMoreLink"
                                                     Content="How to put the MMCSS task settings back"
                                                     NavigateUri="https://microsoft.github.io/MIDI/kb/mmcss-task-settings/"
                                                     Style="{StaticResource PageLinkStyle}" Margin="0,0,0,8" />
                                    <ItemsControl x:Name="MmcssTasksItemsControl" ItemTemplate="{StaticResource RegistryEntryTemplate}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================= Drivers ================================= -->
                <ScrollViewer x:Name="DriversPanel" Grid.Row="1" Padding="{StaticResource PageContentPadding}" Visibility="Collapsed">
                    <StackPanel Spacing="24">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="DriversPageTitle" Text="Drivers" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock x:Uid="DriversPageDescription"
                                           Text="Choose which Windows class driver each USB MIDI device uses, and remove old vendor drivers that Windows MIDI Services no longer needs."
                                           Style="{StaticResource PageDescriptionStyle}" />
                            </StackPanel>

                            <Button x:Name="RefreshDriversButton" x:Uid="RefreshDriversButton" Grid.Column="1"
                                    VerticalAlignment="Top" Click="OnRefreshDriversClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" Style="{StaticResource ButtonGlyphStyle}" />
                                    <TextBlock x:Uid="RefreshButtonText" Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="DriversVendorSectionTitle" Text="Old vendor drivers" Style="{StaticResource SectionTitleStyle}" />

                            <StackPanel Spacing="4">
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE88E;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Uid="KorgDriverTitle" Text="KORG USB MIDI driver" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="KorgDriverDescription"
                                                       Text="Not needed with Windows MIDI Services, and a common cause of missing or duplicated ports. Uninstall removes the driver package and any device using it."
                                                       Style="{StaticResource RowDetailStyle}" />
                                            <TextBlock x:Name="KorgDriverStatusText" Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>

                                        <local:StatusPill x:Name="KorgUsbPill" Grid.Column="2" />

                                        <Button x:Name="RemoveKorgDriverButton" x:Uid="RemoveKorgDriverButton"
                                                Grid.Column="3" VerticalAlignment="Center" MinWidth="100"
                                                Content="Uninstall" IsEnabled="False"
                                                Click="OnRemoveKorgDriverClick" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource LeadIconBoxStyle}">
                                            <FontIcon Glyph="&#xE702;" Style="{StaticResource LeadIconGlyphStyle}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Uid="KorgBleDriverTitle" Text="KORG BLE-MIDI driver" Style="{StaticResource RowTitleStyle}" />
                                            <TextBlock x:Uid="KorgBleDriverDescription"
                                                       Text="Bluetooth LE MIDI is built into Windows MIDI Services, so this driver isn't needed and can conflict with it. Uninstall removes the driver package and any device using it."
                                                       Style="{StaticResource RowDetailStyle}" />
                                            <TextBlock x:Name="KorgBleDriverStatusText" Style="{StaticResource RowDetailStyle}" />
                                        </StackPanel>

                                        <local:StatusPill x:Name="KorgBlePill" Grid.Column="2" />

                                        <Button x:Name="RemoveKorgBleDriverButton" x:Uid="RemoveKorgBleDriverButton"
                                                Grid.Column="3" VerticalAlignment="Center" MinWidth="100"
                                                Content="Uninstall" IsEnabled="False"
                                                Click="OnRemoveKorgBleDriverClick" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DriversDevicesSectionTitle" Text="USB MIDI devices" Style="{StaticResource SectionTitleStyle}" />
                                <!-- text first, so it stays put whether or not the ring is spinning -->
                                <TextBlock x:Name="DriversStatusText" Grid.Column="1" Margin="0,8,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressRing x:Name="DriversProgressRing" Grid.Column="2" Margin="0,8,0,0"
                                              Width="20" Height="20" IsActive="False" VerticalAlignment="Center" />
                            </Grid>

                            <InfoBar x:Uid="DriversCautionInfoBar" Severity="Warning" IsOpen="True" IsClosable="False"
                                     Title="Only change the driver for a device you know is a MIDI device."
                                     Message="Windows offers the MIDI class driver for every USB audio device. Forcing it onto one that can't use it can stop the device working, or make the PC stop responding until the next restart." />

                            <!-- outcome of the last driver change. Kept out of the status text, which
                                 the next refresh overwrites. -->
                            <InfoBar x:Name="DriverFollowUpInfoBar" IsOpen="False" />

                            <ItemsControl x:Name="DriversListView" x:Uid="DriversListView">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DriverDeviceItem">
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4"
                                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource LeadIconBoxStyle}" VerticalAlignment="Top">
                                                    <FontIcon Glyph="&#xE88E;" Style="{StaticResource LeadIconGlyphStyle}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource RowTitleStyle}" />
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <local:StatusPill Severity="{x:Bind DriverPillSeverity, Mode=OneWay}"
                                                                          Text="{x:Bind DriverName, Mode=OneWay}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind DriverDetail, Mode=OneWay}"
                                                                   VerticalAlignment="Center"
                                                                   Style="{StaticResource RowDetailStyle}" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}"
                                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                                               IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind ProblemText, Mode=OneWay}"
                                                               Visibility="{x:Bind ProblemVisibility, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                                                    <!-- Both buttons always show. The one for the driver already in
                                                         use is off and says so, so the current state reads at a glance.
                                                         Under the text rather than beside it, so a narrow window
                                                         doesn't cut them off. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                                        <Button Content="{x:Bind UmpButtonText, Mode=OneWay}"
                                                                MinWidth="180"
                                                                IsEnabled="{x:Bind CanUseUniversalMidiPacketDriver, Mode=OneWay}"
                                                                Click="OnUseUmpDriverClick" />
                                                        <Button Content="{x:Bind ClassicButtonText, Mode=OneWay}"
                                                                MinWidth="180"
                                                                IsEnabled="{x:Bind CanUseClassicDriver, Mode=OneWay}"
                                                                Click="OnUseClassicDriverClick" />
                                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                                      Width="20" Height="20" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============================ Shared dialogs ============================ -->
                <ContentDialog x:Name="ConfirmDialog"
                               x:Uid="ConfirmDialog"
                               PrimaryButtonText="Yes"
                               CloseButtonText="Cancel"
                               DefaultButton="Close">
                    <ScrollViewer MaxHeight="360">
                        <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </ContentDialog>

                <ContentDialog x:Name="RestartComputerDialog"
                               x:Uid="RestartComputerDialog"
                               Title="Restart now?"
                               PrimaryButtonText="Restart now"
                               CloseButtonText="Later"
                               DefaultButton="Close">
                    <TextBlock x:Name="RestartComputerDialogText" TextWrapping="Wrap" />
                </ContentDialog>

                <ContentDialog x:Name="RestartServiceDialog"
                               x:Uid="RestartServiceDialog"
                               Title="Restart the MIDI service?"
                               PrimaryButtonText="Restart the service"
                               CloseButtonText="Later"
                               DefaultButton="Close">
                    <ScrollViewer MaxHeight="360">
                        <TextBlock x:Name="RestartServiceDialogText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                </ContentDialog>

                <ContentDialog x:Name="ReplugDeviceDialog"
                               x:Uid="ReplugDeviceDialog"
                               Title="Unplug the device"
                               CloseButtonText="OK"
                               DefaultButton="Close">
                    <TextBlock x:Name="ReplugDeviceDialogText" TextWrapping="Wrap" />
                </ContentDialog>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
