<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="miditroubleshooter.OverviewTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:miditroubleshooter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TileNotCheckedBrush" Color="#C3A6FF" />
                    <SolidColorBrush x:Key="TileNotCheckedBackgroundBrush" Color="#2EC3A6FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TileNotCheckedBrush" Color="#6A3DA8" />
                    <SolidColorBrush x:Key="TileNotCheckedBackgroundBrush" Color="#1F6A3DA8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TileNotCheckedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TileNotCheckedBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="TileRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Ok">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NotChecked">
                    <VisualState.Setters>
                        <Setter Target="TopEdge.Background" Value="{ThemeResource TileNotCheckedBrush}" />
                        <Setter Target="IconBox.Background" Value="{ThemeResource TileNotCheckedBackgroundBrush}" />
                        <Setter Target="IconGlyph.Foreground" Value="{ThemeResource TileNotCheckedBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="160">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopEdge" Grid.Row="0" Height="3" CornerRadius="7,7,0,0"
                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />

                <Grid Grid.Row="1" Padding="18,12,18,10" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="IconBox" Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                AutomationProperties.AccessibilityView="Raw">
                            <FontIcon x:Name="IconGlyph" FontSize="16" />
                        </Border>

                        <TextBlock x:Name="LabelText" Grid.Column="1" VerticalAlignment="Center"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- one text block, so a long value wraps instead of being cut off -->
                    <TextBlock x:Name="ValueText" Grid.Row="1" TextWrapping="Wrap">
                        <Run x:Name="ValueRun" FontSize="28" FontWeight="SemiBold" />
                        <Run x:Name="ValueSuffixRun" FontSize="14"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>

                    <ContentPresenter x:Name="ExtraPresenter" Grid.Row="2" Visibility="Collapsed" />

                    <TextBlock x:Name="DetailText" Grid.Row="3" Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- the tag sits with the link, so the label above has the full width -->
                    <Grid Grid.Row="5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <HyperlinkButton x:Name="LinkButton" Padding="0" Click="OnLinkClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="LinkTextBlock" TextWrapping="Wrap" />
                                <FontIcon Glyph="&#xE76C;" FontSize="10" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                        </HyperlinkButton>

                        <local:StatusPill x:Name="Pill" Grid.Column="1" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
