STRINGTABLE
BEGIN
    IDS_PROJNAME                            "Midi2.RtpMidiTransport"

    IDS_PLUGIN_METADATA_VERSION             "0.1.0.3"
    IDS_PLUGIN_METADATA_NAME                "RTP-MIDI"
    IDS_PLUGIN_METADATA_DESCRIPTION         "Provides host and client RTP-MIDI (IETF RFC 6295) network MIDI 1.0 capabilities"
    IDS_PLUGIN_METADATA_AUTHOR              "Microsoft"

    IDS_RTP_PARENT_DEVICE_NAME              "RTP-MIDI Endpoints"
    IDS_RTP_ENDPOINT_DESCRIPTION_HOST       "RTP-MIDI network connection. The other device connected to this PC."
    IDS_RTP_ENDPOINT_DESCRIPTION_CLIENT     "RTP-MIDI network connection. This PC connected to the other device."

    IDS_RTP_ERROR_INVALID_JSON              "The RTP-MIDI transport configuration is not valid JSON."
    IDS_RTP_ERROR_UNRECOGNIZED_COMMAND      "The RTP-MIDI transport does not support this command."
    IDS_RTP_ERROR_MISSING_ENTRY_IDENTIFIER  "The command needs an entry identifier."
    IDS_RTP_ERROR_INVALID_ENTRY_IDENTIFIER  "The entry identifier is not a valid GUID."
    IDS_RTP_ERROR_ENTRY_NOT_FOUND           "There is no RTP-MIDI host or client with this entry identifier."
    IDS_RTP_ERROR_INVALID_ENTRY             "One or more RTP-MIDI entries could not be read and were skipped."
    IDS_RTP_ERROR_NOT_READY                 "The RTP-MIDI transport has not finished starting. Try again in a moment."
    IDS_RTP_ERROR_MISSING_REMOTE            "A client needs either an advertised name or an address and port to connect to."
    IDS_RTP_ERROR_NAME_TOO_LONG             "A name can be at most 63 bytes long in UTF-8."
    IDS_RTP_ERROR_INVALID_PORT              "The port must be between 1024 and 65534."
    IDS_RTP_ERROR_MISSING_CONNECTION_ID     "The command needs a connection identifier."
    IDS_RTP_ERROR_INVALID_NAME              "A name needs at least one character, and a name advertised on the network cannot contain a period."
    IDS_RTP_ERROR_MISSING_REMOTE_CLIENT_NAME "The command needs the name of the remote device."
    IDS_RTP_ERROR_PENDING_REMOTE_CLIENT_NOT_FOUND "No remote device with this name is waiting to connect to this host. It may have stopped trying."
    IDS_RTP_ERROR_INVALID_APPROVAL_SCOPE    "The scope must be once, untilRestart or always."
    IDS_RTP_ERROR_TOO_MANY_REMOTE_CLIENT_DECISIONS "This host already remembers 256 decisions. Forget some before adding more."
    IDS_RTP_ERROR_CONNECTION_NOT_FOUND      "There is no connection with this identifier. The remote may already have left."
    IDS_RTP_ERROR_TEXT_TOO_LONG             "A remote device name, custom endpoint name or remote address can be at most 255 characters long."
END

IDR_MIDI2RTPMIDITRANSPORT REGISTRY "Midi2.RtpMidiTransport.rgs"

