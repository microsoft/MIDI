    IDS_PERIPHERAL_MIDI1_ENDPOINT_DESCRIPTION           "Bluetooth Low Energy MIDI 1.0 device connected to this PC"
    IDS_PERIPHERAL_MIDI2_ENDPOINT_DESCRIPTION           "Bluetooth Low Energy MIDI 2.0 device (Universal MIDI Packet) connected to this PC"
    IDS_PERIPHERAL_UNKNOWN_CLIENT_NAME_WITH_ADDRESS     "Bluetooth MIDI Client {0}"
    IDS_UNNAMED_DEVICE_ENDPOINT_NAME                    "BLE MIDI {0}"

    IDS_ERROR_INVALID_JSON                              "Invalid Bluetooth MIDI transport configuration JSON."
    IDS_ERROR_CONNECT_MISSING_DEVICE_ID                 "Bluetooth MIDI connectDevice requires a deviceId."
    IDS_ERROR_DISCONNECT_MISSING_DEVICE_ID              "Bluetooth MIDI disconnectDevice requires a deviceId."
    IDS_ERROR_INVALID_DEVICE_ID                         "A Bluetooth MIDI deviceId must be a 12 hex digit Bluetooth address."
    IDS_ERROR_CONNECT_FAILED                            "Bluetooth MIDI connectDevice failed."
    IDS_ERROR_DISCONNECT_FAILED                         "Bluetooth MIDI disconnectDevice failed."
    IDS_ERROR_ENDPOINT_MANAGER_NOT_AVAILABLE            "Bluetooth MIDI endpoint manager is not available."
    IDS_ERROR_START_PERIPHERAL_FAILED                   "Bluetooth MIDI startPeripheral failed."
    IDS_ERROR_STOP_PERIPHERAL_FAILED                    "Bluetooth MIDI stopPeripheral failed."
    IDS_ERROR_DECISION_MISSING_ADDRESS                  "A Bluetooth address is required to identify the client being decided about."
    IDS_ERROR_INVALID_APPROVAL_SCOPE                    "Unrecognized approval scope. Use once, untilRestart or always."
    IDS_ERROR_ADDRESS_NOT_REMEMBERABLE                  "This device's Bluetooth address changes periodically, so a permanent decision about it cannot be honored. Pair the device first, or choose a scope of once or untilRestart."
    IDS_ERROR_DIFFERENT_CLIENT_WAITING                  "A different Bluetooth MIDI client is waiting for a decision."
    IDS_ERROR_NO_CLIENT_WAITING                         "No Bluetooth MIDI client is waiting for a decision."
    IDS_ERROR_FORGET_MISSING_ADDRESS                    "A Bluetooth address is required to identify the client to forget."
    IDS_ERROR_CLIENT_NOT_REMEMBERED                     "No remembered Bluetooth MIDI client has that address."
    IDS_ERROR_INVALID_OFFLINE_RETENTION                 "Offline retention must be ""always"", ""immediate"", a whole number of seconds up to 86400, or ""default"" for a single device."
    IDS_ERROR_UNUSABLE_DEVICE_ID                        "That is not a usable Bluetooth device id."
    IDS_ERROR_INVALID_CONNECTION_PARAMETERS             "Unrecognized Bluetooth MIDI connection parameter preference."
    IDS_ERROR_UNSUPPORTED_COMMAND                       "Unsupported Bluetooth MIDI transport command."

    IDS_CONNECT_DEVICE_NOT_DISCOVERED                   "This device has not been discovered. Wake it so it advertises, then try again."
    IDS_CONNECT_DEVICE_NOT_AVAILABLE                    "Windows could not open this Bluetooth device."
    IDS_CONNECT_SHUTTING_DOWN                           "The transport is shutting down."
    IDS_CONNECT_PAIRING_REQUIRED                        "This device requires pairing before Windows can use its MIDI service. Pair it, then connect it again. Automatic reconnection is paused for this device until then."
    IDS_CONNECT_SERVICE_READ_FAILED                     "Windows could not read this device's MIDI service. The call failed with error 0x{0:08X}."
    IDS_CONNECT_SERVICE_READ_FAILED_PAIRING_MAY_HELP    "Windows could not read this device's MIDI service. The call failed with error 0x{0:08X}. Pairing the device in Windows Settings may fix this, because Windows can then open its MIDI service another way."
    IDS_CONNECT_STOPPED_ANSWERING_PAIRING_MAY_HELP      "The device stopped answering while connecting. Some devices drop the connection until they are paired. Try pairing this device, then connect it again."
    IDS_CONNECT_STOPPED_ANSWERING                       "The device stopped answering while connecting. Keep it in range and awake, and make sure it is not already connected to another host."
    IDS_CONNECT_UNREACHABLE_BUT_HEARD                   "Windows can hear this device, but it did not answer the connection request. Move it closer to this PC, or turn it off and on again."
    IDS_CONNECT_UNREACHABLE_NEVER_HEARD                 "The device did not respond, and Windows has not heard from it since the MIDI service started. Turn it on and keep it in range."
    IDS_CONNECT_UNREACHABLE_NOT_HEARD_RECENTLY          "The device did not respond, and Windows has not heard from it recently. It is probably switched off, asleep, or out of range."
    IDS_CONNECT_SERVICE_ACCESS_DENIED                   "Windows denied access to this device's GATT services."
    IDS_CONNECT_PROTOCOL_ERROR                          "The device reported a GATT protocol error while Windows was reading its MIDI service."
    IDS_CONNECT_PROTOCOL_ERROR_WITH_CODE                "The device answered with Bluetooth error 0x{0:02X} while Windows was reading its MIDI service."
    IDS_CONNECT_MIDI_SERVICE_NOT_FOUND                  "The device does not expose the Bluetooth MIDI service."
    IDS_CONNECT_OPEN_ACCESS_DENIED                      "Access to the device's MIDI service was denied."
    IDS_CONNECT_DEVICE_IN_USE                           "Another component already has this device's MIDI service open. The older Windows Bluetooth MIDI support may be holding it. Remove the device's Bluetooth MIDI entry in Device Manager, then try again."
    IDS_CONNECT_OPEN_FAILED                             "The device's MIDI service could not be opened."
    IDS_CONNECT_CHARACTERISTIC_NOT_FOUND                "The device's MIDI service has neither a MIDI 1.0 nor a UMP characteristic."
    IDS_CONNECT_CHARACTERISTIC_READ_FAILED              "Windows could not read the characteristics of this device's MIDI service. The call failed with error 0x{0:08X}."
    IDS_CONNECT_CHARACTERISTIC_STOPPED_ANSWERING        "The device stopped answering while Windows was reading its MIDI service. Keep it in range and awake, then connect it again."
    IDS_CONNECT_CHARACTERISTIC_UNREACHABLE              "The device did not respond while Windows was reading its MIDI service. Wake it up, keep it in range, and make sure it is not already connected to another host."
    IDS_CONNECT_CHARACTERISTIC_ACCESS_DENIED            "Windows denied access to this device's MIDI characteristics."
    IDS_CONNECT_SESSION_FAILED                          "A Bluetooth session could not be created for this device."
    IDS_CONNECT_UNEXPECTED_ERROR                        "An unexpected Bluetooth error occurred."
    IDS_CONNECT_SUBSCRIBE_FAILED                        "The device's MIDI characteristic could not be subscribed to."
    IDS_CONNECT_ENDPOINT_CREATION_FAILED                "The MIDI endpoint for this device could not be created."
END

