#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiRtpRemoteClientPolicyEnum.idl";
import "MidiRtpSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // Send with MidiRtpTransportManager.CreateRtpHostAsync, and save with
    // MidiServiceTransportPluginConfigManager.SaveUpdate to keep it after a restart. Sent with the
    // HostId of a host which exists, it replaces that host's settings and restarts it.
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpHostCreationConfig", UUID_IMidiRtpHostCreationConfig)]
    runtimeclass MidiRtpHostCreationConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        // with a new HostId
        MidiRtpHostCreationConfig();

        // A new one by default. Set it to an existing host's to change that host.
        [noexcept] Guid HostId;

        // What remote devices show for this PC. Empty for this PC's name. At most 63 bytes in UTF-8.
        [noexcept] String Name;

        // the name advertised on the network, when it should differ from Name. No periods.
        [noexcept] String ServiceInstanceName;

        // The host tries 5004, the port other RTP-MIDI software looks at first, and takes a free
        // one if that is taken
        [noexcept] Boolean UseAutomaticPortAllocation;

        // 1024 to 65534. RTP-MIDI also uses the port after it.
        [noexcept] UInt16 ManuallyAssignedPort;

        // Only meaningful with a specific port: the host starts on another one instead of failing,
        // and reports it through MidiRtpConfiguredHost.UsedPortFallback
        [noexcept] Boolean AllowPortFallback;

        [noexcept] Boolean Advertise;

        // what the host does when a remote which is on neither of its lists asks to connect
        [noexcept] MidiRtpRemoteClientPolicy RemoteClientPolicy;

        // So a remote can repair a lost Note Off. Only turn off for a device which cannot parse it.
        [noexcept] Boolean SendRecoveryJournal;

        // The network adapter the host is limited to, by the GUID Windows gives it. This is the
        // same value as Windows.Networking.Connectivity.NetworkAdapter.NetworkAdapterId and the
        // .NET NetworkInterface.Id. The default, an empty GUID, runs the host on every adapter.
        // Setting it also fills in NetworkAdapterName from Windows.
        [noexcept] Guid NetworkAdapterId;

        // Only shown, so a customer can tell which adapter a host is waiting for
        [noexcept] String NetworkAdapterName;

        // When the adapter is missing, the host runs on every adapter until it is back, instead
        // of not running at all. True by default.
        [noexcept] Boolean AllowNetworkAdapterFallback;

        // How fast the host sends to each remote. Set a limit when a remote passes what it
        // receives on to a 5-pin DIN cable and loses data in large SysEx dumps. Unlimited by
        // default. Changing only this on an existing host does not restart it.
        [noexcept] MidiRtpSendSpeedLimit SendSpeedLimit;
    }
}
