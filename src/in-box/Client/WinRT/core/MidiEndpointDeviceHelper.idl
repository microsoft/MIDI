#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";


namespace Windows.Devices.Midi2.Enumeration
{
    [contract(MidiEnumerationApiContract, 1)]
    
    [static_name("Windows.Devices.Midi2.Enumeration.IMidiEndpointDeviceHelperStatics", UUID_IMidiEndpointDeviceHelperStatics)]
    static runtimeclass MidiEndpointDeviceHelper
    {
        // returns a short version of the midisrv-enumerated id
        // from:    \\?\swd#midisrv#midiu_ksa_9447707571394916916#{e7cce071-3c03-423f-88d3-f1045d02552b}
        // to       ksa_9447707571394916916
        [noexcept] static String GetShortIdFromFullId(String fullEndpointDeviceId);

        // returns the full id for a midisrv-enumerated shortId
        [noexcept] static String GetFullIdFromShortId(String shortEndpointDeviceId);

        // returns true if this is a midisrv-enumerated UMP id. This only checks format
        // and components, not whether the device is actually present or real.
        [noexcept] static Boolean IsPossibleWindowsMidiServicesEndpointDeviceId(String fullEndpointDeviceId);

        // returns true if this is a midisrv-enumerated MIDI 1 API port id. This only checks format
        // and components, not whether the device is actually present or real.
        [noexcept] static Boolean IsPossibleWindowsMidiServicesLegacyApiPortDeviceId(String legacyPortDeviceId);       

        // puts the full id in the correct case. Wrapper around the internal function which
        // does that for all endpoint ids we expose. Useful when doing comparisons.
        [noexcept] static String NormalizeFullId(String fullEndpointDeviceId);


        [noexcept] static String EnsureCompliantUmpEndpointName(String endpointName);

        [noexcept] static String EnsureCompliantProductInstanceId(String productInstanceId);

    }
}
