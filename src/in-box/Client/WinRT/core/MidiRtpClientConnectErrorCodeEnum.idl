#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";
#include "..\..\..\Transport\RtpMidiTransport\rtp_transport_error_codes.h"

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]
    enum MidiRtpClientConnectErrorCode
    {
        NoErrorInformationAvailable =           RTP_MIDI_ERROR_CODE_UNKNOWN_ERROR,
        InvalidJson =                           RTP_MIDI_ERROR_CODE_INVALID_JSON,
        UnrecognizedCommand =                   RTP_MIDI_ERROR_CODE_UNRECOGNIZED_COMMAND,
        InvalidOrMissingEntryIdentifier =       RTP_MIDI_ERROR_CODE_MISSING_ENTRY_IDENTIFIER,
        MalformedEntryIdentifier =              RTP_MIDI_ERROR_CODE_INVALID_ENTRY_IDENTIFIER,

        // from ReconnectRtpClientAsync, for an entry the service does not have
        ClientNotFound =                        RTP_MIDI_ERROR_CODE_ENTRY_NOT_FOUND,

        InvalidEntry =                          RTP_MIDI_ERROR_CODE_INVALID_ENTRY,
        TransportNotReady =                     RTP_MIDI_ERROR_CODE_NOT_READY,

        // the match criteria need either an advertised name, or an address and a port, not both
        InvalidOrMissingMatchCriteria =         RTP_MIDI_ERROR_CODE_MISSING_REMOTE,

        NameTooLong =                           RTP_MIDI_ERROR_CODE_NAME_TOO_LONG,
        InvalidPort =                           RTP_MIDI_ERROR_CODE_INVALID_PORT,
        InvalidName =                           RTP_MIDI_ERROR_CODE_INVALID_NAME,
        ServiceUnavailable =                    RTP_MIDI_ERROR_CODE_CLIENT_API_SERVICE_UNAVAILABLE,
        InvalidArgument =                       RTP_MIDI_ERROR_CODE_CLIENT_API_INVALID_ARGUMENT,
        ClientApiException =                    RTP_MIDI_ERROR_CODE_CLIENT_API_EXCEPTION,
    };
}
