#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiServiceConfigEndpointMatchCriteria.idl";
import "MidiServiceEndpointCustomizationProvenance.idl";
import "Midi1PortNamingApproachEnum.idl";


namespace Windows.Devices.Midi2.ServiceConfig
{
    [contract(MidiServiceConfigApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.ServiceConfig.IMidiServiceEndpointCustomization", UUID_IMidiServiceEndpointCustomization)]

    // One stored endpoint customization as the service currently holds it. Read-only: to change a
    // customization, send a MidiServiceEndpointCustomizationConfig, and to delete one send a
    // MidiServiceEndpointCustomizationRemovalConfig.
    runtimeclass MidiServiceEndpointCustomization
    {
        [noexcept] Guid TransportId{ get; };

        [noexcept] MidiServiceConfigEndpointMatchCriteria MatchCriteria{ get; };
        [noexcept] MidiServiceEndpointCustomizationProvenance Provenance{ get; };

        [noexcept] String Name{ get; };
        [noexcept] String Description{ get; };
        [noexcept] String ImageFileName{ get; };

        [noexcept] Boolean RequiresNoteOffTranslation{ get; };
        [noexcept] Boolean SupportsMidiPolyphonicExpression{ get; };
        [noexcept] UInt16 RecommendedControlChangeIntervalMilliseconds{ get; };

        [noexcept] Int64 OutgoingLatencyTicks{ get; };
        [noexcept] Boolean UseCustomOutgoingLatency{ get; };

        [noexcept] Windows.Devices.Midi2.Enumeration.Midi1PortNamingApproach Midi1PortNamingApproach{ get; };

        [noexcept] Windows.Foundation.Collections.IMapView<UInt8, String> Midi1SourcePortCustomNames{ get; };
        [noexcept] Windows.Foundation.Collections.IMapView<UInt8, String> Midi1DestinationPortCustomNames{ get; };

        // Empty when the service could not match this customization to an endpoint it has created.
        [noexcept] String ResolvedEndpointDeviceId{ get; };

        // True when nothing on this machine matches. The customization is still applied the moment
        // something does, so this is a prompt to re-link it, not a fault.
        [noexcept] Boolean IsOrphaned{ get; };

        // False when the entry holds nothing the customer would miss. An editor which saves the
        // whole set can leave an entry behind holding only default values.
        [noexcept] Boolean HasUserContent{ get; };
    };
}
