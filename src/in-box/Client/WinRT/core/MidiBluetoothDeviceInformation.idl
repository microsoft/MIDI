#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiBluetoothProtocolEnum.idl";
import "MidiBluetoothDeviceConnectErrorCodeEnum.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothDeviceInformation", UUID_IMidiBluetoothDeviceInformation)]
    runtimeclass MidiBluetoothDeviceInformation
    {
        // The 12 hex digit Bluetooth address, and the key for every operation in this namespace.
        // This is not a Windows device interface id.
        [noexcept] String BluetoothDeviceId{ get; };

        // The same address as a number, for lining up with the Windows.Devices.Bluetooth APIs
        [noexcept] UInt64 BluetoothAddress{ get; };

        [noexcept] String Name{ get; };

        [noexcept] MidiBluetoothProtocol SelectedProtocol{ get; };

        [noexcept] Boolean IsConnected{ get; };
        [noexcept] Boolean IsPaired{ get; };

        // True once the device has refused an operation until the link is authenticated. Nothing
        // in a Bluetooth advertisement declares this, so it is only known after an attempt has
        // been made. Automatic reconnection is suspended while it is set.
        [noexcept] Boolean RequiresPairing{ get; };

        // False when the device has stopped advertising. Bluetooth MIDI peripherals sleep
        // aggressively, so a device which is not present is usually asleep rather than gone.
        [noexcept] Boolean IsPresent{ get; };

        [noexcept] Int16 SignalStrengthDecibelMilliwatts{ get; };
        [noexcept] Windows.Foundation.TimeSpan LastSeenAgo{ get; };

        // False when the radio has never heard this device at all, which is how a paired device
        // the system remembers is told apart from one which was heard a long time ago.
        // LastSeenAgo means nothing when this is false.
        [noexcept] Boolean HasBeenSeen{ get; };

        [noexcept] Boolean HasEndpoint{ get; };
        [noexcept] String EndpointDeviceId{ get; };
        [noexcept] String EndpointDeviceInstanceId{ get; };

        [noexcept] UInt64 MessagesReceived{ get; };
        [noexcept] UInt64 MessagesSent{ get; };

        // GATT packets, counted before any decoding. Packets climbing while MessagesReceived
        // stays at zero means the device is transmitting something this transport cannot decode;
        // both at zero means the device is sending nothing at all.
        [noexcept] UInt64 PacketsReceived{ get; };
        [noexcept] UInt64 PacketsSent{ get; };

        // What the link actually negotiated. Zero when not connected.
        [noexcept] Windows.Foundation.TimeSpan ConnectionInterval{ get; };

        [noexcept] String LastConnectError{ get; };

        // Why the last connection attempt failed. Connecting happens in the background long after
        // the request returns, so this is the only place that reason appears.
        [noexcept] MidiBluetoothDeviceConnectErrorCode LastConnectErrorCode{ get; };

        [noexcept] Int32 LastConnectErrorHResult{ get; };
        [noexcept] Int32 LastSendErrorHResult{ get; };

        // Seconds this device's endpoint outlives it going offline, or one of the named values in
        // MidiBluetoothOfflineRetention. This is what the device itself is set to, so it can be
        // UseTransportDefault.
        [noexcept] Int32 OfflineRetentionSeconds{ get; };

        // The same, resolved against the transport setting, so it is never UseTransportDefault.
        [noexcept] Int32 EffectiveOfflineRetentionSeconds{ get; };
    }
}
