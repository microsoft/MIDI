#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";


namespace Windows.Devices.Midi2.Utilities.Files
{
    [contract(MidiFilesUtilityApiContract,1)]
    [interface_name("Windows.Devices.Midi2.Utilities.Files.IMidiFileWriteOptions", UUID_IMidiFileWriteOptions)]
    runtimeclass MidiFileWriteOptions
    {
        MidiFileWriteOptions();

        // Merge every track into one and write a format 0 file. Which track a message came from
        // is lost, which is usually what a capture or a single instrument part wants anyway. A
        // sequence with one track is written as format 0 either way.
        Boolean WriteSingleTrack;

        // Leave the status byte off a message that repeats the one before it. Every reader
        // handles this and it makes a note-heavy file noticeably smaller, but a file written
        // without it survives a damaged byte better.
        Boolean UseRunningStatus;

        // Ticks per quarter note used when the sequence is absolutely timed, because a Standard
        // MIDI File has no way of saying "a tick is a microsecond" and the sequence has to be
        // laid out on a musical timeline instead. At the default and 120 beats per minute, one
        // tick is a little over half a millisecond. Ignored for a musically timed sequence,
        // which keeps its own division.
        UInt16 AbsoluteTimingTicksPerQuarterNote;

        // Ceiling on the file this is allowed to produce.
        UInt64 MaximumFileBytes;
    };
}
