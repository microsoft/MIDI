#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiRtpSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // One connection with a remote device. RTP-MIDI is the same in both directions once
    // connected, so hosts and clients report their connections with this one type.
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpConnection", UUID_IMidiRtpConnection)]
    runtimeclass MidiRtpConnection
    {
        // unique within its host or client entry, for DisconnectRemoteClientAsync
        [noexcept] UInt32 ConnectionId{ get; };

        // the name the remote sent, which the endpoint is named after
        [noexcept] String RemoteName{ get; };

        // the live socket address, which changes between reconnects. Display only, never for matching.
        [noexcept] String RemoteAddress{ get; };
        [noexcept] UInt16 RemotePort{ get; };
        [noexcept] UInt16 LocalPort{ get; };

        // The remote's DNS host name, such as "Studio-Mac.local", from its RTP-MIDI advertisement,
        // or empty. Compare it with MidiNetworkAdvertisedHost.HostName, ignoring case, to find the
        // same device on Network MIDI 2.0.
        [noexcept] String RemoteHostName{ get; };

        // false while the two sides are still connecting
        [noexcept] Boolean IsConnected{ get; };

        // true when this PC sent the invitation
        [noexcept] Boolean ThisPcInvited{ get; };

        [noexcept] String EndpointDeviceId{ get; };

        // Clock sync round trip in MIDI timestamp ticks: the average of the recent exchanges, and
        // the best of them. Zero until the first exchange completes.
        [noexcept] UInt64 CurrentLatencyTicks{ get; };
        [noexcept] UInt64 BestLatencyTicks{ get; };

        [noexcept] UInt64 TotalCountNetworkPacketsSent{ get; };
        [noexcept] UInt64 TotalCountNetworkPacketsReceived{ get; };

        // RTP-MIDI never resends. A lost packet is repaired from the recovery journal the next
        // packet carries, and a note which cannot be repaired is ended so it does not hang.
        [noexcept] UInt64 TotalCountPacketsLost{ get; };
        [noexcept] UInt64 TotalCountLossesRepairedFromJournal{ get; };
        [noexcept] UInt64 TotalCountNoteOffsRecovered{ get; };

        [noexcept] UInt64 TotalCountMessagesSent{ get; };
        [noexcept] UInt64 TotalCountMessagesReceived{ get; };

        // What this PC is configured to send to the remote, and what it sends at now. They differ
        // only for a moment after a change. On a host, the speed is the remote's own setting when
        // the host has one for it, otherwise the host's.
        [noexcept] MidiRtpSendSpeedLimit SendSpeedLimit{ get; };
        [noexcept] MidiRtpSendSpeedLimit CurrentSendSpeedLimit{ get; };

        // True when the speed comes from the host's RemoteClientSettings for this remote. Always
        // false on a client's connection.
        [noexcept] Boolean UsesRemoteClientSettings{ get; };
    }
}
