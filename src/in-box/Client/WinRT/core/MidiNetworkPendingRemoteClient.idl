#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



import "IMidiServiceTransportPluginConfig.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkPendingRemoteClient", UUID_IMidiNetworkPendingRemoteClient)]
    runtimeclass MidiNetworkPendingRemoteClient : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        [noexcept] Guid HostId{ get; };

        [noexcept] String HostServiceInstanceName{ get; };
        [noexcept] String HostUmpEndpointName{ get; };

        [noexcept] String UmpEndpointName{ get; };
        [noexcept] String ProductInstanceId{ get;};
        [noexcept] String RemoteAddress{ get; };

        [noexcept] Windows.Foundation.DateTime RequestTime{ get; };

    }
}
