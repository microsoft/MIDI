#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Loopback
{
    // What a loopback does when the MIDI it delivers keeps coming back into it.
    [contract(MidiTransportsLoopbackApiContract, 1)]
    enum MidiLoopbackFeedbackProtection
    {
        // Mute the loopback, just as if the customer had muted it. This is the default.
        Mute = 0,

        // Do nothing, and do not watch for feedback at all.
        Off = 1,
    };
}
