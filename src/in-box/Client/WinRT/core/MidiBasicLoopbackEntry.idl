#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";
import "MidiBasicLoopbackFeedbackProtectionEnum.idl";

namespace Windows.Devices.Midi2.Transports.BasicLoopback
{
    [contract(MidiTransportsBasicLoopbackApiContract, 1)]
    
    [interface_name("Windows.Devices.Midi2.Transports.BasicLoopback.IMidiBasicLoopbackEntry", UUID_IMidiBasicLoopbackEntry)]
    runtimeclass MidiBasicLoopbackEntry
    {
        [noexcept] Guid AssociationId{ get; };

        [noexcept] String EndpointDeviceId{ get; };

        [noexcept] String Name{ get; };
        [noexcept] String Description{ get; };

        // bare file name within the shared endpoint assets folder, empty when there is none
        [noexcept] String ImageFileName{ get; };

        [noexcept] Boolean IsMuted{ get;};

        // Running total of UMP messages this loopback has carried from its destination back to
        // its source since it was created. Reset when the endpoint is recreated, and not
        // incremented while the loopback is muted.
        [noexcept] UInt64 MessageCount{ get; };

        // Off when the transport on this PC cannot watch for feedback.
        [noexcept] MidiBasicLoopbackFeedbackProtection FeedbackProtection{ get; };

        // True when the loopback is muted because MIDI was feeding back into it. Any change to
        // the muted state clears it.
        [noexcept] Boolean IsMutedForFeedback{ get; };

        // When the feedback was detected. Zero unless IsMutedForFeedback is true.
        [noexcept] Windows.Foundation.DateTime FeedbackDetectedTime{ get; };

    }
}
