#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";
import "MidiCapabilityInquiryMessageTypeEnum.idl";
import "MidiUniqueId.idl";
import "MidiProfileId.idl";
import "MidiMessage64.idl";



namespace Windows.Devices.Midi2.CapabilityInquiry
{
    [contract(MidiCapabilityInquiryApiContract,1)]

    // A capability inquiry message which has been taken off the wire and decoded far enough to act
    // on. Messages this API has no strong type for still arrive here with their type and addressing
    // readable and their payload intact, so an application can handle what the API does not.
    [interface_name("Windows.Devices.Midi2.CapabilityInquiry.IMidiCapabilityInquiryMessage", UUID_IMidiCapabilityInquiryMessage)]
    [static_name("Windows.Devices.Midi2.CapabilityInquiry.IMidiCapabilityInquiryMessageStatics", UUID_IMidiCapabilityInquiryMessageStatics)]
    runtimeclass MidiCapabilityInquiryMessage
    {
        [noexcept] Boolean IsValid{ get; };

        [noexcept] MidiCapabilityInquiryMessageType MessageType{ get; };

        // 0x00 to 0x0F addresses a channel, 0x7E a group, 0x7F the function block. Which values
        // are permitted depends on the message: property exchange is only ever 0x7F.
        [noexcept] UInt8 DeviceId{ get; };

        // The MIDI-CI version the sender used to format this message.
        [noexcept] UInt8 SourceVersion{ get; };

        MidiUniqueId SourceMuid{ get; };
        MidiUniqueId DestinationMuid{ get; };

        // Carried only by Invalidate MUID, naming the identifier being withdrawn.
        MidiUniqueId TargetMuid{ get; };

        // Discovery only. A responder must echo this so an initiator with several outputs can tell
        // which one the reply came back on.
        [noexcept] UInt8 OutputPathId{ get; };

        // The whole payload, from the universal system exclusive byte onwards and without the
        // enclosing markers. Always present, so nothing is lost for a message with no strong type.
        Windows.Foundation.Collections.IVector<UInt8> Data{ get; };

        // Property exchange framing. Meaningless unless the message is a property exchange message.
        [noexcept] Boolean HasPropertyExchangeFields{ get; };
        [noexcept] UInt8 RequestId{ get; };

        // The header as it arrived, and parsed. Header is null when the device sent something that
        // is not a JSON object; HeaderText still holds what it sent so a caller can see why.
        String HeaderText{ get; };
        Windows.Data.Json.JsonObject Header{ get; };

        // One based, as the specification numbers them. Chunk zero does not exist.
        [noexcept] UInt16 ChunkNumber{ get; };
        [noexcept] UInt16 ChunkCount{ get; };

        // This chunk's slice of the property data, which is only the whole resource when the
        // message is the single chunk of a one chunk reply.
        Windows.Foundation.Collections.IVector<UInt8> Body{ get; };

        // Profile configuration. Meaningless unless the message is a profile message.
        [noexcept] Boolean HasProfileFields{ get; };

        // The profile the message is about. Null for Profile Inquiry and for the reply to it, which
        // deal in whole lists rather than in any one profile.
        MidiProfileId ProfileId{ get; };

        // Channels asked for by Set Profile On, or taken by an enabled or disabled report. Zero
        // when the message addresses a group or a function block, whose width is already known, and
        // zero when it came from a device speaking the first message version.
        [noexcept] UInt16 ProfileChannelCount{ get; };

        // Profile Details Inquiry and its reply. Below 0x40 the meaning is common to every profile;
        // from 0x40 up the profile specification defines it.
        [noexcept] Boolean HasProfileInquiryTarget{ get; };
        [noexcept] UInt8 ProfileInquiryTarget{ get; };

        // The payload of a details reply, or of Profile Specific Data.
        Windows.Foundation.Collections.IVector<UInt8> ProfileData{ get; };

        // The two lists a reply to Profile Inquiry carries. A device with no profiles on the
        // addressed channel still replies, with both lists empty.
        Windows.Foundation.Collections.IVector<MidiProfileId> EnabledProfiles{ get; };
        Windows.Foundation.Collections.IVector<MidiProfileId> DisabledProfiles{ get; };

        // Acknowledgment fields, carried by ACK and NAK. A device speaking the first message
        // version sends neither, so this is false even though the message itself is well formed.
        [noexcept] Boolean HasAcknowledgmentFields{ get; };

        // Which message this answers, so a reply can be matched to the transaction that caused it.
        [noexcept] MidiCapabilityInquiryMessageType OriginalMessageType{ get; };

        [noexcept] UInt8 StatusCode{ get; };
        [noexcept] UInt8 StatusData{ get; };

        // Five bytes whose meaning depends on the branch: the profile identifier for a profile
        // message, and the request id followed by the chunk number for property exchange.
        Windows.Foundation.Collections.IVector<UInt8> StatusDetails{ get; };

        // Text the device sent to explain the failure. The specification says to show it to the
        // person using the application.
        String StatusMessage{ get; };

        // Decodes from the assembled system exclusive payload, excluding the 0xF0 and 0xF7 markers.
        [noexcept] static MidiCapabilityInquiryMessage FromSystemExclusiveData(
            Windows.Foundation.Collections.IIterable<UInt8> data);

        // Decodes straight from the packets which carried it. The messages must be the complete
        // system exclusive transfer, in order.
        [noexcept] static MidiCapabilityInquiryMessage FromUmpMessages(
            Windows.Foundation.Collections.IIterable<Windows.Devices.Midi2.MidiMessage64> messages);

        // True when the payload is a capability inquiry message at all, without decoding it.
        [noexcept] static Boolean IsCapabilityInquiryData(
            Windows.Foundation.Collections.IIterable<UInt8> data);
    };
}
