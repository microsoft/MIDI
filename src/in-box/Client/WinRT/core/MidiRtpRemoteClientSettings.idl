#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiRtpSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // One remote's own settings on a host, used for it instead of the host's. RTP-MIDI carries
    // nothing else that stays the same from one connection to the next, so a remote is known by
    // the name it sends, ignoring case, the same way remembered decisions know it.
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpRemoteClientSettings", UUID_IMidiRtpRemoteClientSettings)]
    [constructor_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpRemoteClientSettingsFactory", UUID_IMidiRtpRemoteClientSettingsFactory)]
    runtimeclass MidiRtpRemoteClientSettings
    {
        MidiRtpRemoteClientSettings();
        MidiRtpRemoteClientSettings(String remoteClientName);

        [noexcept] String RemoteClientName{ get; set; };

        // How fast the host sends to this remote. Unlimited by default.
        [noexcept] MidiRtpSendSpeedLimit SendSpeedLimit{ get; set; };

        // Added after Preview 11, so a new interface rather than a change to the one above
        [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpRemoteClientSettings2", UUID_IMidiRtpRemoteClientSettings2)]
        [contract(MidiTransportsRtpApiContract, 2)]
        {
            // When messages back up behind SendSpeedLimit, skip some in-between values so this
            // remote catches up. True by default.
            [noexcept] Boolean SkipInBetweenValuesToCatchUp{ get; set; };
        }
    }
}
