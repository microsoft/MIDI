#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.ServiceConfig
{
    [contract(MidiServiceConfigApiContract, 1)]
    enum MidiServiceConfigSaveResult
    {
        Success =                           0,

        // the caller asked to persist something which is never persisted, such as a
        // transport command or a configuration which only has meaning for the calling process
        ErrorNotPersistable =               100,

        ErrorConfigJsonNullOrEmpty =        600,
        ErrorProcessingConfigJson =         601,

        // no configuration file is registered, or the registered name is not a bare file name
        ErrorNoConfigFileRegistered =       700,

        // the file on disk is not valid JSON. It is left untouched rather than overwritten,
        // because replacing it would discard settings the customer may be able to recover
        ErrorConfigFileNotValidJson =       701,

        // the customer does not have permission to write the configuration file
        ErrorAccessDenied =                 702,

        // another writer holds the file. Retrying is reasonable
        ErrorConfigFileBusy =               703,

        ErrorWritingConfigFile =            704,

        // the file was written but did not read back as valid JSON, so it was restored
        ErrorVerificationFailed =           705,

        ErrorUnexpected =                   2000,
    };
}
