#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // Send with MidiRtpTransportManager.DisconnectRtpClientAsync, and save with
    // MidiServiceTransportPluginConfigManager.SaveUpdate to take the client out of the
    // configuration file
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpClientDisconnectConfig", UUID_IMidiRtpClientDisconnectConfig)]
    [constructor_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpClientDisconnectConfigFactory", UUID_IMidiRtpClientDisconnectConfigFactory)]
    runtimeclass MidiRtpClientDisconnectConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        MidiRtpClientDisconnectConfig();
        MidiRtpClientDisconnectConfig(Guid clientId);

        [noexcept] Guid ClientId{ get; set; };
    }
}
