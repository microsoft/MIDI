#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";
import "MidiCapabilityInquiryMessage.idl";
import "MidiGroup.idl";



namespace Windows.Devices.Midi2.CapabilityInquiry
{
    [contract(MidiCapabilityInquiryApiContract,1)]

    // A capability inquiry message which arrived without having been asked for, or which could not
    // be matched to an outstanding request. Profile reports, subscription updates and a device's
    // own Discovery all come this way.
    [interface_name("Windows.Devices.Midi2.CapabilityInquiry.IMidiCapabilityInquiryMessageReceivedEventArgs", UUID_IMidiCapabilityInquiryMessageReceivedEventArgs)]
    runtimeclass MidiCapabilityInquiryMessageReceivedEventArgs
    {
        MidiCapabilityInquiryMessage Message{ get; };

        Windows.Devices.Midi2.MidiGroup Group{ get; };

        [noexcept] UInt64 Timestamp{ get; };
    };
}
