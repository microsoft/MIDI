#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiLoopbackFeedbackProtectionEnum.idl";

namespace Windows.Devices.Midi2.Transports.Loopback
{
    [contract(MidiTransportsLoopbackApiContract, 1)]

    // Changes a loopback which already exists. Only the properties you set are changed. Apply it
    // to the running loopback with MidiLoopbackManager.UpdateLoopback, and save it with
    // MidiServiceTransportPluginConfigManager.SaveUpdate. Saving it for a loopback which is not
    // saved returns ErrorEntryNotSaved.
    [interface_name("Windows.Devices.Midi2.Transports.Loopback.IMidiLoopbackUpdateConfig", UUID_IMidiLoopbackUpdateConfig)]
    [constructor_name("Windows.Devices.Midi2.Transports.Loopback.IMidiLoopbackUpdateConfigFactory", UUID_IMidiLoopbackUpdateConfigFactory)]
    runtimeclass MidiLoopbackUpdateConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        MidiLoopbackUpdateConfig(Guid associationId);

        [noexcept] Guid AssociationId{ get; };

        // An empty name is ignored, because every endpoint needs one
        [noexcept] String EndpointAName;
        [noexcept] String EndpointADescription;

        // Bare file name in the shared endpoint assets folder. Empty removes the picture.
        [noexcept] String EndpointAImageFileName;

        // An empty name is ignored, because every endpoint needs one
        [noexcept] String EndpointBName;
        [noexcept] String EndpointBDescription;

        // Bare file name in the shared endpoint assets folder. Empty removes the picture.
        [noexcept] String EndpointBImageFileName;

        [noexcept] Boolean IsMuted;

        [noexcept] MidiLoopbackFeedbackProtection FeedbackProtection;
    }
}
