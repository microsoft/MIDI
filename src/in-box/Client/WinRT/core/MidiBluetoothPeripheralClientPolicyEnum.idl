#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // Whether a remote Central which connects to this PC is let through without asking. Bluetooth
    // does not let Windows refuse the connection itself, so requiring approval means the device
    // stays connected but gets no MIDI endpoint and no data until somebody decides.
    enum MidiBluetoothPeripheralClientPolicy
    {
        RequireApproval = 0,
        AllowAny = 1,
    };
}
