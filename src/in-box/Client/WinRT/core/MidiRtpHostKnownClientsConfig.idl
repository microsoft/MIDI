#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiRtpKnownRemoteClient.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // Every remote a host has been told to allow or deny for good. Save it through
    // MidiServiceTransportPluginConfigManager.SaveUpdate so the decisions outlive a restart. There
    // is nothing to send: the running service already has each decision from
    // ApproveOrDenyRemoteClientConnectRequestAsync.
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpHostKnownClientsConfig", UUID_IMidiRtpHostKnownClientsConfig)]
    [constructor_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpHostKnownClientsConfigFactory", UUID_IMidiRtpHostKnownClientsConfigFactory)]
    runtimeclass MidiRtpHostKnownClientsConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        MidiRtpHostKnownClientsConfig();
        MidiRtpHostKnownClientsConfig(Guid hostId);

        [noexcept] Guid HostId{ get; set; };

        // Both saved lists are replaced by this, so it must be the complete set for the host. A
        // remote left out of it is forgotten. MidiRtpConfiguredHost.KnownRemoteClients is the set
        // the service holds now.
        [noexcept] Windows.Foundation.Collections.IVector<MidiRtpKnownRemoteClient> KnownClients{ get; };
    }
}
