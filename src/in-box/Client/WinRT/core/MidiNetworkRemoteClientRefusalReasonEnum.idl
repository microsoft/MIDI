#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    // Why a host turned a remote client away. A device has one session with this PC at a time.
    [contract(MidiTransportsNetworkApiContract, 2)]
    enum MidiNetworkRemoteClientRefusalReason
    {
        // a reason this version of the API doesn't know
        Unknown = 0,

        // the device already has a session with this host
        AlreadyConnectedToThisHost = 1,

        // this PC is already connected to the device as a client, through a client entry
        ThisPCAlreadyConnectedToRemote = 2,
    };
}
