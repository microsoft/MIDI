#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiBluetoothProtocolEnum.idl";
import "MidiBluetoothPeripheralClientPolicyEnum.idl";
import "MidiBluetoothPeripheralClient.idl";
import "MidiBluetoothRememberedClient.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothPeripheralStatus", UUID_IMidiBluetoothPeripheralStatus)]
    runtimeclass MidiBluetoothPeripheralStatus
    {
        [noexcept] Boolean IsRunning{ get; };

        [noexcept] MidiBluetoothProtocol Protocol{ get; };

        // The name remote devices see. Windows takes this from the computer name and gives an
        // application no way to override it, so it is reported rather than configured.
        [noexcept] String AdvertisedName{ get; };

        [noexcept] UInt32 SubscribedClientCount{ get; };

        // What happens to the next remote Central which connects. Reported whether or not the
        // peripheral is running, because it describes the rule rather than the current state.
        [noexcept] MidiBluetoothPeripheralClientPolicy ClientPolicy{ get; };

        // A remote Central being subscribed is the only sign that data can actually move
        [noexcept] Boolean IsClientConnected{ get; };

        // The endpoint represents the remote device, so it exists only while one is connected
        [noexcept] String EndpointDeviceId{ get; };
        [noexcept] String EndpointDeviceInstanceId{ get; };

        [noexcept] UInt64 MessagesReceived{ get; };
        [noexcept] UInt64 MessagesSent{ get; };

        // Null when nothing is connected
        [noexcept] MidiBluetoothPeripheralClient ConnectedClient{ get; };

        // Decisions the service is currently honoring. Pass this whole status to
        // MidiBluetoothPeripheralClientListConfig to write them to the configuration file.
        [noexcept] IVectorView<MidiBluetoothRememberedClient> AllowedClients{ get; };
        [noexcept] IVectorView<MidiBluetoothRememberedClient> DeniedClients{ get; };
    }
}
