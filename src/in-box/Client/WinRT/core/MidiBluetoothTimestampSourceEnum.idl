#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // Where the timestamps on messages from a device come from. BLE MIDI carries a 13 bit
    // millisecond timestamp which the transport correlates with this PC's clock, but several
    // inexpensive devices never advance theirs, and some keep jumping or run too unevenly to use.
    // Correlating against such a clock would put messages in the wrong place, so the time the
    // message arrived is substituted instead and reported here as an estimate.
    //
    // This is observed from received traffic rather than declared by the device, so it stays
    // Unknown until enough has been received to judge. A clock which never moved is picked up
    // again as soon as it starts moving. One that kept jumping, or was too uneven to smooth, is
    // judged again when the device reconnects.
    enum MidiBluetoothTimestampSource
    {
        Unknown = 0,
        Device = 1,
        ArrivalTime = 2,
    };
}
