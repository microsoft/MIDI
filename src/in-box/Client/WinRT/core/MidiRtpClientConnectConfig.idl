#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "IMidiServiceTransportPluginConfig.idl";
import "MidiRtpClientMatchCriteria.idl";
import "MidiRtpSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // Send with MidiRtpTransportManager.ConnectRtpClientAsync, and save with
    // MidiServiceTransportPluginConfigManager.SaveUpdate to reconnect after a restart
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpClientConnectConfig", UUID_IMidiRtpClientConnectConfig)]
    runtimeclass MidiRtpClientConnectConfig : Windows.Devices.Midi2.ServiceConfig.IMidiServiceTransportPluginConfig
    {
        // with a new ClientId
        MidiRtpClientConnectConfig();

        [noexcept] Guid ClientId;

        // optional, and written into the configuration file with the entry
        [noexcept] String Comment;

        // What the remote shows for this PC. Empty for this PC's name. At most 63 bytes in UTF-8.
        [noexcept] String Name;

        // Used instead of the remote's name for the endpoint, from the moment it is created.
        // Empty to use the name the remote sends.
        [noexcept] String CustomEndpointName;

        [noexcept] MidiRtpClientMatchCriteria MatchCriteria;

        // false to connect once, and stay disconnected after the connection ends
        [noexcept] Boolean AutoReconnect;

        // So the remote can repair a lost Note Off. Only turn off for a device which cannot parse it.
        [noexcept] Boolean SendRecoveryJournal;

        // How fast this PC sends to the remote. Set a limit when the remote passes what it
        // receives on to a 5-pin DIN cable and loses data in large SysEx dumps. Unlimited by
        // default. Changing only this on an existing client does not drop its connection.
        [noexcept] MidiRtpSendSpeedLimit SendSpeedLimit;
    }
}
