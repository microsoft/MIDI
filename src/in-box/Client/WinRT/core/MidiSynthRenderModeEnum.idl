#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Synth
{
    [contract(MidiTransportsSynthApiContract, 1)]
    enum MidiSynthRenderMode
    {
        // Reproduces the observable behavior of the older in-box synthesizer, limits included:
        // 32 voices, linear interpolation, no reverb or chorus, and a 22050 Hz render rate whose
        // bandwidth limit is part of the sound being reproduced.
        Compatible = 0,

        // The same sound set without the historic limits.
        Modern = 1,
    };
}
