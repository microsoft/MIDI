#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiLoopbackEndpointEntry.idl";
import "MidiLoopbackFeedbackProtectionEnum.idl";

namespace Windows.Devices.Midi2.Transports.Loopback
{
    [contract(MidiTransportsLoopbackApiContract, 1)]
    
    [interface_name("Windows.Devices.Midi2.Transports.Loopback.IMidiLoopbackEntry", UUID_IMidiLoopbackEntry)]
    runtimeclass MidiLoopbackEntry
    {
        [noexcept] Guid AssociationId{ get; };

        [noexcept] MidiLoopbackEndpointEntry EndpointA{ get; };
        [noexcept] MidiLoopbackEndpointEntry EndpointB{ get; };

        [noexcept] Boolean IsMuted{ get; };

        // Off when the transport on this PC cannot watch for feedback.
        [noexcept] MidiLoopbackFeedbackProtection FeedbackProtection{ get; };

        // True when the loopback is muted because MIDI was feeding back into it. Any change to
        // the muted state clears it.
        [noexcept] Boolean IsMutedForFeedback{ get; };

        // When the feedback was detected. Zero unless IsMutedForFeedback is true.
        [noexcept] Windows.Foundation.DateTime FeedbackDetectedTime{ get; };
    };
}
