#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiRtpConnection.idl";
import "MidiRtpKnownRemoteClient.idl";
import "MidiRtpRemoteClientPolicyEnum.idl";
import "MidiRtpRemoteClientSettings.idl";
import "MidiRtpSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // This PC, offered on the network for remote devices to connect to
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpConfiguredHost", UUID_IMidiRtpConfiguredHost)]
    runtimeclass MidiRtpConfiguredHost
    {
        [noexcept] Guid HostId{ get; };

        // what remote devices show in their lists
        [noexcept] String Name{ get; };

        [noexcept] String ServiceInstanceName{ get; };

        // The name actually on the network. The DNS client renames a name another device already
        // uses rather than refusing it.
        [noexcept] String ActualServiceInstanceName{ get; };
        [noexcept] Boolean ServiceInstanceNameWasChanged{ get; };

        [noexcept] Boolean IsEnabled{ get; };
        [noexcept] Boolean HasStarted{ get; };
        [noexcept] Boolean Advertise{ get; };

        // what the host was configured to use, or "auto"
        [noexcept] String ConfiguredPort{ get; };

        // zero until the host has started
        [noexcept] UInt16 ActualPort{ get; };

        [noexcept] Boolean AllowPortFallback{ get; };

        // True when the host could not have the port it wanted and started on another one: the
        // configured port, or 5004 when the port is automatic
        [noexcept] Boolean UsedPortFallback{ get; };

        [noexcept] Boolean SendRecoveryJournal{ get; };

        // The network adapter the host is limited to, or an empty GUID for every adapter, and the
        // name it had when it was chosen
        [noexcept] Guid NetworkAdapterId{ get; };
        [noexcept] String NetworkAdapterName{ get; };
        [noexcept] Boolean AllowNetworkAdapterFallback{ get; };

        // True when the host's adapter is missing. With HasStarted the host is running on every
        // adapter until it is back, which UsedNetworkAdapterFallback also says. Without it the
        // host is waiting for the adapter and starts by itself when it is back.
        [noexcept] Boolean IsNetworkAdapterMissing{ get; };
        [noexcept] Boolean UsedNetworkAdapterFallback{ get; };

        [noexcept] MidiRtpRemoteClientPolicy RemoteClientPolicy{ get; };

        // The decisions the service remembers for this host across a restart. Save these through
        // MidiRtpHostKnownClientsConfig to keep them in the configuration file.
        [noexcept] Windows.Foundation.Collections.IVectorView<MidiRtpKnownRemoteClient> KnownRemoteClients{ get; };

        // the HRESULT of the last attempt to start or advertise the host, or 0
        [noexcept] Int32 LastErrorCode{ get; };

        [noexcept] Windows.Foundation.Collections.IVectorView<MidiRtpConnection> Connections{ get; };

        // What the host is configured to send at, and what the running host is using. They
        // differ only for a moment after a change.
        [noexcept] MidiRtpSendSpeedLimit SendSpeedLimit{ get; };
        [noexcept] MidiRtpSendSpeedLimit CurrentSendSpeedLimit{ get; };

        // The remotes with their own settings, used for them instead of the host's. To change
        // one, send and save a MidiRtpHostRemoteClientSettingsConfig holding this whole list with
        // the change made.
        [noexcept] Windows.Foundation.Collections.IVectorView<MidiRtpRemoteClientSettings> RemoteClientSettings{ get; };
    }
}
