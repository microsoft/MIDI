#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiNetworkKnownRemoteClient.idl";
import "MidiNetworkMidi1PortGroup.idl";
import "MidiNetworkRemoteClientPolicyEnum.idl";
import "MidiNetworkRemoteClientSettings.idl";
import "MidiNetworkSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    // A host saved in the configuration file, which the service starts when it starts. This is
    // what is saved, not what is running now. GetConfiguredHosts reports that.
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkSavedHost", UUID_IMidiNetworkSavedHost)]
    runtimeclass MidiNetworkSavedHost
    {
        [noexcept] Guid HostId{ get; };

        [noexcept] String Name{ get; };
        [noexcept] String ServiceInstanceName{ get; };
        [noexcept] String ProductInstanceId{ get; };

        [noexcept] Boolean IsEnabled{ get; };

        // These include changes saved later with MidiNetworkHostUpdateConfig
        [noexcept] Boolean CreateOnlyUmpEndpoints{ get; };
        [noexcept] UInt8 FallbackMidi1PortCount{ get; };

        [noexcept] Boolean UseAutomaticPortAllocation{ get; };

        // Empty when UseAutomaticPortAllocation is true
        [noexcept] String ManuallyAssignedPort{ get; };

        [noexcept] Boolean AllowPortFallback{ get; };

        // These include changes saved later with MidiNetworkHostUpdateConfig. An empty GUID is
        // every adapter.
        [noexcept] Guid NetworkAdapterId{ get; };
        [noexcept] String NetworkAdapterName{ get; };
        [noexcept] Boolean AllowNetworkAdapterFallback{ get; };

        [noexcept] Boolean Advertise{ get; };

        [noexcept] MidiNetworkRemoteClientPolicy RemoteClientPolicy{ get; };

        // Every saved allow and deny decision. To change one, save a
        // MidiNetworkHostKnownClientsConfig holding this whole list with the change made.
        [noexcept] Windows.Foundation.Collections.IVectorView<MidiNetworkKnownRemoteClient> KnownRemoteClients{ get; };

        // These include changes saved later with MidiNetworkHostUpdateConfig
        [noexcept] MidiNetworkSendSpeedLimit SendSpeedLimit{ get; };
        [noexcept] Boolean ReduceSendSpeedAutomatically{ get; };

        // The remote clients with their own settings, as last saved with
        // MidiNetworkHostRemoteClientSettingsConfig
        [noexcept] Windows.Foundation.Collections.IVectorView<MidiNetworkRemoteClientSettings> RemoteClientSettings{ get; };

        // Added after Preview 11, so a new interface rather than a change to the one above
        [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkSavedHost2", UUID_IMidiNetworkSavedHost2)]
        [contract(MidiTransportsNetworkApiContract, 2)]
        {
            // True when none is saved. Includes a change saved later with MidiNetworkHostUpdateConfig.
            [noexcept] Boolean SkipInBetweenValuesToCatchUp{ get; };

            // Empty when none are saved, which means FallbackMidi1PortCount applies. Includes a
            // change saved later with MidiNetworkHostUpdateConfig. A new copy each time.
            [noexcept] Windows.Foundation.Collections.IVectorView<MidiNetworkMidi1PortGroup> FallbackMidi1PortGroups{ get; };
        }
    };
}
