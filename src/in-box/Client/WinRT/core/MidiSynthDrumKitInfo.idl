#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Synth
{
    [contract(MidiTransportsSynthApiContract, 1)]

    // One drum kit in the active sound set. Kits are selected by a program change on a drum
    // channel, not by a bank select.
    [interface_name("Windows.Devices.Midi2.Transports.Synth.IMidiSynthDrumKitInfo", UUID_IMidiSynthDrumKitInfo)]
    runtimeclass MidiSynthDrumKitInfo
    {
        String Name{ get; };

        // Zero-based, as it appears on the wire.
        UInt8 Program{ get; };
    }
}
