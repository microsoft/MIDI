#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";



namespace Windows.Devices.Midi2.Transports.BasicLoopback
{
    [contract(MidiTransportsBasicLoopbackApiContract, 1)]
    
    [interface_name("Windows.Devices.Midi2.Transports.BasicLoopback.IMidiBasicLoopbackEndpointDefinition", UUID_IMidiBasicLoopbackEndpointDefinition)]
    [constructor_name("Windows.Devices.Midi2.Transports.BasicLoopback.IMidiBasicLoopbackEndpointDefinitionFactory", UUID_IMidiBasicLoopbackEndpointDefinitionFactory)]
    runtimeclass MidiBasicLoopbackEndpointDefinition
    {
        MidiBasicLoopbackEndpointDefinition();
        MidiBasicLoopbackEndpointDefinition(String name);
        MidiBasicLoopbackEndpointDefinition(String name, String description);
        MidiBasicLoopbackEndpointDefinition(String name, String description, String uniqueId);

        [noexcept] String Name;
        [noexcept] String UniqueId;
        [noexcept] String Description;

        // Bare file name of a picture in the shared endpoint assets folder, not a path. An app
        // is expected to copy the customer's chosen file into that folder and name it here.
        [noexcept] String ImageFileName;
    };
}
