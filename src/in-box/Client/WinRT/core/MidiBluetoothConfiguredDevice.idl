#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Bluetooth
{
    [contract(MidiTransportsBluetoothApiContract, 1)]

    // A device saved in the service configuration. Passing a MidiBluetoothDeviceConnectConfig to
    // MidiServiceTransportPluginConfigManager.SaveUpdate is what puts one here.
    [interface_name("Windows.Devices.Midi2.Transports.Bluetooth.IMidiBluetoothConfiguredDevice", UUID_IMidiBluetoothConfiguredDevice)]
    runtimeclass MidiBluetoothConfiguredDevice
    {
        // The 12 hex digit Bluetooth address, in the same form MidiBluetoothDeviceInformation uses
        [noexcept] String BluetoothDeviceId{ get; };

        // Whatever the app that saved the entry passed as MidiBluetoothDeviceConnectConfig.Comment,
        // usually the device name. Empty when none was saved.
        [noexcept] String Comment{ get; };

        // False when the entry was kept but switched off with a MidiBluetoothDeviceDisconnectConfig,
        // so the service does not connect the device when it starts
        [noexcept] Boolean IsEnabled{ get; };
    }
}
