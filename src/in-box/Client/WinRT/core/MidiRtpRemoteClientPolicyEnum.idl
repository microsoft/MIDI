#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // What a host does when a remote which is on neither of its lists asks to connect. RTP-MIDI
    // has no way to tell a remote to wait, so a remote that needs approval gets no answer, keeps
    // asking for about twelve seconds, and gets in on its first ask after it is approved.
    enum MidiRtpRemoteClientPolicy
    {
        AllowAny = 0,
        RequireApproval = 1,
    };
}
