#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Synth
{
    [contract(MidiTransportsSynthApiContract, 1)]
    enum MidiSynthAudioOutputMode
    {
        // Opens the endpoint with the format it already reports, so no device setting is changed
        // and every other application keeps playing.
        WasapiShared = 0,

        // The same, but asks for the smallest period the audio engine will allow.
        WasapiSharedLowLatency = 1,

        // Takes the device for the synthesizer alone.
        WasapiExclusive = 2,

        Asio = 3,
    };
}
