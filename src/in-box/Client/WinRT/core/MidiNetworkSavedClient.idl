#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiNetworkClientMatchCriteria.idl";
import "MidiNetworkMidi1PortGroup.idl";
import "MidiNetworkSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    // A client saved in the configuration file, which the service connects when it starts. This
    // is what is saved, not what is connected now. GetConfiguredClients reports that.
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkSavedClient", UUID_IMidiNetworkSavedClient)]
    runtimeclass MidiNetworkSavedClient
    {
        [noexcept] Guid ClientId{ get; };

        // the comment saved with the entry, often the device's name
        [noexcept] String Comment{ get; };

        [noexcept] Boolean IsEnabled{ get; };

        // These include changes saved later with MidiNetworkClientUpdateConfig
        [noexcept] Boolean CreateOnlyUmpEndpoints{ get; };
        [noexcept] UInt8 FallbackMidi1PortCount{ get; };

        // The name this PC announces to the remote. Empty means the machine name.
        [noexcept] String UmpEndpointName{ get; };

        // Empty when the endpoint uses the name the remote device announces
        [noexcept] String CustomEndpointName{ get; };

        // A new copy each time, so changing it changes nothing
        [noexcept] MidiNetworkClientMatchCriteria MatchCriteria{ get; };

        // These include changes saved later with MidiNetworkClientUpdateConfig
        [noexcept] MidiNetworkSendSpeedLimit SendSpeedLimit{ get; };
        [noexcept] Boolean ReduceSendSpeedAutomatically{ get; };

        // Added after Preview 11, so a new interface rather than a change to the one above
        [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkSavedClient2", UUID_IMidiNetworkSavedClient2)]
        [contract(MidiTransportsNetworkApiContract, 2)]
        {
            // True when none is saved. Includes a change saved later with MidiNetworkClientUpdateConfig.
            [noexcept] Boolean SkipInBetweenValuesToCatchUp{ get; };

            // Empty when none are saved, which means FallbackMidi1PortCount applies. Includes a
            // change saved later with MidiNetworkClientUpdateConfig. A new copy each time.
            [noexcept] Windows.Foundation.Collections.IVectorView<MidiNetworkMidi1PortGroup> FallbackMidi1PortGroups{ get; };
        }
    };
}
