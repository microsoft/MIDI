#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";
import "MidiDeclaredDeviceIdentity.idl";



namespace Windows.Devices.Midi2.CapabilityInquiry
{
    [contract(MidiCapabilityInquiryApiContract,1)]

    [interface_name("Windows.Devices.Midi2.CapabilityInquiry.IMidiDeviceInfo", UUID_IMidiDeviceInfo)]
    [static_name("Windows.Devices.Midi2.CapabilityInquiry.IMidiDeviceInfoStatics", UUID_IMidiDeviceInfoStatics)]
    runtimeclass MidiDeviceInfo : Windows.Foundation.IStringable
    {
        MidiDeviceInfo();

        // The same identity the endpoint declares elsewhere, deliberately the same type. A device
        // states who it is through several different carriers and they are required to agree, so
        // sharing the type is what keeps them from drifting apart.
        Windows.Devices.Midi2.Enumeration.MidiDeclaredDeviceIdentity Identity;

        // Names for the numbers above. A device is free to send either, or neither.
        String Manufacturer;
        String Family;
        String Model;
        String Version;

        [noexcept] Windows.Data.Json.JsonObject GetJson();
        [noexcept] static MidiDeviceInfo FromJson(Windows.Data.Json.JsonObject json);
    };
}
