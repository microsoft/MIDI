#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiNetworkSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    // One remote client which has reached a host on this PC. Absence from the host's collection
    // is how a caller learns a remote client went away; nothing reports departures separately.
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkHostConnection", UUID_IMidiNetworkHostConnection)]
    runtimeclass MidiNetworkHostConnection
    {
        [noexcept] String UmpEndpointName{ get; };
        [noexcept] String ProductInstanceId{ get; };

        // live socket address, so it changes between reconnects. Display only, never for matching
        [noexcept] String RemoteAddress{ get; };
        [noexcept] String RemotePort{ get; };

        [noexcept] Boolean IsSessionActive{ get; };

        // true when the host is holding the invitation until the user approves or denies it
        [noexcept] Boolean IsPendingApproval{ get; };

        [noexcept] String EndpointDeviceId{ get; };

        // Measured from the Ping Reply round trip, averaged over the samples taken since this was
        // last read. Zero until the first reply arrives.
        [noexcept] UInt64 CurrentLatencyTicks{ get; };

        [noexcept] UInt32 RetransmitCount{ get; };                 // command packets we resent because this client asked
        [noexcept] UInt32 RetransmitRequestCount{ get; };          // retransmit requests this client sent us
        [noexcept] UInt64 TotalCountNetworkPacketsSent{ get; };
        [noexcept] UInt64 TotalCountNetworkPacketsReceived{ get; };

        // What the host sends to this client at right now. Lower than the host's SendSpeedLimit
        // while ReduceSendSpeedAutomatically has slowed the connection down.
        [noexcept] MidiNetworkSendSpeedLimit CurrentSendSpeedLimit{ get; };

        // What the host is configured to send to this client: the client's own settings when the
        // host has them, otherwise the host's
        [noexcept] MidiNetworkSendSpeedLimit SendSpeedLimit{ get; };
        [noexcept] Boolean ReduceSendSpeedAutomatically{ get; };

        // True when the two above come from the host's RemoteClientSettings for this client
        [noexcept] Boolean UsesRemoteClientSettings{ get; };
    };
}
