#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiNetworkClientEntryStateEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkConfiguredClient", UUID_IMidiNetworkConfiguredClient)]
    runtimeclass MidiNetworkConfiguredClient
    {
        [noexcept] Guid ClientId{ get; };  // internal id we use to match up in config file

        //Boolean IsEnabled;                    // true if this is allows to connect. Mostly for pre-configured connections
        [noexcept] Boolean IsSessionActive{ get; };                // true if a session is active

        // Where the configured entry is in its life. A client is reported even when it is not
        // connected, so an app can show something the service cannot currently reach.
        [noexcept] MidiNetworkClientEntryState EntryState{ get; };

        [noexcept] Boolean IsDirectConnection{ get; };             // configured by address and port rather than discovered
        [noexcept] String ConfiguredDirectAddress{ get; };
        [noexcept] String ConfiguredDirectPort{ get; };

        // The advertised host this entry was configured to match, as a Windows device id. Empty
        // for a direct connection. This is what ties a configured client back to a discovered
        // host, so an app can show one row instead of two.
        [noexcept] String MatchDeviceId{ get; };

        [noexcept] String ConnectedRemoteAddress{ get; };
        [noexcept] String ConnectedRemotePort{ get; };
        [noexcept] String ConnectedLocalAddress{ get; };
        [noexcept] String ConnectedLocalPort{ get; };              // need to see if I can get this in the service

        [noexcept] String EndpointDeviceId{ get; };                // the created MIDI endpoint's id

        [noexcept] UInt32 RetransmitCount{ get; };                 // number of times we've retransmitted messages to this client, for telemetry and debugging purposes
        [noexcept] UInt32 RetransmitRequestCount{ get; };          // number of times we've received a retransmit request from this client, for telemetry and debugging purposes
        [noexcept] UInt64 CurrentLatencyTicks{ get; };             // latency in ticks, for telemetry and debugging purposes
        [noexcept] UInt64 TotalCountNetworkPacketsSent{ get; };
        [noexcept] UInt64 TotalCountNetworkPacketsReceived{ get; };

    };
}

