#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

import "MidiNetworkMidi1PortGroup.idl";
import "MidiNetworkSendSpeedLimitEnum.idl";

namespace Windows.Devices.Midi2.Transports.Network
{
    // One remote client's own settings on a host, used for it instead of the host's. A remote
    // client is recognized by its name and product instance id together, ignoring case, the same
    // way the host's allow and deny lists recognize it.
    [contract(MidiTransportsNetworkApiContract, 1)]
    [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkRemoteClientSettings", UUID_IMidiNetworkRemoteClientSettings)]
    [constructor_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkRemoteClientSettingsFactory", UUID_IMidiNetworkRemoteClientSettingsFactory)]
    runtimeclass MidiNetworkRemoteClientSettings
    {
        MidiNetworkRemoteClientSettings();
        MidiNetworkRemoteClientSettings(String remoteClientName, String remoteClientProductInstanceId);

        [noexcept] String RemoteClientName { get; set; };
        [noexcept] String RemoteClientProductInstanceId { get; set; };

        // How fast the host sends to this remote client. Unlimited by default.
        [noexcept] MidiNetworkSendSpeedLimit SendSpeedLimit { get; set; };

        // While this remote client keeps asking for data again, send more slowly, down to MIDI
        // 1.0 wire speed, then go back up to SendSpeedLimit once it stops. Off by default.
        [noexcept] Boolean ReduceSendSpeedAutomatically { get; set; };

        // Added after Preview 11, so a new interface rather than a change to the one above
        [interface_name("Windows.Devices.Midi2.Transports.Network.IMidiNetworkRemoteClientSettings2", UUID_IMidiNetworkRemoteClientSettings2)]
        [contract(MidiTransportsNetworkApiContract, 2)]
        {
            // When messages back up behind SendSpeedLimit, skip some in-between values so this
            // remote client catches up. True by default.
            [noexcept] Boolean SkipInBetweenValuesToCatchUp { get; set; };

            // The groups to create MIDI 1.0 ports for when this remote client doesn't describe
            // itself, and what to call them. Used instead of the host's when it isn't empty. Empty
            // by default.
            [noexcept] Windows.Foundation.Collections.IVector<MidiNetworkMidi1PortGroup> FallbackMidi1PortGroups { get; };

            // Ignore SendSpeedLimit, ReduceSendSpeedAutomatically and SkipInBetweenValuesToCatchUp
            // here and send to this remote client at the host's speed. For an entry which is only
            // there for its MIDI 1.0 port groups. False by default.
            [noexcept] Boolean UseHostSendSpeed { get; set; };
        }
    }
}
