#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 1)]

    // Which remote a client connects to. Set either the advertised name, or the address and port.
    [interface_name("Windows.Devices.Midi2.Transports.Rtp.IMidiRtpClientMatchCriteria", UUID_IMidiRtpClientMatchCriteria)]
    runtimeclass MidiRtpClientMatchCriteria
    {
        MidiRtpClientMatchCriteria();

        // from MidiRtpAdvertisedHost.ServiceInstanceName. Found again when its address changes.
        [noexcept] String ServiceInstanceName;

        // an address, or a host name to look up each time the client connects
        [noexcept] String DirectHostNameOrIPAddress;

        // the remote's control port. RTP-MIDI also uses the port after it.
        [noexcept] UInt16 DirectPort;
    }
}
