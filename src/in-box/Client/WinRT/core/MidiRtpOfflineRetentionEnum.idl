#include "..\..\..\Inc\midi_sdk_idl_defs.h"
import "MidiApiContracts.idl";

namespace Windows.Devices.Midi2.Transports.Rtp
{
    [contract(MidiTransportsRtpApiContract, 2)]

    // How long a client's MIDI endpoint stays while its remote is away. Anything greater than zero
    // is a number of seconds, so these name only the values which are not a duration.
    //
    // This matters because an application using WinMM or WinRT MIDI 1.0 has no way to ask whether
    // a device is present. Whether its port exists is the only signal it gets.
    enum MidiRtpOfflineRetention
    {
        // The endpoint is there from the moment the service starts, whether or not the remote
        // answers, and stays until the client is disconnected here or removed. Needs AutoReconnect.
        KeepAlways = -1,

        // The endpoint and its MIDI 1.0 ports are removed as soon as the connection ends, and are
        // made again when it connects. This is the default.
        Immediate = 0,
    };
}
