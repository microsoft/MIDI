<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
      <ImplicitUsings>enable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <StartupObject></StartupObject>
      <RootNamespace>WindowsMidiServices</RootNamespace>
      <PlatformTargets>x64, ARM64</PlatformTargets>
      <AllowUnsafeBlocks>False</AllowUnsafeBlocks>

      <PublishSingleFile>false</PublishSingleFile>
      <PublishSelfContained>false</PublishSelfContained>
      <SelfContained>false</SelfContained>
      <PublishTrimmed>false</PublishTrimmed>
      <PublishAot>false</PublishAot>

      <Platforms>ARM64;x64</Platforms>
      <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
      <!-- Without this, the build script gets "NETSDK1083: The specified RuntimeIdentifier 'win10-x64' is not recognized" -->
      <!--<UseRidGraph>true</UseRidGraph>-->

      <!-- Needed for System.Management for viewing service details -->
      <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

      <AssemblyVersion></AssemblyVersion>

      <!-- needed to copy the required winrt implmentation dlls to bin folder -->
      <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

      <RollForward>LatestMinor</RollForward>

      <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>

      <NoWin32Manifest>true</NoWin32Manifest>

      <!-- Referenced projects bring their .pdb along by default. That drags the ~90 MB native SDK
           symbol file into the module folder, where nothing reads it. Release symbols are gathered
           separately by build\build-sdk.ps1. -->
      <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />

    <!-- PowerShell supplies these at run time from its own load context, so the copies this
         package would place beside the module are never used. -->
    <PackageReference Include="System.Management.Automation" Version="7.4.7" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuGet\Windows.Devices.Midi2.NuGet\Windows.Devices.Midi2.NuGet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FormatsToProcess in the manifest resolves relative to the module folder, so this has to
         travel with the assembly for both build and publish. -->
    <Content Include="WindowsMidiServices.format.ps1xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>




</Project>
