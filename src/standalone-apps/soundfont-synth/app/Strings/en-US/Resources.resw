  <!-- ==================================== App ==================================== -->
  <data name="AppDisplayName" xml:space="preserve">
    <value>MIDI 2.0 SoundFont Synth</value>
    <comment>Product name. Also the MIDI session name and the model name the synths report over MIDI-CI.</comment>
  </data>
  <data name="PreviewChicletText.Text" xml:space="preserve">
    <value>PREVIEW</value>
    <comment>Shown in the title bar. All capitals on purpose, so it reads as a badge.</comment>
  </data>
  <data name="DefaultSynthName" xml:space="preserve">
    <value>SoundFont Synth</value>
    <comment>Used when a file name gives nothing to name a synth after. 31 characters at most.</comment>
  </data>
  <data name="VirtualDeviceDescriptionFormat" xml:space="preserve">
    <value>SoundFont synth playing {0}</value>
    <comment>The description Windows shows for a synth's MIDI endpoint. {0} is the SoundFont file name.</comment>
